#!/usr/bin/env bash
set -euo pipefail

NFT_CONFIG="/etc/nftables.conf"
BACKUP_DIR="/etc/nftables.conf.ctos-backups"

if [ "$(id -u)" -ne 0 ]; then
  echo "ctos-install-host-firewall must run as root" >&2
  exit 1
fi

if [ ! -f "$NFT_CONFIG" ]; then
  echo "missing $NFT_CONFIG" >&2
  exit 1
fi

if grep -Fq 'ctos vm egress' "$NFT_CONFIG"; then
  echo "CTOS VM egress rules already present in $NFT_CONFIG"
  exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

awk '
  {
    print
    if ($0 ~ /^[[:space:]]*chain forward[[:space:]]*\{[[:space:]]*$/) {
      in_forward = 1
      next
    }
    if (in_forward && $0 ~ /^[[:space:]]*policy drop[[:space:]]*$/) {
      print "    iifname \"virbr-ctos\" oifname \"wlan0\" ct state { new, established, related } counter accept comment \"ctos vm egress\""
      print "    iifname \"wlan0\" oifname \"virbr-ctos\" ct state established,related counter accept comment \"ctos vm egress return\""
      in_forward = 0
    }
  }
' "$NFT_CONFIG" >"$tmp"

nft -c -f "$tmp"

install -d -m 0755 "$BACKUP_DIR"
backup="$BACKUP_DIR/nftables.conf.$(date +%Y%m%d-%H%M%S)"
cp "$NFT_CONFIG" "$backup"
install -m 0644 "$tmp" "$NFT_CONFIG"
nft -f "$NFT_CONFIG"

echo "Installed CTOS VM egress rules in $NFT_CONFIG"
echo "Backup: $backup"
