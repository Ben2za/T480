#!/usr/bin/env bash
set -u

section() {
  printf '\n## %s\n' "$1"
}

run() {
  printf '+ %s\n' "$*"
  "$@" 2>&1 || true
}

if [ "$(id -u)" -ne 0 ]; then
  echo "ctos-firewall-report must run as root" >&2
  exit 1
fi

section "Host"
run date -Is
run uname -a
run id

section "Routes And Interfaces"
run ip -brief addr
run ip route
run sysctl net.ipv4.ip_forward
run sysctl net.ipv4.conf.all.rp_filter
run sysctl net.ipv4.conf.default.rp_filter
run sysctl net.ipv4.conf.virbr-ctos.rp_filter
run sysctl net.ipv4.conf.virbr0.rp_filter
run sysctl net.ipv4.conf.wlan0.rp_filter

section "Libvirt Networks"
run virsh -c qemu:///system net-info ctos-nat
run virsh -c qemu:///system net-dumpxml ctos-nat
run virsh -c qemu:///system net-info default
run virsh -c qemu:///system net-dumpxml default
run virsh -c qemu:///system domiflist ctos-kali

section "Firewalld"
run firewall-cmd --state
run firewall-cmd --get-default-zone
run firewall-cmd --get-active-zones
run firewall-cmd --get-active-policies
run firewall-cmd --zone=libvirt --list-all
run firewall-cmd --zone=public --list-all
run firewall-cmd --info-policy=ctos-vm-egress
run firewall-cmd --direct --get-all-rules

section "Nftables"
run nft list ruleset

section "Iptables Compat"
run iptables-save
