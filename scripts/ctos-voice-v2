        "opengrm_ngramprint": tools_dir / "opengrm" / "bin" / "ngramprint",
        "phonetisaurus": tools_dir / "phonetisaurus",
    }


def remote_path_probe(user: str, host: str, paths: dict[str, Path]) -> dict[str, Any]:
    commands = ["printf 'PATHS\\n'"]
    for name, path in paths.items():
        quoted_name = shlex.quote(name)
        quoted_path = shlex.quote(str(path))
        commands.append(
            "if test -e {path}; then printf 'ok\\t%s\\t%s\\n' {name} {path}; "
            "else printf 'missing\\t%s\\t%s\\n' {name} {path}; fi".format(
                name=quoted_name,
                path=quoted_path,
            )
        )
    remote = "; ".join(commands)
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=12,
    )


def remote_path_prepare(user: str, host: str, paths: dict[str, Path]) -> dict[str, Any]:
    commands = ["set -u", "printf 'PREPARE\\n'"]
    for name, path in paths.items():
        quoted_name = shlex.quote(name)
        quoted_path = shlex.quote(str(path))
        commands.append(
            "install -d -m 2775 {path} && printf 'ok\\t%s\\t%s\\n' {name} {path}".format(
                name=quoted_name,
                path=quoted_path,
            )
        )
    remote = "; ".join(commands)
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=12,
    )


