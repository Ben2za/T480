def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="CTOS voice backend V2 planning and readiness helper")
    sub = parser.add_subparsers(dest="command", required=True)

    plan = sub.add_parser("plan", help="show the selected V2 direction")
    plan.set_defaults(func=cmd_plan)

    backends = sub.add_parser("backends", help="show backend registry")
    backends.add_argument("--json", action="store_true")
    backends.set_defaults(func=cmd_backends)

    intents = sub.add_parser("intents", help="show CTOS French intent catalog")
    intents.add_argument("--json", action="store_true")
    intents.set_defaults(func=cmd_intents)

    export_phrases = sub.add_parser("export-phrases", help="export phrases for backend handoff")
    export_phrases.add_argument(
        "--format",
        choices=(
            "plain",
            "jsonl",
            "tsv",
            "yaml",
            "ha-sentences",
            "home-assistant",
            "speech-to-phrase",
            "ha-map",
            "intent-map",
        ),
        default="plain",
    )
    export_phrases.set_defaults(func=cmd_export_phrases)

    export_backend = sub.add_parser("export-backend", help="write backend handoff files under a directory")
    export_backend.add_argument("--backend", choices=("home-assistant", "speech-to-phrase"), default="home-assistant")
    export_backend.add_argument("--dir", default="/tmp/ctos-voice-backend")
    export_backend.set_defaults(func=cmd_export_backend)

    validate_backend = sub.add_parser("validate-backend", help="validate an exported backend bundle")
    validate_backend.add_argument("--dir", default="/tmp/ctos-voice-backend")
    validate_backend.add_argument("--json", action="store_true")
    validate_backend.set_defaults(func=cmd_validate_backend)

    backend_commands = sub.add_parser("backend-commands", help="print safe next commands for a mature backend handoff")
