    status.add_argument("--json", action="store_true")
    status.add_argument("--target-probe", action="store_true", help="also probe ctos-core over SSH")
    status.add_argument("--host", default=DEFAULT_CORE_HOST)
    status.add_argument("--user", default=DEFAULT_CORE_USER)
    status.set_defaults(func=cmd_status)

    next_commands = sub.add_parser("next-commands", help="print the next safe handoff commands")
    next_commands.set_defaults(func=cmd_next_commands)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
