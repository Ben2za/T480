def load_json(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as error:
        raise SystemExit(f"cannot read {path}: {error}") from error
    except json.JSONDecodeError as error:
        raise SystemExit(f"invalid JSON in {path}: {error}") from error
    if not isinstance(data, dict):
        raise SystemExit(f"{path} must contain a JSON object")
    return data


def load_intents() -> dict[str, Any]:
    try:
        return load_intent_catalog(INTENTS)
    except IntentCatalogError as error:
        raise SystemExit(str(error)) from error


def which(name: str) -> str | None:
    return shutil.which(name)


def command_status(names: list[str]) -> dict[str, str | None]:
    return {name: which(name) for name in names}


def run(args: list[str], timeout: float = 8.0) -> dict[str, Any]:
    try:
        proc = subprocess.run(args, capture_output=True, check=False, text=True, timeout=timeout)
        return {
            "rc": proc.returncode,
            "stdout": proc.stdout.strip(),
            "stderr": proc.stderr.strip(),
        }
    except FileNotFoundError:
        return {"rc": 127, "stdout": "", "stderr": f"{args[0]} not found"}
    except subprocess.TimeoutExpired:
        return {"rc": 124, "stdout": "", "stderr": "timeout"}


def slug(text: str) -> str:
    normalized = normalize_text(text)
    return normalized.replace(" ", "-") or "sample"


def yaml_scalar(value: Any) -> str:
    return json.dumps(str(value), ensure_ascii=False)


def ha_intent_name(intent_id: Any) -> str:
    parts = [part for part in str(intent_id or "").replace("-", "_").split("_") if part]
    if not parts:
        return "CTOSUnknown"
    rendered: list[str] = []
    for part in parts:
        if part.casefold() == "ctos":
            rendered.append("CTOS")
        else:
            rendered.append(part[:1].upper() + part[1:])
    return "".join(rendered)


def catalog_language() -> str:
    language = load_intents().get("language", "fr")
    return str(language or "fr")


def render_custom_sentences(entries: list[dict[str, Any]]) -> str:
    lines = [
        "# Generated from ai/voice_intents_fr.json.",
        "# Recognition only: map backend intent names back through ctos_intent_map.json.",
        f"language: {yaml_scalar(catalog_language())}",
        "intents:",
    ]
    for intent in entries:
        phrases = [phrase for phrase in intent.get("phrases", []) if isinstance(phrase, str)]
        if not phrases:
            continue
        lines.append(f"  {ha_intent_name(intent.get('id'))}:")
        lines.append("    data:")
        lines.append("      - sentences:")
        for phrase in phrases:
            lines.append(f"          - {yaml_scalar(phrase)}")
    return "\n".join(lines) + "\n"


def backend_intent_map(entries: list[dict[str, Any]]) -> dict[str, Any]:
    mapped: dict[str, Any] = {}
    for intent in entries:
        command = intent.get("command")
        phrases = [phrase for phrase in intent.get("phrases", []) if isinstance(phrase, str)]
        mapped[ha_intent_name(intent.get("id"))] = {
            "ctos_intent_id": intent.get("id"),
            "tier": intent.get("tier"),
            "command": command if isinstance(command, list) else [],
            "spoken_reply": intent.get("spoken_reply"),
            "phrase_count": len(phrases),
        }
    return {
        "schema": 1,
        "source": str(INTENTS.relative_to(ROOT)),
        "language": catalog_language(),
        "backend_intents": mapped,
        "policy": {
            "recognition_only": True,
            "mutable_actions": "ctos_approval_required",
            "recordings": "temporary_by_default",
        },
    }


def render_backend_readme(backend: str, root: Path, sentences: Path, intent_map: Path) -> str:
    relative_sentences = sentences.relative_to(root)
    relative_map = intent_map.relative_to(root)
    return "\n".join([
        "# CTOS Voice Backend Export",
        "",
        f"Backend target: `{backend}`",
        "",
        "Generated files:",
        "",
        f"- `{relative_sentences}`: Home Assistant custom sentences YAML.",
        f"- `{relative_map}`: CTOS sidecar map from backend intent names to CTOS commands.",
        "",
        "This bundle is recognition-only. Do not execute backend intent names directly.",
        "Route recognized intents back through CTOS permission tiers and approval handling.",
        "",
        "Suggested use:",
        "",
        "```bash",
        "ctos-voice-v2 export-backend --backend home-assistant --dir /tmp/ctos-voice-backend",
        "```",
        "",
    ]) + "\n"


def parse_generated_custom_sentences(path: Path) -> dict[str, list[str]]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        raise SystemExit(f"cannot read {path}: {error}") from error
    current: str | None = None
    parsed: dict[str, list[str]] = {}
    intent_re = re.compile(r"^  ([A-Za-z][A-Za-z0-9_]*):$")
    for line_no, line in enumerate(lines, start=1):
        match = intent_re.match(line)
        if match:
            current = match.group(1)
            parsed.setdefault(current, [])
            continue
        stripped = line.strip()
        if not stripped.startswith("- "):
            continue
        item = stripped[2:].strip()
        if not item.startswith('"'):
            continue
        if current is None:
            raise SystemExit(f"{path}:{line_no}: sentence outside intent")
        try:
            parsed[current].append(str(json.loads(item)))
        except json.JSONDecodeError as error:
            raise SystemExit(f"{path}:{line_no}: invalid quoted sentence: {error}") from error
    return parsed


def backend_bundle_paths(root: Path, language: str) -> dict[str, Path]:
    return {
        "root": root,
        "sentences": root / "custom_sentences" / language / "ctos.yaml",
        "map": root / "ctos_intent_map.json",
        "readme": root / "README.md",
    }


def validate_backend_bundle(root: Path) -> dict[str, Any]:
    entries = intent_entries()
    language = catalog_language()
    paths = backend_bundle_paths(root, language)
    checks: list[dict[str, Any]] = []
    failures = 0

    def add(name: str, ok: bool, detail: str) -> None:
        nonlocal failures
        if not ok:
            failures += 1
        checks.append({"name": name, "ok": ok, "detail": detail})

    for key in ("sentences", "map", "readme"):
        path = paths[key]
        add(f"{key}_exists", path.exists(), str(path))
    if failures:
        return {
            "ok": False,
            "root": str(root),
            "language": language,
            "paths": {key: str(value) for key, value in paths.items()},
            "checks": checks,
            "failures": failures,
        }

    parsed_sentences = parse_generated_custom_sentences(paths["sentences"])
    try:
        intent_map = json.loads(paths["map"].read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"cannot parse {paths['map']}: {error}") from error
    backend_map = intent_map.get("backend_intents") if isinstance(intent_map, dict) else None
    add("map_shape", isinstance(backend_map, dict), "backend_intents object")
    if not isinstance(backend_map, dict):
        backend_map = {}

    expected_names = [ha_intent_name(intent.get("id")) for intent in entries]
    add(
        "sentence_intent_set",
        set(parsed_sentences) == set(expected_names),
        f"expected={len(expected_names)} actual={len(parsed_sentences)}",
    )
    add(
        "map_intent_set",
        set(backend_map) == set(expected_names),
        f"expected={len(expected_names)} actual={len(backend_map)}",
    )
    for intent in entries:
        name = ha_intent_name(intent.get("id"))
        phrases = [phrase for phrase in intent.get("phrases", []) if isinstance(phrase, str)]
        mapped = backend_map.get(name, {})
        if not isinstance(mapped, dict):
            mapped = {}
        add(f"{name}.phrases", parsed_sentences.get(name) == phrases, f"{len(phrases)} phrases")
        add(f"{name}.ctos_id", mapped.get("ctos_intent_id") == intent.get("id"), str(intent.get("id")))
        add(f"{name}.tier", mapped.get("tier") == intent.get("tier"), f"T{intent.get('tier')}")
        add(f"{name}.command", mapped.get("command") == intent.get("command"), " ".join(intent.get("command", [])))
        tier = intent.get("tier")
        add(f"{name}.safe_tier", isinstance(tier, int) and tier <= 1, f"T{tier}")
    return {
        "ok": failures == 0,
        "root": str(root),
        "language": language,
        "paths": {key: str(value) for key, value in paths.items()},
        "checks": checks,
        "failures": failures,
    }


def load_samples_manifest(path: Path) -> list[dict[str, Any]]:
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as error:
        raise SystemExit(f"cannot read {path}: {error}") from error
    stripped = raw.strip()
    if not stripped:
        return []
    if path.suffix.lower() == ".jsonl":
        samples: list[dict[str, Any]] = []
        for line_no, line in enumerate(stripped.splitlines(), start=1):
            line = line.strip()
            if not line:
                continue
            try:
                item = json.loads(line)
            except json.JSONDecodeError as error:
                raise SystemExit(f"invalid JSONL in {path}:{line_no}: {error}") from error
            if not isinstance(item, dict):
                raise SystemExit(f"{path}:{line_no} must contain a JSON object")
            samples.append(item)
        return samples
    try:
        payload = json.loads(stripped)
    except json.JSONDecodeError as error:
        raise SystemExit(f"invalid JSON in {path}: {error}") from error
    if isinstance(payload, list):
        return [item for item in payload if isinstance(item, dict)]
    if isinstance(payload, dict):
        samples = payload.get("samples", [])
        if isinstance(samples, list):
            return [item for item in samples if isinstance(item, dict)]
    raise SystemExit(f"{path} must contain a samples list")


def samples_from_dir(path: Path) -> list[dict[str, Any]]:
    if not path.is_dir():
        raise SystemExit(f"sample dir not found: {path}")
    rows: list[dict[str, Any]] = []
    for wav in sorted(path.glob("*.wav")):
        stem = wav.stem
        if "__" in stem:
            expected, label = stem.split("__", 1)
        else:
            expected, label = "", stem
        rows.append({
            "id": stem,
            "file": str(wav),
            "intent_id": expected or None,
            "label": label.replace("-", " "),
        })
    return rows


def sample_path(sample: dict[str, Any], base: Path | None) -> Path | None:
    raw = sample.get("file") or sample.get("path")
    if not isinstance(raw, str) or not raw:
        return None
    path = Path(raw).expanduser()
    if not path.is_absolute() and base is not None:
        path = base / path
    return path


def sample_transcript(
    sample: dict[str, Any],
    base: Path | None,
    timeout: float,
    backend: str,
    args: argparse.Namespace,
) -> tuple[int, str, str]:
    for key in ("transcript", "text", "recognized_text"):
        value = sample.get(key)
        if isinstance(value, str) and value.strip():
            return 0, value.strip(), "manifest"
    path = sample_path(sample, base)
    if path is None:
        return 2, "", "missing transcript/file"
    if not path.exists():
        return 2, "", f"file not found: {path}"

    if backend == "open-stt":
        command = [
            str(ROOT / "scripts" / "ctos-voice-v2"),
            "stp-transcribe",
            "--from-wav",
            str(path),
            "--wyoming-host",
            args.wyoming_host,
            "--wyoming-port",
            str(args.wyoming_port),
            "--preprocess",
            args.preprocess,
            "--language",
            args.language,
            "--timeout",
            str(timeout),
            "--json",
            "--no-speak",
        ]
        if args.target_tunnel:
            command += ["--target-tunnel", "--host", args.host, "--user", args.user]
        result = run(command, timeout=max(timeout + 30, timeout * 2))
        if result["rc"] != 0:
            try:
                payload = json.loads(result["stdout"] or "{}")
            except json.JSONDecodeError:
                payload = {}
            recognition = payload.get("recognition") if isinstance(payload, dict) else {}
            if isinstance(recognition, dict):
                text = str(recognition.get("transcript") or "").strip()
                if text:
                    return int(result["rc"]), text, "open-stt guarded"
                error = recognition.get("error")
                if error:
                    return int(result["rc"]), "", str(error)
            return int(result["rc"]), "", result["stderr"] or result["stdout"] or "open-stt transcription failed"
        try:
            payload = json.loads(result["stdout"] or "{}")
        except json.JSONDecodeError:
            return 1, "", result["stdout"] or "invalid open-stt JSON"
        recognition = payload.get("recognition") if isinstance(payload, dict) else {}
        if not isinstance(recognition, dict):
            return 1, "", "missing open-stt recognition payload"
        text = str(recognition.get("transcript") or "").strip()
        if not text:
            return 4, "", "empty open-stt transcript"
        return 0, text, "open-stt"

    result = run([str(ROOT / "scripts" / "ctos-voice"), "transcribe-file", str(path), "--json"], timeout=timeout)
    if result["rc"] != 0:
        return int(result["rc"]), "", result["stderr"] or result["stdout"] or "transcription failed"
    try:
        payload = json.loads(result["stdout"] or "{}")
    except json.JSONDecodeError:
        return 1, "", result["stdout"] or "invalid transcription JSON"
    text = str(payload.get("text") or "").strip()
    if not text:
        return 4, "", "empty transcript"
    return 0, text, "vosk"


def expected_intent(sample: dict[str, Any]) -> str | None:
    for key in ("intent_id", "expected_intent", "expected"):
        value = sample.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def expected_text(sample: dict[str, Any]) -> str | None:
    for key in ("expected_text", "expected_transcript", "label"):
        value = sample.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def validate_registry() -> list[str]:
    errors: list[str] = []
    registry = load_json(BACKENDS)
    backends = registry.get("backends")
    if not isinstance(backends, list) or not backends:
        errors.append("voice_backends.json needs a non-empty backends list")
    else:
        seen: set[str] = set()
        for backend in backends:
            if not isinstance(backend, dict):
                errors.append("each backend entry must be an object")
                continue
            backend_id = str(backend.get("id") or "")
            if not backend_id:
                errors.append("backend without id")
            if backend_id in seen:
                errors.append(f"duplicate backend id: {backend_id}")
            seen.add(backend_id)
    errors.extend(validate_intent_catalog(INTENTS))
    return errors


def core_probe(user: str, host: str) -> dict[str, Any]:
    remote = (
        "printf 'TOOLS\\n'; "
        "command -v docker podman python3 git curl ssh || true; "
        "printf 'SERVICES\\n'; "
        "systemctl is-active sshd NetworkManager ollama 2>/dev/null || true"
    )
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=8,
    )


def python_module_status(module: str, python_bin: str | Path = sys.executable) -> dict[str, Any]:
    python_path = str(python_bin)
    result = run(
        [
            python_path,
            "-c",
            "import importlib.util, sys; "
            f"sys.exit(0 if importlib.util.find_spec({module!r}) else 1)",
        ],
        timeout=8,
    )
    return {
        "importable": result["rc"] == 0,
        "python": python_path,
        "rc": result["rc"],
        "stderr": result["stderr"],
    }


def hassil_parse_status(python_bin: str | Path, sentences: Path) -> dict[str, Any]:
    python_path = str(python_bin)
    script = (
        "import json, sys; "
        "from pathlib import Path; "
        "from hassil import Intents; "
        "path = Path(sys.argv[1]); "
        "intents = Intents.from_files([path]); "
        "print(json.dumps({'intent_count': len(intents.intents), "
        "'intent_names': sorted(intents.intents.keys())}, ensure_ascii=False))"
    )
    result = run([python_path, "-c", script, str(sentences)], timeout=12)
    payload: dict[str, Any] = {
        "ok": result["rc"] == 0,
        "python": python_path,
        "sentences": str(sentences),
        "rc": result["rc"],
        "stdout": result["stdout"],
        "stderr": result["stderr"],
    }
    if result["rc"] == 0 and result["stdout"]:
        try:
            parsed = json.loads(result["stdout"])
            if isinstance(parsed, dict):
                payload.update(parsed)
        except json.JSONDecodeError:
            pass
    return payload


def speech_to_phrase_help_status(python_bin: str | Path) -> dict[str, Any]:
    python_path = str(python_bin)
    result = run([python_path, "-m", "speech_to_phrase", "--help"], timeout=12)
    return {
        "ok": result["rc"] == 0,
        "python": python_path,
        "rc": result["rc"],
        "stdout_first_line": (result["stdout"].splitlines() or [""])[0],
        "stderr": result["stderr"],
    }


def speech_to_phrase_train_help_status(python_bin: str | Path) -> dict[str, Any]:
    python_path = str(python_bin)
    result = run([python_path, "-m", "speech_to_phrase.train", "--help"], timeout=12)
    return {
        "ok": result["rc"] == 0,
        "python": python_path,
        "rc": result["rc"],
        "stdout_first_line": (result["stdout"].splitlines() or [""])[0],
        "stderr": result["stderr"],
    }


def speech_to_phrase_model_info(python_bin: str | Path, model_id: str) -> dict[str, Any]:
    python_path = str(python_bin)
    script = (
        "import json, sys; "
        "from speech_to_phrase.models import MODELS, URL_FORMAT; "
        "model_id = sys.argv[1]; "
        "model = next((m for m in MODELS.values() if m.id == model_id), None); "
        "payload = {'ok': model is not None, 'model_id': model_id}; "
        "payload.update({} if model is None else {"
        "'type': str(model.type.value), 'language': model.language, "
        "'language_family': model.language_family, "
        "'sentences_language': model.sentences_language, "
        "'download_url': URL_FORMAT.format(model_id=model.id)}); "
        "print(json.dumps(payload, ensure_ascii=False))"
    )
    result = run([python_path, "-c", script, model_id], timeout=12)
    payload: dict[str, Any] = {
        "ok": False,
        "python": python_path,
        "model_id": model_id,
        "rc": result["rc"],
        "stdout": result["stdout"],
        "stderr": result["stderr"],
    }
    if result["rc"] == 0 and result["stdout"]:
        try:
            parsed = json.loads(result["stdout"])
            if isinstance(parsed, dict):
                payload.update(parsed)
        except json.JSONDecodeError:
            pass
    return payload


def path_status(paths: dict[str, Path]) -> dict[str, Any]:
    items = {
        name: {"path": str(path), "exists": path.exists()}
        for name, path in paths.items()
    }
    return {
        "ready": all(item["exists"] for item in items.values()),
        "items": items,
    }


def speech_to_phrase_training_status(
    python_bin: str | Path,
    model_id: str,
    train_dir: Path,
    tools_dir: Path,
    models_dir: Path,
) -> dict[str, Any]:
    train_help = speech_to_phrase_train_help_status(python_bin)
    model = speech_to_phrase_model_info(python_bin, model_id) if train_help["ok"] else {
        "ok": False,
        "model_id": model_id,
        "detail": "train helper unavailable",
    }
    tools = path_status({
        "kaldi_prepare_lang": tools_dir / "kaldi" / "utils" / "prepare_lang.sh",
        "kaldi_format_lm": tools_dir / "kaldi" / "utils" / "format_lm.sh",
        "kaldi_mkgraph": tools_dir / "kaldi" / "utils" / "mkgraph.sh",
        "kaldi_online_decoding": tools_dir / "kaldi" / "steps" / "online" / "nnet3" / "prepare_online_decoding.sh",
        "openfst_fstcompile": tools_dir / "openfst" / "bin" / "fstcompile",
        "openfst_fstarcsort": tools_dir / "openfst" / "bin" / "fstarcsort",
        "opengrm_ngramcount": tools_dir / "opengrm" / "bin" / "ngramcount",
        "opengrm_ngrammake": tools_dir / "opengrm" / "bin" / "ngrammake",
        "opengrm_ngramprint": tools_dir / "opengrm" / "bin" / "ngramprint",
        "phonetisaurus": tools_dir / "phonetisaurus",
    })
    model_root = models_dir / model_id
    model_assets = path_status({
        "model_root": model_root,
        "lexicon_db": model_root / "lexicon.db",
        "g2p_fst": model_root / "g2p.fst",
        "acoustic_conf": model_root / "model" / "conf",
        "acoustic_phones": model_root / "model" / "phones",
        "acoustic_model": model_root / "model" / "model",
    })
    ready = bool(train_help["ok"] and model.get("ok") and tools["ready"] and model_assets["ready"])
    return {
        "ready": ready,
        "model_id": model_id,
        "train_dir": str(train_dir),
        "tools_dir": str(tools_dir),
        "models_dir": str(models_dir),
        "train_help": train_help,
        "model": model,
        "tools": tools,
        "model_assets": model_assets,
    }


