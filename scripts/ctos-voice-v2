                "we would own more adapter code",
                "still needs dependency and model-cache policy",
            ],
            "sources": [
                "https://github.com/SYSTRAN/faster-whisper",
            ],
        },
    ]


def cmd_open_stt_candidates(args: argparse.Namespace) -> int:
    model_dir = Path(args.model_dir).expanduser()
    cache_dir = Path(args.cache_dir).expanduser()
    backend_dir = Path(args.backend_dir).expanduser()
    paths = {
        "model_dir": model_dir,
        "cache_dir": cache_dir,
        "backend_dir": backend_dir,
    }
    local_tools = command_status(["python3", "git", "ffmpeg", "arecord", "ssh", "podman", "docker"])
    target_prepare = remote_path_prepare(args.user, args.host, paths) if args.target_prepare else None
    target_probe = remote_path_probe(args.user, args.host, paths) if args.target_probe or args.target_prepare else None
    candidates = open_stt_candidate_catalog()
    selected = next((item for item in candidates if item["id"] == args.selected), candidates[0])
    if selected["id"] == "wyoming-faster-whisper":
        manual_commands = [
            "ctos-voice-v2 open-stt-plan --target-probe",
            "ctos-voice-v2 open-stt status",
            f"ctos-voice-v2 open-stt start --model {shlex.quote(args.smoke_model)}",
            (
                "ctos-voice-v2 stp-transcribe --wyoming-port {port} "
                "--target-tunnel --record-seconds 5 --preprocess auto --route"
            ).format(port=args.port),
            "ctos-voice-v2 open-stt stop",
        ]
    else:
        manual_commands = [
            "No executable smoke plan is rendered for this fallback yet.",
            "Use it only if wyoming-faster-whisper fails the help/runtime probe.",
        ]
    payload = {
        "selected": selected["id"],
        "target": f"{args.user}@{args.host}",
        "port": args.port,
        "model_dir": str(model_dir),
        "cache_dir": str(cache_dir),
        "backend_dir": str(backend_dir),
        "local_tools": local_tools,
        "target_prepare": target_prepare,
        "target_probe": target_probe,
        "candidates": candidates,
        "first_smoke": {
            "status": "managed_temporary_container",
            "selected": selected["id"],
            "image": DEFAULT_OPEN_STT_IMAGE if selected["id"] == "wyoming-faster-whisper" else None,
            "container": DEFAULT_OPEN_STT_CONTAINER if selected["id"] == "wyoming-faster-whisper" else None,
            "smoke_model": args.smoke_model,
            "commands": manual_commands,
            "notes": [
                "Run the container help probe before any model-backed transcription test.",
                "The direct venv path is currently blocked on ctos-core by a Python 3.14/pysilero-vad build issue.",
                "Keep the service bound to 127.0.0.1 on ctos-core.",
                "Use the existing CTOS Wyoming client command for the first microphone test.",
                "Do not create a daemon until the smoke transcript and CTOS route pass.",
            ],
        },
        "policy": {
            "install_now": False,
            "daemon_now": False,
            "always_on_microphone": False,
            "direct_transcript_to_shell": False,
            "mutable_actions": "ctos_approval_required",
        },
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if target_prepare is None or target_prepare.get("rc") == 0 else 1

    print("CTOS open STT candidates")
    print("========================")
    print(f"selected    {selected['id']} ({selected['label']})")
    print(f"target      {args.user}@{args.host}")
    print(f"wyoming     tcp://127.0.0.1:{args.port}")
    print(f"smoke model {args.smoke_model}")
    if selected["id"] == "wyoming-faster-whisper":
        print(f"image       {DEFAULT_OPEN_STT_IMAGE}")
        print(f"container   {DEFAULT_OPEN_STT_CONTAINER}")
    print()
    print("why selected:")
    for item in selected["fit"]:
        print(f"  - {item}")
    print()
    print("risks before daemon:")
    for item in selected["risks"]:
        print(f"  - {item}")
    print()
    print("fallbacks:")
    for item in candidates:
        if item["id"] == selected["id"]:
            continue
        print(f"  - {item['id']}: {item['role']} ({item['engine']})")
    print()
    print("boundary:")
    print("  - candidate returns transcript text only")
    print("  - CTOS planner decides intent/action")
    print("  - no persistent service or model download in this command")
    print("  - mutable actions still require approval")
    print()
    print("local tool preflight:")
    for name, path in local_tools.items():
        print(f"  {name:<8} {path or '-'}")
    if target_probe is not None:
        if target_prepare is not None:
            print()
            print(f"target path prepare {args.user}@{args.host} rc={target_prepare.get('rc')}")
            if target_prepare.get("stdout"):
                print(target_prepare["stdout"])
            if target_prepare.get("stderr"):
                print(target_prepare["stderr"], file=sys.stderr)
        print()
        print(f"target path probe {args.user}@{args.host} rc={target_probe.get('rc')}")
        if target_probe.get("stdout"):
            print(target_probe["stdout"])
        if target_probe.get("stderr"):
            print(target_probe["stderr"], file=sys.stderr)
    print()
    print("first smoke plan:")
    for command in manual_commands:
        print(f"  {command}")
    return 0 if target_prepare is None or target_prepare.get("rc") == 0 else 1


def cmd_open_stt(args: argparse.Namespace) -> int:
    runtime = args.container_runtime
    if runtime == "auto":
        runtime = "podman"
    model_dir = Path(args.model_dir).expanduser()
    cache_dir = Path(args.cache_dir).expanduser()
    backend_dir = Path(args.backend_dir).expanduser()
    result = remote_open_stt_container_action(
        args.user,
        args.host,
        runtime,
        args.action,
        args.image,
        args.model,
        model_dir,
        cache_dir,
        backend_dir,
        args.port,
        args.container_name,
        args.logs_tail,
    )
    payload = {
        "action": args.action,
        "host": args.host,
        "user": args.user,
        "image": args.image,
        "model": args.model,
        "container_runtime": runtime,
        "container_name": args.container_name,
        "port": args.port,
        "model_dir": str(model_dir),
        "cache_dir": str(cache_dir),
        "backend_dir": str(backend_dir),
        "tunnel_command_on_t480": shlex.join([
            "ssh",
            "-F",
            "/dev/null",
            "-N",
            "-L",
            f"127.0.0.1:{args.port}:127.0.0.1:{args.port}",
            f"{args.user}@{args.host}",
        ]),
        "transcribe_command_on_t480": shlex.join([
            "ctos-voice-v2",
            "stp-transcribe",
            "--wyoming-port",
            str(args.port),
            "--target-tunnel",
            "--record-seconds",
            "5",
            "--preprocess",
            "auto",
            "--route",
        ]),
        "rc": result["rc"],
        "stdout": result["stdout"],
        "stderr": result["stderr"],
        "ok": result["rc"] == 0,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if payload["ok"] else 1

    print("CTOS open-STT container")
    print("=======================")
    print(f"action      {args.action}")
    print(f"target      {args.user}@{args.host}")
    print(f"runtime     {runtime}")
    print(f"container   {args.container_name}")
    print(f"image       {args.image}")
    print(f"model       {args.model}")
    print(f"uri         tcp://127.0.0.1:{args.port}")
    print(f"status      {'ok' if payload['ok'] else 'failed'} rc={result['rc']}")
    print()
    if result["stdout"]:
        print(result["stdout"])
    if result["stderr"]:
        print(result["stderr"], file=sys.stderr)
    if args.action == "start" and payload["ok"]:
        print()
        print("from T480, run one push-to-talk route:")
        print(f"  {payload['transcribe_command_on_t480']}")
        print()
        print("stop after the test window:")
        print("  ctos-voice-v2 open-stt stop")
    elif args.action == "status" and payload["ok"]:
        print()
        print("start/test/stop:")
        print("  ctos-voice-v2 open-stt start")
        print(f"  {payload['transcribe_command_on_t480']}")
        print("  ctos-voice-v2 open-stt stop")
    return 0 if payload["ok"] else 1


def line_value(output: str, prefix: str) -> str | None:
    for line in output.splitlines():
        if line.startswith(prefix):
            return line.split("=", 1)[1].strip() if "=" in line else line[len(prefix):].strip()
    return None


def section_contains(output: str, section: str, needle: str) -> bool:
    active = False
    for line in output.splitlines():
        if line == section:
            active = True
            continue
        if active and line.isupper() and line.replace("_", "").isalpha():
            return False
        if active and needle in line:
            return True
    return False


def remote_container_state(output: str) -> str:
    if "CONTAINER\nmissing" in output or section_contains(output, "CONTAINER", "missing"):
        return "missing"
    for line in output.splitlines():
        if line.startswith("name="):
            if "running=true" in line:
                return "running"
            if "status=" in line:
                match = re.search(r"status=([^ ]+)", line)
                return match.group(1) if match else "present"
            return "present"
    return "unknown"


def remote_image_state(output: str) -> str:
    if section_contains(output, "IMAGE", "present"):
        return "present"
    if section_contains(output, "IMAGE", "missing"):
        return "missing"
    return "unknown"


def remote_path_summary(output: str) -> dict[str, int]:
    summary = {"ok": 0, "missing": 0, "blocked": 0, "other": 0}
    for line in output.splitlines():
        if line.startswith("ok\t") or line.startswith("ok "):
            summary["ok"] += 1
        elif line.startswith("missing\t") or line.startswith("missing "):
            summary["missing"] += 1
        elif line.startswith("blocked\t") or line.startswith("blocked "):
            summary["blocked"] += 1
        elif line and not line.isupper():
            summary["other"] += 1
    return summary


def cmd_doctor(args: argparse.Namespace) -> int:
    errors = validate_registry()
    tools = command_status([
        "ctos-voice",
        "ctos-ai",
        "ctos-audio",
        "pw-record",
        "arecord",
        "ffmpeg",
        "espeak-ng",
        "pavucontrol",
        "python3",
        "curl",
        "ssh",
    ])
    voice_probe = run([str(ROOT / "scripts" / "ctos-voice"), "probe", "--json"], timeout=12)

    core = None
    hass = None
    token = None
    stp = None
    open_stt = None
    onboarding = None
    if not args.local_only:
        core = core_probe(args.user, args.host)
        runtime = args.container_runtime
        if runtime == "auto":
            runtime = "podman"
        hass = remote_hass_context_action(
            args.user,
            args.host,
            runtime,
            "status",
            args.hass_image,
            Path(args.hass_config_dir).expanduser(),
            args.hass_port,
            args.timezone,
            args.hass_container_name,
            args.logs_tail,
        )
        token = remote_hass_token_probe(
            args.user,
            args.host,
            args.hass_token_file,
            args.hass_port,
        )
        stp = remote_stp_container_action(
            args.user,
            args.host,
            runtime,
            "status",
            args.stp_image,
            Path(args.stp_backend_dir).expanduser(),
            Path(args.stp_train_dir).expanduser(),
            Path(args.stp_models_dir).expanduser(),
            args.stp_port,
            args.hass_websocket_uri,
            args.hass_token_file,
            args.stp_container_name,
            args.logs_tail,
        )
        open_stt = remote_path_probe(args.user, args.host, {
            "model_dir": Path(args.open_stt_model_dir),
            "cache_dir": Path(args.open_stt_cache_dir),
            "backend_dir": Path(args.open_stt_backend_dir),
        })
        onboarding = local_hass_onboarding_status(args.hass_port)

    token_state = hass_token_state(token["stdout"]) if token else "skipped"
    hass_container = remote_container_state(hass["stdout"]) if hass else "skipped"
    hass_image = remote_image_state(hass["stdout"]) if hass else "skipped"
    stp_container = remote_container_state(stp["stdout"]) if stp else "skipped"
    stp_image = remote_image_state(stp["stdout"]) if stp else "skipped"
    open_stt_paths = remote_path_summary(open_stt["stdout"]) if open_stt else None
    onboarding_user_done = onboarding.get("user_done") if isinstance(onboarding, dict) else None

    state = "ready"
    next_action = "ctos-voice-v2 sample-plan --dir /tmp/ctos-voice-samples --write-manifest"
    blockers: list[str] = []
    if errors:
        state = "local_catalog_error"
        blockers.append("voice backend registry or intent catalog is invalid")
        next_action = "fix ai/voice_backends.json or ai/voice_intents_fr.json"
    elif voice_probe["rc"] != 0:
        state = "voice_v1_probe_failed"
        blockers.append("local push-to-talk/TTS probe failed")
        next_action = "ctos-voice probe"
    elif args.local_only:
        state = "local_ok_target_skipped"
        next_action = "ctos-voice-v2 doctor"
    elif core and core["rc"] != 0:
        state = "ctos_core_unreachable"
        blockers.append("ctos-core SSH probe failed")
        next_action = "restore T480 <-> ctos-core SSH/link, then rerun ctos-voice-v2 doctor"
    elif hass and hass["rc"] != 0:
        state = "hass_status_failed"
        blockers.append("temporary Home Assistant context status failed")
        next_action = "ctos-voice-v2 hass-context start"
    elif hass_container != "running":
        state = "hass_not_running"
        blockers.append(f"Home Assistant container state is {hass_container}")
        next_action = "ctos-voice-v2 hass-context start"
    elif token_state != "ready":
        state = token_state if token_state != "unknown" else "hass_token_not_ready"
        blockers.append(f"Home Assistant token state is {token_state}")
        if token_state in {"missing_token", "missing_token_file", "empty_token"}:
            if onboarding_user_done is True:
                next_action = "ctos-voice-v2 hass-context token-save"
            else:
                next_action = "ctos-voice-v2 hass-context onboard-api"
        else:
            next_action = "ctos-voice-v2 hass-context token-save"
    elif stp and stp["rc"] != 0:
        state = "stp_status_failed"
        blockers.append("Speech-to-Phrase container status failed")
        next_action = "ctos-voice-v2 stp-container status"
    elif stp_container != "running":
        state = "ready_to_start_speech_to_phrase"
        next_action = "ctos-voice-v2 stp-container start"

    payload = {
        "state": state,
        "next_action": next_action,
        "blockers": blockers,
        "local": {
            "registry_ok": not errors,
            "registry_errors": errors,
            "tools": tools,
            "voice_probe_rc": voice_probe["rc"],
        },
        "target": None if args.local_only else {
            "host": args.host,
            "user": args.user,
            "core_rc": core["rc"] if core else None,
            "hass_rc": hass["rc"] if hass else None,
            "hass_image": hass_image,
            "hass_container": hass_container,
            "hass_onboarding": onboarding,
            "token_state": token_state,
            "stp_rc": stp["rc"] if stp else None,
            "stp_image": stp_image,
            "stp_container": stp_container,
            "open_stt_paths": open_stt_paths,
        },
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if state in {"ready", "ready_to_start_speech_to_phrase", "local_ok_target_skipped"} else 1

    print("CTOS voice stack doctor")
    print("=======================")
    print(f"state       {state}")
    print(f"next        {next_action}")
    print()
    print("local:")
    print(f"  registry  {'ok' if not errors else 'failed'}")
    for error in errors:
        print(f"    - {error}")
    print(f"  voice V1  {'ok' if voice_probe['rc'] == 0 else f'failed rc={voice_probe['rc']}'}")
    for name in ("ctos-voice", "ctos-ai", "ctos-audio", "pw-record", "ffmpeg", "espeak-ng", "pavucontrol"):
        print(f"  {name:<11} {tools.get(name) or '-'}")
    if args.local_only:
        print()
        print("target: skipped (--local-only)")
    else:
        print()
        print(f"target: {args.user}@{args.host}")
        print(f"  core ssh       {'ok' if core and core['rc'] == 0 else f'failed rc={core['rc'] if core else '-'}'}")
        print(f"  hass image     {hass_image}")
        print(f"  hass container {hass_container}")
        if isinstance(onboarding, dict):
            steps = onboarding.get("steps")
            if isinstance(steps, dict) and steps:
                rendered = " ".join(f"{key}={str(value).lower()}" for key, value in steps.items())
            else:
                rendered = "unavailable"
            print(f"  hass onboard   {rendered}")
        print(f"  hass token     {token_state}")
        print(f"  stp image      {stp_image}")
        print(f"  stp container  {stp_container}")
        if open_stt_paths is not None:
            print(
                "  open-stt dirs  "
                f"ok={open_stt_paths['ok']} missing={open_stt_paths['missing']} blocked={open_stt_paths['blocked']}"
            )
    if blockers:
        print()
        print("blockers:")
        for blocker in blockers:
            print(f"  - {blocker}")
    print()
    print("recommended commands:")
    if state in {"missing_token", "missing_token_file", "empty_token", "hass_token_not_ready"}:
        print(f"  {next_action}")
        print("  ctos-voice-v2 hass-context readiness")
        print("  ctos-voice-v2 stp-container start")
    elif state == "ready_to_start_speech_to_phrase":
        print("  ctos-voice-v2 stp-container start")
        print("  ctos-voice-v2 stp-container logs")
    else:
        print(f"  {next_action}")
    return 0 if state in {"ready", "ready_to_start_speech_to_phrase", "local_ok_target_skipped"} else 1


def print_audio_analysis(analysis: dict[str, Any]) -> None:
    if not analysis.get("ok"):
        print(f"audio-check failed: {analysis.get('error') or analysis.get('state')}")
        return
    print(
        "level       "
        f"state={analysis.get('state')} "
        f"rms={analysis.get('rms_pct')}% "
        f"peak={analysis.get('peak_pct')}% "
        f"clip={analysis.get('clipped_pct')}%"
    )
    print(f"duration    {analysis.get('duration_seconds')}s {analysis.get('rate')}Hz")
    activity = analysis.get("activity") if isinstance(analysis.get("activity"), dict) else {}
    if activity:
        print(
            "activity    "
            f"{activity.get('active_pct')}% "
            f"threshold={activity.get('threshold_pct')}%"
        )
    recommendation = analysis.get("recommendation")
    if recommendation:
        print(f"next        {recommendation}")


def cmd_mic_check(args: argparse.Namespace) -> int:
    if args.from_wav and args.keep_wav:
        print("--from-wav and --keep-wav are mutually exclusive", file=sys.stderr)
        return 2
    delete_after = False
    record_detail = ""
    if args.from_wav:
        wav_path = Path(args.from_wav).expanduser()
    elif args.keep_wav:
        wav_path = Path(args.keep_wav).expanduser()
        record_rc, record_detail = record_with_ctos_voice(args.record_seconds, wav_path)
        if record_rc != 0:
            print(record_detail, file=sys.stderr)
            return record_rc
    else:
        handle = tempfile.NamedTemporaryFile(prefix="ctos-mic-check-", suffix=".wav", delete=False, dir="/tmp")
        handle.close()
        wav_path = Path(handle.name)
        delete_after = True
        record_rc, record_detail = record_with_ctos_voice(args.record_seconds, wav_path)
        if record_rc != 0:
            wav_path.unlink(missing_ok=True)
            print(record_detail, file=sys.stderr)
            return record_rc

    try:
        analysis = analyze_wav_audio(wav_path)
        payload = {
            "ok": bool(analysis.get("ok")),
            "audio": str(wav_path),
            "record_detail": record_detail,
            "analysis": analysis,
        }
        if args.json:
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
            return 0 if payload["ok"] else 1

        print("CTOS microphone check")
        print("=====================")
        print(f"audio       {wav_path}")
        if record_detail:
            print(f"record      {record_detail}")
        print_audio_analysis(analysis)
        return 0 if payload["ok"] else 1
    finally:
        if delete_after:
            wav_path.unlink(missing_ok=True)


def cmd_stp_transcribe(args: argparse.Namespace) -> int:
    if args.from_wav and args.keep_wav:
        print("--from-wav and --keep-wav are mutually exclusive", file=sys.stderr)
        return 2
    if args.preprocess == "off" and args.preprocess_wav:
        print("--preprocess-wav requires --preprocess auto or --preprocess normalize", file=sys.stderr)
        return 2
    if args.execute_safe and args.save_agenda:
        print("choose --execute-safe or --save-agenda, not both", file=sys.stderr)
        return 2
    delete_after = False
    delete_preprocessed = False
    if args.from_wav:
        wav_path = Path(args.from_wav).expanduser()
    elif args.keep_wav:
        wav_path = Path(args.keep_wav).expanduser()
        record_rc, detail = record_with_ctos_voice(args.record_seconds, wav_path)
        if record_rc != 0:
            print(detail, file=sys.stderr)
            return record_rc
    else:
        handle = tempfile.NamedTemporaryFile(prefix="ctos-stp-", suffix=".wav", delete=False, dir="/tmp")
        handle.close()
        wav_path = Path(handle.name)
        delete_after = True
        record_rc, detail = record_with_ctos_voice(args.record_seconds, wav_path)
        if record_rc != 0:
            wav_path.unlink(missing_ok=True)
            print(detail, file=sys.stderr)
            return record_rc

    tunnel_proc: subprocess.Popen[str] | None = None
    connect_host = args.wyoming_host
    connect_port = args.wyoming_port
    tunnel_payload: dict[str, Any] = {"enabled": bool(args.target_tunnel)}
    try:
        if args.target_tunnel:
            local_port = free_local_port()
            connect_host = "127.0.0.1"
            connect_port = local_port
            tunnel_payload.update({
                "user": args.user,
                "host": args.host,
                "local_port": local_port,
                "remote_port": args.wyoming_port,
            })
            tunnel_proc = start_ssh_tunnel(args.user, args.host, local_port, args.wyoming_port)
            if not wait_for_tcp("127.0.0.1", local_port, args.timeout):
                stderr = ""
                if tunnel_proc.stderr is not None:
                    tunnel_proc.terminate()
                    try:
                        _, stderr = tunnel_proc.communicate(timeout=2)
                    except subprocess.TimeoutExpired:
                        tunnel_proc.kill()
                payload = {
                    "ok": False,
                    "state": "tunnel_unavailable",
                    "tunnel": tunnel_payload,
                    "error": stderr.strip() or f"local tunnel did not open on 127.0.0.1:{local_port}",
                }
                if args.json:
                    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
                else:
                    print("CTOS Speech-to-Phrase transcribe")
                    print("================================")
                    print("state       tunnel_unavailable")
                    print(f"target      {args.user}@{args.host}:{args.wyoming_port}")
                    print(f"error       {payload['error']}")
                return 1

        audio_analysis = analyze_wav_audio(wav_path)
        preprocess_info, preprocessed_path = prepare_stt_audio(
            wav_path,
            args.preprocess,
            Path(args.preprocess_wav).expanduser() if args.preprocess_wav else None,
        )
        if preprocessed_path is not None and preprocess_info.get("delete_output"):
            delete_preprocessed = True
        stt_wav_path = Path(str(preprocess_info.get("output") or wav_path))
        stt_audio_analysis = (
            preprocess_info.get("output_analysis")
            if isinstance(preprocess_info.get("output_analysis"), dict)
            else analyze_wav_audio(stt_wav_path)
        )
        if preprocess_info.get("ok"):
            recognition = wyoming_transcribe_wav(
                stt_wav_path,
                connect_host,
                connect_port,
                args.timeout,
                language=args.language,
            )
        else:
            recognition = {
                "ok": False,
                "transcript": "",
                "audio": {
                    "path": str(stt_wav_path),
                },
                "events": [],
                "error": str(preprocess_info.get("reason") or "audio preprocessing blocked STT"),
                "skipped": "preprocess",
            }
        route_result: dict[str, Any] | None = None
        route_payload: Any = None
        transcript = str(recognition.get("transcript") or "").strip()
        transcript_guard = guard_stt_transcript(transcript, stt_audio_analysis)
        if args.no_transcript_guard and transcript:
            transcript_guard = {
                "ok": True,
                "state": "disabled",
                "route_allowed": True,
                "reason": "transcript guard disabled by operator",
            }
        should_route = bool(args.route or args.execute_safe or args.save_agenda)
        if transcript and should_route and transcript_guard.get("route_allowed"):
            route_result = route_transcript_with_ctos_voice(
                transcript,
                args.execute_safe,
                args.no_speak,
                args.save_agenda,
            )
            if route_result.get("stdout"):
                try:
                    route_payload = json.loads(route_result["stdout"])
                except json.JSONDecodeError:
                    route_payload = route_result["stdout"]

        payload = {
            "ok": (
                bool(recognition.get("ok"))
                and bool(transcript_guard.get("ok"))
                and (route_result is None or route_result.get("rc") == 0)
            ),
            "audio": str(wav_path),
            "tunnel": tunnel_payload,
            "target": {
                "host": connect_host,
                "port": connect_port,
            },
            "audio_analysis": audio_analysis,
            "preprocess": preprocess_info,
            "stt_audio": str(stt_wav_path),
            "stt_audio_analysis": stt_audio_analysis,
            "recognition": recognition,
            "transcript_guard": transcript_guard,
            "route": route_result,
            "route_payload": route_payload,
        }
        if args.json:
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
            return 0 if payload["ok"] else 1

        print("CTOS Speech-to-Phrase transcribe")
        print("================================")
        print(f"audio       {wav_path}")
        print_audio_analysis(audio_analysis)
        print(f"preprocess  {preprocess_info.get('state')} - {preprocess_info.get('reason')}")
        if stt_wav_path != wav_path:
            print(f"stt-audio   {stt_wav_path}")
            print_audio_analysis(stt_audio_analysis)
        if args.target_tunnel:
            print(f"tunnel      {args.user}@{args.host}:{args.wyoming_port} -> 127.0.0.1:{connect_port}")
        else:
            print(f"wyoming     {connect_host}:{connect_port}")
        print(f"state       {'ok' if recognition.get('ok') else 'failed'}")
        if transcript:
            print(f"transcript  {transcript}")
            print(f"guard       {transcript_guard.get('state')} - {transcript_guard.get('reason')}")
            match = match_intent(transcript)
            best = match.get("best") if isinstance(match, dict) else None
            if isinstance(best, dict):
                print(f"intent      {best.get('intent_id')} score={best.get('score')} phrase={best.get('phrase')}")
            else:
                print("intent      -")
        if not recognition.get("ok"):
            print(f"error       {recognition.get('error')}")
        if transcript and should_route and not transcript_guard.get("route_allowed"):
            print("route       skipped by transcript guard")
        if route_result is not None:
            print()
            print(f"route rc    {route_result.get('rc')}")
            if route_result.get("stdout"):
                print(route_result["stdout"])
            if route_result.get("stderr"):
                print(route_result["stderr"], file=sys.stderr)
        return 0 if payload["ok"] else 1
    finally:
        if tunnel_proc is not None and tunnel_proc.poll() is None:
            tunnel_proc.terminate()
            try:
                tunnel_proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                tunnel_proc.kill()
        if delete_after:
            wav_path.unlink(missing_ok=True)
        if delete_preprocessed and 'preprocessed_path' in locals() and preprocessed_path is not None:
            preprocessed_path.unlink(missing_ok=True)


def cmd_wyoming_selftest(args: argparse.Namespace) -> int:
    handle = tempfile.NamedTemporaryFile(prefix="ctos-wyoming-selftest-", suffix=".wav", delete=False, dir="/tmp")
    handle.close()
    wav_path = Path(handle.name)
    route_result: dict[str, Any] | None = None
    route_payload: Any = None
    try:
        write_silence_wav(wav_path, seconds=args.seconds, rate=args.rate)
        port, server_state, thread = start_mock_wyoming_server(args.transcript, args.language, args.timeout)
        if port <= 0:
            payload = {
                "ok": False,
                "state": "mock_unavailable",
                "error": server_state.get("error") or "mock server did not expose a port",
            }
            if args.json:
                print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
            else:
                print("CTOS Wyoming self-test")
                print("======================")
                print("state       mock_unavailable")
                print(f"error       {payload['error']}")
            return 1

        recognition = wyoming_transcribe_wav(wav_path, "127.0.0.1", port, args.timeout, language=args.language)
        thread.join(timeout=1)
        transcript = str(recognition.get("transcript") or "").strip()
        if transcript and not args.no_route:
            route_result = route_transcript_with_ctos_voice(transcript, args.execute_safe, args.no_speak)
            if route_result.get("stdout"):
                try:
                    route_payload = json.loads(route_result["stdout"])
                except json.JSONDecodeError:
                    route_payload = route_result["stdout"]

        server_error = str(server_state.get("error") or "")
        payload = {
            "ok": (
                bool(recognition.get("ok"))
                and not server_error
                and (route_result is None or route_result.get("rc") == 0)
            ),
            "scope": "mock Wyoming transport and CTOS routing only; not real speech recognition",
            "audio": str(wav_path),
            "mock": {
                "port": port,
                "transcript": args.transcript,
                "error": server_error,
                "events": summarize_wyoming_events(server_state.get("events", [])),
            },
            "recognition": recognition,
            "route": route_result,
            "route_payload": route_payload,
        }
        if args.json:
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
            return 0 if payload["ok"] else 1

        print("CTOS Wyoming self-test")
        print("======================")
        print("scope       mock transport + CTOS route only")
        print(f"state       {'ok' if payload['ok'] else 'failed'}")
        print(f"mock        127.0.0.1:{port}")
        print(f"transcript  {transcript or '-'}")
        if server_error:
            print(f"mock error  {server_error}")
        if transcript:
            match = match_intent(transcript)
            best = match.get("best") if isinstance(match, dict) else None
            if isinstance(best, dict):
                print(f"intent      {best.get('intent_id')} score={best.get('score')} phrase={best.get('phrase')}")
            else:
                print("intent      -")
        if not recognition.get("ok"):
            print(f"error       {recognition.get('error')}")
        if route_result is not None:
            print()
            print(f"route rc    {route_result.get('rc')}")
            if route_result.get("stdout"):
                print(route_result["stdout"])
            if route_result.get("stderr"):
                print(route_result["stderr"], file=sys.stderr)
        return 0 if payload["ok"] else 1
    finally:
        wav_path.unlink(missing_ok=True)


def cmd_sample_plan(args: argparse.Namespace) -> int:
    entries = intent_entries()
    sample_dir = Path(args.dir).expanduser()
    manifest = Path(args.manifest).expanduser() if args.manifest else sample_dir / "manifest.jsonl"
    print("CTOS voice sample plan")
    print("======================")
    print(f"sample_dir {sample_dir}")
    print(f"manifest   {manifest}")
    print()
    print("Commands:")
    print(f"mkdir -p {sample_dir}")
    rows: list[dict[str, Any]] = []
    for intent in entries:
        phrases = [phrase for phrase in intent.get("phrases", []) if isinstance(phrase, str)]
        if not phrases:
            continue
        intent_id = str(intent.get("id") or "unknown")
        phrase = phrases[0]
        filename = f"{intent_id}__{slug(phrase)}.wav"
        path = sample_dir / filename
        rows.append({"intent_id": intent_id, "label": phrase, "file": str(path)})
        print(f"ctos-voice record-once --seconds {args.seconds:g} --out {path} --json")
    print()
    if args.write_manifest:
        manifest.parent.mkdir(parents=True, exist_ok=True)
        manifest.write_text(
            "\n".join(json.dumps(row, ensure_ascii=False, sort_keys=True) for row in rows) + "\n",
            encoding="utf-8",
        )
        print(f"wrote manifest {manifest}")
    else:
        print("Manifest JSONL (optional; pass --write-manifest to create it):")
        for row in rows:
            print(json.dumps(row, ensure_ascii=False, sort_keys=True))
    print()
    print("Regression:")
    print(f"ctos-voice-v2 regression --manifest {manifest}")
    print(f"ctos-voice-v2 regression --dir {sample_dir}")
    return 0


def cmd_regression(args: argparse.Namespace) -> int:
    samples: list[dict[str, Any]] = []
    base: Path | None = None
    if args.manifest:
        manifest = Path(args.manifest).expanduser()
        base = manifest.parent
        samples.extend(load_samples_manifest(manifest))
    if args.dir:
        sample_dir = Path(args.dir).expanduser()
        samples.extend(samples_from_dir(sample_dir))
    if not samples:
        print("no samples; pass --manifest or --dir", file=sys.stderr)
        return 2
    results: list[dict[str, Any]] = []
    failures = 0
    for index, sample in enumerate(samples, start=1):
        sample_id = str(sample.get("id") or sample.get("label") or f"sample-{index}")
        expected = expected_intent(sample)
        expected_phrase = expected_text(sample)
        rc, transcript, source = sample_transcript(sample, base, args.timeout, args.backend, args)
        match = match_intent(transcript, args.threshold) if transcript else {
            "matched": False,
            "best": None,
            "candidates": [],
            "normalized": "",
            "threshold": args.threshold,
            "text": transcript,
        }
        best = match.get("best") or {}
        actual = best.get("intent_id") if match.get("matched") else None
        text_score = score_phrase(transcript, expected_phrase) if transcript and expected_phrase else None
        status = "unknown"
        if rc != 0:
            status = "error"
        elif expected:
            status = "pass" if actual == expected else "fail"
        elif expected_phrase:
            status = "pass" if text_score is not None and text_score >= args.text_threshold else "fail"
        elif match.get("matched"):
            status = "matched"
        if status in {"error", "fail"}:
            failures += 1
        results.append({
            "id": sample_id,
            "expected": expected,
            "expected_text": expected_phrase,
            "status": status,
            "transcript": transcript,
            "transcript_source": source,
            "actual": actual,
            "score": best.get("score"),
            "text_score": text_score,
            "matched_phrase": best.get("phrase"),
            "rc": rc,
            "detail": source if rc == 0 else source,
        })
    payload = {
        "ok": failures == 0,
        "total": len(results),
        "failures": failures,
        "backend": args.backend,
        "threshold": args.threshold,
        "text_threshold": args.text_threshold,
        "results": results,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print("CTOS voice regression")
        print("=====================")
        print(
            f"backend {args.backend}  total {payload['total']}  failures {payload['failures']}  "
            f"intent_threshold {args.threshold}  text_threshold {args.text_threshold}"
        )
        print()
        for item in results:
            expected = item["expected"] or "-"
            actual = item["actual"] or "-"
            score = item["score"] if item["score"] is not None else "-"
            text_score = item["text_score"] if item["text_score"] is not None else "-"
            print(
                f"{item['status']:<7} {item['id']:<26} expected={expected:<18} "
                f"actual={actual:<18} score={score} text_score={text_score}"
            )
            if item["expected_text"]:
                print(f"        expected-text: {item['expected_text']}")
            print(f"        transcript[{item['transcript_source']}]: {item['transcript'] or '-'}")
            if item["matched_phrase"]:
                print(f"        phrase: {item['matched_phrase']}")
    return 1 if failures else 0


def cmd_match(args: argparse.Namespace) -> int:
    text = " ".join(args.text).strip()
    if not text:
        print("text is required", file=sys.stderr)
        return 2
    result = match_intent(text, args.threshold)
    if args.json:
        result["candidates"] = result["candidates"][: args.top]
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0 if result["matched"] else 1
    print("CTOS voice intent match")
    print("=======================")
    print(f"text       {result['text']}")
    print(f"normalized {result['normalized']}")
    best = result.get("best") or {}
    if result["matched"]:
        print(f"match      {best.get('intent_id')} score={best.get('score')} phrase={best.get('phrase')}")
        print(f"command    {' '.join(best.get('command') or [])}")
    else:
        print(f"match      none above threshold {args.threshold}")
    print("top:")
    for item in result["candidates"][: args.top]:
        print(f"  {item.get('score'):<5} {item.get('intent_id'):<18} {item.get('phrase')}")
    return 0 if result["matched"] else 1


def cmd_status(args: argparse.Namespace) -> int:
    errors = validate_registry()
    tools = command_status([
        "ctos-voice",
        "ctos-ai",
        "ctos-audio",
        "pw-record",
        "arecord",
        "ffmpeg",
        "espeak-ng",
        "pavucontrol",
        "python3",
        "git",
        "curl",
        "ssh",
        "docker",
        "podman",
    ])
    voice_probe = run([str(ROOT / "scripts" / "ctos-voice"), "probe", "--json"], timeout=12)
    payload: dict[str, Any] = {
        "registry_ok": not errors,
        "registry_errors": errors,
        "files": {
            "backends": str(BACKENDS),
            "intents": str(INTENTS),
            "doc": str(DOC),
        },
        "tools": tools,
        "voice_probe": voice_probe,
        "target_probe": None,
    }
    if args.target_probe:
        payload["target_probe"] = core_probe(args.user, args.host)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0 if not errors else 1
    print("CTOS voice V2 status")
    print("====================")
    print(f"registry       {'ok' if not errors else 'error'}")
    for error in errors:
        print(f"  - {error}")
    print("local tools:")
    for name, path in tools.items():
        print(f"  {name:<14} {path or '-'}")
    print("voice V1 probe:")
    if voice_probe["rc"] == 0:
        print("  ok")
    else:
        print(f"  rc={voice_probe['rc']} {voice_probe['stderr'] or voice_probe['stdout']}")
    if args.target_probe:
        target = payload["target_probe"] or {}
        print(f"ctos-core probe rc={target.get('rc')}")
        if target.get("stdout"):
            print(target["stdout"])
        if target.get("stderr"):
            print(target["stderr"], file=sys.stderr)
    else:
        print("ctos-core probe skipped; pass --target-probe")
    return 0 if not errors else 1


