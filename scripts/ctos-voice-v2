def hass_context_target_probe(
    user: str,
    host: str,
    runtime: str,
    image: str,
    config_dir: Path,
    port: int,
) -> dict[str, Any]:
    quoted_runtime = shlex.quote(runtime)
    quoted_image = shlex.quote(image)
    quoted_config = shlex.quote(str(config_dir))
    quoted_parent = shlex.quote(str(config_dir.parent))
    quoted_port = shlex.quote(str(port))
    remote = "\n".join([
        "set -u",
        "printf 'TOOLS\\n'",
        f"command -v {quoted_runtime} python3 curl ssh ss || true",
        "printf 'IMAGE\\n'",
        f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} image exists {quoted_image} >/dev/null 2>&1; then echo present; else echo missing; fi",
        "printf 'PATHS\\n'",
        f"if test -d {quoted_config}; then printf 'ok\\tconfig_dir\\t%s\\n' {quoted_config}; else printf 'missing\\tconfig_dir\\t%s\\n' {quoted_config}; fi",
        f"if test -w {quoted_parent}; then printf 'ok\\tconfig_parent_writable\\t%s\\n' {quoted_parent}; else printf 'blocked\\tconfig_parent_writable\\t%s\\n' {quoted_parent}; fi",
        "printf 'PORT\\n'",
        f"ss -H -ltn 2>/dev/null | awk '{{print $4}}' | grep -E '(^|:){quoted_port}$' >/dev/null && echo busy || echo free",
    ])
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=10,
    )


def hass_context_target_prepare(user: str, host: str, config_dir: Path) -> dict[str, Any]:
    quoted_config = shlex.quote(str(config_dir))
    remote = "\n".join([
        "set -eu",
        f"mkdir -p {quoted_config}",
        f"chmod 2775 {quoted_config}",
        "printf 'PREPARED\\n'",
        f"stat -c '%U %G %A %n' {quoted_config}",
    ])
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=10,
    )


def hass_http_json(
    method: str,
    url: str,
    payload: dict[str, Any] | None = None,
    token: str | None = None,
    form: dict[str, str] | None = None,
    timeout: float = 20.0,
) -> dict[str, Any]:
    headers: dict[str, str] = {}
    data: bytes | None = None
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if form is not None:
        data = parse.urlencode(form).encode("utf-8")
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = request.Request(url, data=data, headers=headers, method=method)
    try:
        with request.urlopen(req, timeout=timeout) as response:
            body = response.read().decode("utf-8", "replace")
            parsed: Any = None
            if body:
                try:
                    parsed = json.loads(body)
                except json.JSONDecodeError:
                    parsed = body
            return {"ok": True, "status": response.status, "json": parsed, "body": body}
    except HTTPError as error:
        body = error.read().decode("utf-8", "replace")
        parsed = None
        if body:
            try:
                parsed = json.loads(body)
            except json.JSONDecodeError:
                parsed = body
        return {"ok": False, "status": error.code, "json": parsed, "body": body}
    except (OSError, URLError) as error:
        return {"ok": False, "status": None, "json": None, "body": "", "error": str(error)}


def websocket_read_frame(sock: socket.socket) -> tuple[int, bytes]:
    header = sock.recv(2)
    if len(header) != 2:
        raise RuntimeError("short websocket frame header")
    first, second = header
    opcode = first & 0x0F
    length = second & 0x7F
    masked = bool(second & 0x80)
    if length == 126:
        length = struct.unpack("!H", sock.recv(2))[0]
    elif length == 127:
        length = struct.unpack("!Q", sock.recv(8))[0]
    mask = sock.recv(4) if masked else b""
    payload = b""
    while len(payload) < length:
        chunk = sock.recv(length - len(payload))
        if not chunk:
            raise RuntimeError("short websocket frame payload")
        payload += chunk
    if masked:
        payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
    return opcode, payload


def websocket_send_json(sock: socket.socket, payload: dict[str, Any]) -> None:
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    mask = os.urandom(4)
    if len(raw) < 126:
        header = bytes([0x81, 0x80 | len(raw)])
    elif len(raw) < 65536:
        header = bytes([0x81, 0x80 | 126]) + struct.pack("!H", len(raw))
    else:
        header = bytes([0x81, 0x80 | 127]) + struct.pack("!Q", len(raw))
    masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(raw))
    sock.sendall(header + mask + masked)


def websocket_read_json(sock: socket.socket) -> dict[str, Any]:
    opcode, payload = websocket_read_frame(sock)
    if opcode == 8:
        raise RuntimeError("websocket closed")
    if opcode != 1:
        raise RuntimeError(f"unexpected websocket opcode {opcode}")
    parsed = json.loads(payload.decode("utf-8"))
    if not isinstance(parsed, dict):
        raise RuntimeError("websocket message is not an object")
    return parsed


def hass_create_long_lived_token(
    base_url: str,
    access_token: str,
    client_name: str,
    lifespan: int,
) -> dict[str, Any]:
    parsed = parse.urlparse(base_url.rstrip("/") + "/api/websocket")
    if parsed.scheme not in {"http", "ws"}:
        return {"ok": False, "error": f"unsupported websocket scheme from {base_url}"}
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or (443 if parsed.scheme == "wss" else 80)
    path = parsed.path or "/api/websocket"
    key = base64.b64encode(os.urandom(16)).decode("ascii")
    expected_accept = base64.b64encode(
        hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()
    ).decode("ascii")
    try:
        with socket.create_connection((host, port), timeout=10) as sock:
            sock.settimeout(12)
            request_lines = [
                f"GET {path} HTTP/1.1",
                f"Host: {host}:{port}",
                "Upgrade: websocket",
                "Connection: Upgrade",
                f"Sec-WebSocket-Key: {key}",
                "Sec-WebSocket-Version: 13",
                "\r\n",
            ]
            sock.sendall("\r\n".join(request_lines).encode("ascii"))
            response = b""
            while b"\r\n\r\n" not in response:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                response += chunk
            header_text = response.decode("iso-8859-1", "replace")
            if " 101 " not in header_text.splitlines()[0]:
                return {"ok": False, "error": "websocket upgrade failed", "status": header_text.splitlines()[0]}
            if expected_accept not in header_text:
                return {"ok": False, "error": "websocket accept validation failed"}
            auth_required = websocket_read_json(sock)
            if auth_required.get("type") != "auth_required":
                return {"ok": False, "error": "expected auth_required", "message_type": auth_required.get("type")}
            websocket_send_json(sock, {"type": "auth", "access_token": access_token})
            auth_ok = websocket_read_json(sock)
            if auth_ok.get("type") != "auth_ok":
                return {"ok": False, "error": "websocket auth failed", "message_type": auth_ok.get("type")}
            websocket_send_json(sock, {
                "id": 1,
                "type": "auth/long_lived_access_token",
                "client_name": client_name,
                "lifespan": lifespan,
            })
            token_msg = websocket_read_json(sock)
            if not token_msg.get("success"):
                return {
                    "ok": False,
                    "error": "long-lived token request failed",
                    "message_type": token_msg.get("type"),
                    "error_payload": token_msg.get("error"),
                }
            token = token_msg.get("result")
            if not isinstance(token, str) or not token:
                return {"ok": False, "error": "long-lived token response missing token"}
            return {"ok": True, "token": token}
    except (OSError, RuntimeError, json.JSONDecodeError) as error:
        return {"ok": False, "error": str(error)}


def hass_onboard_via_api(
    base_url: str,
    name: str,
    username: str,
    password: str,
    language: str,
    client_id: str,
    token_client_name: str,
    token_lifespan: int,
) -> dict[str, Any]:
    base = base_url.rstrip("/")
    steps: list[dict[str, Any]] = []
    status = hass_http_json("GET", f"{base}/api/onboarding")
    steps.append({"step": "status_before", "ok": status["ok"], "status": status.get("status"), "body": status.get("json")})
    if not status["ok"]:
        return {"ok": False, "steps": steps, "error": "cannot read onboarding status"}
    done = {
        str(item.get("step")): bool(item.get("done"))
        for item in (status.get("json") or [])
        if isinstance(item, dict)
    }
    if done.get("user"):
        return {"ok": False, "steps": steps, "error": "user step already done; use browser/login flow or token-save"}

    user_payload = {
        "name": name,
        "username": username,
        "password": password,
        "client_id": client_id,
        "language": language,
    }
    user_result = hass_http_json("POST", f"{base}/api/onboarding/users", payload=user_payload)
    auth_code = None
    if isinstance(user_result.get("json"), dict):
        auth_code = user_result["json"].get("auth_code")
    steps.append({
        "step": "user",
        "ok": user_result["ok"],
        "status": user_result.get("status"),
        "auth_code_received": isinstance(auth_code, str) and bool(auth_code),
    })
    if not user_result["ok"] or not isinstance(auth_code, str) or not auth_code:
        return {"ok": False, "steps": steps, "error": "user onboarding failed"}

    token_result = hass_http_json(
        "POST",
        f"{base}/auth/token",
        form={
            "grant_type": "authorization_code",
            "code": auth_code,
            "client_id": client_id,
        },
    )
    token_json = token_result.get("json") if isinstance(token_result.get("json"), dict) else {}
    access_token = token_json.get("access_token") if isinstance(token_json, dict) else None
    steps.append({
        "step": "auth_token",
        "ok": token_result["ok"],
        "status": token_result.get("status"),
        "access_token_received": isinstance(access_token, str) and bool(access_token),
        "expires_in": token_json.get("expires_in") if isinstance(token_json, dict) else None,
    })
    if not token_result["ok"] or not isinstance(access_token, str) or not access_token:
        return {"ok": False, "steps": steps, "error": "auth code exchange failed"}

    for endpoint, step in (("core_config", "core_config"), ("analytics", "analytics")):
        result = hass_http_json("POST", f"{base}/api/onboarding/{endpoint}", payload={}, token=access_token)
        steps.append({"step": step, "ok": result["ok"], "status": result.get("status")})

    integration = hass_http_json(
        "POST",
        f"{base}/api/onboarding/integration",
        payload={
            "client_id": client_id,
            "redirect_uri": f"{base}/?auth_callback=1",
        },
        token=access_token,
    )
    steps.append({"step": "integration", "ok": integration["ok"], "status": integration.get("status")})

    long_lived = hass_create_long_lived_token(base, access_token, token_client_name, token_lifespan)
    steps.append({
        "step": "long_lived_token",
        "ok": bool(long_lived.get("ok")),
        "lifespan_days": token_lifespan,
        "client_name": token_client_name,
    })
    if not long_lived.get("ok"):
        return {"ok": False, "steps": steps, "error": long_lived.get("error", "long-lived token failed")}

    status_after = hass_http_json("GET", f"{base}/api/onboarding")
    steps.append({
        "step": "status_after",
        "ok": status_after["ok"],
        "status": status_after.get("status"),
        "body": status_after.get("json"),
    })
    return {"ok": True, "steps": steps, "token": long_lived["token"]}


def local_hass_api_probe(port: int, timeout: float = 3.0) -> dict[str, Any]:
    url = f"http://127.0.0.1:{port}/api/onboarding"
    result = hass_http_json("GET", url, timeout=timeout)
    body = result.get("json")
    return {
        "ok": bool(result.get("ok") and result.get("status") == 200),
        "url": url,
        "status": result.get("status"),
        "body_type": type(body).__name__,
        "error": result.get("error", ""),
    }


def local_hass_onboarding_status(port: int, timeout: float = 3.0) -> dict[str, Any]:
    probe = local_hass_api_probe(port, timeout=timeout)
    if not probe["ok"]:
        return {
            **probe,
            "steps": {},
            "user_done": None,
            "all_done": None,
        }
    result = hass_http_json("GET", probe["url"], timeout=timeout)
    steps: dict[str, bool] = {}
    body = result.get("json")
    if isinstance(body, list):
        for item in body:
            if isinstance(item, dict) and isinstance(item.get("step"), str):
                steps[str(item["step"])] = bool(item.get("done"))
    return {
        **probe,
        "steps": steps,
        "user_done": steps.get("user"),
        "all_done": bool(steps) and all(steps.values()),
    }


def local_hass_tunnel_action(user: str, host: str, port: int, action: str) -> dict[str, Any]:
    before = local_hass_api_probe(port)
    command = [
        "ssh",
        "-F",
        "/dev/null",
        "-fN",
        "-o",
        "ExitOnForwardFailure=yes",
        "-o",
        "BatchMode=yes",
        "-o",
        "PasswordAuthentication=no",
        "-o",
        "PreferredAuthentications=publickey",
        "-o",
        "ConnectTimeout=4",
        "-o",
        "LogLevel=ERROR",
        "-L",
        f"127.0.0.1:{port}:127.0.0.1:{port}",
        f"{user}@{host}",
    ]
    if action == "tunnel-status":
        state = "ready" if before["ok"] else "unavailable"
        return {
            "rc": 0 if before["ok"] else 1,
            "stdout": "\n".join([
                "LOCAL_HASS_TUNNEL",
                f"state={state}",
                f"url={before['url']}",
                f"http_status={before.get('status')}",
            ]),
            "stderr": str(before.get("error") or ""),
        }
    if before["ok"]:
        return {
            "rc": 0,
            "stdout": "\n".join([
                "LOCAL_HASS_TUNNEL",
                "state=already_ready",
                f"url={before['url']}",
                f"http_status={before.get('status')}",
            ]),
            "stderr": "",
        }
    start = run(command, timeout=10)
    deadline = time.monotonic() + 8
    after = local_hass_api_probe(port)
    while not after["ok"] and time.monotonic() < deadline:
        time.sleep(0.25)
        after = local_hass_api_probe(port)
    state = "started" if after["ok"] else "failed"
    return {
        "rc": 0 if after["ok"] else 1,
        "stdout": "\n".join([
            "LOCAL_HASS_TUNNEL",
            f"state={state}",
            f"url={after['url']}",
            f"http_status={after.get('status')}",
            f"ssh_rc={start['rc']}",
        ]),
        "stderr": "\n".join(part for part in (start["stderr"], str(after.get("error") or "")) if part),
    }


def local_hass_onboarding_action(port: int) -> dict[str, Any]:
    status = local_hass_onboarding_status(port)
    lines = [
        "LOCAL_HASS_ONBOARDING",
        f"state={'ready' if status['ok'] else 'unavailable'}",
        f"url={status['url']}",
        f"http_status={status.get('status')}",
    ]
    steps = status.get("steps")
    if isinstance(steps, dict):
        for name in ("user", "core_config", "analytics", "integration"):
            if name in steps:
                lines.append(f"{name}={str(steps[name]).lower()}")
    return {
        "rc": 0 if status["ok"] else 1,
        "stdout": "\n".join(lines),
        "stderr": str(status.get("error") or ""),
    }


def remote_hass_context_action(
    user: str,
    host: str,
    runtime: str,
    action: str,
    image: str,
    config_dir: Path,
    port: int,
    timezone: str,
    container_name: str,
    logs_tail: int,
) -> dict[str, Any]:
    quoted_runtime = shlex.quote(runtime)
    quoted_image = shlex.quote(image)
    quoted_config = shlex.quote(str(config_dir))
    quoted_port = shlex.quote(str(port))
    quoted_timezone = shlex.quote(timezone)
    quoted_container = shlex.quote(container_name)
    quoted_logs_tail = shlex.quote(str(logs_tail))
    start_cmd = (
        f"mkdir -p {quoted_config}; "
        f"chmod 2775 {quoted_config}; "
        f"if {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
        f"  if {quoted_runtime} inspect --format '{{{{.State.Running}}}}' {quoted_container} 2>/dev/null | grep -qx true; then "
        "    echo already_running; "
        "  else "
        f"    {quoted_runtime} rm -f {quoted_container} >/dev/null; "
        f"    {quoted_runtime} run -d --rm --pull=missing --name {quoted_container} "
        f"      -e TZ={quoted_timezone} -v {quoted_config}:/config "
        f"      -p 127.0.0.1:{quoted_port}:8123 {quoted_image}; "
        "  fi; "
        "else "
        f"  {quoted_runtime} run -d --rm --pull=missing --name {quoted_container} "
        f"    -e TZ={quoted_timezone} -v {quoted_config}:/config "
        f"    -p 127.0.0.1:{quoted_port}:8123 {quoted_image}; "
        "fi"
    )
    status_block = "\n".join([
        "printf 'TOOLS\\n'",
        f"command -v {quoted_runtime} curl ss || true",
        "printf 'IMAGE\\n'",
        f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} image exists {quoted_image} >/dev/null 2>&1; then echo present; else echo missing; fi",
        "printf 'CONTAINER\\n'",
        (
            f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
            f"{quoted_runtime} inspect --format 'name={{{{.Name}}}} status={{{{.State.Status}}}} running={{{{.State.Running}}}} started={{{{.State.StartedAt}}}}' {quoted_container}; "
            "else echo missing; fi"
        ),
        "printf 'PORT\\n'",
        f"ss -H -ltn 2>/dev/null | awk '{{print $4}}' | grep -E '(^|:){quoted_port}$' >/dev/null && echo busy || echo free",
        "printf 'HTTP\\n'",
        f"curl -fsS -o /dev/null -w '%{{http_code}}\\n' http://127.0.0.1:{quoted_port}/ 2>/dev/null || echo unavailable",
    ])
    if action == "start":
        remote = "\n".join(["set -eu", "printf 'START\\n'", start_cmd, status_block])
        timeout = 900
    elif action == "stop":
        remote = "\n".join([
            "set -u",
            "printf 'STOP\\n'",
            (
                f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"{quoted_runtime} stop {quoted_container}; else echo missing; fi"
            ),
            status_block,
        ])
        timeout = 60
    elif action == "logs":
        remote = "\n".join([
            "set -u",
            "printf 'LOGS\\n'",
            (
                f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"{quoted_runtime} logs --tail {quoted_logs_tail} {quoted_container}; else echo missing; fi"
            ),
        ])
        timeout = 60
    else:
        remote = "\n".join(["set -u", status_block])
        timeout = 20
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=timeout,
    )


def remote_hass_token_probe(
    user: str,
    host: str,
    token_file: str,
    port: int,
) -> dict[str, Any]:
    quoted_token_file = shlex.quote(token_file)
    quoted_port = shlex.quote(str(port))
    remote = "\n".join([
        "set -u",
        f"CTOS_HA_TOKEN_TEMPLATE={quoted_token_file}",
        "CTOS_HA_TOKEN_FILE=${CTOS_HA_TOKEN_TEMPLATE/\\$UID/$(id -u)}",
        f"CTOS_HA_PORT={quoted_port}",
        "printf 'TOKEN\\n'",
        "printf 'path=%s\\n' \"$CTOS_HA_TOKEN_FILE\"",
        (
            "if test -f \"$CTOS_HA_TOKEN_FILE\"; then "
            "echo exists=true; "
            "stat -c 'owner=%U group=%G mode=%a bytes=%s' \"$CTOS_HA_TOKEN_FILE\"; "
            "if test -s \"$CTOS_HA_TOKEN_FILE\"; then echo nonempty=true; else echo nonempty=false; fi; "
            "else echo exists=false; echo nonempty=false; fi"
        ),
        "printf 'API\\n'",
        (
            "if test -s \"$CTOS_HA_TOKEN_FILE\"; then "
            "TOKEN=$(tr -d '\\r\\n' < \"$CTOS_HA_TOKEN_FILE\"); "
            "if test -n \"$TOKEN\"; then "
            "HTTP_CODE=$( { "
            "printf 'header = \"Authorization: Bearer %s\"\\n' \"$TOKEN\"; "
            "printf 'header = \"Content-Type: application/json\"\\n'; "
            "} | curl -fsS -o /dev/null -w '%{http_code}' -K - "
            "\"http://127.0.0.1:${CTOS_HA_PORT}/api/\" 2>/dev/null || true ); "
            "if test -z \"$HTTP_CODE\"; then HTTP_CODE=unavailable; fi; "
            "printf 'http=%s\\n' \"$HTTP_CODE\"; "
            "case \"$HTTP_CODE\" in "
            "200) echo state=ready ;; "
            "401|403) echo state=invalid_token ;; "
            "000|unavailable) echo state=unavailable ;; "
            "*) printf 'state=http_%s\\n' \"$HTTP_CODE\" ;; "
            "esac; "
            "else echo http=skipped; echo state=empty_token; fi; "
            "else echo http=skipped; echo state=missing_token; fi"
        ),
    ])
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=20,
    )


def remote_hass_token_save(
    user: str,
    host: str,
    token_file: str,
    token: str,
) -> dict[str, Any]:
    quoted_token_file = shlex.quote(token_file)
    remote = "\n".join([
        "set -euo pipefail",
        f"CTOS_HA_TOKEN_TEMPLATE={quoted_token_file}",
        "CTOS_HA_TOKEN_FILE=${CTOS_HA_TOKEN_TEMPLATE/\\$UID/$(id -u)}",
        "mkdir -p \"$(dirname \"$CTOS_HA_TOKEN_FILE\")\"",
        "TMP_FILE=\"${CTOS_HA_TOKEN_FILE}.tmp.$$\"",
        "umask 077",
        "cat > \"$TMP_FILE\"",
        "tr -d '\\r\\n' < \"$TMP_FILE\" > \"${TMP_FILE}.clean\"",
        "mv \"${TMP_FILE}.clean\" \"$CTOS_HA_TOKEN_FILE\"",
        "rm -f \"$TMP_FILE\"",
        "chmod 600 \"$CTOS_HA_TOKEN_FILE\"",
        "test -s \"$CTOS_HA_TOKEN_FILE\"",
        "printf 'TOKEN_SAVED\\n'",
        "printf 'path=%s\\n' \"$CTOS_HA_TOKEN_FILE\"",
        "stat -c 'owner=%U group=%G mode=%a bytes=%s' \"$CTOS_HA_TOKEN_FILE\"",
    ])
    try:
        proc = subprocess.run(
            [
                "ssh",
                "-F",
                "/dev/null",
                "-o",
                "BatchMode=yes",
                "-o",
                "PasswordAuthentication=no",
                "-o",
                "PreferredAuthentications=publickey",
                "-o",
                "ConnectTimeout=4",
                "-o",
                "LogLevel=ERROR",
                f"{user}@{host}",
                "bash",
                "-lc",
                remote,
            ],
            input=token.strip() + "\n",
            capture_output=True,
            check=False,
            text=True,
            timeout=20,
        )
        return {"rc": proc.returncode, "stdout": proc.stdout.strip(), "stderr": proc.stderr.strip()}
    except FileNotFoundError:
        return {"rc": 127, "stdout": "", "stderr": "ssh not found"}
    except subprocess.TimeoutExpired:
        return {"rc": 124, "stdout": "", "stderr": "timeout"}


def hass_token_state(output: str) -> str:
    for line in output.splitlines():
        if line.startswith("state="):
            return line.split("=", 1)[1].strip()
    return "unknown"


def wait_for_tcp(host: str, port: int, timeout: float) -> bool:
    deadline = time.monotonic() + timeout
    last_error: OSError | None = None
    while time.monotonic() < deadline:
        try:
            with socket.create_connection((host, port), timeout=0.5):
                return True
        except OSError as error:
            last_error = error
            time.sleep(0.1)
    if last_error:
        return False
    return False


def wyoming_write_event(
    sock: socket.socket,
    event_type: str,
    data: dict[str, Any] | None = None,
    payload: bytes | None = None,
) -> None:
    event: dict[str, Any] = {
        "type": event_type,
        "version": "1.0",
    }
    if data:
        event["data"] = data
    if payload is not None:
        event["payload_length"] = len(payload)
    sock.sendall(json.dumps(event, separators=(",", ":")).encode("utf-8") + b"\n")
    if payload is not None:
        sock.sendall(payload)


def wyoming_read_event(sock_file: Any) -> dict[str, Any] | None:
    line = sock_file.readline()
    if not line:
        return None
    try:
        event = json.loads(line.decode("utf-8"))
    except json.JSONDecodeError as error:
        return {"type": "parse_error", "error": str(error), "raw": line.decode("utf-8", "replace")}
    if not isinstance(event, dict):
        return {"type": "parse_error", "error": "event is not an object"}
    data_length = int(event.get("data_length") or 0)
    if data_length:
        data_raw = sock_file.read(data_length)
        try:
            event["data"] = json.loads(data_raw.decode("utf-8"))
        except json.JSONDecodeError:
            event["data"] = {"raw": data_raw.decode("utf-8", "replace")}
    payload_length = int(event.get("payload_length") or 0)
    if payload_length:
        event["payload"] = sock_file.read(payload_length)
    return event


def wyoming_transcribe_wav(
    wav_path: Path,
    host: str,
    port: int,
    timeout: float,
    language: str | None = None,
) -> dict[str, Any]:
    if not wav_path.exists():
        return {"ok": False, "error": f"audio file not found: {wav_path}"}
    try:
        with wave.open(str(wav_path), "rb") as wav:
            channels = wav.getnchannels()
            width = wav.getsampwidth()
            rate = wav.getframerate()
            frames = wav.getnframes()
            audio = wav.readframes(frames)
    except wave.Error as error:
        return {"ok": False, "error": f"invalid WAV file: {error}"}
    if channels != 1 or width != 2:
        return {"ok": False, "error": "audio must be mono 16-bit PCM WAV"}
    if not audio:
        return {"ok": False, "error": "audio file has no frames"}

    events: list[dict[str, Any]] = []
    transcript = ""
    try:
        with socket.create_connection((host, port), timeout=timeout) as sock:
            sock.settimeout(timeout)
            sock_file = sock.makefile("rb")
            wyoming_write_event(sock, "describe")
            first = wyoming_read_event(sock_file)
            if first:
                events.append(first)
            transcribe_data: dict[str, Any] = {}
            if language:
                transcribe_data["language"] = language
            wyoming_write_event(sock, "transcribe", transcribe_data)
            wyoming_write_event(sock, "audio-start", {"rate": rate, "width": width, "channels": channels})
            chunk_size = rate * channels * width // 2
            for offset in range(0, len(audio), chunk_size):
                wyoming_write_event(
                    sock,
                    "audio-chunk",
                    {"rate": rate, "width": width, "channels": channels},
                    audio[offset:offset + chunk_size],
                )
            wyoming_write_event(sock, "audio-stop")
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                event = wyoming_read_event(sock_file)
                if event is None:
                    break
                events.append(event)
                event_type = str(event.get("type") or "")
                data = event.get("data") if isinstance(event.get("data"), dict) else {}
                if event_type == "transcript":
                    text = data.get("text") or data.get("name")
                    if isinstance(text, str):
                        transcript = text.strip()
                    break
                if event_type == "error":
                    return {
                        "ok": False,
                        "error": str(data.get("message") or data or "wyoming error"),
                        "events": summarize_wyoming_events(events),
                    }
    except OSError as error:
        return {"ok": False, "error": str(error), "events": summarize_wyoming_events(events)}
    return {
        "ok": bool(transcript),
        "transcript": transcript,
        "audio": {
            "path": str(wav_path),
            "rate": rate,
            "channels": channels,
            "width": width,
            "frames": frames,
        },
        "events": summarize_wyoming_events(events),
        "error": "" if transcript else "no transcript returned",
    }


def analyze_wav_audio(wav_path: Path) -> dict[str, Any]:
    if not wav_path.exists():
        return {"ok": False, "state": "missing", "error": f"audio file not found: {wav_path}"}
    try:
        with wave.open(str(wav_path), "rb") as wav:
            channels = wav.getnchannels()
            width = wav.getsampwidth()
            rate = wav.getframerate()
            frames = wav.getnframes()
            audio = wav.readframes(frames)
    except wave.Error as error:
        return {"ok": False, "state": "invalid", "error": f"invalid WAV file: {error}"}

    payload: dict[str, Any] = {
        "ok": False,
        "path": str(wav_path),
        "rate": rate,
        "channels": channels,
        "width": width,
        "frames": frames,
        "duration_seconds": round(frames / rate, 3) if rate else 0,
    }
    if channels != 1 or width != 2:
        payload.update({
            "state": "unsupported_format",
            "error": "audio must be mono 16-bit PCM WAV",
        })
        return payload
    if not audio:
        payload.update({"state": "empty", "error": "audio file has no frames"})
        return payload

    count = len(audio) // 2
    samples = struct.unpack("<" + "h" * count, audio)
    peak = max(abs(sample) for sample in samples)
    square_sum = sum(sample * sample for sample in samples)
    rms = math.sqrt(square_sum / count) if count else 0.0
    clipped = sum(1 for sample in samples if abs(sample) >= 32760)
    near_clip = sum(1 for sample in samples if abs(sample) >= 32000)
    zeroish = sum(1 for sample in samples if abs(sample) <= 1)
    activity = audio_activity_profile(samples, rate)
    peak_pct = peak / 32768 * 100
    rms_pct = rms / 32768 * 100
    clipped_pct = clipped / count * 100 if count else 0.0
    near_clip_pct = near_clip / count * 100 if count else 0.0
    zero_pct = zeroish / count * 100 if count else 0.0
    peak_dbfs = 20 * math.log10(peak / 32768) if peak else None
    rms_dbfs = 20 * math.log10(rms / 32768) if rms else None

    state = "ok"
    recommendation = "audio level looks usable for a next STT attempt"
    if peak == 0 or rms_pct < 0.2:
        state = "too_quiet"
        recommendation = "raise microphone gain with `ctos-audio mic-up 5`, move closer, or select the correct input in `ctos-audio mixer`"
    elif clipped_pct > 0.1 or near_clip_pct > 1.0 or (peak_pct >= 99.5 and rms_pct > 18):
        state = "clipping"
        recommendation = "lower microphone gain with `ctos-audio mic-set 20` or `ctos-audio mic-down 10`, then record again"
    elif rms_pct > 22:
        state = "hot"
        recommendation = "lower microphone gain a little with `ctos-audio mic-down 5` before open-STT testing"

    payload.update({
        "ok": True,
        "state": state,
        "samples": count,
        "rms_pct": round(rms_pct, 2),
        "peak_pct": round(peak_pct, 2),
        "rms_dbfs": round(rms_dbfs, 2) if rms_dbfs is not None else None,
        "peak_dbfs": round(peak_dbfs, 2) if peak_dbfs is not None else None,
        "clipped_samples": clipped,
        "clipped_pct": round(clipped_pct, 4),
        "near_clip_pct": round(near_clip_pct, 4),
        "zero_pct": round(zero_pct, 2),
        "activity": activity,
        "recommendation": recommendation,
    })
    return payload


def audio_activity_profile(samples: tuple[int, ...], rate: int) -> dict[str, Any]:
    if not samples or rate <= 0:
        return {
            "active_windows": 0,
            "total_windows": 0,
            "active_pct": 0.0,
            "threshold_pct": 0.0,
            "first_active_sample": None,
            "last_active_sample": None,
        }

    window = max(1, int(rate * 0.03))
    window_rms: list[float] = []
    for start in range(0, len(samples), window):
        chunk = samples[start:start + window]
        if not chunk:
            continue
        rms = math.sqrt(sum(sample * sample for sample in chunk) / len(chunk))
        window_rms.append(rms)
    if not window_rms:
        return {
            "active_windows": 0,
            "total_windows": 0,
            "active_pct": 0.0,
            "threshold_pct": 0.0,
            "first_active_sample": None,
            "last_active_sample": None,
        }

    sorted_rms = sorted(window_rms)
    noise_index = min(len(sorted_rms) - 1, max(0, int(len(sorted_rms) * 0.25)))
    noise_floor = sorted_rms[noise_index]
    threshold = max(noise_floor * 3.0, 32768 * 0.006)
    active_indices = [index for index, rms in enumerate(window_rms) if rms >= threshold]
    if not active_indices:
        first_active = None
        last_active = None
    else:
        first_active = max(0, active_indices[0] * window)
        last_active = min(len(samples), (active_indices[-1] + 1) * window)
    return {
        "active_windows": len(active_indices),
        "total_windows": len(window_rms),
        "active_pct": round(len(active_indices) / len(window_rms) * 100, 2),
        "threshold_pct": round(threshold / 32768 * 100, 3),
        "noise_floor_pct": round(noise_floor / 32768 * 100, 3),
        "first_active_sample": first_active,
        "last_active_sample": last_active,
    }


def read_mono_s16_wav(wav_path: Path) -> dict[str, Any]:
    try:
        with wave.open(str(wav_path), "rb") as wav:
            channels = wav.getnchannels()
            width = wav.getsampwidth()
            rate = wav.getframerate()
            frames = wav.getnframes()
            audio = wav.readframes(frames)
    except wave.Error as error:
        return {"ok": False, "error": f"invalid WAV file: {error}"}
    if channels != 1 or width != 2:
        return {"ok": False, "error": "audio must be mono 16-bit PCM WAV"}
    if not audio:
        return {"ok": False, "error": "audio file has no frames"}
    count = len(audio) // 2
    samples = struct.unpack("<" + "h" * count, audio)
    return {
        "ok": True,
        "path": str(wav_path),
        "rate": rate,
        "frames": frames,
        "samples": samples,
    }


def write_mono_s16_wav(wav_path: Path, rate: int, samples: tuple[int, ...]) -> None:
    wav_path.parent.mkdir(parents=True, exist_ok=True)
    clamped = [max(-32768, min(32767, int(round(sample)))) for sample in samples]
    audio = struct.pack("<" + "h" * len(clamped), *clamped)
    with wave.open(str(wav_path), "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(rate)
        wav.writeframes(audio)


def prepare_stt_audio(
    wav_path: Path,
    mode: str,
    output_path: Path | None = None,
) -> tuple[dict[str, Any], Path | None]:
    if mode == "off":
        return {
            "ok": True,
            "state": "disabled",
            "input": str(wav_path),
            "output": str(wav_path),
            "delete_output": False,
            "reason": "audio preprocessing disabled",
        }, None

    source = read_mono_s16_wav(wav_path)
    if not source.get("ok"):
        return {
            "ok": False,
            "state": "invalid_audio",
            "input": str(wav_path),
            "output": str(wav_path),
            "delete_output": False,
            "reason": source.get("error", "invalid audio"),
        }, None

    rate = int(source["rate"])
    samples: tuple[int, ...] = source["samples"]
    analysis = analyze_wav_audio(wav_path)
    activity = audio_activity_profile(samples, rate)
    active_pct = float(activity.get("active_pct") or 0.0)
    if str(analysis.get("state")) in {"clipping", "unsupported_format", "empty", "invalid", "missing"}:
        return {
            "ok": False,
            "state": f"blocked_{analysis.get('state')}",
            "input": str(wav_path),
            "output": str(wav_path),
            "delete_output": False,
            "activity": activity,
            "reason": "source audio is not safe to normalize for STT",
        }, None
    if active_pct < DEFAULT_STT_MIN_ACTIVE_PCT:
        return {
            "ok": False,
            "state": "low_activity",
            "input": str(wav_path),
            "output": str(wav_path),
            "delete_output": False,
            "activity": activity,
            "reason": "not enough voice-like activity to trust open-STT; refusing to amplify silence/noise",
        }, None

    first_active = activity.get("first_active_sample")
    last_active = activity.get("last_active_sample")
    pad = int(rate * 0.20)
    if isinstance(first_active, int) and isinstance(last_active, int) and last_active > first_active:
        trim_start = max(0, first_active - pad)
        trim_end = min(len(samples), last_active + pad)
        working = samples[trim_start:trim_end]
    else:
        trim_start = 0
        trim_end = len(samples)
        working = samples

    peak = max(abs(sample) for sample in working) if working else 0
    rms = math.sqrt(sum(sample * sample for sample in working) / len(working)) if working else 0.0
    if not peak or not rms:
        return {
            "ok": False,
            "state": "silent_after_trim",
            "input": str(wav_path),
            "output": str(wav_path),
            "delete_output": False,
            "activity": activity,
            "reason": "active region collapsed to silence",
        }, None

    target_rms = 32768 * (DEFAULT_STT_TARGET_RMS_PCT / 100)
    max_peak = 32768 * (DEFAULT_STT_MAX_PEAK_PCT / 100)
    gain = min(target_rms / rms, max_peak / peak)
    if mode == "auto":
        gain = max(1.0, gain)
    gain = max(0.05, min(gain, 20.0))
    processed = tuple(max(-32768, min(32767, int(round(sample * gain)))) for sample in working)

    if output_path is None:
        handle = tempfile.NamedTemporaryFile(prefix="ctos-stp-preprocessed-", suffix=".wav", delete=False, dir="/tmp")
        handle.close()
        output_path = Path(handle.name)
        delete_output = True
    else:
        output_path = output_path.expanduser()
        delete_output = False
    write_mono_s16_wav(output_path, rate, processed)
    output_analysis = analyze_wav_audio(output_path)
    return {
        "ok": True,
        "state": "processed",
        "input": str(wav_path),
        "output": str(output_path),
        "delete_output": delete_output,
        "mode": mode,
        "activity": activity,
        "trim": {
            "start_seconds": round(trim_start / rate, 3),
            "end_seconds": round(trim_end / rate, 3),
            "duration_seconds": round((trim_end - trim_start) / rate, 3),
        },
        "gain": round(gain, 3),
        "target_rms_pct": DEFAULT_STT_TARGET_RMS_PCT,
        "max_peak_pct": DEFAULT_STT_MAX_PEAK_PCT,
        "output_analysis": output_analysis,
        "reason": "prepared voice-like audio for STT",
    }, output_path


def guard_stt_transcript(transcript: str, audio_analysis: dict[str, Any]) -> dict[str, Any]:
    text = transcript.strip()
    normalized = normalize_text(text)
    if not text:
        return {
            "ok": False,
            "state": "empty",
            "route_allowed": False,
            "reason": "no transcript returned",
        }
    if not normalized:
        return {
            "ok": False,
            "state": "unreadable_transcript",
            "route_allowed": False,
            "reason": "transcript contains no speech-like text after normalization",
        }
    if re.search(r"([^\w\s'’.,;:!?\-/])\1{2,}", text, flags=re.UNICODE):
        return {
            "ok": False,
            "state": "symbol_repetition",
            "route_allowed": False,
            "reason": "transcript contains repeated non-speech symbols",
        }
    symbol_count = sum(1 for char in text if not (char.isalnum() or char.isspace() or char in "'’.,;:!?-/"))
    if symbol_count and symbol_count / max(1, len(text)) > 0.15:
        return {
            "ok": False,
            "state": "symbol_noise",
            "route_allowed": False,
            "reason": "transcript contains too much non-speech symbol noise",
        }

    for known in COMMON_STT_HALLUCINATIONS:
        if known in normalized:
            return {
                "ok": False,
                "state": "known_hallucination",
                "route_allowed": False,
                "reason": f"blocked common Whisper silence/noise hallucination: {known}",
            }

    state = str(audio_analysis.get("state") or "")
    if state in {"too_quiet", "clipping", "unsupported_format", "empty", "invalid", "missing"}:
        return {
            "ok": False,
            "state": f"bad_audio_{state}",
            "route_allowed": False,
            "reason": "audio analysis is not clean enough to trust the transcript",
        }

    return {
        "ok": True,
        "state": "ok",
        "route_allowed": True,
        "reason": "transcript passed basic safety guard",
    }


def summarize_wyoming_events(events: list[dict[str, Any]]) -> list[dict[str, Any]]:
    summary: list[dict[str, Any]] = []
    for event in events:
        item: dict[str, Any] = {"type": event.get("type")}
        data = event.get("data")
        if isinstance(data, dict):
            for key in ("name", "text", "language", "version", "message"):
                if key in data:
                    item[key] = data[key]
        if "payload" in event:
            payload = event.get("payload")
            item["payload_bytes"] = len(payload) if isinstance(payload, bytes) else 0
        summary.append(item)
    return summary


def write_silence_wav(path: Path, seconds: float = 0.25, rate: int = 16000) -> None:
    frames = max(1, int(rate * seconds))
    with wave.open(str(path), "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(rate)
        wav.writeframes(b"\x00\x00" * frames)


def start_mock_wyoming_server(
    transcript: str,
    language: str,
    timeout: float,
) -> tuple[int, dict[str, Any], threading.Thread]:
    state: dict[str, Any] = {"events": [], "error": "", "port": 0}
    ready = threading.Event()

    def serve_once() -> None:
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server:
                server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                server.bind(("127.0.0.1", 0))
                server.listen(1)
                server.settimeout(timeout)
                state["port"] = int(server.getsockname()[1])
                ready.set()
                conn, _addr = server.accept()
                with conn:
                    conn.settimeout(timeout)
                    sock_file = conn.makefile("rb")
                    while True:
                        event = wyoming_read_event(sock_file)
                        if event is None:
                            break
                        state["events"].append(event)
                        event_type = str(event.get("type") or "")
                        if event_type == "describe":
                            wyoming_write_event(conn, "info", {
                                "name": "ctos-wyoming-selftest",
                                "version": "1",
                            })
                        elif event_type == "audio-stop":
                            wyoming_write_event(conn, "transcript", {
                                "text": transcript,
                                "language": language,
                            })
                            break
        except Exception as error:  # pragma: no cover - exercised by command-level self-test
            state["error"] = str(error)
        finally:
            ready.set()

    thread = threading.Thread(target=serve_once, name="ctos-wyoming-selftest", daemon=True)
    thread.start()
    if not ready.wait(timeout):
        state["error"] = "mock Wyoming server did not start"
        return 0, state, thread
    return int(state["port"]), state, thread


def start_ssh_tunnel(user: str, host: str, local_port: int, remote_port: int) -> subprocess.Popen[str]:
    return subprocess.Popen(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-N",
            "-L",
            f"127.0.0.1:{local_port}:127.0.0.1:{remote_port}",
            f"{user}@{host}",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )


def free_local_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return int(sock.getsockname()[1])


def record_with_ctos_voice(seconds: float, out_path: Path) -> tuple[int, str]:
    result = run(
        [
            str(ROOT / "scripts" / "ctos-voice"),
            "record-once",
            "--seconds",
            str(seconds),
            "--out",
            str(out_path),
        ],
        timeout=max(20, seconds + 15),
    )
    detail = result["stderr"] or result["stdout"]
    return int(result["rc"]), detail


def route_transcript_with_ctos_voice(
    transcript: str,
    execute_safe: bool,
    no_speak: bool,
    save_agenda: bool = False,
) -> dict[str, Any]:
    command = [str(ROOT / "scripts" / "ctos-voice"), "route", "--json"]
    if execute_safe:
        command.append("--execute-safe")
    if save_agenda:
        command.append("--save-agenda")
    if no_speak:
        command.append("--no-speak")
    command.append(transcript)
    return run(command, timeout=35)


def stp_container_entrypoint() -> str:
    return (
        'test -s /run/secrets/ctos-ha-token || '
        '{ echo "missing /run/secrets/ctos-ha-token" >&2; exit 2; }; '
        'exec /run.sh "$@" --hass-token "$(tr -d "\\r\\n" < /run/secrets/ctos-ha-token)"'
    )


def remote_stp_container_inspect(
    user: str,
    host: str,
    runtime: str,
    image: str,
    pull_policy: str,
) -> dict[str, Any]:
    quoted_runtime = shlex.quote(runtime)
    quoted_image = shlex.quote(image)
    quoted_pull = shlex.quote(pull_policy)
    remote = "\n".join([
        "set -u",
        "printf 'RUNTIME\\n'",
        f"command -v {quoted_runtime}",
        "printf 'IMAGE_BEFORE\\n'",
        f"if {quoted_runtime} image exists {quoted_image} >/dev/null 2>&1; then echo present; else echo missing; fi",
        "printf 'HELP\\n'",
        f"{quoted_runtime} run --pull={quoted_pull} --rm {quoted_image} --help",
        "printf 'IMAGE_AFTER\\n'",
        (
            f"{quoted_runtime} image inspect "
            "--format '{{.Id}} {{if .Digest}}{{.Digest}}{{else}}no-digest{{end}} {{.Size}}' "
            f"{quoted_image}"
        ),
    ])
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=240,
    )


def remote_stp_container_action(
    user: str,
    host: str,
    runtime: str,
    action: str,
    image: str,
    backend_dir: Path,
    train_dir: Path,
    models_dir: Path,
    port: int,
    hass_websocket_uri: str,
    token_file: str,
    container_name: str,
    logs_tail: int,
) -> dict[str, Any]:
    custom_dir = backend_dir / "custom_sentences"
    quoted_runtime = shlex.quote(runtime)
    quoted_image = shlex.quote(image)
    quoted_backend = shlex.quote(str(backend_dir))
    quoted_custom = shlex.quote(str(custom_dir))
    quoted_train = shlex.quote(str(train_dir))
    quoted_models = shlex.quote(str(models_dir))
    quoted_port = shlex.quote(str(port))
    quoted_uri = shlex.quote(hass_websocket_uri)
    quoted_token_template = shlex.quote(token_file)
    quoted_container = shlex.quote(container_name)
    quoted_logs_tail = shlex.quote(str(logs_tail))
    quoted_entrypoint = shlex.quote(stp_container_entrypoint())
    run_cmd = " ".join([
        f"{quoted_runtime} run -d --rm",
        f"--name {quoted_container}",
        "--network host",
        f"-v {quoted_custom}:/custom_sentences:ro",
        f"-v {quoted_train}:/train",
        f"-v {quoted_models}:/models",
        '-v "${CTOS_HA_TOKEN_FILE}:/run/secrets/ctos-ha-token:ro"',
        "--entrypoint bash",
        quoted_image,
        "-lc",
        quoted_entrypoint,
        "ctos-speech-to-phrase",
        f"--uri tcp://127.0.0.1:{quoted_port}",
        "--custom-sentences-dir /custom_sentences",
        "--train-dir /train",
        "--models-dir /models",
        f"--hass-websocket-uri {quoted_uri}",
    ])
    status_block = "\n".join([
        "printf 'TOOLS\\n'",
        f"command -v {quoted_runtime} curl ss || true",
        "printf 'IMAGE\\n'",
        f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} image exists {quoted_image} >/dev/null 2>&1; then echo present; else echo missing; fi",
        "printf 'PATHS\\n'",
        f"test -d {quoted_backend} && echo ok backend_dir {quoted_backend} || echo missing backend_dir {quoted_backend}",
        f"test -d {quoted_custom} && echo ok custom_sentences {quoted_custom} || echo missing custom_sentences {quoted_custom}",
        f"test -d {quoted_train} && echo ok train_dir {quoted_train} || echo missing train_dir {quoted_train}",
        f"test -d {quoted_models} && echo ok models_dir {quoted_models} || echo missing models_dir {quoted_models}",
        "printf 'CONTAINER\\n'",
        (
            f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
            f"{quoted_runtime} inspect --format 'name={{{{.Name}}}} status={{{{.State.Status}}}} running={{{{.State.Running}}}} started={{{{.State.StartedAt}}}}' {quoted_container}; "
            "else echo missing; fi"
        ),
        "printf 'PORT\\n'",
        f"ss -H -ltn 2>/dev/null | awk '{{print $4}}' | grep -E '(^|:){quoted_port}$' >/dev/null && echo busy || echo free",
    ])
    token_block = "\n".join([
        f"CTOS_HA_TOKEN_TEMPLATE={quoted_token_template}",
        "CTOS_HA_TOKEN_FILE=${CTOS_HA_TOKEN_TEMPLATE/\\$UID/$(id -u)}",
        "printf 'TOKEN\\n'",
        "printf 'path=%s\\n' \"$CTOS_HA_TOKEN_FILE\"",
        "test -s \"$CTOS_HA_TOKEN_FILE\" && echo state=file_present || echo state=missing_token_file",
    ])
    if action == "start":
        start_block = "\n".join([
            token_block,
            'test -s "$CTOS_HA_TOKEN_FILE"',
            f"mkdir -p {quoted_backend} {quoted_train} {quoted_models}",
            (
                f"if {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"  if {quoted_runtime} inspect --format '{{{{.State.Running}}}}' {quoted_container} 2>/dev/null | grep -qx true; then "
                "    echo already_running; "
                "  else "
                f"    {quoted_runtime} rm -f {quoted_container} >/dev/null; "
                f"    {run_cmd}; "
                "  fi; "
                "else "
                f"  {run_cmd}; "
                "fi"
            ),
        ])
        remote = "\n".join(["set -eu", "printf 'START\\n'", start_block, status_block])
        timeout = 240
    elif action == "stop":
        remote = "\n".join([
            "set -u",
            "printf 'STOP\\n'",
            (
                f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"{quoted_runtime} stop {quoted_container}; else echo missing; fi"
            ),
            status_block,
        ])
        timeout = 60
    elif action == "logs":
        remote = "\n".join([
            "set -u",
            "printf 'LOGS\\n'",
            (
                f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"{quoted_runtime} logs --tail {quoted_logs_tail} {quoted_container}; else echo missing; fi"
            ),
        ])
        timeout = 60
    else:
        remote = "\n".join(["set -u", token_block, status_block])
        timeout = 20
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=timeout,
    )


def remote_open_stt_container_action(
    user: str,
    host: str,
    runtime: str,
    action: str,
    image: str,
    model: str,
    model_dir: Path,
    cache_dir: Path,
    backend_dir: Path,
    port: int,
    container_name: str,
    logs_tail: int,
) -> dict[str, Any]:
    quoted_runtime = shlex.quote(runtime)
    quoted_image = shlex.quote(image)
    quoted_model = shlex.quote(model)
    quoted_model_dir = shlex.quote(str(model_dir))
    quoted_cache_dir = shlex.quote(str(cache_dir))
    quoted_backend_dir = shlex.quote(str(backend_dir))
    quoted_port = shlex.quote(str(port))
    quoted_container = shlex.quote(container_name)
    quoted_logs_tail = shlex.quote(str(logs_tail))
    run_cmd = " ".join([
        f"{quoted_runtime} run -d --rm --pull=missing",
        f"--name {quoted_container}",
        f"-p 127.0.0.1:{quoted_port}:{quoted_port}",
        f"-v {quoted_model_dir}:/data",
        quoted_image,
        f"--model {quoted_model}",
        "--language fr",
        "--compute-type int8",
        "--cpu-threads 4",
        f"--uri tcp://0.0.0.0:{quoted_port}",
        "--data-dir /data",
        "--download-dir /data",
    ])
    status_block = "\n".join([
        "printf 'TOOLS\\n'",
        f"command -v {quoted_runtime} curl ss || true",
        "printf 'IMAGE\\n'",
        f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} image exists {quoted_image} >/dev/null 2>&1; then echo present; else echo missing; fi",
        "printf 'PATHS\\n'",
        f"test -d {quoted_model_dir} && echo ok model_dir {quoted_model_dir} || echo missing model_dir {quoted_model_dir}",
        f"test -d {quoted_cache_dir} && echo ok cache_dir {quoted_cache_dir} || echo missing cache_dir {quoted_cache_dir}",
        f"test -d {quoted_backend_dir} && echo ok backend_dir {quoted_backend_dir} || echo missing backend_dir {quoted_backend_dir}",
        "printf 'CONTAINER\\n'",
        (
            f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
            f"{quoted_runtime} inspect --format 'name={{{{.Name}}}} status={{{{.State.Status}}}} running={{{{.State.Running}}}} started={{{{.State.StartedAt}}}} image={{{{.Config.Image}}}}' {quoted_container}; "
            "else echo missing; fi"
        ),
        "printf 'PORT\\n'",
        f"ss -H -ltn 2>/dev/null | awk '{{print $4}}' | grep -E '(^|:){quoted_port}$' >/dev/null && echo busy || echo free",
    ])
    if action == "start":
        start_block = "\n".join([
            f"mkdir -p {quoted_model_dir} {quoted_cache_dir} {quoted_backend_dir}",
            f"chmod 2775 {quoted_model_dir} {quoted_cache_dir} {quoted_backend_dir}",
            (
                f"if {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"  if {quoted_runtime} inspect --format '{{{{.State.Running}}}}' {quoted_container} 2>/dev/null | grep -qx true; then "
                "    echo already_running; "
                "  else "
                f"    {quoted_runtime} rm -f {quoted_container} >/dev/null; "
                f"    {run_cmd}; "
                "  fi; "
                "else "
                f"  {run_cmd}; "
                "fi"
            ),
        ])
        readiness_block = "\n".join([
            "printf 'READY\\n'",
            (
                f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                "  i=0; "
                "  while [ \"$i\" -lt 90 ]; do "
                f"    if {quoted_runtime} logs --tail {quoted_logs_tail} {quoted_container} 2>&1 | grep -qi 'Ready'; then echo ready; break; fi; "
                f"    if ! {quoted_runtime} inspect --format '{{{{.State.Running}}}}' {quoted_container} 2>/dev/null | grep -qx true; then "
                "      echo stopped_before_ready; "
                f"      {quoted_runtime} logs --tail {quoted_logs_tail} {quoted_container} 2>&1 || true; "
                "      exit 1; "
                "    fi; "
                "    i=$((i + 1)); "
                "    sleep 1; "
                "  done; "
                f"  if ! {quoted_runtime} logs --tail {quoted_logs_tail} {quoted_container} 2>&1 | grep -qi 'Ready'; then "
                "    echo not_ready; "
                f"    {quoted_runtime} logs --tail {quoted_logs_tail} {quoted_container} 2>&1 || true; "
                "    exit 1; "
                "  fi; "
                "else echo missing; exit 1; fi"
            ),
        ])
        remote = "\n".join(["set -eu", "printf 'START\\n'", start_block, readiness_block, status_block])
        timeout = 900
    elif action == "stop":
        remote = "\n".join([
            "set -u",
            "printf 'STOP\\n'",
            (
                f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"{quoted_runtime} stop --time 20 {quoted_container}; else echo missing; fi"
            ),
            status_block,
        ])
        timeout = 60
    elif action == "logs":
        remote = "\n".join([
            "set -u",
            "printf 'LOGS\\n'",
            (
                f"if command -v {quoted_runtime} >/dev/null 2>&1 && {quoted_runtime} container exists {quoted_container} >/dev/null 2>&1; then "
                f"{quoted_runtime} logs --tail {quoted_logs_tail} {quoted_container}; else echo missing; fi"
            ),
        ])
        timeout = 60
    else:
        remote = "\n".join(["set -u", status_block])
        timeout = 20
    return run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "PreferredAuthentications=publickey",
            "-o",
            "ConnectTimeout=4",
            "-o",
            "LogLevel=ERROR",
            f"{user}@{host}",
            remote,
        ],
        timeout=timeout,
    )


def bundle_or_error(root: Path) -> dict[str, Any]:
    try:
        return validate_backend_bundle(root)
    except SystemExit as error:
        return {
            "ok": False,
            "root": str(root),
            "language": catalog_language(),
            "paths": {},
            "checks": [{"name": "bundle_parse", "ok": False, "detail": str(error)}],
            "failures": 1,
        }


def cmd_plan(args: argparse.Namespace) -> int:
    registry = load_json(BACKENDS)
    intents = load_intents()
    selected = registry.get("selected_spike", "unknown")
    print("CTOS Voice Backend V2")
    print("=====================")
    print(f"selected spike  {selected}")
    print(f"docs            {DOC}")
    print(f"backend registry {BACKENDS}")
    print(f"intent catalog  {INTENTS}")
    print()
    print("Direction:")
    print("- keep Vosk push-to-talk V1 as fallback")
    print("- use Speech-to-Phrase-style fixed intents before open dictation")
    print("- use Home Assistant Assist/Wyoming as the mature voice ecosystem target")
    print("- add Piper-quality TTS after intent recognition is reliable")
    print("- keep mutable CTOS actions behind the approval queue")
    print()
    print("Safe intents:")
    for intent in intents.get("intents", []):
        if isinstance(intent, dict):
            phrases = intent.get("phrases", [])
            first = phrases[0] if isinstance(phrases, list) and phrases else "-"
            print(f"- {intent.get('id')} T{intent.get('tier')} -> {' '.join(intent.get('command', []))}  [{first}]")
    print()
    print("Next:")
    print("  ctos-voice-v2 status")
    print("  ctos-voice-v2 intents")
    print("  ctos-voice-v2 match agenda")
    print("  ctos-voice-v2 export-phrases --format jsonl")
    print("  ctos-voice-v2 export-backend --backend home-assistant --dir /tmp/ctos-voice-backend")
    print("  ctos-voice-v2 next-commands")
    return 0


def cmd_backends(args: argparse.Namespace) -> int:
    registry = load_json(BACKENDS)
    if args.json:
        print(json.dumps(registry, ensure_ascii=False, indent=2))
        return 0
    print("CTOS voice backends")
    print("===================")
    for backend in registry.get("backends", []):
        if not isinstance(backend, dict):
            continue
        print(f"{backend.get('id'):<24} {backend.get('role'):<22} {backend.get('status'):<10} {backend.get('label')}")
    return 0


def cmd_intents(args: argparse.Namespace) -> int:
    intents = load_intents()
    if args.json:
        print(json.dumps(intents, ensure_ascii=False, indent=2))
        return 0
    print("CTOS voice intents // fr")
    print("=======================")
    for intent in intents.get("intents", []):
        if not isinstance(intent, dict):
            continue
        print(f"{intent.get('id')}  T{intent.get('tier')}  command={' '.join(intent.get('command', []))}")
        for phrase in intent.get("phrases", []):
            print(f"  - {phrase}")
    return 0


def cmd_export_phrases(args: argparse.Namespace) -> int:
    entries = intent_entries()
    rows = phrase_rows()
    if args.format == "jsonl":
        for row in rows:
            print(json.dumps(row, ensure_ascii=False, sort_keys=True))
    elif args.format == "tsv":
        print("intent_id\ttier\tphrase\tnormalized\tcommand")
        for row in rows:
            print(f"{row['intent_id']}\t{row['tier']}\t{row['phrase']}\t{row['normalized']}\t{' '.join(row['command'])}")
    elif args.format == "yaml":
        print("# CTOS voice phrases; generic export, not a Home Assistant-ready config")
        print("intents:")
        for intent in entries:
            print(f"  - id: {intent.get('id')}")
            print(f"    tier: {intent.get('tier')}")
            print(f"    command: {' '.join(intent.get('command', []))}")
            print("    phrases:")
            for phrase in intent.get("phrases", []):
                if isinstance(phrase, str):
                    print(f"      - {phrase}")
    elif args.format in {"ha-sentences", "home-assistant", "speech-to-phrase"}:
        print(render_custom_sentences(entries), end="")
    elif args.format in {"ha-map", "intent-map"}:
        print(json.dumps(backend_intent_map(entries), ensure_ascii=False, indent=2, sort_keys=True))
    else:
        for row in rows:
            print(f"{row['intent_id']:<18} T{row['tier']}  {row['phrase']}")
    return 0


def cmd_export_backend(args: argparse.Namespace) -> int:
    entries = intent_entries()
    language = catalog_language()
    out_dir = Path(args.dir).expanduser()
    sentences = out_dir / "custom_sentences" / language / "ctos.yaml"
    intent_map = out_dir / "ctos_intent_map.json"
    readme = out_dir / "README.md"
    sentences.parent.mkdir(parents=True, exist_ok=True)
    out_dir.mkdir(parents=True, exist_ok=True)
    sentences.write_text(render_custom_sentences(entries), encoding="utf-8")
    intent_map.write_text(
        json.dumps(backend_intent_map(entries), ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    readme.write_text(render_backend_readme(args.backend, out_dir, sentences, intent_map), encoding="utf-8")
    print("CTOS voice backend export")
    print("=========================")
    print(f"backend   {args.backend}")
    print(f"root      {out_dir}")
    print(f"sentences {sentences}")
    print(f"map       {intent_map}")
    print(f"readme    {readme}")
    return 0


def cmd_validate_backend(args: argparse.Namespace) -> int:
    payload = validate_backend_bundle(Path(args.dir).expanduser())
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if payload["ok"] else 1
    print("CTOS voice backend bundle validation")
    print("====================================")
    print(f"root      {payload['root']}")
    print(f"language  {payload['language']}")
    print(f"status    {'ok' if payload['ok'] else 'failed'}")
    print()
    for check in payload["checks"]:
        marker = "ok" if check["ok"] else "FAIL"
        print(f"{marker:<5} {check['name']:<28} {check['detail']}")
    return 0 if payload["ok"] else 1


def cmd_backend_commands(args: argparse.Namespace) -> int:
    out_dir = Path(args.dir).expanduser()
    custom_dir = out_dir / "custom_sentences"
    venv = Path("/tmp/ctos-speech-to-phrase-smoke-venv")
    print("CTOS voice mature-backend handoff")
    print("=================================")
    print(f"backend {args.backend}")
    print()
    print("1. Generate and validate the inert bundle:")
    print(f"   ctos-voice-v2 export-backend --backend {args.backend} --dir {out_dir}")
    print(f"   ctos-voice-v2 validate-backend --dir {out_dir}")
    print(f"   ctos-voice-v2 backend-preflight --backend {args.backend} --dir {out_dir}")
    print()
    if args.backend == "speech-to-phrase":
        print("2. Speech-to-Phrase local smoke test, no daemon:")
        print(f"   python3 -m venv {venv}")
        print(f"   PIP_NO_CACHE_DIR=1 {venv}/bin/python -m pip install -U pip")
        print(f"   PIP_NO_CACHE_DIR=1 {venv}/bin/python -m pip install git+https://github.com/OHF-Voice/speech-to-phrase.git")
        print(f"   {venv}/bin/python -c \"import speech_to_phrase; print('speech_to_phrase import ok')\"")
        print(f"   {venv}/bin/python -m speech_to_phrase --help")
        print(f"   ctos-voice-v2 backend-preflight --backend speech-to-phrase --dir {out_dir} --runtime-python {venv}/bin/python")
        print()
        print("3. No-HA offline training preflight:")
        print(f"   {venv}/bin/python -m speech_to_phrase.train --help")
        print("   # Heavy/offline step; run only after model/tools cache is chosen:")
        print("   # {python} -m speech_to_phrase.train \\".format(python=f"{venv}/bin/python"))
        print("   #   --model fr_FR-rhasspy \\")
        print(f"   #   --sentences {out_dir / 'custom_sentences' / catalog_language() / 'ctos.yaml'} \\")
        print("   #   --train-dir /srv/ctos/cache/speech-to-phrase/train \\")
        print("   #   --tools-dir /srv/ctos/cache/speech-to-phrase/tools \\")
        print("   #   --models-dir /srv/ctos/models/speech-to-phrase")
        print()
        print("4. Official container handoff plan:")
        print("   ctos-voice-v2 stp-container-plan --target-probe")
        print()
        print("5. Speech-to-Phrase recognition handoff:")
        print(f"   custom sentences dir: {custom_dir}")
        print("   use the chosen upstream entry point/help, passing at minimum:")
        print(f"   --custom-sentences-dir {custom_dir}")
        print("   --hass-websocket-uri ws://127.0.0.1:8123/api/websocket")
        print("   --hass-token-file /run/user/$UID/ctos-ha-token")
        print("   --models-dir /srv/ctos/models/speech-to-phrase")
        print("   --train-dir /srv/ctos/cache/speech-to-phrase/train")
        print("   --tools-dir /srv/ctos/cache/speech-to-phrase/tools")
        print()
        print("   Do not paste tokens into shell history. Use a token file outside Git.")
        print("   Do not make it a daemon yet. First target is a local import/help test, then")
        print("   a temporary Home Assistant/Wyoming recognition test.")
    else:
        print("2. Home Assistant handoff:")
        print("   copy/sync the generated custom_sentences tree into a test Home Assistant config")
        print("   or mount it read-only into a Home Assistant test container.")
        print(f"   source tree: {custom_dir}")
        print()
        print("   Do not expose CTOS actions to Home Assistant automations yet.")
    print()
    print("6. CTOS boundary:")
    print("   backend intent names are labels only; use ctos_intent_map.json to route")
    print("   recognized intents through CTOS tiers and approvals.")
    return 0


def cmd_backend_preflight(args: argparse.Namespace) -> int:
    root = Path(args.dir).expanduser()
    custom_dir = root / "custom_sentences"
    runtime_python = str(Path(args.runtime_python).expanduser()) if args.runtime_python else sys.executable
    stp_train_dir = Path(args.stp_train_dir).expanduser()
    stp_tools_dir = Path(args.stp_tools_dir).expanduser()
    stp_models_dir = Path(args.stp_models_dir).expanduser()
    bundle = bundle_or_error(root)
    tools = command_status([
        "python3",
        "git",
        "curl",
        "ffmpeg",
        "ssh",
        "docker",
        "podman",
        "ctos-voice",
        "ctos-ai",
    ])
    modules = {
        "speech_to_phrase": python_module_status("speech_to_phrase", runtime_python),
        "wyoming": python_module_status("wyoming", runtime_python),
        "hassil": python_module_status("hassil", runtime_python),
    }
    parse_check = hassil_parse_status(runtime_python, Path(bundle["paths"].get("sentences", ""))) if bundle["ok"] else {
        "ok": False,
        "sentences": str(root / "custom_sentences" / catalog_language() / "ctos.yaml"),
        "detail": "bundle invalid",
    }
    stp_help = speech_to_phrase_help_status(runtime_python) if modules["speech_to_phrase"]["importable"] else {
        "ok": False,
        "detail": "speech_to_phrase not importable",
    }
    stp_training = speech_to_phrase_training_status(
        runtime_python,
        args.stp_model,
        stp_train_dir,
        stp_tools_dir,
        stp_models_dir,
    ) if modules["speech_to_phrase"]["importable"] else {
        "ready": False,
        "model_id": args.stp_model,
        "train_dir": str(stp_train_dir),
        "tools_dir": str(stp_tools_dir),
        "models_dir": str(stp_models_dir),
        "detail": "speech_to_phrase not importable",
    }
    token_file = Path(args.hass_token_file).expanduser() if args.hass_token_file else None
    hass = {
        "websocket_uri_set": bool(args.hass_websocket_uri),
        "token_file": str(token_file) if token_file else None,
        "token_file_exists": bool(token_file and token_file.is_file()),
    }
    hass["ready"] = bool(hass["websocket_uri_set"] and hass["token_file_exists"])
    backend_runtime_ready = (
        modules["speech_to_phrase"]["importable"]
        and modules["wyoming"]["importable"]
        and modules["hassil"]["importable"]
        and stp_help["ok"]
        and parse_check["ok"]
    ) if args.backend == "speech-to-phrase" else True
    blockers: list[str] = []
    if not bundle["ok"]:
        blockers.append("exported backend bundle is missing or invalid")
    if args.backend == "speech-to-phrase" and not modules["speech_to_phrase"]["importable"]:
        blockers.append("speech_to_phrase Python module is not installed/importable")
    if args.backend == "speech-to-phrase" and not modules["wyoming"]["importable"]:
        blockers.append("wyoming Python module is not installed/importable")
    if args.backend == "speech-to-phrase" and not modules["hassil"]["importable"]:
        blockers.append("hassil Python module is not installed/importable")
    if args.backend == "speech-to-phrase" and modules["speech_to_phrase"]["importable"] and not stp_help["ok"]:
        blockers.append("speech_to_phrase module help command failed")
    if args.backend == "speech-to-phrase" and not parse_check["ok"]:
        blockers.append("custom sentences failed hassil parsing in the selected runtime")
    if args.backend == "speech-to-phrase" and not stp_training.get("ready"):
        blockers.append("offline Speech-to-Phrase training needs a model/tools cache")
    if args.backend == "speech-to-phrase" and not hass["ready"]:
        blockers.append("full recognition test needs a Home Assistant websocket URI and token file")
    recognition_context_ready = (
        bool(stp_training.get("ready")) if args.backend == "speech-to-phrase" else True
    )
    readiness = {
        "bundle_ready": bool(bundle["ok"]),
        "local_smoke_possible": bool(tools["python3"]),
        "backend_runtime_ready": bool(backend_runtime_ready),
        "offline_training_context_ready": recognition_context_ready,
        "home_assistant_context_ready": bool(hass["ready"]),
        "full_recognition_ready": bool(
            bundle["ok"] and backend_runtime_ready and recognition_context_ready and hass["ready"]
        ),
        "blockers": blockers,
    }
    payload: dict[str, Any] = {
        "backend": args.backend,
        "root": str(root),
        "custom_sentences_dir": str(custom_dir),
        "runtime_python": runtime_python,
        "bundle": bundle,
        "tools": tools,
        "python_modules": modules,
        "speech_to_phrase_help": stp_help,
        "custom_sentences_parse": parse_check,
        "speech_to_phrase_training": stp_training,
        "home_assistant": hass,
        "readiness": readiness,
        "target_probe": None,
    }
    if args.target_probe:
        payload["target_probe"] = backend_target_probe(args.user, args.host)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if bundle["ok"] else 1

    print("CTOS voice backend preflight")
    print("============================")
    print(f"backend    {args.backend}")
    print(f"root       {root}")
    print(f"python     {runtime_python}")
    print(f"sentences  {custom_dir}")
    print()
    print(f"bundle     {'ok' if bundle['ok'] else 'failed'}")
    for check in bundle["checks"]:
        marker = "ok" if check["ok"] else "FAIL"
        print(f"  {marker:<5} {check['name']:<28} {check['detail']}")
    print()
    print("local tools:")
    for name, path in tools.items():
        print(f"  {name:<10} {path or '-'}")
    print("python modules:")
    for name, status in modules.items():
        print(f"  {name:<18} {'ok' if status['importable'] else '-'}")
    print("backend parse/help:")
    print(f"  hassil custom yaml {'ok' if parse_check['ok'] else '-'}")
    if parse_check.get("intent_names"):
        print(f"  intents           {', '.join(parse_check['intent_names'])}")
    print(f"  speech_to_phrase help {'ok' if stp_help['ok'] else '-'}")
    print("offline training:")
    print(f"  model             {stp_training.get('model_id', args.stp_model)}")
    model = stp_training.get("model", {}) if isinstance(stp_training.get("model"), dict) else {}
    if model.get("language"):
        print(f"  language          {model.get('language')}")
    print(f"  train helper      {'ok' if stp_training.get('train_help', {}).get('ok') else '-'}")
    print(f"  tools cache       {'ok' if stp_training.get('tools', {}).get('ready') else '-'}")
    print(f"  model cache       {'ok' if stp_training.get('model_assets', {}).get('ready') else '-'}")
    print()
    print("readiness:")
    for key in (
        "bundle_ready",
        "local_smoke_possible",
        "backend_runtime_ready",
        "offline_training_context_ready",
        "home_assistant_context_ready",
        "full_recognition_ready",
    ):
        print(f"  {key:<30} {readiness[key]}")
    if blockers:
        print("blockers:")
        for blocker in blockers:
            print(f"  - {blocker}")
    if args.target_probe:
        target = payload["target_probe"] or {}
        print()
        print(f"target probe rc={target.get('rc')}")
        if target.get("stdout"):
            print(target["stdout"])
        if target.get("stderr"):
            print(target["stderr"], file=sys.stderr)
    print()
    print("next:")
    print(f"  ctos-voice-v2 backend-commands --backend {args.backend} --dir {root}")
    print("  keep tokens in a file outside Git; do not paste them into commands.")
    return 0 if bundle["ok"] else 1


def cmd_stp_cache(args: argparse.Namespace) -> int:
    runtime_python = str(Path(args.runtime_python).expanduser()) if args.runtime_python else sys.executable
    train_dir = Path(args.train_dir).expanduser()
    tools_dir = Path(args.tools_dir).expanduser()
    models_dir = Path(args.models_dir).expanduser()
    status = speech_to_phrase_training_status(
        runtime_python,
        args.model,
        train_dir,
        tools_dir,
        models_dir,
    )
    required_paths = stp_cache_required_paths(args.model, tools_dir, models_dir)
    remote_probe = remote_path_probe(args.user, args.host, required_paths) if args.target_probe else None
    payload = {
        "model": args.model,
        "runtime_python": runtime_python,
        "recommended_owner": "ctos-core",
        "train_dir": str(train_dir),
        "tools_dir": str(tools_dir),
        "models_dir": str(models_dir),
        "status": status,
        "required_paths": {name: str(path) for name, path in required_paths.items()},
        "target_probe": remote_probe,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if status["ready"] else 1

    model = status.get("model", {}) if isinstance(status.get("model"), dict) else {}
    print("CTOS Speech-to-Phrase cache")
    print("===========================")
    print(f"model       {args.model}")
    if model.get("language"):
        print(f"language    {model.get('language')}")
    if model.get("download_url"):
        print(f"model URL   {model.get('download_url')}")
    print(f"runtime     {runtime_python}")
    print("owner       ctos-core recommended")
    print(f"train-dir   {train_dir}")
    print(f"tools-dir   {tools_dir}")
    print(f"models-dir  {models_dir}")
    print()
    print("readiness:")
    print(f"  train helper  {'ok' if status.get('train_help', {}).get('ok') else '-'}")
    print(f"  model id      {'ok' if model.get('ok') else '-'}")
    print(f"  tools cache   {'ok' if status.get('tools', {}).get('ready') else '-'}")
    print(f"  model cache   {'ok' if status.get('model_assets', {}).get('ready') else '-'}")
    print(f"  ready         {status['ready']}")
    print()
    print("missing local paths:")
    for group_name in ("model_assets", "tools"):
        group = status.get(group_name, {})
        items = group.get("items", {}) if isinstance(group, dict) else {}
        for name, item in items.items():
            if isinstance(item, dict) and not item.get("exists"):
                print(f"  {name:<24} {item.get('path')}")
    if remote_probe is not None:
        print()
        print(f"target probe {args.user}@{args.host} rc={remote_probe.get('rc')}")
        if remote_probe.get("stdout"):
            print(remote_probe["stdout"])
        if remote_probe.get("stderr"):
            print(remote_probe["stderr"], file=sys.stderr)
    print()
    print("next commands:")
    print("  ctos-voice-v2 backend-commands --backend speech-to-phrase --dir /tmp/ctos-voice-backend")
    print("  # After cache/tooling decision, run the commented speech_to_phrase.train command there.")
    print()
    print("notes:")
    print("  - The standalone trainer does not need a Home Assistant token.")
    print("  - It does need the French Rhasspy model and speech tools cache.")
    print("  - Keep generated recordings/transcripts and tokens outside Git.")
    return 0 if status["ready"] else 1


def cmd_hass_context_plan(args: argparse.Namespace) -> int:
    runtime = args.container_runtime
    if runtime == "auto":
        runtime = "podman"
    config_dir = Path(args.config_dir).expanduser()
    token_file = args.hass_token_file
    run_cmd = [
        runtime,
        "run",
        "--rm",
        "--name",
        "ctos-ha-test",
        "-e",
        f"TZ={args.timezone}",
        "-v",
        f"{config_dir}:/config",
        "-p",
        f"127.0.0.1:{args.port}:8123",
        args.image,
    ]
    tunnel_cmd = [
        "ssh",
        "-F",
        "/dev/null",
        "-N",
        "-L",
        f"127.0.0.1:{args.port}:127.0.0.1:{args.port}",
        f"{args.user}@{args.host}",
    ]
    prepare_command = (
        f"ssh -F /dev/null {shlex.quote(f'{args.user}@{args.host}')} "
        f"{shlex.quote(f'mkdir -p {shlex.quote(str(config_dir))}')}"
    )
    token_edit_remote = (
        f"install -m 600 /dev/null /run/user/$(id -u)/{Path(token_file).name} "
        f"&& ${{EDITOR:-nano}} /run/user/$(id -u)/{Path(token_file).name}"
    )
    token_edit_command = (
        f"ssh -tt -F /dev/null {shlex.quote(f'{args.user}@{args.host}')} "
        f"{shlex.quote(token_edit_remote)}"
    )
    speech_plan_command = (
        "ctos-voice-v2 stp-container-plan "
        f"--hass-websocket-uri ws://127.0.0.1:{args.port}/api/websocket "
        f"--hass-token-file {shlex.quote(token_file)}"
    )
    target_prepare = hass_context_target_prepare(args.user, args.host, config_dir) if args.target_prepare else None
    target_probe = hass_context_target_probe(
        args.user,
        args.host,
        runtime,
        args.image,
        config_dir,
        args.port,
    ) if args.target_probe or args.target_prepare else None
    payload = {
        "host": args.host,
        "user": args.user,
        "image": args.image,
        "container_runtime": runtime,
        "config_dir": str(config_dir),
        "port": args.port,
        "timezone": args.timezone,
        "hass_websocket_uri": f"ws://127.0.0.1:{args.port}/api/websocket",
        "hass_token_file": token_file,
        "prepare_command": prepare_command,
        "run_command_on_core": shlex.join(run_cmd),
        "tunnel_command_on_t480": shlex.join(tunnel_cmd),
        "ui_url_on_t480": f"http://127.0.0.1:{args.port}",
        "token_edit_command": token_edit_command,
        "speech_to_phrase_plan_command": speech_plan_command,
        "target_prepare": target_prepare,
        "target_probe": target_probe,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if not target_prepare or target_prepare["rc"] == 0 else 1

    print("CTOS temporary Home Assistant context plan")
    print("==========================================")
    print("purpose     temporary HA websocket/token context for Speech-to-Phrase")
    print(f"image       {args.image}")
    print(f"runtime     {runtime}  (rootless/non-persistent preferred)")
    print(f"config      {config_dir}")
    print(f"bind        127.0.0.1:{args.port}:8123")
    print(f"websocket   ws://127.0.0.1:{args.port}/api/websocket")
    print(f"token file  {token_file}")
    print()
    print("why this shape:")
    print("  - Home Assistant provides the websocket/token surface Speech-to-Phrase expects.")
    print("  - This is not a Home Assistant OS/Supervisor install and creates no systemd unit.")
    print("  - Binding to 127.0.0.1 keeps the UI/API off the LAN; use the SSH tunnel from T480.")
    print("  - No privileged/dbus/device mounts are added for the first no-device recognition test.")
    print()
    print("prepare config dir on ctos-core:")
    print(f"  {prepare_command}")
    print()
    print("start temporary Home Assistant on ctos-core:")
    print(f"  {shlex.join(run_cmd)}")
    print()
    print("from T480, tunnel the UI/API:")
    print(f"  {shlex.join(tunnel_cmd)}")
    print(f"  open {payload['ui_url_on_t480']}")
    print()
    print("manual onboarding/token:")
    print("  1. Complete the local Home Assistant onboarding in the tunneled browser.")
    print("  2. Create a long-lived access token from the local HA user profile/security page.")
    print("  3. Write only the token value into the remote token file, outside Git and shell history:")
    print(f"     {token_edit_command}")
    print()
    print("then generate the Speech-to-Phrase run command:")
    print(f"  {speech_plan_command}")
    print()
    print("stop condition:")
    print("  keep this as a temporary manual test until one recognition loop passes.")
    if target_prepare is not None:
        print()
        print(f"target prepare {args.user}@{args.host} rc={target_prepare.get('rc')}")
        if target_prepare.get("stdout"):
            print(target_prepare["stdout"])
        if target_prepare.get("stderr"):
            print(target_prepare["stderr"], file=sys.stderr)
    if target_probe is not None:
        print()
        print(f"target probe {args.user}@{args.host} rc={target_probe.get('rc')}")
        if target_probe.get("stdout"):
            print(target_probe["stdout"])
        if target_probe.get("stderr"):
            print(target_probe["stderr"], file=sys.stderr)
    return 0 if not target_prepare or target_prepare["rc"] == 0 else 1


def cmd_hass_context(args: argparse.Namespace) -> int:
    runtime = args.container_runtime
    if runtime == "auto":
        runtime = "podman"
    config_dir = Path(args.config_dir).expanduser()
    tunnel_command = shlex.join([
        "ssh",
        "-F",
        "/dev/null",
        "-N",
        "-L",
        f"127.0.0.1:{args.port}:127.0.0.1:{args.port}",
        f"{args.user}@{args.host}",
    ])
    speech_plan_command = (
        "ctos-voice-v2 stp-container-plan "
        f"--hass-websocket-uri ws://127.0.0.1:{args.port}/api/websocket "
        f"--hass-token-file {shlex.quote(args.hass_token_file)}"
    )
    token_template = shlex.quote(args.hass_token_file)
    token_edit_remote = (
        f"CTOS_HA_TOKEN_TEMPLATE={token_template}; "
        "CTOS_HA_TOKEN_FILE=${CTOS_HA_TOKEN_TEMPLATE/\\$UID/$(id -u)}; "
        "install -m 600 /dev/null \"$CTOS_HA_TOKEN_FILE\"; "
        "${EDITOR:-nano} \"$CTOS_HA_TOKEN_FILE\""
    )
    token_edit_command = (
        f"ssh -tt -F /dev/null {shlex.quote(f'{args.user}@{args.host}')} "
        f"{shlex.quote(token_edit_remote)}"
    )
    if args.action == "tunnel-command":
        result = {
            "rc": 0,
            "stdout": "\n".join([
                tunnel_command,
                f"open http://127.0.0.1:{args.port}",
            ]),
            "stderr": "",
        }
    elif args.action == "token-command":
        result = {
            "rc": 0,
            "stdout": "\n".join([
                token_edit_command,
                "paste only the Home Assistant long-lived token, then save and close the editor",
            ]),
            "stderr": "",
        }
    elif args.action == "token-save":
        if args.token_stdin:
            token = sys.stdin.read().strip()
        else:
            token = getpass.getpass("Home Assistant long-lived token: ").strip()
        if not token:
            result = {"rc": 2, "stdout": "", "stderr": "empty token; nothing saved"}
        elif any(char.isspace() for char in token):
            result = {"rc": 2, "stdout": "", "stderr": "token contains whitespace; paste only the token value"}
        else:
            result = remote_hass_token_save(
                args.user,
                args.host,
                args.hass_token_file,
                token,
            )
    elif args.action in {"tunnel-status", "tunnel-start"}:
        result = local_hass_tunnel_action(args.user, args.host, args.port, args.action)
    elif args.action == "onboarding-status":
        result = local_hass_onboarding_action(args.port)
    elif args.action == "onboard-api":
        if not args.json:
            print("CTOS Home Assistant API onboarding")
            print("==================================")
            print("This will create the first temporary Home Assistant user,")
            print("create a long-lived token through the local websocket API,")
            print("and store only the token file on ctos-core.")
            print()
        name = args.ha_name or input("HA display name [CTOS Operator]: ").strip() or "CTOS Operator"
        username = args.ha_username or input("HA username [ctos]: ").strip() or "ctos"
        password = getpass.getpass("HA password: ")
        password_confirm = getpass.getpass("Confirm HA password: ")
        if not password:
            result = {"rc": 2, "stdout": "", "stderr": "empty password; onboarding not attempted"}
        elif password != password_confirm:
            result = {"rc": 2, "stdout": "", "stderr": "password confirmation mismatch; onboarding not attempted"}
        else:
            onboard = hass_onboard_via_api(
                args.ha_url,
                name,
                username,
                password,
                args.language,
                args.client_id or f"{args.ha_url.rstrip('/')}/",
                args.token_client_name,
                args.token_lifespan_days,
            )
            steps = [
                f"{item.get('step')} ok={item.get('ok')} status={item.get('status', '-')}"
                for item in onboard.get("steps", [])
            ]
            if onboard.get("ok") and isinstance(onboard.get("token"), str):
                save = remote_hass_token_save(
                    args.user,
                    args.host,
                    args.hass_token_file,
                    onboard["token"],
                )
                result = {
                    "rc": save["rc"],
                    "stdout": "\n".join([
                        "ONBOARDING",
                        *steps,
                        "TOKEN_SAVE",
                        save["stdout"],
                        "NEXT",
                        "ctos-voice-v2 hass-context readiness",
                    ]).strip(),
                    "stderr": save["stderr"],
                }
            else:
                result = {
                    "rc": 1,
                    "stdout": "\n".join(["ONBOARDING", *steps]).strip(),
                    "stderr": str(onboard.get("error", "onboarding failed")),
                }
    elif args.action == "token-status":
        result = remote_hass_token_probe(
            args.user,
            args.host,
            args.hass_token_file,
            args.port,
        )
        if result["rc"] == 0 and hass_token_state(result["stdout"]) != "ready":
            result = {**result, "rc": 1}
    elif args.action == "readiness":
        status_result = remote_hass_context_action(
            args.user,
            args.host,
            runtime,
            "status",
            args.image,
            config_dir,
            args.port,
            args.timezone,
            args.container_name,
            args.logs_tail,
        )
        token_result = remote_hass_token_probe(
            args.user,
            args.host,
            args.hass_token_file,
            args.port,
        )
        token_ready = hass_token_state(token_result["stdout"]) == "ready"
        next_lines = [
            "NEXT",
            speech_plan_command if token_ready else "complete onboarding, create the token file, then re-run readiness",
        ]
        result = {
            "rc": 0 if status_result["rc"] == 0 and token_result["rc"] == 0 and token_ready else 1,
            "stdout": "\n".join([
                "HASS_STATUS",
                status_result["stdout"].strip(),
                "HASS_TOKEN",
                token_result["stdout"].strip(),
                *next_lines,
            ]).strip() + "\n",
            "stderr": "\n".join(
                part for part in (status_result["stderr"].strip(), token_result["stderr"].strip()) if part
            ),
        }
    else:
        result = remote_hass_context_action(
            args.user,
            args.host,
            runtime,
            args.action,
            args.image,
            config_dir,
            args.port,
            args.timezone,
            args.container_name,
            args.logs_tail,
        )
    payload = {
        "action": args.action,
        "host": args.host,
        "user": args.user,
        "image": args.image,
        "container_runtime": runtime,
        "container_name": args.container_name,
        "config_dir": str(config_dir),
        "port": args.port,
        "timezone": args.timezone,
        "ui_url_on_t480": f"http://127.0.0.1:{args.port}",
        "tunnel_command_on_t480": tunnel_command,
        "hass_token_file": args.hass_token_file,
        "token_edit_command": token_edit_command,
        "speech_to_phrase_plan_command": speech_plan_command,
        "rc": result["rc"],
        "stdout": result["stdout"],
        "stderr": result["stderr"],
        "ok": result["rc"] == 0,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if payload["ok"] else 1

    print("CTOS temporary Home Assistant context")
    print("=====================================")
    print(f"action      {args.action}")
    print(f"target      {args.user}@{args.host}")
    print(f"runtime     {runtime}")
    print(f"container   {args.container_name}")
    print(f"image       {args.image}")
    print(f"config      {config_dir}")
    print(f"bind        127.0.0.1:{args.port}:8123")
    print(f"status      {'ok' if payload['ok'] else 'failed'} rc={result['rc']}")
    print()
    if result["stdout"]:
        print(result["stdout"])
    if result["stderr"]:
        print(result["stderr"], file=sys.stderr)
    if args.action == "start" and payload["ok"]:
        print()
        print("from T480, tunnel the UI/API:")
        print(f"  {payload['tunnel_command_on_t480']}")
        print(f"  open {payload['ui_url_on_t480']}")
        print()
        print("next:")
        print("  complete local onboarding, create a long-lived token,")
        print("  write it to /run/user/$UID/ctos-ha-token outside Git/history,")
        print("  then run the Speech-to-Phrase container plan.")
    return 0 if payload["ok"] else 1


def cmd_stp_container_plan(args: argparse.Namespace) -> int:
    backend_dir = Path(args.backend_dir).expanduser()
    custom_dir = backend_dir / "custom_sentences"
    train_dir = Path(args.train_dir).expanduser()
    models_dir = Path(args.models_dir).expanduser()
    token_file = args.hass_token_file
    runtime = args.container_runtime
    if runtime == "auto":
        runtime = "podman"
    paths = {
        "backend_dir": backend_dir,
        "custom_sentences": custom_dir,
        "train_dir": train_dir,
        "models_dir": models_dir,
    }
    target_probe = stp_container_target_probe(args.user, args.host, paths) if args.target_probe else None

    help_cmd = [
        runtime,
        "run",
        "--rm",
        args.image,
        "--help",
    ]
    run_base_cmd = [
        runtime,
        "run",
        "--rm",
        "--name",
        "ctos-speech-to-phrase",
        "--network",
        "host",
        "-v",
        f"{custom_dir}:/custom_sentences:ro",
        "-v",
        f"{train_dir}:/train",
        "-v",
        f"{models_dir}:/models",
    ]
    run_backend_args = [
        "--uri",
        f"tcp://127.0.0.1:{args.port}",
        "--custom-sentences-dir",
        "/custom_sentences",
        "--train-dir",
        "/train",
        "--models-dir",
        "/models",
        "--hass-websocket-uri",
        args.hass_websocket_uri,
    ]
    token_file_command = (
        f"CTOS_HA_TOKEN_TEMPLATE={shlex.quote(token_file)}; "
        "CTOS_HA_TOKEN_FILE=${CTOS_HA_TOKEN_TEMPLATE/\\$UID/$(id -u)}"
    )
    container_entrypoint = stp_container_entrypoint()
    run_command = " ".join([
        shlex.join(run_base_cmd),
        '-v "${CTOS_HA_TOKEN_FILE}:/run/secrets/ctos-ha-token:ro"',
        "--entrypoint",
        "bash",
        shlex.quote(args.image),
        "-lc",
        shlex.quote(container_entrypoint),
        "ctos-speech-to-phrase",
        shlex.join(run_backend_args),
    ])
    payload = {
        "image": args.image,
        "model": args.model,
        "container_runtime": runtime,
        "port": args.port,
        "backend_dir": str(backend_dir),
        "custom_sentences_dir": str(custom_dir),
        "train_dir": str(train_dir),
        "models_dir": str(models_dir),
        "hass_websocket_uri": args.hass_websocket_uri,
        "hass_token_file": token_file,
        "help_command": shlex.join(help_cmd),
        "token_file_command": token_file_command,
        "token_mount_path": "/run/secrets/ctos-ha-token",
        "run_command": run_command,
        "target_probe": target_probe,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0

    print("CTOS Speech-to-Phrase container plan")
    print("====================================")
    print("purpose     official Wyoming/Speech-to-Phrase backend, no local Kaldi build first")
    print(f"image       {args.image}")
    print(f"runtime     {runtime}  (podman preferred; docker acceptable if already chosen)")
    print(f"model       {args.model}")
    print("model note  live service derives language from Home Assistant; explicit model is for offline cache checks")
    print(f"uri         tcp://127.0.0.1:{args.port}")
    print(f"backend     {backend_dir}")
    print(f"sentences   {custom_dir}")
    print(f"train       {train_dir}")
    print(f"models      {models_dir}")
    print("tools      image-internal /usr/src/tools")
    print()
    print("why container first:")
    print("  - the Python package can run/import locally, but its no-HA trainer expects")
    print("    Kaldi/OpenFST/OpenGRM/Phonetisaurus tool paths to already exist.")
    print("  - the official Wyoming container is the smaller first live-backend test.")
    print("  - CTOS still owns intent mapping, approvals, and action routing.")
    print()
    print("prepare bundle on T480:")
    print("  ctos-voice-v2 export-backend --backend speech-to-phrase --dir /tmp/ctos-voice-backend")
    print("  ctos-voice-v2 validate-backend --dir /tmp/ctos-voice-backend")
    print()
    print("sync bundle to ctos-core:")
    print(f"  ssh -F /dev/null {args.user}@{args.host} 'mkdir -p {backend_dir}'")
    print(f"  tar -C /tmp/ctos-voice-backend -cf - . | ssh -F /dev/null {args.user}@{args.host} 'tar -C {backend_dir} -xf -'")
    print()
    print("on ctos-core, inspect the container before any service:")
    print(f"  {shlex.join(help_cmd)}")
    print()
    print("before the live container, verify the HA/token gate from T480:")
    print("  ctos-voice-v2 hass-context readiness")
    print()
    print("temporary live command, localhost-only on ctos-core:")
    print(f"  {token_file_command}")
    print(f"  {run_command}")
    print()
    print("token rule:")
    print(f"  write the Home Assistant token to {token_file}, chmod 600 it, and never paste it into shell history.")
    print("  the container receives the token through a read-only file mount, not a host shell token argument.")
    print()
    print("access from T480, if the backend runs on ctos-core:")
    print(f"  ssh -F /dev/null -N -L 127.0.0.1:{args.port}:127.0.0.1:{args.port} {args.user}@{args.host}")
    print()
    print("stop condition:")
    print("  do not create a persistent systemd service until the container --help and")
    print("  one manual recognition loop have been verified.")
    if target_probe is not None:
        print()
        print(f"target probe {args.user}@{args.host} rc={target_probe.get('rc')}")
        if target_probe.get("stdout"):
            print(target_probe["stdout"])
        if target_probe.get("stderr"):
            print(target_probe["stderr"], file=sys.stderr)
    return 0


def cmd_stp_container(args: argparse.Namespace) -> int:
    runtime = args.container_runtime
    if runtime == "auto":
        runtime = "podman"
    backend_dir = Path(args.backend_dir).expanduser()
    train_dir = Path(args.train_dir).expanduser()
    models_dir = Path(args.models_dir).expanduser()
    gate_result = None
    if args.action == "start":
        gate_result = remote_hass_token_probe(
            args.user,
            args.host,
            args.hass_token_file,
            args.hass_port,
        )
        gate_state = hass_token_state(gate_result["stdout"])
        if gate_result["rc"] != 0 or gate_state != "ready":
            result = {
                "rc": 1,
                "stdout": "\n".join([
                    "HASS_TOKEN_GATE",
                    gate_result["stdout"].strip(),
                    "START",
                    "blocked_before_container_start",
                    "next=run ctos-voice-v2 hass-context readiness",
                ]).strip() + "\n",
                "stderr": gate_result["stderr"],
            }
        else:
            result = remote_stp_container_action(
                args.user,
                args.host,
                runtime,
                args.action,
                args.image,
                backend_dir,
                train_dir,
                models_dir,
                args.port,
                args.hass_websocket_uri,
                args.hass_token_file,
                args.container_name,
                args.logs_tail,
            )
    else:
        result = remote_stp_container_action(
            args.user,
            args.host,
            runtime,
            args.action,
            args.image,
            backend_dir,
            train_dir,
            models_dir,
            args.port,
            args.hass_websocket_uri,
            args.hass_token_file,
            args.container_name,
            args.logs_tail,
        )
    payload = {
        "action": args.action,
        "host": args.host,
        "user": args.user,
        "image": args.image,
        "container_runtime": runtime,
        "container_name": args.container_name,
        "port": args.port,
        "backend_dir": str(backend_dir),
        "train_dir": str(train_dir),
        "models_dir": str(models_dir),
        "hass_websocket_uri": args.hass_websocket_uri,
        "hass_token_file": args.hass_token_file,
        "hass_gate_state": hass_token_state(gate_result["stdout"]) if gate_result else None,
        "tunnel_command_on_t480": shlex.join([
            "ssh",
            "-F",
            "/dev/null",
            "-N",
            "-L",
            f"127.0.0.1:{args.port}:127.0.0.1:{args.port}",
            f"{args.user}@{args.host}",
        ]),
        "rc": result["rc"],
        "stdout": result["stdout"],
        "stderr": result["stderr"],
        "ok": result["rc"] == 0,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if payload["ok"] else 1

    print("CTOS Speech-to-Phrase container")
    print("===============================")
    print(f"action      {args.action}")
    print(f"target      {args.user}@{args.host}")
    print(f"runtime     {runtime}")
    print(f"container   {args.container_name}")
    print(f"image       {args.image}")
    print(f"uri         tcp://127.0.0.1:{args.port}")
    print(f"status      {'ok' if payload['ok'] else 'failed'} rc={result['rc']}")
    print()
    if result["stdout"]:
        print(result["stdout"])
    if result["stderr"]:
        print(result["stderr"], file=sys.stderr)
    if args.action == "start" and payload["ok"]:
        print()
        print("from T480, tunnel the Wyoming backend if needed:")
        print(f"  {payload['tunnel_command_on_t480']}")
    return 0 if payload["ok"] else 1


def cmd_stp_container_inspect(args: argparse.Namespace) -> int:
    runtime = args.container_runtime
    if runtime == "auto":
        runtime = "podman"
    result = remote_stp_container_inspect(
        args.user,
        args.host,
        runtime,
        args.image,
        args.pull_policy,
    )
    payload = {
        "host": args.host,
        "user": args.user,
        "image": args.image,
        "container_runtime": runtime,
        "pull_policy": args.pull_policy,
        "rc": result["rc"],
        "stdout": result["stdout"],
        "stderr": result["stderr"],
        "ok": result["rc"] == 0,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if payload["ok"] else 1

    print("CTOS Speech-to-Phrase container inspect")
    print("=======================================")
    print(f"target      {args.user}@{args.host}")
    print(f"runtime     {runtime}")
    print(f"image       {args.image}")
    print(f"pull        {args.pull_policy}")
    print(f"status      {'ok' if payload['ok'] else 'failed'} rc={result['rc']}")
    print()
    if result["stdout"]:
        print(result["stdout"])
    if result["stderr"]:
        print(result["stderr"], file=sys.stderr)
    print()
    if payload["ok"]:
        print("next:")
        print("  choose a temporary Home Assistant websocket/token-file context")
        print("  then run one localhost-only manual recognition loop before any service")
    else:
        print("next:")
        print("  inspect stderr/stdout above; do not create a service until image help passes")
    return 0 if payload["ok"] else 1


def cmd_open_stt_plan(args: argparse.Namespace) -> int:
    model_dir = Path(args.model_dir).expanduser()
    cache_dir = Path(args.cache_dir).expanduser()
    backend_dir = Path(args.backend_dir).expanduser()
    paths = {
        "model_dir": model_dir,
        "cache_dir": cache_dir,
        "backend_dir": backend_dir,
    }
    local_tools = command_status(["python3", "ffmpeg", "arecord", "ssh", "podman", "docker"])
    target_prepare = remote_path_prepare(args.user, args.host, paths) if args.target_prepare else None
    target_probe = remote_path_probe(args.user, args.host, paths) if args.target_probe or args.target_prepare else None
    payload = {
        "engine": args.engine,
        "model": args.model,
        "role": "open_ended_transcription",
        "port": args.port,
        "target": f"{args.user}@{args.host}",
        "model_dir": str(model_dir),
        "cache_dir": str(cache_dir),
        "backend_dir": str(backend_dir),
        "local_tools": local_tools,
        "target_prepare": target_prepare,
        "target_probe": target_probe,
        "policy": {
            "speech_to_phrase": "deterministic Tier 0/1 command rail",
            "open_stt": "transcript/proposal rail only",
            "direct_voice_to_shell": False,
            "mutable_actions": "approval_required",
            "transcripts": "temporary_by_default",
        },
        "next_commands": [
            "ctos-voice-v2 open-stt-plan --target-probe",
            "ctos-voice-v2 open-stt-candidates",
            "choose one open STT backend candidate for a temporary push-to-talk test",
            "ctos-voice-v2 hass-context readiness",
            "ctos-voice-v2 stp-container start",
        ],
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0

    print("CTOS open-ended STT rail plan")
    print("=============================")
    print("purpose     natural French requests and dictation, not fixed command matching")
    print(f"engine      {args.engine}")
    print(f"model       {args.model}")
    print(f"target      {args.user}@{args.host}")
    print(f"wyoming     tcp://127.0.0.1:{args.port}  (future localhost-only test port)")
    print(f"models      {model_dir}")
    print(f"cache       {cache_dir}")
    print(f"backend     {backend_dir}")
    print()
    print("why this rail exists:")
    print("  - Speech-to-Phrase is excellent for exact, deterministic commands.")
    print("  - It is the wrong tool for natural requests like agenda planning.")
    print("  - Whisper-class STT can transcribe open-ended phrases; CTOS then decides intent.")
    print()
    print("boundary:")
    print("  - Open STT returns text only.")
    print("  - CTOS converts text into a proposed action.")
    print("  - Mutable actions still require approval.")
    print("  - No raw transcript is executed as shell.")
    print("  - Transcripts and recordings stay temporary unless explicitly archived.")
    print()
    print("local tool preflight:")
    for name, path in local_tools.items():
        print(f"  {name:<8} {path or '-'}")
    if target_probe is not None:
        if target_prepare is not None:
            print()
            print(f"target path prepare {args.user}@{args.host} rc={target_prepare.get('rc')}")
            if target_prepare.get("stdout"):
                print(target_prepare["stdout"])
            if target_prepare.get("stderr"):
                print(target_prepare["stderr"], file=sys.stderr)
        print()
        print(f"target path probe {args.user}@{args.host} rc={target_probe.get('rc')}")
        if target_probe.get("stdout"):
            print(target_probe["stdout"])
        if target_probe.get("stderr"):
            print(target_probe["stderr"], file=sys.stderr)
    print()
    print("recommended sequence:")
    print("  1. Probe the open STT placement on ctos-core.")
    print("  2. Choose one local backend candidate for a temporary push-to-talk test.")
    print("  3. Route its transcript through `ctos-ai` before any action runs.")
    print("  4. Return to Home Assistant/Speech-to-Phrase for the strict fixed-command rail.")
    print()
    print("not doing yet:")
    print("  - no model download")
    print("  - no persistent service")
    print("  - no always-on microphone")
    return 0 if target_prepare is None or target_prepare.get("rc") == 0 else 1


