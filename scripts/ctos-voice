def cmd_record_once(args: argparse.Namespace) -> int:
    out_path = Path(args.out).expanduser()
    rc, detail = record_audio(args.seconds, out_path)
    if args.json:
        print(json.dumps({"ok": rc == 0, "path": str(out_path), "detail": detail}, ensure_ascii=False, indent=2))
    elif rc == 0:
        print(f"recorded {out_path}")
    else:
        print(detail, file=sys.stderr)
    return rc


def cmd_transcribe_file(args: argparse.Namespace) -> int:
    rc, transcript = transcribe_wav(Path(args.file).expanduser())
    if args.json:
        print(json.dumps({"ok": rc == 0, "text": transcript}, ensure_ascii=False, indent=2))
    else:
        print(transcript)
    return rc


def cmd_setup_vosk(args: argparse.Namespace) -> int:
    commands = [
        "sudo pacman -S --needed python-vosk vosk-api",
        f"python3 -m venv {VOSK_VENV}",
        f"{VOSK_VENV}/bin/python -m pip install --upgrade pip",
        f"{VOSK_VENV}/bin/python -m pip install vosk",
        f"mkdir -p {STT_HOME}",
        f"curl -fL --retry 3 -o /tmp/{VOSK_MODEL_NAME}.zip {VOSK_MODEL_URL}",
        f"python3 -m zipfile -e /tmp/{VOSK_MODEL_NAME}.zip {STT_HOME}",
        f"rm -f /tmp/{VOSK_MODEL_NAME}.zip",
        "ctos-voice probe",
    ]
    if args.print_commands:
        if args.model_only:
            print("\n".join(commands[4:8] + [commands[-1]]))
        elif args.venv:
            print("\n".join(commands[1:]))
        else:
            print("\n".join([commands[0]] + commands[4:]))
        return 0
    if not args.yes:
        if args.model_only:
            print("This downloads the Vosk French small model outside the repo.")
        else:
            print("This installs Arch packages and downloads the Vosk French small model outside the repo.")
        print("Re-run with `ctos-voice setup-vosk --yes` or inspect with `--print-commands`.")
        return 2
    if args.venv and not module_available("vosk"):
        VOSK_VENV.parent.mkdir(parents=True, exist_ok=True)
        create = subprocess.run([sys.executable, "-m", "venv", str(VOSK_VENV)], check=False)
        if create.returncode != 0:
            return create.returncode
        venv_python = VOSK_VENV / "bin" / "python"
        upgrade = subprocess.run([str(venv_python), "-m", "pip", "install", "--upgrade", "pip"], check=False)
        if upgrade.returncode != 0:
            return upgrade.returncode
        install = subprocess.run([str(venv_python), "-m", "pip", "install", "vosk"], check=False)
        if install.returncode != 0:
            return install.returncode
        add_vosk_venv_to_path()
    if not args.model_only and not args.venv and not module_available("vosk"):
        if not shutil.which("sudo") or not shutil.which("pacman"):
            print("setup-vosk expects sudo and pacman on EndeavourOS/Arch when python-vosk is missing.", file=sys.stderr)
            return 3
        install = subprocess.run(["sudo", "pacman", "-S", "--needed", "python-vosk", "vosk-api"], check=False)
        if install.returncode != 0:
            return install.returncode
    if not vosk_model_ready():
        if not shutil.which("curl"):
            print("curl is required for the model download.", file=sys.stderr)
            return 3
        STT_HOME.mkdir(parents=True, exist_ok=True)
        zip_path = Path("/tmp") / f"{VOSK_MODEL_NAME}.zip"
        download = subprocess.run(["curl", "-fL", "--retry", "3", "-o", str(zip_path), VOSK_MODEL_URL], check=False)
        if download.returncode != 0:
            zip_path.unlink(missing_ok=True)
            return download.returncode
        try:
            with zipfile.ZipFile(zip_path) as archive:
                archive.extractall(STT_HOME)
        except zipfile.BadZipFile as exc:
            zip_path.unlink(missing_ok=True)
            print(f"invalid Vosk model zip: {exc}", file=sys.stderr)
            return 1
        finally:
            zip_path.unlink(missing_ok=True)
    payload = voice_probe()
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    if args.model_only:
        return 0 if payload["vosk"]["model_ready"] else 4  # type: ignore[index]
    return 0 if payload["voice_input_ready"] else 4


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="CTOS voice V1: typed chat, spoken replies, and Vosk push-to-talk")
    sub = parser.add_subparsers(dest="command", required=True)

    probe = sub.add_parser("probe", help="show local voice input/output capabilities")
    probe.add_argument("--json", action="store_true")
    probe.set_defaults(func=cmd_probe)

    say = sub.add_parser("say", help="speak text using the first available local TTS command")
    say.add_argument("text", nargs="+")
    say.add_argument("--engine", choices=["auto", "piper", "spd-say", "espeak-ng", "espeak"], default=os.environ.get("CTOS_VOICE_ENGINE", "auto"))
    say.add_argument("--no-speak", action="store_true")
    say.set_defaults(func=cmd_say)

    render_wav = sub.add_parser("render-wav", help="render Piper speech to a WAV file without playback")
    render_wav.add_argument("--engine", choices=["piper"], default="piper")
    render_wav.add_argument("--output", required=True)
    render_wav.add_argument("--stdin", action="store_true", help="read bounded speech text from stdin")
    render_wav.add_argument("text", nargs="*")
    render_wav.set_defaults(func=cmd_render_wav)

    tts_probe = sub.add_parser("tts-probe", help="show local TTS engine readiness")
    tts_probe.add_argument("--json", action="store_true")
    tts_probe.set_defaults(func=cmd_tts_probe)

    setup_piper = sub.add_parser("setup-piper", help="install Piper TTS in a local venv and download the default French voice")
    setup_piper.add_argument("--yes", action="store_true")
    setup_piper.add_argument("--print-commands", action="store_true")
    setup_piper.set_defaults(func=cmd_setup_piper)

    tts_test = sub.add_parser("tts-test", help="run a short local TTS A/B test")
    tts_test.add_argument("--engine", choices=["auto", "piper", "spd-say", "espeak-ng", "espeak"], default=os.environ.get("CTOS_VOICE_ENGINE", "auto"))
    tts_test.add_argument("--no-speak", action="store_true")
    tts_test.add_argument("text", nargs="*")
    tts_test.set_defaults(func=cmd_tts_test)

    ask = sub.add_parser("ask", help="ask CTOS Local and speak the response")
    ask.add_argument("prompt", nargs="+")
    ask.add_argument("--model", default="qwen2.5-coder:0.5b")
    ask.add_argument("--max-tokens", type=int, default=120)
    ask.add_argument("--no-speak", action="store_true")
    ask.set_defaults(func=cmd_ask)

    command = sub.add_parser("command", help="run a tiny read-only voice-command intent")
    command.add_argument("phrase", nargs="+")
    command.add_argument("--no-speak", action="store_true")
    command.set_defaults(func=cmd_command)

    route = sub.add_parser("route", help="route typed transcript text through the CTOS planner")
    route.add_argument("phrase", nargs="+")
    route.add_argument("--threshold", type=float, default=0.72)
    route.add_argument("--execute-safe", action="store_true", help="execute only safe Tier 0/1 ctos-ai commands")
    route.add_argument("--save-agenda", action="store_true", help="store a recognized agenda proposal without writing agenda state")
    route.add_argument("--json", action="store_true")
    route.add_argument("--no-speak", action="store_true")
    route.set_defaults(func=cmd_route)

    assistant = sub.add_parser("assistant", help="route typed transcript text, then fall back to bounded CTOS Local chat")
    assistant.add_argument("phrase", nargs="+")
    assistant.add_argument("--model", default="qwen2.5-coder:0.5b")
    assistant.add_argument("--max-tokens", type=int, default=180)
    assistant.add_argument("--threshold", type=float, default=0.72)
    assistant.add_argument("--no-actions", action="store_true", help="do not execute even safe CTOS command intents")
    assistant.add_argument("--save-agenda", action="store_true", help="store a recognized agenda proposal without writing agenda state")
    assistant.add_argument("--json", action="store_true")
    assistant.add_argument("--no-speak", action="store_true")
    assistant.set_defaults(func=cmd_assistant)

    chat = sub.add_parser("chat", help="typed local chat loop with spoken replies")
    chat.add_argument("prompt", nargs="*", help="optional one-shot prompt; omit for REPL")
    chat.add_argument("--model", default="qwen2.5-coder:0.5b")
    chat.add_argument("--max-tokens", type=int, default=180)
    chat.add_argument("--no-speak", action="store_true")
    chat.set_defaults(func=cmd_chat)

    listen_once = sub.add_parser("listen-once", help="record one phrase, transcribe it, and ask CTOS Local")
    listen_once.add_argument("--seconds", type=float, default=4.0)
    listen_once.add_argument("--model", default="qwen2.5-coder:0.5b")
    listen_once.add_argument("--max-tokens", type=int, default=160)
    listen_once.add_argument("--no-speak", action="store_true")
    listen_once.add_argument("--keep-wav", help="keep the recorded WAV at this path for debugging")
    listen_once.add_argument("--from-wav", help="debug: use an existing WAV instead of recording the microphone")
    listen_once.set_defaults(func=cmd_listen_once)

    voice_command = sub.add_parser("voice-command", help="push-to-talk read-only command intent")
    voice_command.add_argument("--seconds", type=float, default=3.0)
    voice_command.add_argument("--no-speak", action="store_true")
    voice_command.add_argument("--from-wav", help="debug: use an existing WAV instead of recording the microphone")
    voice_command.set_defaults(func=cmd_voice_command)

    route_once = sub.add_parser("route-once", help="push-to-talk transcript routing without direct mutation")
    route_once.add_argument("--seconds", type=float, default=4.0)
    route_once.add_argument("--threshold", type=float, default=0.72)
    route_once.add_argument("--execute-safe", action="store_true", help="execute only safe Tier 0/1 ctos-ai commands")
    route_once.add_argument("--save-agenda", action="store_true", help="store a recognized agenda proposal without writing agenda state")
    route_once.add_argument("--json", action="store_true")
    route_once.add_argument("--no-speak", action="store_true")
    route_once.add_argument("--from-wav", help="debug: use an existing WAV instead of recording the microphone")
    route_once.set_defaults(func=cmd_route_once)

    assistant_once = sub.add_parser("assistant-once", help="push-to-talk assistant: CTOS action first, bounded local chat fallback")
    assistant_once.add_argument("--seconds", type=float, default=4.0)
    assistant_once.add_argument("--model", default="qwen2.5-coder:0.5b")
    assistant_once.add_argument("--max-tokens", type=int, default=180)
    assistant_once.add_argument("--threshold", type=float, default=0.72)
    assistant_once.add_argument("--no-actions", action="store_true", help="do not execute even safe CTOS command intents")
    assistant_once.add_argument("--save-agenda", action="store_true", help="store a recognized agenda proposal without writing agenda state")
    assistant_once.add_argument("--json", action="store_true")
    assistant_once.add_argument("--no-speak", action="store_true")
    assistant_once.add_argument("--from-wav", help="debug: use an existing WAV instead of recording the microphone")
    assistant_once.set_defaults(func=cmd_assistant_once)

    record_once = sub.add_parser("record-once", help="record a short mono WAV sample")
    record_once.add_argument("--seconds", type=float, default=3.0)
    record_once.add_argument("--out", default="/tmp/ctos-voice-once.wav")
    record_once.add_argument("--json", action="store_true")
    record_once.set_defaults(func=cmd_record_once)

    transcribe_file = sub.add_parser("transcribe-file", help="transcribe a WAV file with the local Vosk model")
    transcribe_file.add_argument("file")
    transcribe_file.add_argument("--json", action="store_true")
    transcribe_file.set_defaults(func=cmd_transcribe_file)

    setup_vosk = sub.add_parser("setup-vosk", help="install python-vosk and download the small French Vosk model")
    setup_vosk.add_argument("--yes", action="store_true")
    setup_vosk.add_argument("--print-commands", action="store_true")
    setup_vosk.add_argument("--model-only", action="store_true", help="download/extract only the Vosk model; do not run pacman")
    setup_vosk.add_argument("--venv", action="store_true", help="install Python Vosk into a local user venv instead of pacman")
    setup_vosk.set_defaults(func=cmd_setup_vosk)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
