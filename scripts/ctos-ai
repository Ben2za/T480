    cheap_lane.set_defaults(func=cmd_cheap_lane)

    cheap_plan = sub.add_parser("cheap-plan", help="show the non-destructive cheap AI lane plan")
    cheap_plan.add_argument("--tool", choices=["all", "aider", "9router", "agent-reach"], default="all")
    cheap_plan.add_argument("--json", action="store_true")
    cheap_plan.set_defaults(func=cmd_cheap_plan)

    code_draft = sub.add_parser("code-draft", help="make a bounded cheap local draft without reading files")
    code_draft.add_argument("prompt", nargs="+", help="draft request, or '-' to read stdin")
    code_draft.add_argument("--kind", choices=["plan", "code", "research"], default="plan")
    code_draft.add_argument("--model", default="qwen2.5-coder:1.5b")
    code_draft.add_argument("--temperature", type=float, default=0.0)
    code_draft.add_argument("--max-tokens", type=int, default=384)
    code_draft.add_argument("--host", default=DEFAULT_CORE_HOST)
    code_draft.add_argument("--user", default=DEFAULT_CORE_USER)
    code_draft.add_argument("--timeout", default=os.environ.get("CTOS_CORE_TIMEOUT", "10"))
    code_draft.add_argument("--remote-timeout", type=float, default=210.0)
    code_draft.add_argument("--print-prompt", action="store_true", help="print the exact prompt without contacting the model")
