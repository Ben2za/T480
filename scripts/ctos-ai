def validate_stored_action(row: sqlite3.Row) -> tuple[ActionSpec, dict[str, Any], list[str]]:
    specs = action_specs()
    spec = specs.get(str(row["action"]))
    if spec is None:
        raise ValueError(f"approval action is no longer allowlisted: {row['action']}")
    try:
        params = json.loads(str(row["params_json"]))
        stored_command = json.loads(str(row["command_json"]))
    except json.JSONDecodeError as error:
        raise ValueError(f"approval payload is corrupt: {error}") from error
    if not isinstance(params, dict):
        raise ValueError("approval params are corrupt")
    if spec.name == "kali-checkpoint" and not valid_snapshot_label(str(params.get("label", ""))):
        raise ValueError("stored checkpoint label is invalid")
    command = spec.command(params)
    if stored_command != command:
        raise ValueError("stored command differs from the current allowlist command; reject and re-propose")
    return spec, params, command


def cmd_approve(args: argparse.Namespace) -> int:
    try:
        row = load_approval(args.id)
    except ApprovalStoreError as error:
        print(str(error), file=sys.stderr)
        return 1
    if row is None:
        print(f"approval #{args.id} not found", file=sys.stderr)
        return 1
    if row["status"] != "pending":
        print(f"approval #{args.id} is {row['status']}, not pending", file=sys.stderr)
        return 1
    try:
        _, _, command = validate_stored_action(row)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2

    if args.dry_run:
        print(format_approval(row))
        print()
        print(f"dry-run: would execute {shell_join(command)}")
        return 0

    result = run(command, timeout=args.timeout)
    status = "executed" if result["rc"] == 0 else "failed"
    summary = one_line(result["stderr"] or result["stdout"] or f"rc={result['rc']}")[:800]
    stamp = now_iso()
    try:
        with approval_connect() as conn:
            conn.execute(
                """
                UPDATE approvals
                SET status = ?, updated_at = ?, executed_at = ?, rc = ?, result = ?
                WHERE id = ?
                """,
                (status, stamp, stamp, int(result["rc"]), summary, args.id),
            )
    except ApprovalStoreError as error:
        print(str(error), file=sys.stderr)
        return 1
    print(f"approval #{args.id} {status}: rc={result['rc']}")
    if result["stdout"]:
        print(result["stdout"])
    if result["stderr"]:
        print(result["stderr"], file=sys.stderr)
    return int(result["rc"])


def cmd_reject(args: argparse.Namespace) -> int:
    try:
        row = load_approval(args.id)
    except ApprovalStoreError as error:
        print(str(error), file=sys.stderr)
        return 1
    if row is None:
        print(f"approval #{args.id} not found", file=sys.stderr)
        return 1
    if row["status"] != "pending":
        print(f"approval #{args.id} is {row['status']}, not pending", file=sys.stderr)
        return 1
    note = args.reason or "rejected by operator"
    stamp = now_iso()
    try:
        with approval_connect() as conn:
            conn.execute(
                """
                UPDATE approvals
                SET status = 'rejected', updated_at = ?, result = ?
                WHERE id = ?
                """,
                (stamp, one_line(note)[:800], args.id),
            )
    except ApprovalStoreError as error:
        print(str(error), file=sys.stderr)
        return 1
    print(f"approval #{args.id} rejected")
    return 0


