AI_HOME = Path(os.environ.get("CTOS_AI_HOME", Path.home() / ".local/share/ctos-ai")).expanduser()
APPROVAL_DB = Path(os.environ.get("CTOS_AI_APPROVAL_DB", AI_HOME / "approvals.sqlite3")).expanduser()
DEFAULT_CORE_HOST = os.environ.get("CTOS_CORE_HOST", "10.42.0.2")
