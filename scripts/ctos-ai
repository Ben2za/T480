    runtime_check.add_argument("--json", action="store_true")
    runtime_check.set_defaults(func=cmd_runtime_check)

    ask_local = sub.add_parser("ask-local", help="ask the bounded local Ollama model on ctos-core")
    ask_local.add_argument("prompt", nargs="+", help="prompt text, or '-' to read stdin")
    ask_local.add_argument("--model", default="qwen2.5-coder:0.5b")
    ask_local.add_argument("--system", default="", help="optional per-call instruction appended to the CTOS identity contract")
    ask_local.add_argument("--raw-model", action="store_true", help="send no default CTOS identity contract; diagnostic use only")
    ask_local.add_argument("--temperature", type=float, default=0.0)
    ask_local.add_argument("--max-tokens", type=int, default=256)
    ask_local.add_argument("--host", default=DEFAULT_CORE_HOST)
    ask_local.add_argument("--user", default=DEFAULT_CORE_USER)
    ask_local.add_argument("--timeout", default=os.environ.get("CTOS_CORE_TIMEOUT", "10"))
