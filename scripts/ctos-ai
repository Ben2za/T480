    agenda_reject.add_argument("ref", help="proposal id or latest")
    agenda_reject.add_argument("--reason")
    agenda_reject.add_argument("--json", action="store_true")
    agenda_reject.set_defaults(func=cmd_agenda_reject)

    agenda = sub.add_parser("agenda", help="pass through to ctos-agenda")
    agenda.add_argument("agenda_args", nargs=argparse.REMAINDER)
    agenda.set_defaults(func=cmd_agenda)

    plan = sub.add_parser("plan-day", help="shortcut for ctos-agenda plan-day")
    plan.add_argument("--date")
