#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
INVENTORY = ROOT / "fleet" / "nodes.json"
CORE_HELPER = ROOT / "scripts" / "ctos-core"


def read_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except OSError as error:
        raise SystemExit(f"cannot read {path}: {error}") from error
    except json.JSONDecodeError as error:
        raise SystemExit(f"invalid JSON in {path}: {error}") from error


def run(args: list[str], timeout: float = 8.0) -> dict[str, Any]:
    try:
        proc = subprocess.run(args, capture_output=True, check=False, text=True, timeout=timeout)
        return {
            "rc": proc.returncode,
            "stdout": proc.stdout.strip(),
            "stderr": proc.stderr.strip(),
        }
    except FileNotFoundError:
        return {"rc": 127, "stdout": "", "stderr": f"{args[0]} not found"}
    except subprocess.TimeoutExpired:
        return {"rc": 124, "stdout": "", "stderr": "timeout"}


def read(path: Path, default: str = "") -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return default


def bytes_fmt(value: int) -> str:
    units = ["B", "KiB", "MiB", "GiB", "TiB"]
    size = float(value)
    for unit in units:
        if size < 1024 or unit == units[-1]:
            return f"{size:.1f} {unit}" if unit != "B" else f"{int(size)} {unit}"
        size /= 1024
    return f"{value} B"


def meminfo() -> dict[str, int]:
    data: dict[str, int] = {}
    for line in read(Path("/proc/meminfo")).splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        parts = value.strip().split()
        if parts and parts[0].isdigit():
            data[key] = int(parts[0]) * 1024
    return data


def local_status() -> dict[str, Any]:
    mem = meminfo()
    total = mem.get("MemTotal", 0)
    available = mem.get("MemAvailable", 0)
    used = max(total - available, 0)
    root = shutil.disk_usage("/")
    home = shutil.disk_usage(str(Path.home()))
    uptime_seconds = int(float(read(Path("/proc/uptime"), "0").split()[0]))
    return {
        "available": True,
        "source": "local",
        "hostname": read(Path("/proc/sys/kernel/hostname"), "unknown"),
        "kernel": os.uname().release,
        "uptime_seconds": uptime_seconds,
        "load": [round(item, 2) for item in os.getloadavg()],
        "memory": {
            "total_text": bytes_fmt(total),
            "used_text": bytes_fmt(used),
            "available_text": bytes_fmt(available),
            "used_percent": round((used / total) * 100, 1) if total else 0,
        },
        "storage": {
            "root_free_text": bytes_fmt(root.free),
            "root_used_percent": round((root.used / root.total) * 100, 1) if root.total else 0,
            "home_free_text": bytes_fmt(home.free),
            "home_used_percent": round((home.used / home.total) * 100, 1) if home.total else 0,
        },
    }


def core_status() -> dict[str, Any]:
    result = run([str(CORE_HELPER), "status", "--json"], timeout=10.0)
    if result["rc"] != 0:
        return {
            "available": False,
            "source": "scripts/ctos-core",
            "error": result["stderr"] or result["stdout"] or "ctos-core status failed",
        }
    try:
        data = json.loads(str(result["stdout"]))
    except json.JSONDecodeError as error:
        return {
            "available": False,
            "source": "scripts/ctos-core",
            "error": f"invalid ctos-core JSON: {error}",
        }
    data["source"] = "scripts/ctos-core"
    return data


def parse_key_values(text: str) -> dict[str, str]:
    data: dict[str, str] = {}
    for line in text.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key:
            data[key] = value.strip()
    return data


def int_value(data: dict[str, str], key: str, default: int = 0) -> int:
    try:
        return int(float(data.get(key, str(default))))
    except ValueError:
        return default


def ssh_linux_status(node: dict[str, Any]) -> dict[str, Any]:
    control = node.get("control") or {}
    user = str(control.get("user") or "")
    host = str(control.get("host") or "")
    if not user or not host:
        return {
            "available": False,
            "source": "ssh",
            "error": "missing ssh user or host in inventory",
        }

    remote = r"""
printf 'hostname=%s\n' "$(hostname 2>/dev/null || echo unknown)"
printf 'kernel=%s\n' "$(uname -r 2>/dev/null || echo unknown)"
if [ -r /etc/os-release ]; then
  . /etc/os-release
  printf 'os_name=%s\n' "${NAME:-Linux}"
  printf 'os_version=%s\n' "${VERSION_ID:-}"
fi
awk '/MemTotal:/ {total=$2*1024} /MemAvailable:/ {avail=$2*1024} END {printf "mem_total=%d\nmem_available=%d\n", total, avail}' /proc/meminfo
awk '{printf "uptime_seconds=%d\n", $1}' /proc/uptime
df -B1 -P / | awk 'NR==2 {used=$5; sub(/%/,"",used); printf "root_free=%s\nroot_used_percent=%s\n", $4, used}'
"""
    result = run(
        [
            "ssh",
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=5",
            f"{user}@{host}",
            remote,
        ],
        timeout=10.0,
    )
    if result["rc"] != 0:
        return {
            "available": False,
            "source": "ssh",
            "error": result["stderr"] or result["stdout"] or "ssh status failed",
        }

    values = parse_key_values(str(result["stdout"]))
    total = int_value(values, "mem_total")
    available = int_value(values, "mem_available")
    used = max(total - available, 0)
    return {
        "available": True,
        "source": "ssh",
        "hostname": values.get("hostname", "unknown"),
        "kernel": values.get("kernel", ""),
        "os": " ".join(part for part in [values.get("os_name"), values.get("os_version")] if part),
        "uptime_seconds": int_value(values, "uptime_seconds"),
        "memory": {
            "total_text": bytes_fmt(total),
            "used_text": bytes_fmt(used),
            "available_text": bytes_fmt(available),
            "used_percent": round((used / total) * 100, 1) if total else 0,
        },
        "storage": {
            "root_free_text": bytes_fmt(int_value(values, "root_free")),
            "root_used_percent": int_value(values, "root_used_percent"),
        },
    }


def live_for_node(node: dict[str, Any]) -> dict[str, Any]:
    node_id = node.get("id")
    control = node.get("control") or {}
    mode = control.get("mode")
    if node_id == "ctos-t480" or mode == "local":
        return local_status()
    if node_id == "ctos-core" and mode == "ssh":
        return core_status()
    if mode == "ssh":
        return ssh_linux_status(node)
    return {
        "available": False,
        "source": "inventory",
        "summary": "planned or unsupported control mode",
    }


def inventory_snapshot(include_live: bool = True) -> dict[str, Any]:
    data = read_json(INVENTORY)
    nodes = []
    for node in data.get("nodes", []):
        item = dict(node)
        if include_live:
            item["live"] = live_for_node(node)
        nodes.append(item)
    return {
        "time": int(time.time()),
        "version": data.get("version", 1),
        "nodes": nodes,
        "features": data.get("features", []),
    }


def render_node(node: dict[str, Any]) -> str:
    live = node.get("live") or {}
    state = "online" if live.get("available") else node.get("status", "unknown")
    bits = [
        f"{node.get('id'):<16}",
        f"{node.get('role'):<16}",
        f"{state:<10}",
        f"{node.get('os'):<18}",
    ]
    if live.get("available"):
        kernel = live.get("kernel", "")
        memory = live.get("memory", {})
        if isinstance(memory, dict):
            bits.append(f"{kernel} ram {memory.get('used_percent', '--')}%")
        else:
            bits.append(str(kernel))
    else:
        bits.append(str(live.get("summary") or live.get("error") or node.get("notes", ""))[:80])
    return "  ".join(bits)


def render_status(data: dict[str, Any]) -> None:
    print("CTOS fleet")
    print(f"inventory: {INVENTORY}")
    print()
    print("nodes:")
    for node in data.get("nodes", []):
        print("  " + render_node(node))
    print()
    print("features:")
    for feature in data.get("features", []):
        print(
            "  "
            f"{feature.get('id'):<18} {feature.get('status'):<8} "
            f"{feature.get('owner')} -> {feature.get('target')}"
        )


def cmd_status(args: argparse.Namespace) -> int:
    data = inventory_snapshot(include_live=not args.no_live)
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
    else:
        render_status(data)
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    data = read_json(INVENTORY)
    for node in data.get("nodes", []):
        print(f"{node.get('id'):<16} {node.get('role'):<16} {node.get('status'):<12} {node.get('os')}")
    return 0


def cmd_features(args: argparse.Namespace) -> int:
    data = read_json(INVENTORY)
    if args.json:
        print(json.dumps(data.get("features", []), indent=2, sort_keys=True))
        return 0
    for feature in data.get("features", []):
        print(f"{feature.get('id')}: {feature.get('status')}")
        print(f"  owner:  {feature.get('owner')}")
        print(f"  target: {feature.get('target')}")
        print(f"  {feature.get('summary')}")
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="CTOS archipelago inventory and live status helper.")
    sub = p.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="show declared nodes with live status where available")
    status.add_argument("--json", action="store_true", help="emit JSON")
    status.add_argument("--no-live", action="store_true", help="do not query local or remote machines")
    status.set_defaults(func=cmd_status)

    list_cmd = sub.add_parser("list", help="list declared nodes only")
    list_cmd.set_defaults(func=cmd_list)

    features = sub.add_parser("features", help="show planned archipelago features")
    features.add_argument("--json", action="store_true", help="emit JSON")
    features.set_defaults(func=cmd_features)

    return p


def main() -> int:
    args = parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
