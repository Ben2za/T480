#!/usr/bin/env bash
set -euo pipefail

NFT_CONFIG="${NFT_CONFIG:-/etc/nftables.conf}"
SYSCTL_CONFIG="${SYSCTL_CONFIG:-/etc/sysctl.d/90-ctos-ip-forward.conf}"
BACKUP_DIR="${BACKUP_DIR:-/etc/nftables.conf.ctos-backups}"
LAN_IF="${LAN_IF:-enp0s31f6}"
WAN_IF="${WAN_IF:-wlan0}"
LAN_NET="${LAN_NET:-10.42.0.0/24}"

if [ "$(id -u)" -ne 0 ]; then
  echo "ctos-install-tower-egress must run as root" >&2
  echo "usage: sudo $0" >&2
  exit 1
fi

if [ ! -f "$NFT_CONFIG" ]; then
  echo "missing $NFT_CONFIG" >&2
  exit 1
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

python3 - "$NFT_CONFIG" "$tmp" "$LAN_IF" "$WAN_IF" "$LAN_NET" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

src = Path(sys.argv[1])
dst = Path(sys.argv[2])
lan_if = sys.argv[3]
wan_if = sys.argv[4]
lan_net = sys.argv[5]

text = src.read_text(encoding="utf-8")
changed = False

if "ctos tower egress" not in text:
    lines = text.splitlines()
    out: list[str] = []
    in_forward = False
    inserted = False
    for line in lines:
        out.append(line)
        stripped = line.strip()
        if stripped == "chain forward {":
            in_forward = True
            continue
        if in_forward and stripped == "policy drop":
            indent = line[: len(line) - len(line.lstrip())]
            out.append(
                f'{indent}iifname "{lan_if}" oifname "{wan_if}" '
                'ct state { new, established, related } counter accept '
                'comment "ctos tower egress"'
            )
            out.append(
                f'{indent}iifname "{wan_if}" oifname "{lan_if}" '
                'ct state established,related counter accept '
                'comment "ctos tower egress return"'
            )
            inserted = True
            in_forward = False
            changed = True
    if not inserted:
        raise SystemExit("could not find inet filter forward policy drop insertion point")
    text = "\n".join(out) + "\n"

marker = "destroy table inet filter\n"
destroy_nat = "destroy table ip ctos_tower_nat\n"
if destroy_nat not in text:
    if marker in text:
        text = text.replace(marker, marker + destroy_nat, 1)
    else:
        text = destroy_nat + text
    changed = True

if "table ip ctos_tower_nat" not in text:
    text = text.rstrip() + f'''

table ip ctos_tower_nat {{
  chain postrouting {{
    type nat hook postrouting priority srcnat
    policy accept
    ip saddr {lan_net} oifname "{wan_if}" counter masquerade comment "ctos tower masquerade"
  }}
}}
'''
    changed = True

dst.write_text(text, encoding="utf-8")
if not changed:
    print("unchanged")
else:
    print("changed")
PY

nft -c -f "$tmp"

install -d -m 0755 "$BACKUP_DIR"
backup="$BACKUP_DIR/nftables.conf.$(date +%Y%m%d-%H%M%S)"

if cmp -s "$NFT_CONFIG" "$tmp"; then
  echo "CTOS tower egress already present in $NFT_CONFIG"
else
  cp "$NFT_CONFIG" "$backup"
  install -m 0644 "$tmp" "$NFT_CONFIG"
  echo "Installed CTOS tower egress rules in $NFT_CONFIG"
  echo "Backup: $backup"
fi

install -d -m 0755 "$(dirname "$SYSCTL_CONFIG")"
cat >"$SYSCTL_CONFIG" <<'EOF'
net.ipv4.ip_forward = 1
EOF

sysctl -w net.ipv4.ip_forward=1 >/dev/null
nft -f "$NFT_CONFIG"

echo "CTOS tower egress persistent fix applied"
echo "LAN_IF=$LAN_IF WAN_IF=$WAN_IF LAN_NET=$LAN_NET"
