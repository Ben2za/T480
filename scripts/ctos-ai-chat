#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SCRIPTS = ROOT / "scripts"


def api_chat(messages: list[dict[str, str]], args: argparse.Namespace) -> tuple[int, dict[str, object] | str]:
    payload = {
        "messages": messages,
        "model": args.model,
        "temperature": args.temperature,
        "max_tokens": args.max_tokens,
        "max_turns": args.max_turns,
    }
    if args.system:
        payload["system"] = args.system
    proc = subprocess.run(
        [
            "curl",
            "-fsS",
            "-X",
            "POST",
            "http://127.0.0.1:8767/chat",
            "-H",
            "Content-Type: application/json",
            "--data-binary",
            "@-",
        ],
        input=json.dumps(payload, ensure_ascii=False),
        check=False,
        capture_output=True,
        text=True,
        timeout=args.timeout,
    )
    if proc.returncode != 0:
        return proc.returncode, proc.stderr.strip() or proc.stdout.strip()
    try:
        return 0, json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        return 1, proc.stdout.strip()


def ensure_server(args: argparse.Namespace) -> None:
    health = subprocess.run(
        ["curl", "-fsS", "http://127.0.0.1:8767/health"],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if health.returncode == 0:
        return
    started = subprocess.run(
        [str(SCRIPTS / "ctos-ai-api-server"), "start"],
        check=False,
        capture_output=True,
        text=True,
        timeout=30,
    )
    if started.returncode != 0:
        print(started.stderr.strip() or started.stdout.strip() or "failed to start ctos-ai-api-server", file=sys.stderr)
        return
    for _ in range(20):
        ready = subprocess.run(
            ["curl", "-fsS", "http://127.0.0.1:8767/health"],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
        if ready.returncode == 0:
            return
    print("ctos-ai-api-server did not become ready", file=sys.stderr)


def speak(text: str, args: argparse.Namespace) -> None:
    if not args.speak:
        return
    subprocess.run([str(SCRIPTS / "ctos-voice"), "say", text], check=False, timeout=20)


def run_once(args: argparse.Namespace) -> int:
    if args.ensure_server:
        ensure_server(args)
    messages = [{"role": "user", "content": " ".join(args.prompt).strip()}]
    rc, payload = api_chat(messages, args)
    if isinstance(payload, dict):
        response = str(payload.get("response") or "")
    else:
        response = payload
    print(response)
    speak(response, args)
    if args.stop_server:
        subprocess.run([str(SCRIPTS / "ctos-ai-api-server"), "stop"], check=False)
    return rc


def run_repl(args: argparse.Namespace) -> int:
    if args.ensure_server:
        ensure_server(args)
    messages: list[dict[str, str]] = []
    print("CTOS chat local. Tape /quit pour sortir, /brief pour injecter le brief courant.")
    try:
        while True:
            try:
                prompt = input("toi> ").strip()
            except EOFError:
                print()
                break
            if not prompt:
                continue
            if prompt in {"/q", "/quit", "/exit"}:
                break
            if prompt == "/brief":
                brief = subprocess.run([str(SCRIPTS / "ctos-ai"), "brief"], check=False, capture_output=True, text=True, timeout=30)
                prompt = "Voici le brief CTOS courant. Resume-le et propose une prochaine action read-only.\n\n" + brief.stdout.strip()
            messages.append({"role": "user", "content": prompt})
            rc, payload = api_chat(messages, args)
            if rc != 0:
                print(f"ctos> error: {payload}")
                continue
            if not isinstance(payload, dict):
                print(f"ctos> {payload}")
                continue
            response = str(payload.get("response") or "")
            messages.append({"role": "assistant", "content": response})
            print(f"ctos> {response}")
            speak(response, args)
    finally:
        if args.stop_server:
            subprocess.run([str(SCRIPTS / "ctos-ai-api-server"), "stop"], check=False)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="CTOS local chat loop over the fast localhost API")
    parser.add_argument("prompt", nargs="*", help="optional one-shot prompt; omit for REPL")
    parser.add_argument("--model", default="qwen2.5-coder:0.5b")
    parser.add_argument("--temperature", type=float, default=0.2)
    parser.add_argument("--max-tokens", type=int, default=180)
    parser.add_argument("--max-turns", type=int, default=8)
    parser.add_argument("--timeout", type=float, default=240)
    parser.add_argument("--system", default="")
    parser.add_argument("--speak", action="store_true", help="speak assistant replies through ctos-voice")
    parser.add_argument("--no-ensure-server", action="store_false", dest="ensure_server", help="do not start ctos-ai-api serve if no API is listening")
    parser.add_argument("--stop-server", action="store_true", help="stop a server started by this command on exit")
    parser.set_defaults(ensure_server=True)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.prompt:
        return run_once(args)
    return run_repl(args)


if __name__ == "__main__":
    raise SystemExit(main())
