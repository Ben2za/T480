#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import json
import subprocess
import sys
import time
from dataclasses import dataclass
from typing import Any


URI = "qemu:///system"
DOMAIN = "ctos-kali"


@dataclass
class CommandResult:
    rc: int
    stdout: str
    stderr: str


def run(args: list[str], timeout: float = 20.0) -> CommandResult:
    proc = subprocess.run(args, capture_output=True, check=False, text=True, timeout=timeout)
    return CommandResult(proc.returncode, proc.stdout.strip(), proc.stderr.strip())


def qga(payload: dict[str, Any], timeout: float = 20.0) -> dict[str, Any]:
    result = run(["virsh", "-c", URI, "qemu-agent-command", DOMAIN, json.dumps(payload)], timeout)
    if result.rc != 0:
        raise RuntimeError(result.stderr or result.stdout or "qemu-agent-command failed")
    return json.loads(result.stdout)


def decode(value: str | None) -> str:
    if not value:
        return ""
    return base64.b64decode(value).decode("utf-8", errors="replace")


def guest_exec(command: list[str], timeout: float = 30.0) -> dict[str, Any]:
    if not command:
        raise ValueError("empty guest command")
    response = qga(
        {
            "execute": "guest-exec",
            "arguments": {
                "path": command[0],
                "arg": command[1:],
                "capture-output": True,
            },
        }
    )
    pid = response["return"]["pid"]
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        status = qga({"execute": "guest-exec-status", "arguments": {"pid": pid}})
        data = status["return"]
        if data.get("exited"):
            return {
                "pid": pid,
                "exitcode": data.get("exitcode", 0),
                "stdout": decode(data.get("out-data")),
                "stderr": decode(data.get("err-data")),
            }
        time.sleep(0.25)
    raise TimeoutError(f"guest command timed out after {timeout:.0f}s: {' '.join(command)}")


def command_ping(_: argparse.Namespace) -> int:
    response = qga({"execute": "guest-ping"})
    print(json.dumps(response, indent=2, sort_keys=True))
    return 0


def command_run(args: argparse.Namespace) -> int:
    result = guest_exec(args.command, timeout=args.timeout)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        if result["stdout"]:
            print(result["stdout"], end="" if result["stdout"].endswith("\n") else "\n")
        if result["stderr"]:
            print(result["stderr"], end="" if result["stderr"].endswith("\n") else "\n", file=sys.stderr)
    return int(result["exitcode"])


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run commands in ctos-kali through qemu-guest-agent.")
    subparsers = parser.add_subparsers(dest="command_name", required=True)
    subparsers.add_parser("ping", help="test qemu-guest-agent")
    run_parser = subparsers.add_parser("run", help="run a command in the guest")
    run_parser.add_argument("--json", action="store_true", help="emit JSON")
    run_parser.add_argument("--timeout", type=float, default=30.0, help="command timeout in seconds")
    run_parser.add_argument("command", nargs=argparse.REMAINDER, help="guest command and arguments")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command_name == "ping":
        return command_ping(args)
    if args.command_name == "run":
        if not args.command:
            print("missing guest command", file=sys.stderr)
            return 2
        return command_run(args)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
