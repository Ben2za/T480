    collect = sub.add_parser(
        "collect",
        aliases=["collect-samples"],
        help="guided capture of a small reusable Jarvis voice sample suite",
    )
    collect.add_argument("phrases", nargs="*", help="optional single phrase; quote multi-word text")
    collect.add_argument("--phrase", action="append", help="add one phrase; may be repeated")
    collect.add_argument("--preset", choices=tuple(COLLECT_PRESETS.keys()), default="core")
    collect.add_argument("--seconds", type=float, default=4.0)
    collect.add_argument("--dir", help="sample directory; default: ~/.local/state/ctos/jarvis-samples")
    collect.add_argument("--manifest", help="JSONL manifest path; default: <sample-dir>/manifest.jsonl")
    collect.add_argument("--note", help="operator note stored on every sample")
    collect.add_argument("--no-intent-ids", action="store_true", help="store transcript-only samples instead of fixed intent ids")
    collect.add_argument("--yes", action="store_true", help="do not wait for Enter before each phrase")
