        default="open-stt",
        help="choose the readiness rail to prioritize",
    )
    status.add_argument("--manifest", help="Jarvis sample manifest path")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=cmd_status)

    daily = sub.add_parser(
