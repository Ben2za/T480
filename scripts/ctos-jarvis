def default_state_dir() -> Path:
    xdg_state = os.environ.get("XDG_STATE_HOME")
    if xdg_state:
        return Path(xdg_state).expanduser()
    return Path.home() / ".local" / "state"


def default_sample_dir() -> Path:
    return default_state_dir() / "ctos" / "jarvis-samples"


def safe_slug(text: str, fallback: str = "sample") -> str:
    lowered = text.lower()
    slug = re.sub(r"[^a-z0-9]+", "-", lowered).strip("-")
    return slug[:60] or fallback


def script(name: str) -> str:
    return str(SCRIPTS / name)


def run(cmd: list[str]) -> int:
    return subprocess.run(cmd, check=False).returncode


def run_capture(cmd: list[str], *, env: dict[str, str] | None = None, timeout: float = 60) -> dict[str, object]:
    try:
        proc = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env,
        )
        return {
            "command": cmd,
            "rc": proc.returncode,
            "ok": proc.returncode == 0,
            "stdout": proc.stdout.strip(),
            "stderr": proc.stderr.strip(),
        }
    except subprocess.TimeoutExpired as exc:
        return {
            "command": cmd,
            "rc": 124,
            "ok": False,
            "stdout": (exc.stdout or "").strip() if isinstance(exc.stdout, str) else "",
            "stderr": "timeout",
        }


def preview(text: str, limit: int = 220) -> str:
    one_line = " ".join(text.split())
    if len(one_line) <= limit:
        return one_line
    return one_line[: limit - 3] + "..."


def parse_json_result(result: dict[str, object]) -> dict[str, object]:
    stdout = str(result.get("stdout") or "")
    if not stdout:
        return {}
    try:
        parsed = json.loads(stdout)
    except json.JSONDecodeError:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def parse_json_value(result: dict[str, object]) -> object:
    stdout = str(result.get("stdout") or "")
    if not stdout:
        return None
    try:
        return json.loads(stdout)
    except json.JSONDecodeError:
        return None


def nested(payload: object, *path: str) -> object:
    current = payload
    for key in path:
        if not isinstance(current, dict):
            return None
        current = current.get(key)
    return current


def compact(value: object, fallback: str = "-") -> str:
    if value is None:
        return fallback
    text = " ".join(str(value).split())
    return text or fallback


def ctos_route(payload: object) -> dict[str, object]:
    if not isinstance(payload, dict):
        return {}
    nested_route = payload.get("route")
    if isinstance(nested_route, dict):
        return nested_route
    if any(key in payload for key in ("matched", "mode", "category", "agenda_proposal", "agenda_save", "top_candidates")):
        return payload
    return {}


def route_agenda_proposal(route: dict[str, object]) -> dict[str, object]:
    proposal = route.get("agenda_proposal")
    return proposal if isinstance(proposal, dict) else {}


def route_execution(route_payload: object, route: dict[str, object]) -> dict[str, object]:
    if isinstance(route_payload, dict) and isinstance(route_payload.get("execution"), dict):
        return route_payload["execution"]  # type: ignore[return-value]
    if isinstance(route_payload, dict) and isinstance(route_payload.get("agenda_save"), dict):
        agenda_save = route_payload["agenda_save"]  # type: ignore[index]
        return {
            "kind": "agenda_save",
            "rc": 0 if route_payload.get("state") == "saved_pending" else agenda_save.get("rc"),
            "reason": route_payload.get("save_reason"),
        }
    if isinstance(route.get("execution"), dict):
        return route["execution"]  # type: ignore[return-value]
    if isinstance(route.get("agenda_save"), dict):
        agenda_save = route["agenda_save"]  # type: ignore[index]
        if agenda_save.get("attempted") or agenda_save.get("rc") == 0:
            return {
                "kind": "agenda_save",
                "rc": agenda_save.get("rc"),
                "reason": agenda_save.get("reason"),
            }
    return {}


def route_top_candidate(route: dict[str, object]) -> dict[str, object]:
    candidates = route.get("top_candidates")
    if isinstance(candidates, list):
        for item in candidates:
            if isinstance(item, dict):
                return item
    return {}


def load_json_object(path: Path, label: str) -> dict[str, object]:
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError) as exc:
        raise SystemExit(f"cannot read {label} at {path}: {exc}") from exc
    if not isinstance(parsed, dict):
        raise SystemExit(f"{label} at {path} must contain a JSON object")
    return parsed


def load_jarvis_stack() -> dict[str, object]:
    return load_json_object(JARVIS_STACK, "Jarvis stack manifest")


def load_voice_intents_catalog() -> dict[str, object]:
    return load_json_object(VOICE_INTENTS, "voice intent catalog")


def jarvis_stack_integrity_errors(payload: dict[str, object]) -> list[str]:
    errors: list[str] = []
    if isinstance(payload.get("intents"), list):
        errors.append(f"{JARVIS_STACK} looks like a voice intent catalog; voice intents belong in {VOICE_INTENTS}")
    mature = payload.get("mature_adoption")
    if not isinstance(mature, dict):
        errors.append("jarvis_stack.json is missing object: mature_adoption")
    else:
        for field in ("adopt_now", "sandbox_or_reference", "operator_path"):
            if not isinstance(mature.get(field), list):
                errors.append(f"mature_adoption.{field} must be a list")
    for field in ("decision", "summary"):
        if not str(payload.get(field) or "").strip():
            errors.append(f"jarvis_stack.json is missing text field: {field}")
    if not isinstance(payload.get("selected_layers"), list) or not payload.get("selected_layers"):
        errors.append("jarvis_stack.json needs a non-empty selected_layers list")
    if not isinstance(payload.get("authority_boundary"), dict):
        errors.append("jarvis_stack.json is missing object: authority_boundary")
    return errors


def voice_intents_integrity_errors(payload: dict[str, object]) -> list[str]:
    errors: list[str] = []
    if isinstance(payload.get("mature_adoption"), dict):
        errors.append(f"{VOICE_INTENTS} looks like the Jarvis stack manifest; stack selection belongs in {JARVIS_STACK}")
    intents = payload.get("intents")
    if not isinstance(intents, list) or not intents:
        errors.append("voice_intents_fr.json needs a non-empty intents list")
        return errors
    seen: set[str] = set()
    for index, item in enumerate(intents, start=1):
        if not isinstance(item, dict):
            errors.append(f"intent #{index} must be an object")
            continue
        intent_id = str(item.get("id") or "").strip()
        if not intent_id:
            errors.append(f"intent #{index} is missing id")
        elif intent_id in seen:
            errors.append(f"duplicate intent id: {intent_id}")
        seen.add(intent_id)
        if not isinstance(item.get("command"), list) or not item.get("command"):
            errors.append(f"intent {intent_id or index} needs a non-empty command list")
        if not isinstance(item.get("phrases"), list) or not item.get("phrases"):
            errors.append(f"intent {intent_id or index} needs a non-empty phrases list")
    return errors


def stack_integrity_payload() -> dict[str, object]:
    stack = load_jarvis_stack()
    intents = load_voice_intents_catalog()
    stack_errors = jarvis_stack_integrity_errors(stack)
    intent_errors = voice_intents_integrity_errors(intents)
    errors = [*stack_errors, *intent_errors]
    return {
        "schema": 1,
        "mode": "ctos-jarvis-stack-check",
        "ok": not errors,
        "stack": {
            "path": str(JARVIS_STACK),
            "decision": stack.get("decision"),
            "mature_adoption": isinstance(stack.get("mature_adoption"), dict),
            "selected_layers": len(stack.get("selected_layers") or []) if isinstance(stack.get("selected_layers"), list) else 0,
            "errors": stack_errors,
        },
        "voice_intents": {
            "path": str(VOICE_INTENTS),
            "intents": len(intents.get("intents") or []) if isinstance(intents.get("intents"), list) else 0,
            "errors": intent_errors,
        },
        "errors": errors,
    }


def open_stt_running(payload: dict[str, object]) -> bool:
    stdout = str(payload.get("stdout") or "")
    return "running=true" in stdout


def calibration_next_steps(payload: dict[str, object], *, saved_requested: bool) -> list[str]:
    state = compact(payload.get("state"), "")
    transcribe = payload.get("transcribe") if isinstance(payload.get("transcribe"), dict) else {}
    audio_state = compact(nested(transcribe, "audio_analysis", "state"))
    transcript = compact(nested(transcribe, "recognition", "transcript"), "")
    guard_state = compact(nested(transcribe, "transcript_guard", "state"))
    guard_ok = bool(nested(transcribe, "transcript_guard", "ok"))
    route_payload = nested(transcribe, "route_payload")
    route = ctos_route(route_payload)
    proposal = route_agenda_proposal(route)
    execution = route_execution(route_payload, route)

    steps: list[str] = []
    if state == "backend_not_running":
        steps.append("relance sans --no-start: ctos-jarvis calibrate")
        steps.append("si ca bloque, lance ctos-jarvis doctor pour verifier ctos-core/open-STT")
    elif state == "backend_start_failed":
        steps.append("ctos-jarvis doctor")
        steps.append("ctos-voice-v2 open-stt logs")
    elif audio_state == "too_quiet":
        steps.append("ctos-audio mic-up 5, puis relance ctos-jarvis calibrate")
    elif audio_state in {"hot", "clipping"}:
        steps.append("ctos-audio mic-down 5, puis relance ctos-jarvis calibrate")
    elif not transcript:
        steps.append("rapproche-toi du micro ou augmente legerement le gain; relance ctos-jarvis calibrate")
    elif not guard_ok:
        steps.append(f"transcription bloquee par la garde ({guard_state}); garde le WAV et reteste plus clairement")
    elif execution.get("kind") == "agenda_save" and execution.get("rc") == 0:
        steps.append("ctos-jarvis review")
        steps.append("ctos-jarvis confirm latest --yes")
    elif saved_requested and execution.get("kind") == "agenda_save":
        steps.append(f"sauvegarde agenda refusee: {compact(execution.get('reason'), 'proposition non reconnue')}")
        steps.append("reteste avec une phrase plus directe: ajoute [tache] demain 30 minutes priorite 3")
    elif proposal.get("recognized") and not saved_requested:
        steps.append("ctos-jarvis calibrate --save-agenda pour creer une proposition persistante")
    elif route.get("matched"):
        steps.append("ctos-jarvis listen --seconds 5 --execute-safe --keep-backend pour tester une action sure")
    elif route:
        category = compact(route.get("category"), "unclassified")
        steps.append(f"transcription comprise comme texte ({category}), mais aucune action/proposition fiable")
        steps.append("reteste avec une phrase plus directe: ajoute [tache] demain 30 minutes priorite 3")
    else:
        steps.append("route CTOS absente; relance ctos-jarvis calibrate ou ctos-jarvis doctor")
    return steps


def add_common_assistant_args(parser: argparse.ArgumentParser, *, typed: bool) -> None:
    parser.add_argument("--model", default="qwen2.5-coder:0.5b")
    parser.add_argument("--max-tokens", type=int, default=180)
    parser.add_argument("--threshold", type=float, default=0.72)
    parser.add_argument("--save-agenda", action="store_true", help="save recognized agenda proposal without writing the agenda")
    parser.add_argument("--no-actions", action="store_true", help="do not execute even safe CTOS action intents")
    parser.add_argument("--json", action="store_true")
    if typed:
        parser.add_argument("--speak", action="store_true", help="speak the reply; typed mode is silent by default")
    else:
        parser.add_argument("--no-speak", action="store_true", help="disable spoken feedback")


