    collect_next.add_argument("--no-preflight", action="store_true", help="skip the read-only audio checks before recording")
    collect_next.add_argument("--strict-preflight", action="store_true", help="stop before recording if an audio preflight check warns")
    collect_next.add_argument("--run", action="store_true", help="record the selected phrase")
    collect_next.add_argument("--json", action="store_true")
    collect_next.set_defaults(func=cmd_collect_next)

    corpus = sub.add_parser(
        "corpus",
        aliases=["corpus-check", "sample-check"],
        help="read-only verdict for the reusable Jarvis voice sample corpus",
    )
    corpus.add_argument("--manifest", help="JSONL manifest path; default: ~/.local/state/ctos/jarvis-samples/manifest.jsonl")
    corpus.add_argument("--preset", choices=tuple(COLLECT_PRESETS.keys()), default="core")
    corpus.add_argument("--min-samples", type=int, help="override required sample count")
    corpus.add_argument("--no-check-files", dest="check_files", action="store_false", help="do not verify referenced WAV files exist")
    corpus.add_argument("--allow-incomplete", action="store_true", help="return success for incomplete but readable manifests")
    corpus.add_argument("--json", action="store_true")
    corpus.set_defaults(func=cmd_corpus, check_files=True)

    samples = sub.add_parser("samples", aliases=["sample-list"], help="show reusable Jarvis samples and replay commands")
    samples.add_argument("--manifest", help="JSONL manifest path; default: ~/.local/state/ctos/jarvis-samples/manifest.jsonl")
    samples.add_argument("--limit", type=int, default=8, help="number of recent samples to show; 0 shows all")
    samples.add_argument("--json", action="store_true")
    samples.set_defaults(func=cmd_samples)

    evaluate = sub.add_parser(
        "evaluate",
        aliases=["eval", "test-corpus"],
        help="gate the Jarvis corpus, then run sample regression only when ready",
    )
    evaluate.add_argument("--manifest", help="JSONL manifest path; default: ~/.local/state/ctos/jarvis-samples/manifest.jsonl")
    evaluate.add_argument("--preset", choices=tuple(COLLECT_PRESETS.keys()), default="core")
    evaluate.add_argument("--min-samples", type=int, help="override required sample count")
    evaluate.add_argument("--no-check-files", dest="check_files", action="store_false", help="do not verify referenced WAV files exist")
    evaluate.add_argument("--allow-incomplete", action="store_true", help="allow regression on incomplete but readable manifests")
    evaluate.add_argument("--backend", choices=("vosk", "open-stt", "both"), default="vosk")
    evaluate.add_argument("--threshold", type=float, default=0.72)
    evaluate.add_argument("--text-threshold", type=float, default=0.66)
    evaluate.add_argument("--timeout", type=float, default=20.0)
    evaluate.add_argument("--wyoming-host", default="127.0.0.1")
    evaluate.add_argument("--wyoming-port", type=int, default=10301)
    evaluate.add_argument("--no-target-tunnel", action="store_true", help="for open-STT, use local wyoming host/port instead of ctos-core tunnel")
    evaluate.add_argument("--host", default="10.42.0.2")
    evaluate.add_argument("--user", default="ctos")
    evaluate.add_argument("--language", default="fr")
    evaluate.add_argument("--preprocess", choices=("auto", "off", "normalize"), default="auto")
    evaluate.add_argument("--plan", action="store_true")
    evaluate.add_argument("--json", action="store_true")
    evaluate.set_defaults(func=cmd_evaluate, check_files=True)

    triage = sub.add_parser(
        "triage",
        aliases=["decide", "verdict"],
        help="read-only next-action verdict for the reusable Jarvis voice corpus",
    )
    triage.add_argument("--manifest", help="JSONL manifest path; default: ~/.local/state/ctos/jarvis-samples/manifest.jsonl")
    triage.add_argument("--preset", choices=tuple(COLLECT_PRESETS.keys()), default="core")
    triage.add_argument("--min-samples", type=int, help="override required sample count")
    triage.add_argument("--no-check-files", dest="check_files", action="store_false", help="do not verify referenced WAV files exist")
    triage.add_argument("--limit", type=int, default=8, help="number of recent samples to include in JSON")
    triage.add_argument("--json", action="store_true")
    triage.set_defaults(func=cmd_triage, check_files=True)

    improve = sub.add_parser(
        "improve",
        aliases=["cycle", "advance"],
        help="triage the corpus and optionally run the next safe improvement step",
    )
    improve.add_argument("--manifest", help="JSONL manifest path; default: ~/.local/state/ctos/jarvis-samples/manifest.jsonl")
    improve.add_argument("--dir", help="sample directory used if the next step records samples")
    improve.add_argument("--preset", choices=tuple(COLLECT_PRESETS.keys()), default="core")
    improve.add_argument("--min-samples", type=int, help="override required sample count")
    improve.add_argument("--no-check-files", dest="check_files", action="store_false", help="do not verify referenced WAV files exist")
    improve.add_argument("--limit", type=int, default=8, help="number of recent samples to inspect")
    improve.add_argument("--backend", choices=("vosk", "open-stt", "both"), default="both")
    improve.add_argument("--seconds", type=float, default=4.0, help="recording length when the next step is sample collection")
    improve.add_argument("--yes", action="store_true", help="do not wait for Enter before each recorded phrase")
    improve.add_argument("--no-preflight", action="store_true", help="skip audio preflight if the next step records samples")
    improve.add_argument("--relaxed-preflight", action="store_true", help="warn instead of blocking on audio preflight during collection")
    improve.add_argument("--stop-on-failure", action="store_true", help="stop guided collection after the first failed sample")
    improve.add_argument("--no-intent-ids", action="store_true", help="store transcript-only samples during collection")
    improve.add_argument("--note", help="operator note stored on every collected sample")
    improve.add_argument("--allow-incomplete", action="store_true", help="allow evaluation on incomplete but readable manifests")
    improve.add_argument("--threshold", type=float, default=0.72)
    improve.add_argument("--text-threshold", type=float, default=0.66)
    improve.add_argument("--timeout", type=float, default=20.0)
    improve.add_argument("--run-timeout", type=float, default=300.0, help="timeout for --run --json subprocess capture")
    improve.add_argument("--wyoming-host", default="127.0.0.1")
    improve.add_argument("--wyoming-port", type=int, default=10301)
    improve.add_argument("--no-target-tunnel", action="store_true", help="for open-STT, use local wyoming host/port instead of ctos-core tunnel")
    improve.add_argument("--host", default="10.42.0.2")
    improve.add_argument("--user", default="ctos")
    improve.add_argument("--language", default="fr")
    improve.add_argument("--preprocess", choices=("auto", "off", "normalize"), default="auto")
    improve.add_argument("--plan", action="store_true", help="force plan-only output")
    improve.add_argument("--run", action="store_true", help="execute the selected next step")
    improve.add_argument("--json", action="store_true")
    improve.set_defaults(func=cmd_improve, check_files=True)

    regression = sub.add_parser("regression", aliases=["test-samples"], help="run sample regression through ctos-voice-v2")
    regression.add_argument("--manifest", help="JSONL manifest path; default: ~/.local/state/ctos/jarvis-samples/manifest.jsonl")
    regression.add_argument("--backend", choices=("vosk", "open-stt"), default="vosk")
    regression.add_argument("--threshold", type=float, default=0.72)
    regression.add_argument("--text-threshold", type=float, default=0.66)
    regression.add_argument("--timeout", type=float, default=20.0)
    regression.add_argument("--wyoming-host", default="127.0.0.1")
    regression.add_argument("--wyoming-port", type=int, default=10301)
    regression.add_argument("--target-tunnel", action="store_true")
    regression.add_argument("--host", default="10.42.0.2")
    regression.add_argument("--user", default="ctos")
    regression.add_argument("--language", default="fr")
    regression.add_argument("--preprocess", choices=("auto", "off", "normalize"), default="auto")
    regression.add_argument("--plan", action="store_true")
    regression.add_argument("--json", action="store_true")
    regression.set_defaults(func=cmd_regression)

    review = sub.add_parser("review", help="show pending agenda proposals; read-only")
    review.add_argument("--json", action="store_true")
    review.set_defaults(func=cmd_review)

    confirm = sub.add_parser("confirm", help="confirm a pending agenda proposal by id or 'latest'")
    confirm.add_argument("selector", nargs="?", default="latest")
    confirm.add_argument("--yes", action="store_true", help="required by ctos-ai to write the agenda")
    confirm.add_argument("--json", action="store_true", help="emit confirm result plus optional inbox as JSON")
    confirm.add_argument("--no-inbox", action="store_true", help="do not show the consolidated inbox after success")
    confirm.set_defaults(func=cmd_confirm)

    reject = sub.add_parser("reject", help="reject a pending agenda proposal by id or 'latest'")
    reject.add_argument("selector", nargs="?", default="latest")
    reject.add_argument("--reason", help="store a short reason on the rejected proposal")
    reject.add_argument("--json", action="store_true", help="emit reject result plus optional inbox as JSON")
    reject.add_argument("--no-inbox", action="store_true", help="do not show the consolidated inbox after success")
    reject.set_defaults(func=cmd_reject)

    setup_voice = sub.add_parser("setup-voice", help="run or preview the mature voice backend setup gate")
    setup_voice.add_argument("--plan", action="store_true")
    setup_voice.set_defaults(func=cmd_setup_voice)

    unlock_voice = sub.add_parser("unlock-voice", help="prepare the mature Home Assistant/Speech-to-Phrase rail")
    unlock_voice.add_argument("--plan", action="store_true", help="show the lower-level setup sequence")
    unlock_voice.add_argument("--interactive", action="store_true", help="run the guided setup; may request hidden secrets")
    unlock_voice.add_argument("--no-tunnel", action="store_true", help="skip idempotent Home Assistant tunnel check/start")
    unlock_voice.add_argument("--start", action="store_true", help="start Speech-to-Phrase if the token gate is ready")
    unlock_voice.add_argument("--test", action="store_true", help="record one Speech-to-Phrase test only if the stack is ready")
    unlock_voice.add_argument("--record-seconds", type=float, default=3.0)
    unlock_voice.add_argument("--execute-safe", action="store_true", help="execute Tier 0/1 recognized command during --test")
    unlock_voice.add_argument("--json", action="store_true")
    unlock_voice.set_defaults(func=cmd_unlock_voice)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
