@dataclass
class CommandResult:
    rc: int
    stdout: str
    stderr: str


@dataclass(frozen=True)
class Check:
    name: str
    ok: bool
    detail: str


def run(args: list[str], timeout: float = 20.0) -> CommandResult:
    try:
        proc = subprocess.run(
            args,
            capture_output=True,
            check=False,
            text=True,
            timeout=timeout,
        )
    except FileNotFoundError:
        return CommandResult(127, "", f"{args[0]} not found")
    except subprocess.TimeoutExpired:
        return CommandResult(124, "", "command timed out")
    return CommandResult(proc.returncode, proc.stdout.strip(), proc.stderr.strip())


def virsh(args: list[str], readonly: bool = False, timeout: float = 20.0) -> CommandResult:
    command = ["virsh", "-c", URI]
    if readonly:
        command.append("--readonly")
    command.extend(args)
    return run(command, timeout=timeout)


def parse_info(stdout: str) -> dict[str, str]:
    data: dict[str, str] = {}
    for line in stdout.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip().lower().replace(" ", "_")] = value.strip()
    return data


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8").strip()


def selected_role(content: str) -> str:
    """Return the active Type-C role, which sysfs normally brackets."""

    match = re.search(r"\[([^]]+)\]", content)
    if match:
        return match.group(1).strip().lower()
    parts = content.strip().lower().split()
    return parts[0] if len(parts) == 1 else "unknown"


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


AT_EMPTY_PATH = 0x1000
RENAME_NOREPLACE = 1


def _link_tmpfile_no_replace(
    source_fd: int,
    directory_fd: int,
    target_name: str,
) -> None:
    """Give one O_TMPFILE inode a name without replacing an existing object."""

    if target_name in {"", ".", ".."} or "/" in target_name or "\x00" in target_name:
        raise ValueError("target_name must be one safe basename")
    try:
        linkat = ctypes.CDLL(None, use_errno=True).linkat
    except AttributeError as error:
        raise OSError(errno.ENOSYS, "libc linkat is unavailable") from error
    linkat.argtypes = (
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
    )
    linkat.restype = ctypes.c_int
    ctypes.set_errno(0)
    result = linkat(
        source_fd,
        b"",
        directory_fd,
        os.fsencode(target_name),
        AT_EMPTY_PATH,
    )
    if result != 0:
        error_number = ctypes.get_errno() or errno.EIO
        message = (
            "linkat(AT_EMPTY_PATH) is unavailable or the caller lacks permission"
            if error_number == errno.ENOENT
            else os.strerror(error_number)
        )
        raise OSError(error_number, message, target_name)


def _rename_no_replace(
    directory_fd: int,
    source_name: str,
    target_name: str,
) -> None:
    """Atomically rename one sibling object without replacing the target."""

    for value, label in ((source_name, "source_name"), (target_name, "target_name")):
        if value in {"", ".", ".."} or "/" in value or "\x00" in value:
            raise ValueError(f"{label} must be one safe basename")
    try:
        renameat2 = ctypes.CDLL(None, use_errno=True).renameat2
    except AttributeError as error:
        raise OSError(errno.ENOSYS, "libc renameat2 is unavailable; no fallback attempted") from error
    renameat2.argtypes = (
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    )
    renameat2.restype = ctypes.c_int
    ctypes.set_errno(0)
    result = renameat2(
        directory_fd,
        os.fsencode(source_name),
        directory_fd,
        os.fsencode(target_name),
        RENAME_NOREPLACE,
    )
    if result != 0:
        error_number = ctypes.get_errno() or errno.EIO
        raise OSError(error_number, os.strerror(error_number), target_name)


def invoking_uid() -> int:
    sudo_uid = os.environ.get("SUDO_UID", "")
    if sudo_uid.isdigit():
        return int(sudo_uid)
    return os.getuid()


def publish_json_no_replace(
    path: Path,
    payload: dict[str, Any],
    *,
    uid: int,
    gid: int,
    mode: int,
) -> None:
    """Durably publish a new JSON file without replacing an existing object."""

    if not path.is_absolute():
        raise ValueError("managed publication path must be absolute")
    if path.name in {"", ".", ".."}:
        raise ValueError("managed publication path must have one basename")
    if uid < 0 or gid < 0:
        raise ValueError("managed publication uid/gid must be nonnegative")
    if mode != stat.S_IMODE(mode):
        raise ValueError("managed publication mode contains non-permission bits")

    parent = path.parent
    if parent.resolve(strict=True) != parent:
        raise ValueError("managed publication parent must contain no symlink component")
    encoded = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
    expected_sha256 = hashlib.sha256(encoded).hexdigest()

    directory_fd = os.open(
        parent,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    anonymous_fd = -1
    try:
        opened_parent = os.fstat(directory_fd)
        visible_parent = parent.lstat()
        if (
            not stat.S_ISDIR(opened_parent.st_mode)
            or (opened_parent.st_dev, opened_parent.st_ino)
            != (visible_parent.st_dev, visible_parent.st_ino)
        ):
            raise OSError(errno.ESTALE, "managed publication parent changed")

        tmpfile_flag = getattr(os, "O_TMPFILE", 0)
        if not tmpfile_flag:
            raise OSError(
                errno.EOPNOTSUPP,
                "O_TMPFILE is unavailable; no fallback attempted",
                str(parent),
            )
        try:
            anonymous_fd = os.open(
                ".",
                os.O_RDWR | tmpfile_flag | getattr(os, "O_CLOEXEC", 0),
                0o600,
                dir_fd=directory_fd,
            )
        except OSError as error:
            if error.errno in {errno.EOPNOTSUPP, errno.EISDIR, errno.EINVAL}:
                raise OSError(
                    error.errno,
                    f"O_TMPFILE publication unsupported on {parent}; no fallback attempted",
                    str(parent),
                ) from error
            raise

        remaining = memoryview(encoded)
        while remaining:
            written = os.write(anonymous_fd, remaining)
            if written <= 0:
                raise OSError(errno.EIO, "short JSON publication write")
            remaining = remaining[written:]
        os.fchown(anonymous_fd, uid, gid)
        os.fchmod(anonymous_fd, mode)
        prepared = os.fstat(anonymous_fd)
        if (
            not stat.S_ISREG(prepared.st_mode)
            or prepared.st_nlink != 0
            or prepared.st_uid != uid
            or prepared.st_gid != gid
            or stat.S_IMODE(prepared.st_mode) != mode
            or prepared.st_size != len(encoded)
            or sha256_fd(anonymous_fd) != expected_sha256
        ):
            raise OSError(errno.EIO, "anonymous JSON inode failed verification")
        os.fsync(anonymous_fd)
        _link_tmpfile_no_replace(anonymous_fd, directory_fd, path.name)

        published_fd = os.fstat(anonymous_fd)
        published_path = os.stat(
            path.name,
            dir_fd=directory_fd,
            follow_symlinks=False,
        )
        if (
            not stat.S_ISREG(published_path.st_mode)
            or published_fd.st_nlink != 1
            or published_path.st_nlink != 1
            or (published_fd.st_dev, published_fd.st_ino)
            != (published_path.st_dev, published_path.st_ino)
            or published_path.st_uid != uid
            or published_path.st_gid != gid
            or stat.S_IMODE(published_path.st_mode) != mode
        ):
            raise OSError(errno.EIO, "published JSON inode failed verification")
        os.fsync(anonymous_fd)
        os.fsync(directory_fd)
    finally:
        if anonymous_fd >= 0:
            os.close(anonymous_fd)
        os.close(directory_fd)


def strict_json_bytes(raw: bytes, *, max_bytes: int = 65536) -> dict[str, Any]:
    if len(raw) > max_bytes:
        raise ValueError(f"JSON exceeds {max_bytes} bytes")

    def unique_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ValueError(f"duplicate JSON key: {key}")
            result[key] = value
        return result

    value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_pairs)
    if not isinstance(value, dict):
        raise ValueError("JSON root must be an object")
    return value


def strict_json_object(path: Path, *, max_bytes: int = 65536) -> dict[str, Any]:
    return strict_json_bytes(path.read_bytes(), max_bytes=max_bytes)


def sha256_fd(descriptor: int) -> str:
    """Hash an already-open regular file without changing its final offset."""

    digest = hashlib.sha256()
    os.lseek(descriptor, 0, os.SEEK_SET)
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            break
        digest.update(chunk)
    os.lseek(descriptor, 0, os.SEEK_SET)
    return digest.hexdigest()


def stable_regular_file_hash(path: Path, label: str) -> tuple[str, os.stat_result]:
    """Hash one canonical, single-link regular file via a stable no-follow FD."""

    if path.is_symlink() or path.resolve(strict=True) != path:
        raise ValueError(f"{label} must be canonical and contain no symlink component")
    descriptor = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        initial = os.fstat(descriptor)
        path_metadata = path.lstat()
        if not stat.S_ISREG(initial.st_mode):
            raise ValueError(f"{label} must be a regular file")
        if initial.st_nlink != 1:
            raise ValueError(f"{label} must have exactly one hard link")
        if (initial.st_dev, initial.st_ino) != (path_metadata.st_dev, path_metadata.st_ino):
            raise ValueError(f"{label} changed while it was opened")
        digest = sha256_fd(descriptor)
        final = os.fstat(descriptor)
        if source_stat_signature(final) != source_stat_signature(initial):
            raise ValueError(f"{label} changed while it was hashed")
        return digest, final
    finally:
        os.close(descriptor)


def stable_regular_file_stat(path: Path, label: str) -> os.stat_result:
    if path.is_symlink() or path.resolve(strict=True) != path:
        raise ValueError(f"{label} must be canonical and contain no symlink component")
    descriptor = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        metadata = os.fstat(descriptor)
        path_metadata = path.lstat()
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise ValueError(f"{label} must be a single-link regular file")
        if (metadata.st_dev, metadata.st_ino) != (path_metadata.st_dev, path_metadata.st_ino):
            raise ValueError(f"{label} changed while it was opened")
        return metadata
    finally:
        os.close(descriptor)


def artifact_stat_payload(metadata: os.stat_result) -> dict[str, int]:
    """Canonical identity and mutation-sensitive metadata for one managed file."""

    return {
        "device": metadata.st_dev,
        "inode": metadata.st_ino,
        "mode": metadata.st_mode,
        "uid": metadata.st_uid,
        "gid": metadata.st_gid,
        "nlink": metadata.st_nlink,
        "size": metadata.st_size,
        "mtime_ns": metadata.st_mtime_ns,
        "ctime_ns": metadata.st_ctime_ns,
    }


def exact_directory_errors(path: Path, label: str) -> list[str]:
    try:
        if path.is_symlink() or not path.is_dir():
            return [f"{label} must be a real directory, not a symlink"]
        if path.resolve(strict=True) != path:
            return [f"{label} must resolve to its exact managed path"]
    except OSError as error:
        return [f"cannot inspect {label}: {error}"]
    return []


def canonical_uuid(value: Any, label: str) -> str:
    text_value = str(value)
    try:
        parsed = uuid.UUID(text_value)
    except (ValueError, AttributeError) as error:
        raise ValueError(f"{label} is not a UUID: {error}") from error
    canonical = str(parsed)
    if text_value != canonical:
        raise ValueError(f"{label} must use canonical lowercase UUID form")
    return canonical


def parse_utc_timestamp(value: Any, label: str) -> dt.datetime:
    try:
        parsed = dt.datetime.fromisoformat(str(value))
    except ValueError as error:
        raise ValueError(f"{label} is not an ISO-8601 timestamp: {error}") from error
    if parsed.tzinfo is None or parsed.utcoffset() != dt.timedelta(0):
        raise ValueError(f"{label} must include an explicit UTC offset")
    return parsed


def canonical_json_sha256(payload: Any) -> str:
    encoded = json.dumps(
        payload,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def read_operator_json_source(source: Path, *, max_bytes: int = 65536) -> dict[str, Any]:
    """Read a small operator-owned JSON object through one stable no-follow FD."""

    if not source.is_absolute():
        raise ValueError("evidence source path must be absolute")
    try:
        if source.is_symlink() or source.resolve(strict=True) != source:
            raise ValueError("evidence source must be canonical and contain no symlink component")
    except OSError as error:
        raise ValueError(f"cannot resolve evidence source: {error}") from error
    try:
        if STATE_ROOT == source or STATE_ROOT in source.parents:
            raise ValueError("evidence source must be outside the managed state root")
    except TypeError:
        raise ValueError("invalid evidence source path") from None

    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(source, flags)
    try:
        initial = os.fstat(descriptor)
        path_metadata = source.lstat()
        if not stat.S_ISREG(initial.st_mode):
            raise ValueError("evidence source must be a regular file")
        if (initial.st_dev, initial.st_ino) != (path_metadata.st_dev, path_metadata.st_ino):
            raise ValueError("evidence source changed while it was opened")
        if initial.st_nlink != 1:
            raise ValueError("evidence source must have exactly one hard link")
        if initial.st_uid != invoking_uid():
            raise ValueError(
                f"evidence source owner is {initial.st_uid}, expected invoking uid {invoking_uid()}"
            )
        if stat.S_IMODE(initial.st_mode) & 0o022:
            raise ValueError("evidence source must not be writable by group or others")
        if initial.st_size <= 0 or initial.st_size > max_bytes:
            raise ValueError(f"evidence source size must be 1..{max_bytes} bytes")
        raw = b""
        while len(raw) <= max_bytes:
            chunk = os.read(descriptor, min(8192, max_bytes + 1 - len(raw)))
            if not chunk:
                break
            raw += chunk
        final = os.fstat(descriptor)
        if source_stat_signature(final) != source_stat_signature(initial):
            raise ValueError("evidence source changed during read")
    finally:
        os.close(descriptor)

    def unique_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ValueError(f"duplicate JSON key: {key}")
            result[key] = value
        return result

    try:
        payload = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_pairs)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(f"evidence source is not valid UTF-8 JSON: {error}") from error
    if not isinstance(payload, dict):
        raise ValueError("evidence JSON root must be an object")
    return payload


@contextlib.contextmanager
def mutation_lock():
    """Serialize every CLI mutation and reject unsafe/stale lock objects."""

    identities = media_identities()
    if not identities["ok"]:
        raise RuntimeError("mutation lock identities unavailable: " + "; ".join(identities["errors"]))
    flags = (
        os.O_RDWR
        | os.O_CREAT
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = os.open(MUTATION_LOCK_PATH, flags, 0o600)
    try:
        if os.geteuid() == 0:
            os.fchown(descriptor, identities["root_uid"], identities["libvirt_gid"])
            os.fchmod(descriptor, MUTATION_LOCK_MODE)
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise RuntimeError("mutation lock must be a single-link regular file")
        if (
            metadata.st_uid != identities["root_uid"]
            or metadata.st_gid != identities["libvirt_gid"]
            or stat.S_IMODE(metadata.st_mode) != MUTATION_LOCK_MODE
        ):
            raise RuntimeError("mutation lock ownership or mode is incompatible")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("another Apple recovery mutation is already active") from error
        try:
            yield
        finally:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
    finally:
        os.close(descriptor)


def json_result(args: argparse.Namespace, payload: dict[str, Any]) -> None:
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True))


def memory_to_bytes(node: ET.Element | None) -> int:
    if node is None or node.text is None:
        return 0
    value = int(node.text.strip())
    unit = node.attrib.get("unit", "KiB").lower()
    multipliers = {
        "b": 1,
        "bytes": 1,
        "k": 1024,
        "kb": 1024,
        "kib": 1024,
        "m": 1024**2,
        "mb": 1024**2,
        "mib": 1024**2,
        "g": 1024**3,
        "gb": 1024**3,
        "gib": 1024**3,
    }
    if unit not in multipliers:
        raise ValueError(f"unsupported memory unit: {unit}")
    return value * multipliers[unit]


def xml_profile(root: ET.Element) -> str:
    marker = root.find(f"./metadata/{{{CTOS_METADATA_NS}}}apple-recovery")
    return marker.attrib.get("profile", "") if marker is not None else ""


def xml_signature(root: ET.Element) -> dict[str, Any]:
    disk = None
    cdroms: list[str] = []
    disk_entries: list[dict[str, Any]] = []
    for item in root.findall("./devices/disk"):
        source = item.find("source")
        source_file = source.attrib.get("file", "") if source is not None else ""
        driver = item.find("driver")
        target = item.find("target")
        disk_entries.append(
            {
                "attributes": dict(sorted(item.attrib.items())),
                "driver_attributes": (
                    dict(sorted(driver.attrib.items())) if driver is not None else {}
                ),
                "source_attributes": (
                    dict(sorted(source.attrib.items())) if source is not None else {}
                ),
                "target_attributes": (
                    dict(sorted(target.attrib.items())) if target is not None else {}
                ),
                "readonly": item.find("readonly") is not None,
            }
        )
        if item.attrib.get("device") == "disk":
            disk = item
        elif item.attrib.get("device") == "cdrom":
            cdroms.append(source_file)
    disk_entries.sort(
        key=lambda item: (
            item["target_attributes"].get("dev", ""),
            item["attributes"].get("device", ""),
        )
    )

    disk_source = disk.find("source") if disk is not None else None
    disk_target = disk.find("target") if disk is not None else None
    os_type = root.find("./os/type")
    loader = root.find("./os/loader")
    nvram = root.find("./os/nvram")
    cpu = root.find("./cpu")
    topology = root.find("./cpu/topology")
    interface_source = root.find("./devices/interface/source")
    interface_model = root.find("./devices/interface/model")
    graphics = root.find("./devices/graphics")
    graphics_listen = root.find("./devices/graphics/listen")
    graphics_image = root.find("./devices/graphics/image")
    clipboard = root.find("./devices/graphics/clipboard")
    filetransfer = root.find("./devices/graphics/filetransfer")
    tpm = root.find("./devices/tpm")
    tpm_backend = root.find("./devices/tpm/backend")
    tpm_source = root.find("./devices/tpm/backend/source")
    emulator = root.find("./devices/emulator")
    forbidden = []
    for tag in ("hostdev", "redirdev", "filesystem", "sound", "audio", "smartcard"):
        if root.findall(f"./devices/{tag}"):
            forbidden.append(tag)
    channels = [
        target.attrib.get("name", "")
        for target in root.findall("./devices/channel/target")
    ]
    models = [
        node.attrib.get("model", "")
        for node in root.findall("./devices/controller")
    ]
    models.extend(
        node.attrib.get("type", "")
        for node in root.findall("./devices/video/model")
    )
    models.extend(
        node.attrib.get("type", "")
        for node in root.findall("./devices/interface/model")
    )
    controller_counts: dict[str, int] = {}
    controllers: list[dict[str, Any]] = []
    for node in root.findall("./devices/controller"):
        controller_type = node.attrib.get("type", "")
        default_index = controller_counts.get(controller_type, 0)
        controller_counts[controller_type] = default_index + 1
        controller_index = node.attrib.get("index", str(default_index))
        controller_model = node.attrib.get("model", "")
        model_node = node.find("model")
        target_node = node.find("target")
        root_port = controller_type == "pci" and controller_model == "pcie-root-port"
        expected_target_port = (
            f"0x{15 + int(controller_index):x}"
            if root_port and controller_index.isdigit()
            else ""
        )
        controllers.append(
            {
                "type": controller_type,
                "model": controller_model,
                "index": controller_index,
                "child_model_name": (
                    model_node.attrib.get("name", "")
                    if model_node is not None
                    else ("pcie-root-port" if root_port else "")
                ),
                "target_chassis": (
                    target_node.attrib.get("chassis", "")
                    if target_node is not None
                    else (controller_index if root_port else "")
                ),
                "target_port": (
                    target_node.attrib.get("port", "")
                    if target_node is not None
                    else expected_target_port
                ),
                "child_unexpected_attributes": {
                    "model": (
                        dict(
                            sorted(
                                (key, value)
                                for key, value in model_node.attrib.items()
                                if key != "name"
                            )
                        )
                        if model_node is not None
                        else {}
                    ),
                    "target": (
                        dict(
                            sorted(
                                (key, value)
                                for key, value in target_node.attrib.items()
                                if key not in {"chassis", "port"}
                            )
                        )
                        if target_node is not None
                        else {}
                    ),
                },
                "unexpected_attributes": dict(
                    sorted(
                        (key, value)
                        for key, value in node.attrib.items()
                        if key not in {"type", "model", "index"}
                    )
                ),
            }
        )
    controllers.sort(key=lambda item: (item["type"], item["index"], item["model"]))
    def interface_signature(node: ET.Element) -> dict[str, Any]:
        source = node.find("source")
        model = node.find("model")
        target = node.find("target")
        mac = node.find("mac")
        return {
            "type": node.attrib.get("type", ""),
            "network": source.attrib.get("network", "") if source is not None else "",
            "model": model.attrib.get("type", "") if model is not None else "",
            "mac": mac.attrib.get("address", "").lower() if mac is not None else "",
            "attributes": dict(sorted(node.attrib.items())),
            # bridge/portid are libvirt-derived for a network interface. Any
            # other source setting is configuration and must match the repo.
            "source_unexpected_attributes": (
                dict(
                    sorted(
                        (key, value)
                        for key, value in source.attrib.items()
                        if key not in {"network", "bridge", "portid"}
                    )
                )
                if source is not None
                else {}
            ),
            "link_attributes": [
                dict(sorted(link.attrib.items())) for link in node.findall("link")
            ],
            "target_unexpected_attributes": (
                dict(sorted((key, value) for key, value in target.attrib.items() if key != "dev"))
                if target is not None else {}
            ),
        }

    interfaces = sorted(
        (interface_signature(node) for node in root.findall("./devices/interface")),
        key=lambda item: (item["type"], item["network"], item["model"], item["mac"]),
    )
    inputs = sorted(
        (
            {
                "type": node.attrib.get("type", ""),
                "bus": node.attrib.get("bus", ""),
            }
            for node in root.findall("./devices/input")
        ),
        key=lambda item: (item["type"], item["bus"]),
    )
    serials = sorted(
        (
            {"type": node.attrib.get("type", "")}
            for node in root.findall("./devices/serial")
        ),
        key=lambda item: item["type"],
    )
    consoles = sorted(
        (
            {
                "type": node.attrib.get("type", ""),
                "target_type": (
                    node.find("target").attrib.get("type", "")
                    if node.find("target") is not None
                    else ""
                ),
                "target_port": (
                    node.find("target").attrib.get("port", "")
                    if node.find("target") is not None
                    else ""
                ),
            }
            for node in root.findall("./devices/console")
        ),
        key=lambda item: (item["type"], item["target_type"], item["target_port"]),
    )
    videos = sorted(
        (
            {
                "type": node.attrib.get("type", ""),
                "vram": node.attrib.get("vram", ""),
                "heads": node.attrib.get("heads", ""),
                "primary": node.attrib.get("primary", ""),
            }
            for node in root.findall("./devices/video/model")
        ),
        key=lambda item: (item["type"], item["vram"], item["heads"], item["primary"]),
    )
    active_pcr_banks = sorted(
        child.tag.rsplit("}", 1)[-1]
        for child in root.findall("./devices/tpm/backend/active_pcr_banks/*")
    )
    devices = root.find("./devices")
    allowed_device_tags = {
        "emulator",
        "disk",
        "controller",
        "interface",
        "serial",
        "console",
        "input",
        "graphics",
        "video",
        "tpm",
        "memballoon",
    }
    device_children = list(devices) if devices is not None else []
    device_tags = [child.tag.rsplit("}", 1)[-1] for child in device_children]
    allowed_device_child_tags = {
        "emulator": set(),
        "disk": {"driver", "source", "target", "readonly", "backingStore", "alias", "address"},
        "controller": {"model", "target", "alias", "address"},
        "interface": {"mac", "source", "model", "target", "alias", "address", "link"},
        "serial": {"source", "target", "alias", "address"},
        "console": {"source", "target", "alias", "address"},
        "input": {"alias", "address"},
        "graphics": {"listen", "image", "clipboard", "filetransfer"},
        "video": {"model", "alias", "address"},
        "tpm": {"backend", "alias", "address"},
        "memballoon": {"alias", "address"},
    }
    allowed_nested_device_child_tags = {
        "serial/target": {"model"},
        "console/target": {"model"},
        "tpm/backend": {"source", "active_pcr_banks"},
        "tpm/backend/active_pcr_banks": {"sha256"},
        "controller/model": set(),
        "controller/target": set(),
    }
    unexpected_device_child_tags: list[str] = []

    def inspect_nested_device_children(node: ET.Element, path: str) -> None:
        allowed_children = allowed_nested_device_child_tags.get(path, set())
        for child in list(node):
            child_tag = child.tag.rsplit("}", 1)[-1]
            child_path = f"{path}/{child_tag}"
            if child_tag not in allowed_children:
                unexpected_device_child_tags.append(child_path)
            else:
                inspect_nested_device_children(child, child_path)

    for device in device_children:
        device_tag = device.tag.rsplit("}", 1)[-1]
        allowed_children = allowed_device_child_tags.get(device_tag, set())
        for child in list(device):
            child_tag = child.tag.rsplit("}", 1)[-1]
            if child_tag not in allowed_children:
                unexpected_device_child_tags.append(f"{device_tag}/{child_tag}")
            else:
                inspect_nested_device_children(child, f"{device_tag}/{child_tag}")
    allowed_namespaces = {
        "http://libosinfo.org/xmlns/libvirt/domain/1.0",
        CTOS_METADATA_NS,
    }
    namespaces = {
        node.tag[1:].split("}", 1)[0]
        for node in root.iter()
        if isinstance(node.tag, str) and node.tag.startswith("{")
    }
    allowed_root_tags = {
        "name",
        "uuid",
        "metadata",
        "memory",
        "currentMemory",
        "vcpu",
        "os",
        "features",
        "cpu",
        "clock",
        "on_poweroff",
        "on_reboot",
        "on_crash",
        "pm",
        "devices",
    }
    root_tags = [child.tag.rsplit("}", 1)[-1] for child in list(root)]
    os_node = root.find("./os")
    os_children = list(os_node) if os_node is not None else []
    feature_node = root.find("./features")
    feature_children = list(feature_node) if feature_node is not None else []
    timers = sorted(
        (
            {
                "name": node.attrib.get("name", ""),
                "present": node.attrib.get("present", ""),
                "tickpolicy": node.attrib.get("tickpolicy", ""),
                "unexpected_attributes": dict(
                    sorted(
                        (key, value)
                        for key, value in node.attrib.items()
                        if key not in {"name", "present", "tickpolicy"}
                    )
                ),
            }
            for node in root.findall("./clock/timer")
        ),
        key=lambda item: item["name"],
    )
    return {
        "domain_type": root.attrib.get("type", ""),
        "domain_unexpected_attributes": dict(
            sorted((key, value) for key, value in root.attrib.items() if key != "type")
        ),
        "unexpected_root_tags": sorted(tag for tag in root_tags if tag not in allowed_root_tags),
        "metadata_child_count": len(root.findall("./metadata/*")),
        "name": (root.findtext("name") or "").strip(),
        "uuid": (root.findtext("uuid") or "").strip(),
        "profile": xml_profile(root),
        "memory_bytes": memory_to_bytes(root.find("memory")),
        "current_memory_bytes": memory_to_bytes(root.find("currentMemory")),
        "memory_unexpected_attributes": (
            dict(
                sorted(
                    (key, value)
                    for key, value in root.find("memory").attrib.items()
                    if key != "unit"
                )
            )
            if root.find("memory") is not None
            else {}
        ),
        "current_memory_unexpected_attributes": (
            dict(
                sorted(
                    (key, value)
                    for key, value in root.find("currentMemory").attrib.items()
                    if key != "unit"
                )
            )
            if root.find("currentMemory") is not None
            else {}
        ),
        "vcpu": int((root.findtext("vcpu") or "0").strip()),
        "vcpu_attributes": (
            dict(sorted(root.find("vcpu").attrib.items()))
            if root.find("vcpu") is not None
            else {}
        ),
        "vcpu_placement": root.find("vcpu").attrib.get("placement", "") if root.find("vcpu") is not None else "",
        "os_type_text": (os_type.text or "").strip() if os_type is not None else "",
        "os_attributes": dict(sorted(os_node.attrib.items())) if os_node is not None else {},
        "os_type_attributes": dict(sorted(os_type.attrib.items())) if os_type is not None else {},
        "os_arch": os_type.attrib.get("arch", "") if os_type is not None else "",
        "os_child_tags": sorted(child.tag.rsplit("}", 1)[-1] for child in os_children),
        "os_boot_devs": [node.attrib.get("dev", "") for node in root.findall("./os/boot")],
        "bootmenu": root.find("./os/bootmenu").attrib.get("enable", "") if root.find("./os/bootmenu") is not None else "",
        "machine": os_type.attrib.get("machine", "") if os_type is not None else "",
        "loader": loader.text.strip() if loader is not None and loader.text else "",
        "loader_readonly": loader.attrib.get("readonly", "") if loader is not None else "",
        "loader_secure": loader.attrib.get("secure", "") if loader is not None else "",
        "loader_type": loader.attrib.get("type", "") if loader is not None else "",
        "loader_format": loader.attrib.get("format", "") if loader is not None else "",
        "loader_attributes": dict(sorted(loader.attrib.items())) if loader is not None else {},
        "nvram": nvram.text.strip() if nvram is not None and nvram.text else "",
        "nvram_format": nvram.attrib.get("format", "") if nvram is not None else "",
        "nvram_attributes": dict(sorted(nvram.attrib.items())) if nvram is not None else {},
        "bootmenu_attributes": (
            dict(sorted(root.find("./os/bootmenu").attrib.items()))
            if root.find("./os/bootmenu") is not None
            else {}
        ),
        "boot_attributes": [
            dict(sorted(node.attrib.items())) for node in root.findall("./os/boot")
        ],
        "feature_tags": sorted(child.tag.rsplit("}", 1)[-1] for child in feature_children),
        "feature_attributes": sorted(
            (
                child.tag.rsplit("}", 1)[-1],
                dict(sorted(child.attrib.items())),
            )
            for child in feature_children
        ),
        "smm": root.find("./features/smm").attrib.get("state", "") if root.find("./features/smm") is not None else "",
        "cpu_mode": cpu.attrib.get("mode", "") if cpu is not None else "",
        "cpu_check": cpu.attrib.get("check", "") if cpu is not None else "",
        "cpu_extra_attributes": (
            dict(
                sorted(
                    (key, value)
                    for key, value in cpu.attrib.items()
                    if key not in {"mode", "check"}
                )
            )
            if cpu is not None
            else {}
        ),
        "cpu_child_tags": (
            sorted(child.tag.rsplit("}", 1)[-1] for child in list(cpu))
            if cpu is not None
            else []
        ),
        "topology": dict(topology.attrib) if topology is not None else {},
        "clock_offset": root.find("clock").attrib.get("offset", "") if root.find("clock") is not None else "",
        "clock_unexpected_attributes": (
            dict(
                sorted(
                    (key, value)
                    for key, value in root.find("clock").attrib.items()
                    if key != "offset"
                )
            )
            if root.find("clock") is not None
            else {}
        ),
        "timers": timers,
        "on_poweroff": (root.findtext("on_poweroff") or "").strip(),
        "on_reboot": (root.findtext("on_reboot") or "").strip(),
        "on_crash": (root.findtext("on_crash") or "").strip(),
        "suspend_to_mem": root.find("./pm/suspend-to-mem").attrib.get("enabled", "") if root.find("./pm/suspend-to-mem") is not None else "",
        "suspend_to_disk": root.find("./pm/suspend-to-disk").attrib.get("enabled", "") if root.find("./pm/suspend-to-disk") is not None else "",
        "disk": disk_source.attrib.get("file", "") if disk_source is not None else "",
        "disk_dev": disk_target.attrib.get("dev", "") if disk_target is not None else "",
        "disk_bus": disk_target.attrib.get("bus", "") if disk_target is not None else "",
        "cdroms": sorted(cdroms),
        "disk_entries": disk_entries,
        "network": interface_source.attrib.get("network", "") if interface_source is not None else "",
        "nic_model": interface_model.attrib.get("type", "") if interface_model is not None else "",
        "graphics": graphics.attrib.get("type", "") if graphics is not None else "",
        "graphics_autoport": graphics.attrib.get("autoport", "") if graphics is not None else "",
        "graphics_port": graphics.attrib.get("port", "-1") if graphics is not None else "",
        "graphics_tls_port": graphics.attrib.get("tlsPort", "-1") if graphics is not None else "",
        "graphics_unexpected_attributes": (
            dict(
                sorted(
                    (key, value)
                    for key, value in graphics.attrib.items()
                    if key not in {"type", "autoport", "port", "tlsPort"}
                )
            )
            if graphics is not None
            else {}
        ),
        "graphics_listen": graphics_listen.attrib.get("type", "") if graphics_listen is not None else "",
        "graphics_image_compression": graphics_image.attrib.get("compression", "") if graphics_image is not None else "",
        "clipboard": clipboard.attrib.get("copypaste", "") if clipboard is not None else "",
        "filetransfer": filetransfer.attrib.get("enable", "") if filetransfer is not None else "",
        "tpm_model": tpm.attrib.get("model", "") if tpm is not None else "",
        "tpm_backend": tpm_backend.attrib.get("type", "") if tpm_backend is not None else "",
        "tpm_version": tpm_backend.attrib.get("version", "") if tpm_backend is not None else "",
        "tpm_persistent": tpm_backend.attrib.get("persistent_state", "") if tpm_backend is not None else "",
        "tpm_backend_unexpected_attributes": (
            dict(
                sorted(
                    (key, value)
                    for key, value in tpm_backend.attrib.items()
                    if key not in {"type", "version", "persistent_state"}
                )
            )
            if tpm_backend is not None
            else {}
        ),
        "tpm_source_type": tpm_source.attrib.get("type", "") if tpm_source is not None else "",
        "tpm_source": tpm_source.attrib.get("path", "") if tpm_source is not None else "",
        "active_pcr_banks": active_pcr_banks,
        "forbidden": sorted(forbidden),
        "channels": sorted(channels),
        "models": sorted(models),
        "virtio_models_present": any("virtio" in model.lower() for model in models),
        "controllers": controllers,
        "interfaces": interfaces,
        "inputs": inputs,
        "emulator": (emulator.text or "").strip() if emulator is not None else "",
        "serials": serials,
        "consoles": consoles,
        "videos": videos,
        "emulator_count": len(root.findall("./devices/emulator")),
        "serial_count": len(root.findall("./devices/serial")),
        "console_count": len(root.findall("./devices/console")),
        "graphics_count": len(root.findall("./devices/graphics")),
        "video_count": len(root.findall("./devices/video")),
        "tpm_count": len(root.findall("./devices/tpm")),
        "memballoon_count": len(root.findall("./devices/memballoon")),
        "unexpected_device_tags": sorted(tag for tag in device_tags if tag not in allowed_device_tags),
        "unexpected_device_child_tags": sorted(unexpected_device_child_tags),
        "unknown_namespaces": sorted(namespaces - allowed_namespaces),
        "memballoon_model": root.find("./devices/memballoon").attrib.get("model", "") if root.find("./devices/memballoon") is not None else "",
        "rng": root.find("./devices/rng") is not None,
    }


def expected_signature(profile: str) -> dict[str, Any]:
    cdroms = [str(WINDOWS_ISO_PATH)] if profile == "install" else []
    disk_entries = [
        {
            "attributes": {"device": "disk", "type": "file"},
            "driver_attributes": {
                "discard": "unmap",
                "name": "qemu",
                "type": "qcow2",
            },
            "source_attributes": {"file": str(DISK_PATH)},
            "target_attributes": {"bus": "sata", "dev": "sda"},
            "readonly": False,
        }
    ]
    if profile == "install":
        disk_entries.append(
            {
                "attributes": {"device": "cdrom", "type": "file"},
                "driver_attributes": {"name": "qemu", "type": "raw"},
                "source_attributes": {"file": str(WINDOWS_ISO_PATH)},
                "target_attributes": {"bus": "sata", "dev": "sdb"},
                "readonly": True,
            }
        )
    return {
        "domain_type": "kvm",
        "domain_unexpected_attributes": {},
        "unexpected_root_tags": [],
        "metadata_child_count": 2,
        "name": DOMAIN,
        "uuid": DOMAIN_UUID,
        "profile": profile,
        "memory_bytes": 8192 * 1024 * 1024,
        "current_memory_bytes": 8192 * 1024 * 1024,
        "memory_unexpected_attributes": {},
        "current_memory_unexpected_attributes": {},
        "vcpu": 4,
        "vcpu_attributes": {"placement": "static"},
        "vcpu_placement": "static",
        "os_type_text": "hvm",
        "os_attributes": {},
        "os_type_attributes": {"arch": "x86_64", "machine": "pc-q35-11.0"},
        "os_arch": "x86_64",
        "os_child_tags": sorted(
            ["type", "loader", "nvram", "bootmenu", "boot", *( ["boot"] if profile == "install" else [])]
        ),
        "os_boot_devs": ["cdrom", "hd"] if profile == "install" else ["hd"],
        "bootmenu": "yes",
        "machine": "pc-q35-11.0",
        "loader": str(OVMF_CODE_PATH),
        "loader_readonly": "yes",
        "loader_secure": "yes",
        "loader_type": "pflash",
        "loader_format": "raw",
        "loader_attributes": {
            "format": "raw",
            "readonly": "yes",
            "secure": "yes",
            "type": "pflash",
        },
        "nvram": str(NVRAM_PATH),
        "nvram_format": "raw",
        "nvram_attributes": {"format": "raw"},
