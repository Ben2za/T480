def signature_errors(signature: dict[str, Any], expected: dict[str, Any], label: str = "") -> list[str]:
    prefix = f"{label}: " if label else ""
    errors = [
        f"{prefix}{key}={signature.get(key)!r}, expected {value!r}"
        for key, value in expected.items()
        if signature.get(key) != value
    ]
    if set(signature) != set(expected):
        errors.append(
            f"{prefix}signature keys differ: missing={sorted(set(expected) - set(signature))}, "
            f"unexpected={sorted(set(signature) - set(expected))}"
        )
    return errors


def validate_xml_file(path: Path, profile: str) -> dict[str, Any]:
    errors: list[str] = []
    signature: dict[str, Any] = {}
    if not path.exists():
        return {"ok": False, "path": str(path), "profile": profile, "errors": ["file missing"]}
    try:
        root = ET.fromstring(path.read_text(encoding="utf-8"))
        signature = xml_signature(root)
    except (ET.ParseError, OSError, ValueError) as error:
        return {"ok": False, "path": str(path), "profile": profile, "errors": [str(error)]}

    expected = expected_signature(profile)
    errors.extend(signature_errors(signature, expected))

    validator = shutil.which("virt-xml-validate")
    schema = {"available": bool(validator), "ok": False, "message": "virt-xml-validate not found"}
    if validator:
        result = run([validator, str(path), "domain"])
        schema = {
            "available": True,
            "ok": result.rc == 0,
            "message": result.stdout or result.stderr,
        }
        if result.rc != 0:
            errors.append(schema["message"] or "libvirt schema validation failed")
    else:
        errors.append("virt-xml-validate not found")
    return {
        "ok": not errors,
        "path": str(path),
        "profile": profile,
        "signature": signature,
        "schema": schema,
        "errors": errors,
    }


def repo_validation_state() -> dict[str, Any]:
    profiles = {
        profile: validate_xml_file(path, profile)
        for profile, path in PROFILE_PATHS.items()
    }
    return {"ok": all(item["ok"] for item in profiles.values()), "profiles": profiles}


def media_identities() -> dict[str, Any]:
    """Resolve only the service identities required by managed ISO media."""

    errors: list[str] = []
    identities: dict[str, int | None] = {
        "root_uid": None,
        "qemu_uid": None,
        "libvirt_gid": None,
    }
    for key, kind, name in (
        ("root_uid", "user", "root"),
        ("qemu_uid", "user", LIBVIRT_QEMU_USER),
        ("libvirt_gid", "group", LIBVIRT_OPERATOR_GROUP),
    ):
        try:
            if kind == "user":
                identities[key] = pwd.getpwnam(name).pw_uid
            else:
                identities[key] = grp.getgrnam(name).gr_gid
        except KeyError:
            errors.append(f"required {kind} {name!r} is missing")
    return {"ok": not errors, **identities, "errors": errors}


def media_artifact_state(verify_hash: bool = False) -> dict[str, Any]:
    """Inspect only the fixed ISO artifact, independently of its attestation."""

    errors: list[str] = []
    actual_hash = ""
    size = 0
    identities = media_identities()
    errors.extend(identities["errors"])
    exists = WINDOWS_ISO_PATH.exists() or WINDOWS_ISO_PATH.is_symlink()
    safe_regular = False
    if not exists:
        errors.append(f"Windows ISO missing at managed path: {WINDOWS_ISO_PATH}")
    else:
        try:
            metadata = WINDOWS_ISO_PATH.lstat()
            if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
                errors.append("Windows ISO must be a regular non-symlink file in ctos-iso")
            elif WINDOWS_ISO_PATH.resolve(strict=True) != WINDOWS_ISO_PATH:
                errors.append("Windows ISO must resolve to its exact managed path")
            elif metadata.st_nlink != 1:
                errors.append("Windows ISO must have exactly one hard link")
            else:
                size = metadata.st_size
                if size <= 0:
                    errors.append("Windows ISO is empty")
                elif identities["ok"]:
                    metadata_errors = exact_metadata_errors(
                        WINDOWS_ISO_PATH,
                        "Windows ISO",
                        identities["qemu_uid"],
                        identities["libvirt_gid"],
                        MEDIA_MODE,
                    )
                    errors.extend(metadata_errors)
                    safe_regular = not metadata_errors
        except OSError as error:
            errors.append(f"cannot inspect Windows ISO: {error}")
    if verify_hash and safe_regular:
        try:
            actual_hash = sha256_file(WINDOWS_ISO_PATH)
        except OSError as error:
            errors.append(f"cannot hash Windows ISO: {error}")
        else:
            if actual_hash != WINDOWS_SHA256:
                errors.append(
                    f"Windows ISO SHA-256 mismatch: {actual_hash} != {WINDOWS_SHA256}"
                )
    return {
        "ok": not errors and (not verify_hash or actual_hash == WINDOWS_SHA256),
        "exists": exists,
        "size": size,
        "actual_sha256": actual_hash,
        "identities": identities,
        "errors": errors,
    }


def media_state(verify_hash: bool = False) -> dict[str, Any]:
    artifact = media_artifact_state(verify_hash=verify_hash)
    errors = list(artifact["errors"])
    identities = artifact["identities"]
    attestation: dict[str, Any] = {}
    attestation_exists = MEDIA_ATTESTATION_PATH.exists() or MEDIA_ATTESTATION_PATH.is_symlink()
    if not attestation_exists:
        errors.append(f"media attestation missing: {MEDIA_ATTESTATION_PATH}")
    else:
        try:
            metadata = MEDIA_ATTESTATION_PATH.lstat()
            if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
                errors.append("media attestation must be a regular non-symlink file")
            elif MEDIA_ATTESTATION_PATH.resolve(strict=True) != MEDIA_ATTESTATION_PATH:
                errors.append("media attestation must resolve to its exact managed path")
            elif metadata.st_nlink != 1:
                errors.append("media attestation must have exactly one hard link")
            elif identities["ok"]:
                metadata_errors = exact_metadata_errors(
                    MEDIA_ATTESTATION_PATH,
                    "media attestation",
                    identities["root_uid"],
                    identities["libvirt_gid"],
                    MEDIA_ATTESTATION_MODE,
                )
                errors.extend(metadata_errors)
                if not metadata_errors:
                    attestation = strict_json_object(MEDIA_ATTESTATION_PATH)
        except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
            errors.append(f"media attestation is invalid or unreadable: {error}")

    required = {
        "schema": MEDIA_ATTESTATION_SCHEMA,
        "pool": ISO_POOL,
        "filename": WINDOWS_ISO_NAME,
        "managed_path": str(WINDOWS_ISO_PATH),
        "release": WINDOWS_RELEASE,
        "language": WINDOWS_LANGUAGE,
        "size": artifact["size"],
        "sha256": WINDOWS_SHA256,
        "hash_source": WINDOWS_HASH_SOURCE,
        "entitlement_status": ELIGIBLE_DURABLE_ENTITLEMENT,
    }
    if attestation:
        expected_keys = {*required, "imported_utc"}
        actual_keys = set(attestation)
        if actual_keys != expected_keys:
            errors.append(
                "media attestation keys differ: "
                f"missing={sorted(expected_keys - actual_keys)}, "
                f"unexpected={sorted(actual_keys - expected_keys)}"
            )
        for key, expected in required.items():
            if attestation.get(key) != expected:
                errors.append(
                    f"media attestation {key}={attestation.get(key)!r}, expected {expected!r}"
                )
        imported_utc = attestation.get("imported_utc")
        try:
            imported_time = dt.datetime.fromisoformat(str(imported_utc))
            if imported_time.tzinfo is None or imported_time.utcoffset() != dt.timedelta(0):
                raise ValueError("timestamp is not UTC")
        except (TypeError, ValueError) as error:
            errors.append(f"media attestation imported_utc is invalid: {error}")
        if verify_hash and artifact["actual_sha256"]:
            if attestation.get("sha256") != artifact["actual_sha256"]:
                errors.append("media attestation SHA-256 does not match the managed ISO")

    verified = (
        verify_hash
        and not errors
        and artifact["actual_sha256"] == WINDOWS_SHA256
        and bool(attestation)
    )
    return {
        "ok": not errors and artifact["ok"] and bool(attestation),
        "verified": verified,
        "release": WINDOWS_RELEASE,
        "language": WINDOWS_LANGUAGE,
        "download_sku": WINDOWS_DOWNLOAD_SKU,
        "path": str(WINDOWS_ISO_PATH),
        "pool": ISO_POOL,
        "filename": WINDOWS_ISO_NAME,
        "size": artifact["size"],
        "expected_sha256": WINDOWS_SHA256,
        "actual_sha256": artifact["actual_sha256"],
        "hash_source": WINDOWS_HASH_SOURCE,
        "attestation_path": str(MEDIA_ATTESTATION_PATH),
        "attestation": attestation,
        "driver_policy": "Windows inbox SATA/AHCI and e1000e only; no VirtIO media",
        "errors": errors,
    }


def exact_object_keys(payload: Any, expected: set[str], label: str) -> dict[str, Any]:
    if not isinstance(payload, dict):
        raise ValueError(f"{label} must be an object")
    actual = set(payload)
    if actual != expected:
        raise ValueError(
            f"{label} keys differ: missing={sorted(expected - actual)}, "
            f"unexpected={sorted(actual - expected)}"
        )
    return payload


def managed_json_object(path: Path, label: str) -> tuple[dict[str, Any], list[str]]:
    errors: list[str] = []
    payload: dict[str, Any] = {}
    identities = media_identities()
    errors.extend(identities["errors"])
    exists = path.exists() or path.is_symlink()
    if not exists:
        return {}, [*errors, f"{label} missing: {path}"]
    descriptor: int | None = None
    try:
        if path.resolve(strict=True) != path:
            errors.append(f"{label} must resolve to its exact managed path")
        else:
            descriptor = os.open(
                path,
                os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
            )
            initial = os.fstat(descriptor)
            path_metadata = path.lstat()
            if not stat.S_ISREG(initial.st_mode):
                errors.append(f"{label} must be a regular non-symlink file")
            if (initial.st_dev, initial.st_ino) != (path_metadata.st_dev, path_metadata.st_ino):
                errors.append(f"{label} changed while it was opened")
            if initial.st_nlink != 1:
                errors.append(f"{label} must have exactly one hard link")
            if identities["ok"]:
                if (
                    initial.st_uid != identities["root_uid"]
                    or initial.st_gid != identities["libvirt_gid"]
                ):
                    errors.append(
                        f"{label} owner is {initial.st_uid}:{initial.st_gid}, expected "
                        f"{identities['root_uid']}:{identities['libvirt_gid']}"
                    )
                actual_mode = stat.S_IMODE(initial.st_mode)
                if actual_mode != MANAGED_JSON_MODE:
                    errors.append(
                        f"{label} mode is {actual_mode:04o}, expected {MANAGED_JSON_MODE:04o}"
                    )
            if not errors:
                raw = b""
                while len(raw) <= 65536:
                    chunk = os.read(descriptor, min(8192, 65537 - len(raw)))
                    if not chunk:
                        break
                    raw += chunk
                final = os.fstat(descriptor)
                if source_stat_signature(final) != source_stat_signature(initial):
                    errors.append(f"{label} changed during read")
                else:
                    payload = strict_json_bytes(raw)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        errors.append(f"{label} is invalid or unreadable: {error}")
    finally:
        if descriptor is not None:
            os.close(descriptor)
    return payload, errors


def run_attestation_state(require_current_environment: bool = True) -> dict[str, Any]:
    payload, errors = managed_json_object(RUN_ATTESTATION_PATH, "maintenance run attestation")
    if payload:
        expected_keys = {
            "schema",
            "run_id",
            "domain",
            "domain_uuid",
            "profile",
            "prepared_utc",
            "challenge",
            "host_boot_id",
            "workflow_sha256",
            "hardware_sha256",
            "entitlement_status",
            "media_sha256",
            "windows_release",
            "preinstall_attestation_sha256",
            "preinstall_disk_attestation_sha256",
        }
        try:
            exact_object_keys(payload, expected_keys, "maintenance run attestation")
            canonical_uuid(payload["run_id"], "run_id")
            parse_utc_timestamp(payload["prepared_utc"], "prepared_utc")
            canonical_uuid(payload["host_boot_id"], "host_boot_id")
        except ValueError as error:
            errors.append(str(error))
        required = {
            "schema": RUN_ATTESTATION_SCHEMA,
            "domain": DOMAIN,
            "domain_uuid": DOMAIN_UUID,
            "profile": "install",
            "host_boot_id": payload.get("host_boot_id"),
            "entitlement_status": ELIGIBLE_DURABLE_ENTITLEMENT,
        }
        for key, expected in required.items():
            if payload.get(key) != expected:
                errors.append(f"run attestation {key}={payload.get(key)!r}, expected {expected!r}")
        if require_current_environment:
            try:
                current_workflow_hash = sha256_file(Path(__file__).resolve())
            except OSError as error:
                errors.append(f"cannot hash current workflow: {error}")
            else:
                if payload.get("workflow_sha256") != current_workflow_hash:
                    errors.append("run attestation belongs to a different workflow revision")
        preinstall_hash = str(payload.get("preinstall_attestation_sha256", ""))
        preinstall_disk_hash = str(payload.get("preinstall_disk_attestation_sha256", ""))
        challenge = str(payload.get("challenge", ""))
        if not re.fullmatch(r"[0-9a-f]{64}", challenge):
            errors.append("run attestation challenge must be 256-bit lowercase hex")
        workflow_hash = str(payload.get("workflow_sha256", ""))
        if not HEX_SHA256_RE.fullmatch(workflow_hash):
            errors.append("run attestation workflow_sha256 is invalid")
        hardware_hash = str(payload.get("hardware_sha256", ""))
        if not HEX_SHA256_RE.fullmatch(hardware_hash):
            errors.append("run attestation hardware_sha256 is invalid")
        elif require_current_environment and hardware_hash != canonical_json_sha256(
            expected_signature("install")
        ):
            errors.append("run attestation belongs to a different install hardware policy")
        media_hash = str(payload.get("media_sha256", ""))
        if not HEX_SHA256_RE.fullmatch(media_hash):
            errors.append("run attestation media_sha256 is invalid")
        elif require_current_environment and media_hash != WINDOWS_SHA256:
            errors.append("run attestation belongs to different Windows installation media")
        windows_release = payload.get("windows_release")
        if not isinstance(windows_release, str) or not re.fullmatch(r"[0-9]{2}H[12]", windows_release):
            errors.append("run attestation windows_release is invalid")
        elif require_current_environment and windows_release != WINDOWS_RELEASE:
            errors.append("run attestation belongs to a different Windows release policy")
        if not HEX_SHA256_RE.fullmatch(preinstall_hash):
            errors.append("run attestation preinstall_attestation_sha256 is invalid")
        elif STATE_ATTESTATION_PATH.is_file() and not STATE_ATTESTATION_PATH.is_symlink():
            try:
                actual = sha256_file(STATE_ATTESTATION_PATH)
                if actual != preinstall_hash:
                    errors.append(
                        f"pre-install attestation SHA-256 mismatch: {actual} != {preinstall_hash}"
                    )
            except OSError as error:
                errors.append(f"cannot hash pre-install attestation: {error}")
        else:
            errors.append(f"pre-install attestation missing or unsafe: {STATE_ATTESTATION_PATH}")
        if not HEX_SHA256_RE.fullmatch(preinstall_disk_hash):
            errors.append("run attestation preinstall_disk_attestation_sha256 is invalid")
        else:
            disk_provenance = preinstall_disk_state(verify_current=False)
            if not disk_provenance["ok"]:
                errors.extend(disk_provenance["errors"])
            else:
                try:
                    actual_disk_hash, _disk_metadata = stable_regular_file_hash(
                        PREINSTALL_DISK_ATTESTATION_PATH,
                        "pre-install disk attestation",
                    )
                    if actual_disk_hash != preinstall_disk_hash:
                        errors.append(
                            "pre-install disk attestation SHA-256 differs from the install run"
                        )
                except (OSError, ValueError) as error:
                    errors.append(f"cannot hash pre-install disk attestation: {error}")
    return {
        "ok": bool(payload) and not errors,
        "path": str(RUN_ATTESTATION_PATH),
        "run_id": str(payload.get("run_id", "")),
        "payload": payload,
        "errors": errors,
    }


def validate_guest_evidence(
    payload: dict[str, Any],
    *,
    expected_phase: str,
    expected_run_id: str,
    expected_challenge: str,
    expected_host_boot_id: str,
    expected_workflow_sha256: str,
    run_prepared_utc: str,
    expected_windows_release: str = WINDOWS_RELEASE,
    now: dt.datetime | None = None,
    enforce_freshness: bool = True,
) -> list[str]:
    errors: list[str] = []
    try:
        exact_object_keys(
            payload,
            {
                "schema",
                "evidence_id",
                "run_id",
                "challenge",
                "host_boot_id",
                "workflow_sha256",
                "phase",
                "captured_utc",
                "collection",
                "system",
                "network",
                "windows",
                "security",
                "storage",
                "power",
                "devices",
                "privacy",
                "apple_devices",
            },
            "guest evidence",
        )
        canonical_uuid(payload["evidence_id"], "evidence_id")
        canonical_uuid(payload["run_id"], "run_id")
        canonical_uuid(payload["host_boot_id"], "host_boot_id")
        captured = parse_utc_timestamp(payload["captured_utc"], "captured_utc")
        run_prepared = parse_utc_timestamp(run_prepared_utc, "run prepared_utc")
        current = now or dt.datetime.now(dt.timezone.utc)
        if enforce_freshness:
            if captured > current + dt.timedelta(minutes=5):
                raise ValueError("captured_utc is in the future")
            if captured < current - dt.timedelta(days=7):
                raise ValueError("captured_utc is older than seven days")
        if captured < run_prepared:
            raise ValueError("captured_utc predates the attested install run")

        system = exact_object_keys(
            payload["system"],
            {"installation_complete", "clock_synchronized"},
            "system",
        )
        network = exact_object_keys(
            payload["network"],
            {"ctos_nat_egress"},
            "network",
        )
        windows = exact_object_keys(
            payload["windows"],
            {
                "product_name",
                "display_version",
                "build",
                "activation",
                "evaluation",
                "pending_reboot",
                "pending_updates",
            },
            "windows",
        )
        security = exact_object_keys(
            payload["security"],
            {
                "secure_boot",
                "tpm_present",
                "tpm_ready",
                "tpm_spec",
                "defender_enabled",
                "real_time_protection",
                "firewall_profiles_enabled",
            },
            "security",
        )
        storage = exact_object_keys(
            payload["storage"],
            {"bitlocker_encrypted", "bitlocker_protection"},
            "storage",
        )
        power = exact_object_keys(
            payload["power"],
            {"hibernate_enabled", "ac_sleep_timeout_minutes"},
            "power",
        )
        devices = exact_object_keys(payload["devices"], {"problem_count"}, "devices")
        privacy = exact_object_keys(
            payload["privacy"],
            {"personal_microsoft_account", "apple_account", "phone_ever_attached"},
            "privacy",
        )
        apple = exact_object_keys(
            payload["apple_devices"],
            {
                "installed",
                "product_id",
                "package_family",
                "publisher",
                "status",
                "opened_without_phone",
            },
            "apple_devices",
        )
    except (KeyError, TypeError, ValueError) as error:
        return [str(error)]

    required_top = {
        "schema": GUEST_EVIDENCE_SCHEMA,
        "run_id": expected_run_id,
        "challenge": expected_challenge,
        "host_boot_id": expected_host_boot_id,
        "workflow_sha256": expected_workflow_sha256,
        "phase": expected_phase,
        "collection": "operator-reviewed-console",
    }
    for key, expected in required_top.items():
        if payload.get(key) != expected:
            errors.append(f"guest evidence {key}={payload.get(key)!r}, expected {expected!r}")
    scalar_types = (
        (payload, "schema", str),
        (payload, "evidence_id", str),
        (payload, "run_id", str),
        (payload, "challenge", str),
        (payload, "host_boot_id", str),
        (payload, "workflow_sha256", str),
        (payload, "phase", str),
        (payload, "captured_utc", str),
        (payload, "collection", str),
        (system, "installation_complete", bool),
        (system, "clock_synchronized", bool),
        (network, "ctos_nat_egress", bool),
        (windows, "product_name", str),
        (windows, "display_version", str),
        (windows, "build", str),
        (windows, "activation", str),
        (windows, "evaluation", bool),
        (windows, "pending_reboot", bool),
        (windows, "pending_updates", bool),
        (security, "secure_boot", bool),
        (security, "tpm_present", bool),
        (security, "tpm_ready", bool),
        (security, "tpm_spec", str),
        (security, "defender_enabled", bool),
        (security, "real_time_protection", bool),
        (security, "firewall_profiles_enabled", list),
        (storage, "bitlocker_encrypted", bool),
        (storage, "bitlocker_protection", bool),
        (power, "hibernate_enabled", bool),
        (power, "ac_sleep_timeout_minutes", int),
        (devices, "problem_count", int),
        (privacy, "personal_microsoft_account", bool),
        (privacy, "apple_account", bool),
        (privacy, "phone_ever_attached", bool),
        (apple, "installed", bool),
        (apple, "product_id", str),
        (apple, "package_family", str),
        (apple, "publisher", str),
        (apple, "status", str),
        (apple, "opened_without_phone", bool),
    )
    for section, key, expected_type in scalar_types:
        if type(section.get(key)) is not expected_type:
            errors.append(
                f"guest evidence {key} has type {type(section.get(key)).__name__}, "
                f"expected {expected_type.__name__}"
            )
    if not isinstance(windows["product_name"], str) or windows["product_name"] not in {
        "Windows 11 Home",
        "Windows 11 Pro",
    }:
        errors.append("windows product_name must be Windows 11 Home or Windows 11 Pro")
    if windows["display_version"] != expected_windows_release:
        errors.append(
            f"windows display_version={windows['display_version']!r}, "
            f"expected {expected_windows_release!r}"
        )
    if not isinstance(windows["build"], str) or not re.fullmatch(r"[0-9]{5,6}", windows["build"]):
        errors.append("windows build must be a five- or six-digit string")
    exact_values = (
        (system, "installation_complete", True),
        (system, "clock_synchronized", True),
        (network, "ctos_nat_egress", True),
        (windows, "activation", "Licensed"),
        (windows, "evaluation", False),
        (windows, "pending_reboot", False),
        (windows, "pending_updates", False),
        (security, "secure_boot", True),
        (security, "tpm_present", True),
        (security, "tpm_ready", True),
        (security, "tpm_spec", "2.0"),
        (security, "defender_enabled", True),
        (security, "real_time_protection", True),
        (storage, "bitlocker_encrypted", False),
        (storage, "bitlocker_protection", False),
        (power, "hibernate_enabled", False),
        (power, "ac_sleep_timeout_minutes", 0),
        (devices, "problem_count", 0),
        (privacy, "personal_microsoft_account", False),
        (privacy, "apple_account", False),
        (privacy, "phone_ever_attached", False),
    )
    for section, key, expected in exact_values:
        if section.get(key) != expected or type(section.get(key)) is not type(expected):
            errors.append(f"guest evidence {key}={section.get(key)!r}, expected {expected!r}")
    if security["firewall_profiles_enabled"] != ["Domain", "Private", "Public"]:
        errors.append("all three canonical Windows firewall profiles must be enabled")

    if expected_phase == "windows-installed":
        required_apple = {
            "installed": False,
            "product_id": "",
            "package_family": "",
            "publisher": "",
            "status": "",
            "opened_without_phone": False,
        }
    elif expected_phase == "apple-ready":
        required_apple = {
            "installed": True,
            "product_id": "9NP83LWLPZ9K",
            "package_family": "AppleInc.AppleDevices_nzyj5cx40ttqa",
            "publisher": "Apple Inc.",
            "status": "OK",
            "opened_without_phone": True,
        }
    else:
        errors.append(f"unsupported guest evidence phase: {expected_phase!r}")
        required_apple = {}
    for key, expected in required_apple.items():
        if apple.get(key) != expected or type(apple.get(key)) is not type(expected):
            errors.append(f"apple_devices {key}={apple.get(key)!r}, expected {expected!r}")
    return errors


def guest_evidence_state(
    evidence_id: str,
    expected_phase: str,
    run_payload: dict[str, Any],
    *,
    enforce_freshness: bool = True,
) -> dict[str, Any]:
    try:
        canonical_id = canonical_uuid(evidence_id, "evidence_id")
    except ValueError as error:
        return {"ok": False, "path": "", "payload": {}, "errors": [str(error)]}
    path = EVIDENCE_ROOT / f"{canonical_id}.json"
    payload, errors = managed_json_object(path, "guest evidence")
    if payload:
        errors.extend(
            validate_guest_evidence(
                payload,
                expected_phase=expected_phase,
                expected_run_id=str(run_payload.get("run_id", "")),
                expected_challenge=str(run_payload.get("challenge", "")),
                expected_host_boot_id=str(run_payload.get("host_boot_id", "")),
                expected_workflow_sha256=str(run_payload.get("workflow_sha256", "")),
                run_prepared_utc=str(run_payload.get("prepared_utc", "")),
                expected_windows_release=str(run_payload.get("windows_release", "")),
                enforce_freshness=enforce_freshness,
            )
        )
        if payload.get("evidence_id") != canonical_id:
            errors.append("guest evidence ID does not match its managed filename")
    return {
        "ok": bool(payload) and not errors,
        "path": str(path),
        "payload": payload,
        "sha256": sha256_file(path) if payload and not errors else "",
        "errors": errors,
    }


def entitlement_state() -> dict[str, Any]:
    """Read the auditable, non-secret durable-VM entitlement decision."""

    errors: list[str] = []
    status = ""
    evaluation_status = ""
    if (
        not FLEET_PROFILE_PATH.exists()
        or FLEET_PROFILE_PATH.is_symlink()
        or not FLEET_PROFILE_PATH.is_file()
    ):
        errors.append(f"fleet profile missing or unsafe: {FLEET_PROFILE_PATH}")
    else:
        try:
            data = json.loads(FLEET_PROFILE_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            errors.append(f"fleet profile is invalid: {error}")
        else:
            domains = data.get("domains", [])
            if not isinstance(domains, list):
                errors.append("fleet profile domains value is not a list")
                domains = []
            matches = [
                item
                for item in domains
                if isinstance(item, dict) and item.get("name") == DOMAIN
            ]
            if len(matches) != 1:
                errors.append(f"expected exactly one {DOMAIN} profile, found {len(matches)}")
            else:
                status = str(matches[0].get("windows_vm_entitlement_status", ""))
                evaluation_status = str(matches[0].get("enterprise_evaluation_status", ""))
                if status != ELIGIBLE_DURABLE_ENTITLEMENT:
                    errors.append(
                        "durable Windows VM entitlement is not recorded; "
                        f"status={status!r}, required={ELIGIBLE_DURABLE_ENTITLEMENT!r}"
                    )
    return {
        "ok": not errors,
        "profile": str(FLEET_PROFILE_PATH),
        "status": status,
        "required_status": ELIGIBLE_DURABLE_ENTITLEMENT,
        "enterprise_evaluation_status": evaluation_status,
        "errors": errors,
    }


def inspect_secure_boot_varstore(path: Path) -> dict[str, Any]:
    tool = shutil.which("virt-fw-vars")
    if not tool:
        return {"ok": False, "tool": "", "markers": {}, "errors": ["virt-fw-vars not found"]}
    result = run([tool, "-i", str(path), "--print", "--verbose"], timeout=30.0)
    output = f"{result.stdout}\n{result.stderr}"
    markers = {marker: marker in output for marker in SECURE_BOOT_MARKERS}
    errors: list[str] = []
    if result.rc != 0:
        errors.append(result.stderr or result.stdout or "virt-fw-vars inspection failed")
    missing = [marker for marker, present in markers.items() if not present]
    if missing:
        errors.append("varstore inspection missing: " + ", ".join(missing))
    return {
        "ok": not errors,
        "tool": tool,
        "markers": markers,
        "errors": errors,
    }


def secure_state_identities() -> dict[str, Any]:
    """Resolve the packaged libvirt/swtpm identities without fixed numeric IDs."""

    errors: list[str] = []
    identities: dict[str, int | None] = {
        "root_uid": None,
        "qemu_uid": None,
        "swtpm_uid": None,
        "swtpm_gid": None,
        "libvirt_gid": None,
    }
    lookups = (
        ("root_uid", "user", "root"),
        ("qemu_uid", "user", LIBVIRT_QEMU_USER),
        ("swtpm_uid", "user", SWTPM_USER),
        ("swtpm_gid", "group", SWTPM_USER),
        ("libvirt_gid", "group", LIBVIRT_OPERATOR_GROUP),
    )
    for key, kind, name in lookups:
        try:
            if kind == "user":
                identities[key] = pwd.getpwnam(name).pw_uid
            else:
                identities[key] = grp.getgrnam(name).gr_gid
        except KeyError:
            errors.append(f"required {kind} {name!r} is missing")

    libvirt_gid = identities["libvirt_gid"]
    if os.geteuid() != 0 and libvirt_gid is not None:
        effective_groups = {os.getegid(), *os.getgroups()}
        if libvirt_gid not in effective_groups:
            errors.append(
                f"current process lacks effective {LIBVIRT_OPERATOR_GROUP!r} group membership; re-login first"
            )
    return {"ok": not errors, **identities, "errors": errors}


def exact_metadata_errors(
    path: Path,
    label: str,
    expected_uid: int,
    expected_gid: int,
    expected_mode: int,
) -> list[str]:
    errors: list[str] = []
    try:
        metadata = path.stat()
    except OSError as error:
        return [f"cannot stat {label}: {error}"]
    actual_mode = stat.S_IMODE(metadata.st_mode)
    if metadata.st_uid != expected_uid or metadata.st_gid != expected_gid:
        errors.append(
            f"{label} owner is {metadata.st_uid}:{metadata.st_gid}, "
            f"expected {expected_uid}:{expected_gid}"
        )
    if actual_mode != expected_mode:
        errors.append(f"{label} mode is {actual_mode:04o}, expected {expected_mode:04o}")
    return errors


def secure_state() -> dict[str, Any]:
    errors: list[str] = []
    attestation: dict[str, Any] = {}
    inspection: dict[str, Any] = {"ok": False, "errors": ["NVRAM not inspected"]}
    identities = secure_state_identities()
    errors.extend(identities["errors"])
    if not OVMF_CODE_PATH.is_file():
        errors.append(f"Secure Boot firmware missing: {OVMF_CODE_PATH}")

    root_safe = False
    try:
        if STATE_ROOT.is_symlink() or not STATE_ROOT.is_dir():
            errors.append("secure-state root must be a real directory, not a symlink")
        elif STATE_ROOT.resolve(strict=True) != STATE_ROOT:
            errors.append("secure-state root must resolve to its exact managed path")
        elif identities["ok"]:
            metadata_errors = exact_metadata_errors(
                STATE_ROOT,
                "secure-state root",
                identities["root_uid"],
                identities["libvirt_gid"],
                STATE_ROOT_MODE,
            )
            errors.extend(metadata_errors)
            root_safe = not metadata_errors
    except OSError as error:
        errors.append(f"cannot inspect secure-state root: {error}")

    nvram_safe = False
    if root_safe:
        try:
            if not NVRAM_PATH.exists():
                errors.append(f"prepared NVRAM missing: {NVRAM_PATH}")
            elif (
                NVRAM_PATH.is_symlink()
                or not NVRAM_PATH.is_file()
                or NVRAM_PATH.resolve(strict=True) != NVRAM_PATH
                or NVRAM_PATH.stat().st_size <= 0
                or NVRAM_PATH.stat().st_nlink != 1
            ):
                errors.append("prepared NVRAM must be a non-empty, single-link regular file at the managed path")
            elif identities["ok"]:
                metadata_errors = exact_metadata_errors(
                    NVRAM_PATH,
                    "prepared NVRAM",
                    identities["qemu_uid"],
                    identities["libvirt_gid"],
                    NVRAM_MODE,
                )
                errors.extend(metadata_errors)
                nvram_safe = not metadata_errors
        except OSError as error:
            errors.append(f"cannot inspect prepared NVRAM: {error}")

        try:
            if not TPM_STATE_PATH.exists():
                errors.append(f"private TPM state directory missing: {TPM_STATE_PATH}")
            elif (
                TPM_STATE_PATH.is_symlink()
                or not TPM_STATE_PATH.is_dir()
                or TPM_STATE_PATH.resolve(strict=True) != TPM_STATE_PATH
            ):
                errors.append("TPM state must be a real directory at the managed path, not a symlink")
            elif identities["ok"]:
                errors.extend(
                    exact_metadata_errors(
                        TPM_STATE_PATH,
                        "TPM state directory",
                        identities["swtpm_uid"],
                        identities["libvirt_gid"],
                        TPM_STATE_MODE,
                    )
                )
                contents = list(TPM_STATE_PATH.iterdir())
                if contents:
                    errors.append("TPM state must be strictly empty during the pre-install attestation phase")
        except OSError as error:
            errors.append(f"cannot inspect TPM state permissions/content: {error}")

        try:
            if not STATE_ATTESTATION_PATH.exists():
                errors.append(f"secure-state attestation missing: {STATE_ATTESTATION_PATH}")
            elif (
                STATE_ATTESTATION_PATH.is_symlink()
                or not STATE_ATTESTATION_PATH.is_file()
                or STATE_ATTESTATION_PATH.resolve(strict=True) != STATE_ATTESTATION_PATH
                or STATE_ATTESTATION_PATH.stat().st_nlink != 1
            ):
                errors.append("secure-state attestation must be a single-link regular file at the managed path")
            elif identities["ok"]:
                metadata_errors = exact_metadata_errors(
                    STATE_ATTESTATION_PATH,
                    "secure-state attestation",
                    identities["root_uid"],
                    identities["libvirt_gid"],
                    STATE_ATTESTATION_MODE,
                )
                errors.extend(metadata_errors)
                if not metadata_errors:
                    attestation = json.loads(STATE_ATTESTATION_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            errors.append(f"secure-state attestation is invalid or unreadable: {error}")
    else:
        errors.append("secure-state children were not inspected because the managed root is unsafe or missing")

    if nvram_safe:
        inspection = inspect_secure_boot_varstore(NVRAM_PATH)
        errors.extend(inspection["errors"])

    required = {
        "schema": SECURE_STATE_SCHEMA,
        "domain": DOMAIN,
        "nvram_path": str(NVRAM_PATH),
        "tpm_path": str(TPM_STATE_PATH),
        "secure_boot": True,
        "microsoft_db_2011": True,
        "microsoft_db_2023": True,
        "microsoft_kek_2011": True,
        "microsoft_kek_2023": True,
        "inspection": "virt-fw-vars --print",
        "phase": "pre-install",
        "state_permissions": {
            "root": f"root:{LIBVIRT_OPERATOR_GROUP} {STATE_ROOT_MODE:04o}",
            "nvram": f"{LIBVIRT_QEMU_USER}:{LIBVIRT_OPERATOR_GROUP} {NVRAM_MODE:04o}",
            "tpm": f"{SWTPM_USER}:{LIBVIRT_OPERATOR_GROUP} {TPM_STATE_MODE:04o}",
            "attestation": f"root:{LIBVIRT_OPERATOR_GROUP} {STATE_ATTESTATION_MODE:04o}",
        },
    }
    if attestation:
        for key, expected in required.items():
            if attestation.get(key) != expected:
                errors.append(f"attestation {key}={attestation.get(key)!r}, expected {expected!r}")
        recorded_hash = str(attestation.get("nvram_sha256", "")).lower()
        if not HEX_SHA256_RE.fullmatch(recorded_hash):
            errors.append("attestation nvram_sha256 is not a SHA-256 value")
        elif nvram_safe:
            try:
                actual_hash = sha256_file(NVRAM_PATH)
                if actual_hash != recorded_hash:
                    errors.append(f"NVRAM SHA-256 mismatch: {actual_hash} != {recorded_hash}")
            except OSError as error:
                errors.append(f"cannot hash prepared NVRAM: {error}")
    return {
        "ok": not errors,
        "nvram": str(NVRAM_PATH),
        "tpm_state": str(TPM_STATE_PATH),
        "attestation": str(STATE_ATTESTATION_PATH),
        "identities": identities,
        "varstore_inspection": inspection,
        "errors": errors,
    }


def postinstall_nvram_state() -> dict[str, Any]:
    errors: list[str] = []
    identities = secure_state_identities()
    errors.extend(identities["errors"])
    inspection: dict[str, Any] = {"ok": False, "errors": ["NVRAM not inspected"]}
    digest = ""
    metadata_payload: dict[str, int] = {}
    initial_metadata: os.stat_result | None = None
    safe = False
    try:
        if not NVRAM_PATH.exists():
            errors.append(f"post-install NVRAM missing: {NVRAM_PATH}")
        elif (
            NVRAM_PATH.is_symlink()
            or not NVRAM_PATH.is_file()
            or NVRAM_PATH.resolve(strict=True) != NVRAM_PATH
            or NVRAM_PATH.stat().st_nlink != 1
            or NVRAM_PATH.stat().st_size <= 0
        ):
            errors.append("post-install NVRAM must be a non-empty single-link regular managed file")
        elif identities["ok"]:
            metadata_errors = exact_metadata_errors(
                NVRAM_PATH,
                "post-install NVRAM",
                identities["qemu_uid"],
                identities["libvirt_gid"],
                NVRAM_MODE,
            )
            errors.extend(metadata_errors)
            if not metadata_errors:
                initial_metadata = stable_regular_file_stat(
                    NVRAM_PATH,
                    "post-install NVRAM",
                )
                safe = True
    except OSError as error:
        errors.append(f"cannot inspect post-install NVRAM: {error}")
    if safe:
        inspection = inspect_secure_boot_varstore(NVRAM_PATH)
        errors.extend(inspection["errors"])
        try:
            digest, final_metadata = stable_regular_file_hash(
                NVRAM_PATH,
                "post-install NVRAM",
            )
            if initial_metadata is None or source_stat_signature(
                final_metadata
            ) != source_stat_signature(initial_metadata):
                errors.append("post-install NVRAM changed across inspection and hashing")
                digest = ""
            else:
                metadata_payload = artifact_stat_payload(final_metadata)
        except (OSError, ValueError) as error:
            errors.append(f"cannot hash post-install NVRAM: {error}")
    return {
        "ok": not errors and bool(digest),
        "path": str(NVRAM_PATH),
        "sha256": digest,
        "stat": metadata_payload,
        "inspection": inspection,
        "errors": errors,
    }


def tpm_tree_state(require_nonempty: bool = True) -> dict[str, Any]:
    errors: list[str] = []
    entries: list[dict[str, Any]] = []
    identities = secure_state_identities()
    errors.extend(identities["errors"])
    root_safe = False
    try:
        if (
            TPM_STATE_PATH.is_symlink()
            or not TPM_STATE_PATH.is_dir()
            or TPM_STATE_PATH.resolve(strict=True) != TPM_STATE_PATH
        ):
            errors.append("post-install TPM state must be a real canonical directory")
        elif identities["ok"]:
            metadata_errors = exact_metadata_errors(
                TPM_STATE_PATH,
                "post-install TPM root",
                identities["swtpm_uid"],
                identities["libvirt_gid"],
                TPM_STATE_MODE,
            )
            errors.extend(metadata_errors)
            root_safe = not metadata_errors
    except OSError as error:
        errors.append(f"cannot inspect post-install TPM root: {error}")

    def visit(directory: Path) -> None:
        try:
            initial_directory = directory.lstat()
            with os.scandir(directory) as iterator:
                children = sorted(iterator, key=lambda item: item.name)
        except OSError as error:
            errors.append(f"cannot list TPM state tree: {error}")
            return
        for entry in children:
            path = Path(entry.path)
            relative = path.relative_to(TPM_STATE_PATH).as_posix()
            try:
                metadata = entry.stat(follow_symlinks=False)
            except OSError as error:
                errors.append(f"cannot stat TPM entry {relative}: {error}")
                continue
            if entry.is_symlink():
                errors.append(f"TPM state contains symlink: {relative}")
                continue
            if metadata.st_uid != identities.get("swtpm_uid"):
                errors.append(f"TPM entry {relative} has unexpected owner {metadata.st_uid}")
            if metadata.st_gid not in {
                identities.get("swtpm_gid"),
                identities.get("libvirt_gid"),
            }:
                errors.append(f"TPM entry {relative} has unexpected group {metadata.st_gid}")
            mode = stat.S_IMODE(metadata.st_mode)
            if mode & 0o022 or mode & 0o7000:
                errors.append(f"TPM entry {relative} has unsafe mode {mode:04o}")
            if entry.is_dir(follow_symlinks=False):
                entries.append(
                    {
                        "path": relative,
                        "type": "directory",
                        "mode": f"{mode:04o}",
                        "uid": metadata.st_uid,
                        "gid": metadata.st_gid,
                    }
                )
                visit(path)
            elif entry.is_file(follow_symlinks=False):
                if metadata.st_nlink != 1:
                    errors.append(f"TPM file {relative} must have exactly one hard link")
                    continue
                if metadata.st_size <= 0:
                    errors.append(f"TPM file {relative} must be non-empty")
                    continue
                descriptor: int | None = None
                try:
                    descriptor = os.open(
                        path,
                        os.O_RDONLY
                        | getattr(os, "O_CLOEXEC", 0)
                        | getattr(os, "O_NOFOLLOW", 0),
                    )
                    opened = os.fstat(descriptor)
                    if (opened.st_dev, opened.st_ino) != (metadata.st_dev, metadata.st_ino):
                        raise OSError("file changed while opening")
                    digest = sha256_fd(descriptor)
                    final = os.fstat(descriptor)
                    if source_stat_signature(final) != source_stat_signature(opened):
                        raise OSError("file changed while hashing")
                    path_final = path.lstat()
                    if source_stat_signature(path_final) != source_stat_signature(final):
                        raise OSError("file path changed while hashing")
                except OSError as error:
                    errors.append(f"cannot hash TPM entry {relative}: {error}")
                    continue
                finally:
                    if descriptor is not None:
                        os.close(descriptor)
                entries.append(
                    {
                        "path": relative,
                        "type": "file",
                        "mode": f"{mode:04o}",
                        "uid": metadata.st_uid,
                        "gid": metadata.st_gid,
                        "size": metadata.st_size,
                        "sha256": digest,
                    }
                )
            else:
                errors.append(f"TPM state contains unsupported object: {relative}")
        try:
            final_directory = directory.lstat()
            if source_stat_signature(final_directory) != source_stat_signature(initial_directory):
                errors.append(
                    f"TPM directory changed during traversal: "
                    f"{directory.relative_to(TPM_STATE_PATH).as_posix() or '.'}"
                )
        except OSError as error:
            errors.append(f"cannot re-stat TPM state directory: {error}")

    if root_safe:
        visit(TPM_STATE_PATH)
    file_count = sum(item["type"] == "file" for item in entries)
    if require_nonempty and file_count == 0:
        errors.append("post-install TPM state must contain at least one regular state file")
    tree_sha256 = canonical_json_sha256(entries) if entries and not errors else ""
    return {
        "ok": not errors and (not require_nonempty or file_count > 0),
        "path": str(TPM_STATE_PATH),
        "entries": entries,
        "file_count": file_count,
        "tree_sha256": tree_sha256,
        "errors": errors,
    }


def disk_postinstall_state(hash_disk: bool = True) -> dict[str, Any]:
    errors: list[str] = []
    info_data: Any = None
    check_data: Any = None
    digest = ""
    metadata_payload: dict[str, int] = {}
    initial_metadata: os.stat_result | None = None
    tool = shutil.which("qemu-img")
    if not tool:
        return {
            "ok": False,
            "path": str(DISK_PATH),
            "errors": ["qemu-img not found"],
        }
    volume = volume_state()
    if not volume.get("compatible"):
        errors.extend(volume.get("errors", ["managed disk is not compatible"]))
    identities = media_identities()
    errors.extend(identities["errors"])
    if not errors:
        try:
            initial_metadata = stable_regular_file_stat(DISK_PATH, "maintenance disk")
            if initial_metadata.st_uid != identities["qemu_uid"]:
                errors.append(
                    f"maintenance disk owner is {initial_metadata.st_uid}, "
                    f"expected {identities['qemu_uid']}"
                )
            if initial_metadata.st_gid != identities["libvirt_gid"]:
                errors.append(
                    f"maintenance disk group is {initial_metadata.st_gid}, "
                    f"expected {identities['libvirt_gid']}"
                )
            actual_mode = stat.S_IMODE(initial_metadata.st_mode)
            if actual_mode != DISK_MODE:
                errors.append(
                    f"maintenance disk mode is {actual_mode:04o}, expected {DISK_MODE:04o}"
                )
        except (OSError, ValueError) as error:
            errors.append(f"cannot inspect maintenance disk: {error}")
    if errors:
        return {
            "ok": False,
            "path": str(DISK_PATH),
            "sha256": "",
            "stat": {},
            "info": info_data,
            "check": check_data,
            "errors": errors,
        }
    info = run(
        [
            tool,
            "info",
            "--output=json",
            "--backing-chain",
            "-f",
            "qcow2",
            str(DISK_PATH),
        ],
        timeout=60.0,
    )
    if info.rc != 0:
        errors.append(info.stderr or info.stdout or "qemu-img info failed")
    else:
        try:
            info_data = json.loads(info.stdout)
            chain = info_data if isinstance(info_data, list) else [info_data]
            if len(chain) != 1 or not isinstance(chain[0], dict):
                errors.append("managed disk must have a one-element standalone backing chain")
            else:
                item = chain[0]
                if item.get("format") != "qcow2":
                    errors.append(f"disk format is {item.get('format')!r}, expected 'qcow2'")
                if item.get("virtual-size") != VOLUME_SIZE_BYTES:
                    errors.append(
                        f"disk virtual size is {item.get('virtual-size')!r}, expected {VOLUME_SIZE_BYTES}"
                    )
                if item.get("backing-filename") or item.get("full-backing-filename"):
                    errors.append("maintenance disk must not have a backing file")
                if item.get("snapshots"):
                    errors.append("maintenance disk must not contain internal snapshots")
                if item.get("encrypted"):
                    errors.append("maintenance disk must not be encrypted")
                if item.get("dirty-flag") is not False:
                    errors.append(
                        f"maintenance disk dirty-flag is {item.get('dirty-flag')!r}, expected False"
                    )
                format_specific = item.get("format-specific", {})
                if not isinstance(format_specific, dict):
                    errors.append("qemu-img format-specific metadata must be an object")
                    format_data: dict[str, Any] = {}
                else:
                    raw_format_data = format_specific.get("data", {})
                    if not isinstance(raw_format_data, dict):
                        errors.append("qemu-img format-specific data must be an object")
                        format_data = {}
                    else:
                        format_data = raw_format_data
                if format_data.get("bitmaps"):
                    errors.append("maintenance disk must not contain persistent dirty bitmaps")
                if format_data.get("encrypt"):
                    errors.append("unexpected qcow2 encryption metadata")
                if format_data.get("corrupt") is not False:
                    errors.append(
                        f"maintenance disk corrupt flag is {format_data.get('corrupt')!r}, "
                        "expected False"
                    )
        except (AttributeError, json.JSONDecodeError, TypeError) as error:
            errors.append(f"invalid qemu-img info JSON: {error}")
    check = run(
        [tool, "check", "--output=json", "-f", "qcow2", str(DISK_PATH)],
        timeout=300.0,
    )
    if check.rc != 0:
        errors.append(
            check.stderr or check.stdout or f"qemu-img check failed with status {check.rc}"
        )
    else:
        try:
            check_data = json.loads(check.stdout)
            if not isinstance(check_data, dict):
                errors.append("qemu-img check JSON root must be an object")
            else:
                for key in ("check-errors", "corruptions", "leaks"):
                    value = check_data.get(key, 0)
                    if type(value) is not int or value != 0:
                        errors.append(f"qemu-img check reports {key}={value!r}")
        except json.JSONDecodeError as error:
            errors.append(f"invalid qemu-img check JSON: {error}")
    if hash_disk and not errors:
        try:
            digest, metadata = stable_regular_file_hash(DISK_PATH, "maintenance disk")
            if initial_metadata is None or source_stat_signature(metadata) != source_stat_signature(
                initial_metadata
            ):
                errors.append("maintenance disk changed across qemu-img validation and hashing")
                digest = ""
            else:
                metadata_payload = artifact_stat_payload(metadata)
        except (OSError, ValueError) as error:
            errors.append(f"cannot hash maintenance disk: {error}")
    return {
        "ok": not errors and (not hash_disk or bool(digest)),
        "path": str(DISK_PATH),
        "sha256": digest,
        "stat": metadata_payload,
        "info": info_data,
        "check": check_data,
        "errors": errors,
    }


def offline_domain_guards(domain: dict[str, Any]) -> dict[str, Any]:
    errors: list[str] = []
    state = domain.get("info", {}).get("state", "").lower()
    if state not in {"shut off", "shutoff"}:
        errors.append(f"domain must be shut off, found {state!r}")
    if domain.get("info", {}).get("managed_save", "no").lower() not in {"", "no"}:
        errors.append("managed save state is present")
    for label, arguments in (
        ("snapshot", ["snapshot-list", DOMAIN, "--name"]),
        ("checkpoint", ["checkpoint-list", DOMAIN, "--name"]),
    ):
        result = virsh(arguments, readonly=True)
        if result.rc != 0:
            errors.append(result.stderr or result.stdout or f"cannot inspect {label}s")
        elif result.stdout.strip():
            errors.append(f"domain has {label}s: {result.stdout.splitlines()}")
    job = virsh(["domjobinfo", DOMAIN], readonly=True)
    if job.rc == 0:
        job_info = parse_info(job.stdout)
        job_type = job_info.get("job_type", "").lower()
        if job_type not in {"", "none"}:
            errors.append(f"domain job is active: {job_type!r}")
    else:
        message = f"{job.stdout}\n{job.stderr}".lower()
        if "no job is active" not in message and "no current job" not in message:
            errors.append(job.stderr or job.stdout or "cannot inspect domain jobs")
    return {"ok": not errors, "errors": errors}


def offline_state_fingerprint() -> dict[str, Any]:
    """Cheap receipt binding; the transition later performs full disk validation/hash."""

    disk_metadata = stable_regular_file_stat(DISK_PATH, "maintenance disk")
    nvram_digest, nvram_metadata = stable_regular_file_hash(NVRAM_PATH, "post-install NVRAM")
    tpm = tpm_tree_state(require_nonempty=True)
    if not tpm["ok"]:
        raise ValueError("cannot fingerprint TPM state: " + "; ".join(tpm["errors"]))
    payload = {
        "disk": artifact_stat_payload(disk_metadata),
        "nvram": {
            "stat": artifact_stat_payload(nvram_metadata),
            "sha256": nvram_digest,
        },
        "tpm_tree_sha256": tpm["tree_sha256"],
    }
    return {"payload": payload, "sha256": canonical_json_sha256(payload)}


def preinstall_provenance_state(run_payload: dict[str, Any]) -> dict[str, Any]:
    payload, errors = managed_json_object(
        STATE_ATTESTATION_PATH,
        "pre-install state attestation",
    )
    if payload:
        required = {
            "schema": SECURE_STATE_SCHEMA,
            "domain": DOMAIN,
            "phase": "pre-install",
            "nvram_path": str(NVRAM_PATH),
            "tpm_path": str(TPM_STATE_PATH),
            "secure_boot": True,
            "microsoft_db_2011": True,
            "microsoft_db_2023": True,
            "microsoft_kek_2011": True,
            "microsoft_kek_2023": True,
            "inspection": "virt-fw-vars --print",
        }
        for key, expected in required.items():
            if payload.get(key) != expected:
                errors.append(
                    f"pre-install attestation {key}={payload.get(key)!r}, expected {expected!r}"
                )
        try:
            digest, _metadata = stable_regular_file_hash(
                STATE_ATTESTATION_PATH,
                "pre-install state attestation",
            )
            if digest != run_payload.get("preinstall_attestation_sha256"):
                errors.append("pre-install attestation does not match the install run")
        except (OSError, ValueError) as error:
            digest = ""
            errors.append(f"cannot hash pre-install attestation: {error}")
    else:
        digest = ""
    return {
        "ok": bool(payload) and not errors,
        "path": str(STATE_ATTESTATION_PATH),
        "sha256": digest,
        "payload": payload,
        "errors": errors,
    }


def postinstall_consistency_state(
    evidence_id: str,
    *,
    allow_maintenance_profile: bool = False,
) -> dict[str, Any]:
    errors: list[str] = []
    # A shutdown receipt is the freshness boundary for this offline transition.
    # Once that immutable receipt exists, a host reboot, elapsed wall time, or a
    # reviewed workflow update must not invalidate an otherwise unchanged VM.
    run_state = run_attestation_state(require_current_environment=False)
    if not run_state["ok"]:
        errors.extend(run_state["errors"])
        run_payload: dict[str, Any] = {}
    else:
        run_payload = run_state["payload"]
    evidence = guest_evidence_state(
        evidence_id,
        "windows-installed",
        run_payload,
        enforce_freshness=False,
    )
    if not evidence["ok"]:
        errors.extend(evidence["errors"])
    receipt = shutdown_receipt_state(run_payload) if run_payload else {
        "ok": False,
        "payload": {},
        "errors": ["valid run required before shutdown receipt"],
    }
    if not receipt["ok"]:
        errors.extend(receipt["errors"])
    elif receipt["evidence_id"] != evidence_id:
        errors.append("shutdown receipt evidence ID differs from requested evidence")
    provenance = preinstall_provenance_state(run_payload) if run_payload else {
        "ok": False,
        "errors": ["valid run required before pre-install provenance"],
    }
    if not provenance["ok"]:
        errors.extend(provenance["errors"])

    domain = own_domain_state()
    allowed_profiles = {"install", "maintenance"} if allow_maintenance_profile else {"install"}
    if not domain.get("compatible") or domain.get("profile") not in allowed_profiles:
        errors.extend(domain.get("errors", ["domain profile is not compatible for transition"]))
        if domain.get("compatible") and domain.get("profile") not in allowed_profiles:
            expected = "install or maintenance" if allow_maintenance_profile else "install"
            errors.append(
                f"domain profile must be {expected} at this transition boundary, "
                f"found {domain.get('profile')!r}"
            )
    guards = offline_domain_guards(domain)
    if not guards["ok"]:
        errors.extend(guards["errors"])
    numeric = domain_numeric_state()
    if not numeric["ok"]:
        errors.extend(numeric["errors"])
    elif numeric["state"] != 5:
        errors.append(
            f"domain numeric state must currently be shutoff (5), found "
            f"{numeric['state']}/{numeric['reason']}"
        )

    disk = disk_postinstall_state(hash_disk=True)
    nvram = postinstall_nvram_state()
    tpm = tpm_tree_state(require_nonempty=True)
    for component in (disk, nvram, tpm):
        if not component["ok"]:
            errors.extend(component["errors"])
    try:
        fingerprint = offline_state_fingerprint()
        receipt_fingerprint = receipt.get("payload", {}).get("artifact_stat_sha256")
        if receipt_fingerprint and fingerprint["sha256"] != receipt_fingerprint:
            errors.append("offline artifacts changed after the ACPI shutdown receipt")
        if disk.get("stat") != fingerprint["payload"].get("disk"):
            errors.append("maintenance disk changed between full validation and fingerprinting")
        fingerprint_nvram = fingerprint["payload"].get("nvram", {})
        if (
            nvram.get("sha256") != fingerprint_nvram.get("sha256")
            or nvram.get("stat") != fingerprint_nvram.get("stat")
        ):
            errors.append("NVRAM changed between full validation and fingerprinting")
        if tpm.get("tree_sha256") != fingerprint["payload"].get("tpm_tree_sha256"):
            errors.append("TPM state changed between full validation and fingerprinting")
    except (OSError, ValueError) as error:
        fingerprint = {"payload": {}, "sha256": ""}
        errors.append(f"cannot verify offline artifact fingerprint: {error}")
    return {
        "ok": not errors,
        "run": run_state,
        "evidence": evidence,
        "receipt": receipt,
        "provenance": provenance,
        "domain": domain,
        "guards": guards,
        "numeric_state": numeric,
        "disk": disk,
        "nvram": nvram,
        "tpm": tpm,
        "fingerprint": fingerprint,
        "errors": errors,
    }


def build_maintenance_payload(
    consistency: dict[str, Any],
    generation: str,
) -> dict[str, Any]:
    evidence = consistency["evidence"]
    receipt = consistency["receipt"]
    run_state = consistency["run"]
    return {
        "schema": MAINTENANCE_STATE_SCHEMA,
        "generation": canonical_uuid(generation, "generation"),
        "phase": "windows-installed",
        "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "domain": {
            "name": DOMAIN,
            "uuid": DOMAIN_UUID,
            "profile": "maintenance",
            "hardware_sha256": canonical_json_sha256(expected_signature("maintenance")),
        },
        "run": {
            "id": run_state["run_id"],
            "attestation_sha256": sha256_file(RUN_ATTESTATION_PATH),
        },
        "disk": {
            "path": str(DISK_PATH),
            "format": "qcow2",
            "virtual_size": VOLUME_SIZE_BYTES,
            "sha256": consistency["disk"]["sha256"],
            "qemu_check": "clean",
        },
        "nvram": {
            "path": str(NVRAM_PATH.relative_to(STATE_ROOT)),
            "sha256": consistency["nvram"]["sha256"],
            "secure_boot": True,
        },
        "tpm": {
            "path": str(TPM_STATE_PATH.relative_to(STATE_ROOT)),
            "tree_sha256": consistency["tpm"]["tree_sha256"],
            "file_count": consistency["tpm"]["file_count"],
        },
        "evidence": {
            "id": evidence["payload"]["evidence_id"],
            "sha256": evidence["sha256"],
        },
        "shutdown": {
            "mode": "acpi-observed",
            "receipt_sha256": sha256_file(SHUTDOWN_RECEIPT_PATH),
            "artifact_stat_sha256": receipt["payload"]["artifact_stat_sha256"],
        },
        "provenance": {
            "preinstall_sha256": consistency["provenance"]["sha256"],
            "entitlement_status": ELIGIBLE_DURABLE_ENTITLEMENT,
            "workflow_sha256": run_state["payload"]["workflow_sha256"],
        },
    }


def maintenance_payload_errors(payload: Any) -> list[str]:
    """Validate the complete immutable maintenance payload without host I/O."""

    errors: list[str] = []
    try:
        top = exact_object_keys(
            payload,
            {
                "schema",
                "generation",
                "phase",
                "created_utc",
                "domain",
                "run",
                "disk",
                "nvram",
                "tpm",
                "evidence",
                "shutdown",
                "provenance",
            },
            "maintenance state attestation",
        )
        canonical_uuid(top["generation"], "maintenance generation")
        parse_utc_timestamp(top["created_utc"], "maintenance created_utc")
        domain_payload = exact_object_keys(
            top["domain"],
            {"name", "uuid", "profile", "hardware_sha256"},
            "maintenance domain",
        )
        run_payload = exact_object_keys(
            top["run"], {"id", "attestation_sha256"}, "maintenance run"
        )
        disk_payload = exact_object_keys(
            top["disk"],
            {"path", "format", "virtual_size", "sha256", "qemu_check"},
            "maintenance disk",
        )
        nvram_payload = exact_object_keys(
            top["nvram"], {"path", "sha256", "secure_boot"}, "maintenance NVRAM"
        )
        tpm_payload = exact_object_keys(
            top["tpm"], {"path", "tree_sha256", "file_count"}, "maintenance TPM"
        )
        evidence_payload = exact_object_keys(
            top["evidence"], {"id", "sha256"}, "maintenance evidence"
        )
        shutdown_payload = exact_object_keys(
            top["shutdown"],
            {"mode", "receipt_sha256", "artifact_stat_sha256"},
            "maintenance shutdown",
        )
        provenance_payload = exact_object_keys(
            top["provenance"],
            {"preinstall_sha256", "entitlement_status", "workflow_sha256"},
            "maintenance provenance",
        )
        canonical_uuid(run_payload["id"], "maintenance run id")
        canonical_uuid(evidence_payload["id"], "maintenance evidence id")
    except (KeyError, TypeError, ValueError) as error:
        return [str(error)]

    required = (
        (top, "schema", MAINTENANCE_STATE_SCHEMA),
        (top, "phase", "windows-installed"),
        (domain_payload, "name", DOMAIN),
        (domain_payload, "uuid", DOMAIN_UUID),
        (domain_payload, "profile", "maintenance"),
        (disk_payload, "path", str(DISK_PATH)),
        (disk_payload, "format", "qcow2"),
        (disk_payload, "virtual_size", VOLUME_SIZE_BYTES),
        (disk_payload, "qemu_check", "clean"),
        (nvram_payload, "path", str(NVRAM_PATH.relative_to(STATE_ROOT))),
        (nvram_payload, "secure_boot", True),
        (tpm_payload, "path", str(TPM_STATE_PATH.relative_to(STATE_ROOT))),
        (shutdown_payload, "mode", "acpi-observed"),
        (provenance_payload, "entitlement_status", ELIGIBLE_DURABLE_ENTITLEMENT),
    )
    for section, key, expected in required:
        if section.get(key) != expected or type(section.get(key)) is not type(expected):
            errors.append(f"maintenance {key}={section.get(key)!r}, expected {expected!r}")
    file_count = tpm_payload.get("file_count")
    if type(file_count) is not int or file_count <= 0:
        errors.append("maintenance TPM file_count must be a positive integer")
    for section, key in (
        (domain_payload, "hardware_sha256"),
        (run_payload, "attestation_sha256"),
        (disk_payload, "sha256"),
        (nvram_payload, "sha256"),
        (tpm_payload, "tree_sha256"),
        (evidence_payload, "sha256"),
        (shutdown_payload, "receipt_sha256"),
        (shutdown_payload, "artifact_stat_sha256"),
        (provenance_payload, "preinstall_sha256"),
        (provenance_payload, "workflow_sha256"),
    ):
        if not HEX_SHA256_RE.fullmatch(str(section.get(key, ""))):
            errors.append(f"maintenance {key} is not a SHA-256 value")
    return errors


def maintenance_state(verify_artifacts: bool = True) -> dict[str, Any]:
    payload, errors = managed_json_object(
        MAINTENANCE_ATTESTATION_PATH,
        "maintenance state attestation",
    )
    if payload:
        errors.extend(maintenance_payload_errors(payload))
        try:
            exact_object_keys(
                payload,
                {
                    "schema",
                    "generation",
                    "phase",
                    "created_utc",
                    "domain",
                    "run",
                    "disk",
                    "nvram",
                    "tpm",
                    "evidence",
                    "shutdown",
                    "provenance",
                },
                "maintenance state attestation",
            )
            canonical_uuid(payload["generation"], "generation")
            parse_utc_timestamp(payload["created_utc"], "created_utc")
            domain_payload = exact_object_keys(
                payload["domain"],
                {"name", "uuid", "profile", "hardware_sha256"},
                "maintenance domain",
            )
            run_payload = exact_object_keys(
                payload["run"], {"id", "attestation_sha256"}, "maintenance run"
            )
            disk_payload = exact_object_keys(
                payload["disk"],
                {"path", "format", "virtual_size", "sha256", "qemu_check"},
                "maintenance disk",
            )
            nvram_payload = exact_object_keys(
                payload["nvram"], {"path", "sha256", "secure_boot"}, "maintenance NVRAM"
            )
            tpm_payload = exact_object_keys(
                payload["tpm"], {"path", "tree_sha256", "file_count"}, "maintenance TPM"
            )
            evidence_payload = exact_object_keys(
                payload["evidence"], {"id", "sha256"}, "maintenance evidence"
            )
            shutdown_payload = exact_object_keys(
                payload["shutdown"],
                {"mode", "receipt_sha256", "artifact_stat_sha256"},
                "maintenance shutdown",
            )
            provenance_payload = exact_object_keys(
                payload["provenance"],
                {"preinstall_sha256", "entitlement_status", "workflow_sha256"},
                "maintenance provenance",
            )
        except (KeyError, TypeError, ValueError) as error:
            errors.append(str(error))
            domain_payload = run_payload = disk_payload = nvram_payload = {}
            tpm_payload = evidence_payload = shutdown_payload = provenance_payload = {}
        required = {
            "schema": MAINTENANCE_STATE_SCHEMA,
            "phase": "windows-installed",
        }
        for key, expected in required.items():
            if payload.get(key) != expected:
                errors.append(f"maintenance {key}={payload.get(key)!r}, expected {expected!r}")
        component_required = (
            (domain_payload, "name", DOMAIN),
            (domain_payload, "uuid", DOMAIN_UUID),
            (domain_payload, "profile", "maintenance"),
            (disk_payload, "path", str(DISK_PATH)),
            (disk_payload, "format", "qcow2"),
            (disk_payload, "virtual_size", VOLUME_SIZE_BYTES),
            (disk_payload, "qemu_check", "clean"),
            (nvram_payload, "path", str(NVRAM_PATH.relative_to(STATE_ROOT))),
            (nvram_payload, "secure_boot", True),
            (tpm_payload, "path", str(TPM_STATE_PATH.relative_to(STATE_ROOT))),
            (shutdown_payload, "mode", "acpi-observed"),
            (provenance_payload, "entitlement_status", ELIGIBLE_DURABLE_ENTITLEMENT),
        )
        for section, key, expected in component_required:
            if section.get(key) != expected or type(section.get(key)) is not type(expected):
                errors.append(f"maintenance {key}={section.get(key)!r}, expected {expected!r}")
        for section, key in (
            (run_payload, "attestation_sha256"),
            (disk_payload, "sha256"),
            (nvram_payload, "sha256"),
            (tpm_payload, "tree_sha256"),
            (evidence_payload, "sha256"),
            (shutdown_payload, "receipt_sha256"),
            (shutdown_payload, "artifact_stat_sha256"),
            (provenance_payload, "preinstall_sha256"),
            (provenance_payload, "workflow_sha256"),
        ):
            if not HEX_SHA256_RE.fullmatch(str(section.get(key, ""))):
                errors.append(f"maintenance {key} is not a SHA-256 value")

        if verify_artifacts and not errors:
            run_state = run_attestation_state(require_current_environment=False)
            if not run_state["ok"] or run_state["run_id"] != run_payload.get("id"):
                errors.append("maintenance run attestation is invalid")
            try:
                run_digest, _run_metadata = stable_regular_file_hash(
                    RUN_ATTESTATION_PATH,
                    "maintenance run attestation",
                )
                if run_digest != run_payload.get("attestation_sha256"):
                    errors.append("maintenance run attestation hash differs from its payload")
            except (OSError, ValueError) as error:
                errors.append(f"cannot hash maintenance run attestation: {error}")
            evidence = guest_evidence_state(
                str(evidence_payload.get("id", "")),
                "windows-installed",
                run_state.get("payload", {}),
                enforce_freshness=False,
            )
            if not evidence["ok"] or evidence["sha256"] != evidence_payload.get("sha256"):
                errors.append("maintenance guest evidence is invalid")
            receipt = shutdown_receipt_state(run_state.get("payload", {}))
            if not receipt["ok"]:
                errors.append("maintenance ACPI shutdown receipt is invalid")
            try:
                receipt_digest, _receipt_metadata = stable_regular_file_hash(
                    SHUTDOWN_RECEIPT_PATH,
                    "ACPI shutdown receipt",
                )
                if receipt_digest != shutdown_payload.get("receipt_sha256"):
                    errors.append("maintenance shutdown receipt hash differs from its payload")
            except (OSError, ValueError) as error:
                errors.append(f"cannot hash maintenance shutdown receipt: {error}")
            if receipt.get("payload", {}).get("artifact_stat_sha256") != shutdown_payload.get(
                "artifact_stat_sha256"
            ):
                errors.append("maintenance artifact fingerprint differs from its shutdown receipt")
            provenance = preinstall_provenance_state(run_state.get("payload", {}))
            if not provenance["ok"] or provenance["sha256"] != provenance_payload.get(
                "preinstall_sha256"
            ):
                errors.append("maintenance pre-install provenance is invalid")
            if run_state.get("payload", {}).get("workflow_sha256") != provenance_payload.get(
                "workflow_sha256"
            ):
                errors.append("maintenance workflow provenance differs from its install run")
            disk = disk_postinstall_state(hash_disk=True)
            nvram = postinstall_nvram_state()
            tpm = tpm_tree_state(require_nonempty=True)
            if not disk["ok"] or disk["sha256"] != disk_payload.get("sha256"):
                errors.append("maintenance disk no longer matches its attestation")
            if not nvram["ok"] or nvram["sha256"] != nvram_payload.get("sha256"):
                errors.append("maintenance NVRAM no longer matches its attestation")
            if not tpm["ok"] or tpm["tree_sha256"] != tpm_payload.get("tree_sha256"):
                errors.append("maintenance TPM tree no longer matches its attestation")
            if tpm.get("file_count") != tpm_payload.get("file_count"):
                errors.append("maintenance TPM file count no longer matches its attestation")
            domain = own_domain_state()
            if not domain.get("compatible") or domain.get("profile") != "maintenance":
                errors.append("exact compatible maintenance domain is not defined")
            guards = offline_domain_guards(domain)
            if not guards["ok"]:
                errors.extend(guards["errors"])
            numeric = domain_numeric_state()
            if not numeric["ok"]:
                errors.extend(numeric["errors"])
            elif numeric["state"] != 5:
                errors.append(
                    f"maintenance domain must be shut off (5), found "
                    f"{numeric['state']}/{numeric['reason']}"
                )
            try:
                fingerprint = offline_state_fingerprint()
                if fingerprint["sha256"] != shutdown_payload.get("artifact_stat_sha256"):
                    errors.append("maintenance offline artifact fingerprint is stale")
            except (OSError, ValueError) as error:
                errors.append(f"cannot fingerprint maintenance artifacts: {error}")
    return {
        "ok": bool(payload) and not errors,
        "path": str(MAINTENANCE_ATTESTATION_PATH),
        "payload": payload,
        "errors": errors,
    }


def transition_intent_state() -> dict[str, Any]:
    payload, errors = managed_json_object(TRANSITION_INTENT_PATH, "transition intent")
    if payload:
        try:
            exact_object_keys(
                payload,
                {
                    "schema",
                    "transition_id",
                    "operation",
                    "created_utc",
                    "evidence_id",
                    "run_id",
                    "source_profile",
                    "target_profile",
                    "maintenance",
                    "maintenance_sha256",
                },
                "transition intent",
            )
            canonical_uuid(payload["transition_id"], "transition_id")
            canonical_uuid(payload["evidence_id"], "evidence_id")
            canonical_uuid(payload["run_id"], "run_id")
            parse_utc_timestamp(payload["created_utc"], "created_utc")
            exact_object_keys(
                payload["maintenance"],
                {
                    "schema",
                    "generation",
                    "phase",
                    "created_utc",
                    "domain",
                    "run",
                    "disk",
                    "nvram",
                    "tpm",
                    "evidence",
                    "shutdown",
                    "provenance",
                },
                "intent maintenance payload",
            )
            payload_errors = maintenance_payload_errors(payload["maintenance"])
            if payload_errors:
                raise ValueError("invalid intent maintenance payload: " + "; ".join(payload_errors))
            if payload["run_id"] != payload["maintenance"]["run"]["id"]:
                raise ValueError("transition intent run_id differs from maintenance run id")
            if payload["evidence_id"] != payload["maintenance"]["evidence"]["id"]:
                raise ValueError(
                    "transition intent evidence_id differs from maintenance evidence id"
                )
        except (KeyError, TypeError, ValueError) as error:
            errors.append(str(error))
        required = {
            "schema": TRANSITION_INTENT_SCHEMA,
            "operation": "install-to-maintenance",
            "source_profile": "install",
            "target_profile": "maintenance",
        }
        for key, expected in required.items():
            if payload.get(key) != expected:
                errors.append(f"transition intent {key}={payload.get(key)!r}, expected {expected!r}")
        maintenance_digest = canonical_json_sha256(payload.get("maintenance", {}))
        if payload.get("maintenance_sha256") != maintenance_digest:
            errors.append("transition intent maintenance payload digest mismatch")
    return {
        "ok": bool(payload) and not errors,
        "path": str(TRANSITION_INTENT_PATH),
        "payload": payload,
        "errors": errors,
    }


def transition_complete_state() -> dict[str, Any]:
    payload, errors = managed_json_object(TRANSITION_COMPLETE_PATH, "transition completion")
    if payload:
        try:
            exact_object_keys(
                payload,
                {
                    "schema",
                    "transition_id",
                    "completed_utc",
                    "intent_sha256",
                    "maintenance_sha256",
                    "target_profile",
                },
                "transition completion",
            )
            canonical_uuid(payload["transition_id"], "transition_id")
            parse_utc_timestamp(payload["completed_utc"], "completed_utc")
        except (KeyError, TypeError, ValueError) as error:
            errors.append(str(error))
        intent = transition_intent_state()
        maintenance_state_result = maintenance_state(verify_artifacts=True)
        maintenance = maintenance_state_result.get("payload", {})
        maintenance_errors = maintenance_state_result.get("errors", [])
        if not intent["ok"]:
            errors.append("transition completion has no valid intent")
        if not maintenance_state_result["ok"] or maintenance_errors or not maintenance:
            errors.append("transition completion has no valid maintenance attestation")
        elif intent["ok"] and maintenance != intent["payload"].get("maintenance"):
            errors.append("transition completion maintenance payload differs from its intent")
        required = {
            "schema": TRANSITION_COMPLETE_SCHEMA,
            "transition_id": intent.get("payload", {}).get("transition_id"),
            "intent_sha256": sha256_file(TRANSITION_INTENT_PATH) if intent["ok"] else "",
            "maintenance_sha256": (
                sha256_file(MAINTENANCE_ATTESTATION_PATH) if maintenance and not maintenance_errors else ""
            ),
            "target_profile": "maintenance",
        }
        for key, expected in required.items():
            if payload.get(key) != expected:
                errors.append(
                    f"transition completion {key}={payload.get(key)!r}, expected {expected!r}"
                )
    return {
        "ok": bool(payload) and not errors,
        "path": str(TRANSITION_COMPLETE_PATH),
        "payload": payload,
        "errors": errors,
    }


def consistency_matches_maintenance(
    consistency: dict[str, Any],
    maintenance: dict[str, Any],
) -> list[str]:
    errors: list[str] = []
    payload_errors = maintenance_payload_errors(maintenance)
    if payload_errors:
        return [f"invalid maintenance intent payload: {error}" for error in payload_errors]
    comparisons = (
        (maintenance.get("run", {}).get("id"), consistency["run"].get("run_id"), "run id"),
        (
            maintenance.get("run", {}).get("attestation_sha256"),
            sha256_file(RUN_ATTESTATION_PATH),
            "run attestation hash",
        ),
        (maintenance.get("disk", {}).get("sha256"), consistency["disk"].get("sha256"), "disk hash"),
        (maintenance.get("nvram", {}).get("sha256"), consistency["nvram"].get("sha256"), "NVRAM hash"),
        (
            maintenance.get("tpm", {}).get("tree_sha256"),
            consistency["tpm"].get("tree_sha256"),
            "TPM tree hash",
        ),
        (
            maintenance.get("evidence", {}).get("sha256"),
            consistency["evidence"].get("sha256"),
            "evidence hash",
        ),
        (
            maintenance.get("shutdown", {}).get("receipt_sha256"),
            sha256_file(SHUTDOWN_RECEIPT_PATH),
            "shutdown receipt hash",
        ),
        (
            maintenance.get("shutdown", {}).get("artifact_stat_sha256"),
            consistency["fingerprint"].get("sha256"),
            "artifact fingerprint",
        ),
    )
    for recorded, actual, label in comparisons:
        if recorded != actual:
            errors.append(f"intent {label}={recorded!r}, current {actual!r}")
    return errors


def maintenance_commit_boundary(maintenance: dict[str, Any]) -> dict[str, Any]:
    errors = maintenance_payload_errors(maintenance)
    boundary = offline_receipt_domain_state(
        allowed_profiles={"maintenance"},
        require_shutdown_reason=False,
    )
    if not boundary["ok"]:
        errors.extend(boundary["errors"])
    try:
        fingerprint = offline_state_fingerprint()
        expected = maintenance.get("shutdown", {}).get("artifact_stat_sha256")
        if fingerprint["sha256"] != expected:
            errors.append("maintenance artifacts differ at the completion boundary")
    except (AttributeError, OSError, ValueError) as error:
        fingerprint = {"payload": {}, "sha256": ""}
        errors.append(f"cannot fingerprint maintenance completion boundary: {error}")
    return {
        "ok": not errors,
        "boundary": boundary,
        "fingerprint": fingerprint,
        "errors": errors,
    }


def incomplete_transition_exists() -> bool:
    intent_exists = TRANSITION_INTENT_PATH.exists() or TRANSITION_INTENT_PATH.is_symlink()
    orphan_markers = any(
        path.exists() or path.is_symlink()
        for path in (MAINTENANCE_ATTESTATION_PATH, TRANSITION_COMPLETE_PATH)
    )
    if not intent_exists:
        return orphan_markers
    return not transition_complete_state()["ok"]


def nearest_existing_path(path: Path) -> Path:
    candidate = path
    while not candidate.exists() and candidate != candidate.parent:
        candidate = candidate.parent
    return candidate


def ac_power_check() -> Check:
    if not POWER_SUPPLY_ROOT.is_dir():
        return Check("ac-power", False, f"cannot inspect {POWER_SUPPLY_ROOT}")
    adapters: list[Path] = []
    for entry in POWER_SUPPLY_ROOT.iterdir():
        type_path = entry / "type"
        supply_type = ""
        try:
            if type_path.exists():
                supply_type = read_text(type_path).lower()
        except OSError:
            continue
        if supply_type == "mains":
            adapters.append(entry)
    if not adapters:
        return Check("ac-power", False, "no Mains AC adapter telemetry found")
    for adapter in adapters:
        try:
            if read_text(adapter / "online") == "1":
                return Check("ac-power", True, f"online adapter: {adapter.name}")
        except OSError:
            continue
    return Check("ac-power", False, "all detected adapters report offline or unreadable")


def typec_partner_check() -> Check:
    """Reject phone-like source/host partners, including non-enumerated phones."""

    if not TYPEC_ROOT.is_dir():
        return Check("typec-partners", False, f"cannot inspect {TYPEC_ROOT}")
    try:
        partners = sorted(TYPEC_ROOT.glob("port*-partner"), key=lambda path: path.name)
    except OSError as error:
        return Check("typec-partners", False, f"Type-C inventory failed: {error}")
    unsafe: list[str] = []
    unknown: list[str] = []
    safe: list[str] = []
    for partner in partners:
        if not partner.exists():
            continue
        port_name = partner.name.removesuffix("-partner")
        port = TYPEC_ROOT / port_name
        try:
            power_role = selected_role(read_text(port / "power_role"))
            data_role = selected_role(read_text(port / "data_role"))
        except OSError:
            unknown.append(port_name)
            continue
        if power_role == "source" or data_role == "host":
            unsafe.append(port_name)
        elif power_role == "sink" and data_role == "device":
            safe.append(port_name)
        else:
            unknown.append(port_name)
    if unsafe:
        return Check(
            "typec-partners",
            False,
            "Type-C source/host partner present on " + ", ".join(unsafe),
        )
    if unknown:
        return Check(
            "typec-partners",
            False,
            "Type-C partner role unreadable or unexpected on " + ", ".join(unknown),
        )
    detail = (
        "no Type-C partner present"
        if not partners
        else "only sink/device partner(s): " + ", ".join(safe)
    )
    return Check("typec-partners", True, detail)


def memory_check() -> Check:
    try:
        values: dict[str, int] = {}
        for line in MEMINFO_PATH.read_text(encoding="utf-8").splitlines():
            if ":" not in line:
                continue
            key, value = line.split(":", 1)
            parts = value.strip().split()
            if parts:
                values[key] = int(parts[0]) * 1024
        available = values.get("MemAvailable", 0)
    except (OSError, ValueError) as error:
        return Check("memory", False, f"cannot inspect available memory: {error}")
    ok = available >= MIN_AVAILABLE_MEMORY_BYTES
    return Check(
        "memory",
        ok,
        f"available={available} required={MIN_AVAILABLE_MEMORY_BYTES}",
    )


def storage_check() -> Check:
    anchor = nearest_existing_path(STORAGE_ROOT)
    try:
        free = shutil.disk_usage(anchor).free
    except OSError as error:
        return Check("storage", False, f"cannot inspect storage: {error}")
    ok = free >= MIN_FREE_STORAGE_BYTES
    return Check(
        "storage",
        ok,
        f"anchor={anchor} free={free} required={MIN_FREE_STORAGE_BYTES}",
    )


def apple_usb_check() -> Check:
    if not USB_DEVICES_ROOT.is_dir():
        return Check("apple-usb", False, f"cannot inspect {USB_DEVICES_ROOT}")
    count = 0
    inventory_errors: list[str] = []
    try:
        entries = list(USB_DEVICES_ROOT.iterdir())
    except OSError as error:
        return Check("apple-usb", False, f"USB inventory failed: {error}")
    for entry in entries:
        vendor_path = entry / "idVendor"
        try:
            metadata = vendor_path.stat()
        except FileNotFoundError:
            continue
        except OSError as error:
            inventory_errors.append(f"{entry.name}: idVendor metadata {type(error).__name__}")
            continue
        if not stat.S_ISREG(metadata.st_mode):
            inventory_errors.append(f"{entry.name}: idVendor is not a regular sysfs attribute")
            continue
        try:
            vendor = read_text(vendor_path).lower()
        except FileNotFoundError:
            continue
        except OSError as error:
            inventory_errors.append(f"{entry.name}: idVendor read {type(error).__name__}")
            continue
        if not re.fullmatch(r"[0-9a-f]{4}", vendor):
            inventory_errors.append(f"{entry.name}: idVendor is empty or malformed")
            continue
        if vendor == APPLE_USB_VENDOR:
            count += 1
    if inventory_errors:
        return Check(
            "apple-usb",
            False,
            "USB vendor inventory is incomplete or malformed: " + "; ".join(inventory_errors),
        )
    if count:
        return Check("apple-usb", False, f"{count} Apple USB device(s) visible; disconnect before any VM action")
    return Check("apple-usb", True, "no Apple USB vendor 05ac device is visible")


def candidate_usb_children() -> list[str]:
    """Resolve USB sysfs devices back to the candidate PCI controller."""

    candidate = PCI_DEVICES_ROOT / USB_CONTROLLER
    try:
        candidate_real = candidate.resolve(strict=True)
    except OSError:
        return []
    children: list[str] = []
    try:
        vendor_paths = sorted(USB_DEVICES_ROOT.glob("*/idVendor"), key=lambda path: str(path))
    except OSError:
        return ["<inventory-unreadable>"]
    for vendor_path in vendor_paths:
        root = vendor_path.parent
        try:
            vendor = read_text(vendor_path).lower()
            device_real = root.resolve(strict=True)
        except OSError:
            continue
        if root.name.startswith("usb") and vendor == "1d6b":
            continue
        if candidate_real == device_real or candidate_real in device_real.parents:
            children.append(root.name)
    return children


def domain_guard(name: str) -> Check:
    result = virsh(["domstate", name], readonly=True)
    if result.rc == 0:
        state = result.stdout.strip().lower()
        ok = state in {"shut off", "shutoff"}
        return Check(f"domain-{name}", ok, f"state={state}")
    message = (result.stderr or result.stdout).lower()
    if "failed to get domain" in message or "domain not found" in message or "no domain with matching name" in message:
        return Check(f"domain-{name}", True, "domain not defined")
    return Check(f"domain-{name}", False, result.stderr or result.stdout or "domain state unavailable")


def host_checks() -> list[Check]:
    return [
        domain_guard(KALI_DOMAIN),
        apple_usb_check(),
        typec_partner_check(),
        ac_power_check(),
        memory_check(),
        storage_check(),
    ]


def infra_state() -> dict[str, Any]:
    if not INFRA_SCRIPT.is_file():
        return {"ok": False, "error": f"missing infra helper: {INFRA_SCRIPT}"}
    result = run([str(INFRA_SCRIPT), "--json", "status"])
    if result.rc not in {0, 1} or not result.stdout:
        return {"ok": False, "error": result.stderr or result.stdout or "infra status failed"}
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        return {"ok": False, "error": f"invalid infra JSON: {error}"}
    resources = data.get("resources", [])
    ready = bool(data.get("ok")) and all(
        item.get("compatible")
        and item.get("active")
        and not item.get("errors")
        and not item.get("actions")
        for item in resources
    )
    return {"ok": ready, "raw": data, "error": "" if ready else "CTOS libvirt infra is not converged"}


def is_not_found(result: CommandResult) -> bool:
    message = f"{result.stdout}\n{result.stderr}".lower()
    return any(
        phrase in message
        for phrase in (
            "failed to get domain",
            "domain not found",
            "no domain with matching name",
            "failed to get vol",
            "storage volume not found",
        )
    )


def volume_state() -> dict[str, Any]:
    info = virsh(["vol-info", "--pool", VOLUME_POOL, VOLUME_NAME], readonly=True)
    if info.rc != 0:
        if is_not_found(info):
            return {"ok": True, "exists": False, "compatible": False, "errors": []}
        return {"ok": False, "exists": False, "compatible": False, "errors": [info.stderr or info.stdout]}
    errors: list[str] = []
    path_result = virsh(["vol-path", "--pool", VOLUME_POOL, VOLUME_NAME], readonly=True)
    if path_result.rc != 0:
        errors.append(path_result.stderr or "vol-path failed")
    elif path_result.stdout != str(DISK_PATH):
        errors.append(f"disk path mismatch: {path_result.stdout} != {DISK_PATH}")
    dump = virsh(["vol-dumpxml", "--pool", VOLUME_POOL, VOLUME_NAME], readonly=True)
    capacity = 0
    disk_format = ""
    volume_owner = -1
    volume_group = -1
    volume_mode = -1
    if dump.rc != 0:
        errors.append(dump.stderr or "vol-dumpxml failed")
    else:
        try:
            root = ET.fromstring(dump.stdout)
            capacity = int((root.findtext("capacity") or "0").strip())
            format_node = root.find("./target/format")
            disk_format = format_node.attrib.get("type", "") if format_node is not None else ""
            volume_owner = int((root.findtext("./target/permissions/owner") or "-1").strip())
            volume_group = int((root.findtext("./target/permissions/group") or "-1").strip())
            volume_mode = int((root.findtext("./target/permissions/mode") or "-1").strip(), 8)
        except (ET.ParseError, ValueError) as error:
            errors.append(f"invalid volume XML: {error}")
    if capacity != VOLUME_SIZE_BYTES:
        errors.append(f"disk capacity mismatch: {capacity} != {VOLUME_SIZE_BYTES}")
    if disk_format != "qcow2":
        errors.append(f"disk format mismatch: {disk_format!r} != 'qcow2'")
    identities = media_identities()
    errors.extend(identities["errors"])
    expected_owner = identities.get("qemu_uid")
    expected_group = identities.get("libvirt_gid")
    if volume_owner != expected_owner:
        errors.append(f"volume owner is {volume_owner}, expected {expected_owner}")
    if volume_group != expected_group:
        errors.append(f"volume group is {volume_group}, expected {expected_group}")
    if volume_mode != DISK_MODE:
        errors.append(f"volume mode is {volume_mode:04o}, expected {DISK_MODE:04o}")
    disk_stat: dict[str, int] = {}
    try:
        metadata = stable_regular_file_stat(DISK_PATH, "managed Windows disk")
        disk_stat = artifact_stat_payload(metadata)
        if metadata.st_uid != expected_owner:
            errors.append(f"disk file owner is {metadata.st_uid}, expected {expected_owner}")
        if metadata.st_gid != expected_group:
            errors.append(f"disk file group is {metadata.st_gid}, expected {expected_group}")
        actual_mode = stat.S_IMODE(metadata.st_mode)
        if actual_mode != DISK_MODE:
            errors.append(f"disk file mode is {actual_mode:04o}, expected {DISK_MODE:04o}")
    except (OSError, ValueError) as error:
        errors.append(f"cannot inspect managed Windows disk: {error}")
    return {
        "ok": not errors,
        "exists": True,
        "compatible": not errors,
        "path": path_result.stdout,
        "capacity": capacity,
        "format": disk_format,
        "owner": volume_owner,
        "group": volume_group,
        "mode": volume_mode,
        "stat": disk_stat,
        "errors": errors,
    }


def blank_preinstall_disk_state() -> dict[str, Any]:
    """Prove that the managed qcow2 is standalone, clean, and logically all zero."""

    errors: list[str] = []
    volume = volume_state()
    if not volume.get("compatible"):
        errors.extend(volume.get("errors", ["managed Windows disk is incompatible"]))
    tool = shutil.which("qemu-img")
    if not tool:
        errors.append("qemu-img not found")
    if errors:
        return {
            "ok": False,
            "volume": volume,
            "stat": {},
            "info": None,
            "check": None,
            "map": None,
            "errors": errors,
        }
    try:
        initial = stable_regular_file_stat(DISK_PATH, "pre-install Windows disk")
    except (OSError, ValueError) as error:
        return {
            "ok": False,
            "volume": volume,
            "stat": {},
            "info": None,
            "check": None,
            "map": None,
            "errors": [f"cannot inspect pre-install disk: {error}"],
        }

    info_data: Any = None
    check_data: Any = None
    map_data: Any = None
    info = run(
        [tool, "info", "--output=json", "--backing-chain", "-f", "qcow2", str(DISK_PATH)],
        timeout=60.0,
    )
    if info.rc != 0:
        errors.append(info.stderr or info.stdout or "qemu-img info failed")
    else:
        try:
            info_data = json.loads(info.stdout)
            chain = info_data if isinstance(info_data, list) else [info_data]
            if len(chain) != 1 or not isinstance(chain[0], dict):
                errors.append("pre-install disk must have one standalone backing-chain element")
            else:
                item = chain[0]
                if item.get("format") != "qcow2":
                    errors.append("pre-install disk format is not qcow2")
                if item.get("virtual-size") != VOLUME_SIZE_BYTES:
                    errors.append("pre-install disk virtual size is incorrect")
                if item.get("backing-filename") or item.get("full-backing-filename"):
                    errors.append("pre-install disk has a backing file")
                if item.get("snapshots"):
                    errors.append("pre-install disk contains internal snapshots")
                if item.get("encrypted"):
                    errors.append("pre-install disk is encrypted")
                if item.get("dirty-flag") is not False:
                    errors.append("pre-install disk dirty flag is not false")
                format_specific = item.get("format-specific", {})
                format_data = (
                    format_specific.get("data", {})
                    if isinstance(format_specific, dict)
                    else {}
                )
                if not isinstance(format_data, dict):
                    errors.append("pre-install qcow2 format data is not an object")
                    format_data = {}
                if format_data.get("bitmaps") or format_data.get("encrypt"):
                    errors.append("pre-install disk has unexpected qcow2 metadata")
                if format_data.get("corrupt") is not False:
                    errors.append("pre-install disk corrupt flag is not false")
        except (AttributeError, json.JSONDecodeError, TypeError) as error:
            errors.append(f"invalid pre-install qemu-img info JSON: {error}")

    check = run(
        [tool, "check", "--output=json", "-f", "qcow2", str(DISK_PATH)],
        timeout=300.0,
    )
    if check.rc != 0:
        errors.append(check.stderr or check.stdout or f"qemu-img check failed with status {check.rc}")
    else:
        try:
            check_data = json.loads(check.stdout)
            if not isinstance(check_data, dict):
                errors.append("pre-install qemu-img check root is not an object")
            else:
                for key in ("check-errors", "corruptions", "leaks"):
                    if type(check_data.get(key, 0)) is not int or check_data.get(key, 0) != 0:
                        errors.append(f"pre-install qemu-img check reports {key}")
        except json.JSONDecodeError as error:
            errors.append(f"invalid pre-install qemu-img check JSON: {error}")

    mapping = run(
        [tool, "map", "--output=json", "-f", "qcow2", str(DISK_PATH)],
        timeout=300.0,
    )
    if mapping.rc != 0:
        errors.append(mapping.stderr or mapping.stdout or "qemu-img map failed")
    else:
        try:
            map_data = json.loads(mapping.stdout)
            if not isinstance(map_data, list) or not map_data:
                errors.append("pre-install qemu-img map must be a non-empty array")
            else:
                cursor = 0
                for index, extent in enumerate(map_data):
                    if not isinstance(extent, dict):
                        errors.append(f"pre-install map extent {index} is not an object")
                        continue
                    start = extent.get("start")
                    length = extent.get("length")
                    if type(start) is not int or type(length) is not int or length <= 0:
                        errors.append(f"pre-install map extent {index} has invalid bounds")
                        continue
                    if start != cursor:
                        errors.append(f"pre-install map extent {index} is not contiguous")
                    cursor = start + length
                    if extent.get("data") is not False or extent.get("zero") is not True:
                        errors.append(f"pre-install map extent {index} is not an unallocated zero range")
                if cursor != VOLUME_SIZE_BYTES:
                    errors.append(
                        f"pre-install map covers {cursor} bytes, expected {VOLUME_SIZE_BYTES}"
                    )
        except json.JSONDecodeError as error:
            errors.append(f"invalid pre-install qemu-img map JSON: {error}")
    try:
        final = stable_regular_file_stat(DISK_PATH, "pre-install Windows disk")
        if source_stat_signature(final) != source_stat_signature(initial):
            errors.append("pre-install disk changed during empty-disk validation")
    except (OSError, ValueError) as error:
        final = initial
        errors.append(f"cannot re-stat pre-install disk: {error}")
    return {
        "ok": not errors,
        "volume": volume,
        "stat": artifact_stat_payload(final),
        "info": info_data,
        "check": check_data,
        "map": map_data,
        "errors": errors,
    }


def preinstall_disk_intent_state() -> dict[str, Any]:
    payload, errors = managed_json_object(
        PREINSTALL_DISK_INTENT_PATH,
        "pre-install disk creation intent",
    )
    if payload:
        try:
            exact_object_keys(
                payload,
                {
                    "schema",
                    "generation",
                    "created_utc",
                    "operation",
                    "domain",
                    "domain_uuid",
                    "pool",
                    "name",
                    "path",
                    "capacity",
                    "format",
                    "owner",
                    "group",
                    "mode",
                },
                "pre-install disk creation intent",
            )
            canonical_uuid(payload["generation"], "pre-install disk generation")
            parse_utc_timestamp(payload["created_utc"], "pre-install disk intent created_utc")
        except (KeyError, TypeError, ValueError) as error:
            errors.append(str(error))
        identities = media_identities()
        errors.extend(identities["errors"])
        required = {
            "schema": PREINSTALL_DISK_INTENT_SCHEMA,
            "operation": "create-blank-preinstall-disk",
            "domain": DOMAIN,
            "domain_uuid": DOMAIN_UUID,
            "pool": VOLUME_POOL,
            "name": VOLUME_NAME,
            "path": str(DISK_PATH),
            "capacity": VOLUME_SIZE_BYTES,
            "format": "qcow2",
            "owner": identities.get("qemu_uid"),
            "group": identities.get("libvirt_gid"),
            "mode": DISK_MODE,
        }
        for key, expected in required.items():
            if payload.get(key) != expected or type(payload.get(key)) is not type(expected):
                errors.append(
                    f"pre-install disk intent {key}={payload.get(key)!r}, expected {expected!r}"
                )
    return {
        "ok": bool(payload) and not errors,
        "path": str(PREINSTALL_DISK_INTENT_PATH),
        "payload": payload,
        "errors": errors,
    }


def new_preinstall_disk_intent(identities: dict[str, Any]) -> dict[str, Any]:
    return {
        "schema": PREINSTALL_DISK_INTENT_SCHEMA,
        "generation": str(uuid.uuid4()),
        "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "operation": "create-blank-preinstall-disk",
        "domain": DOMAIN,
        "domain_uuid": DOMAIN_UUID,
        "pool": VOLUME_POOL,
        "name": VOLUME_NAME,
        "path": str(DISK_PATH),
        "capacity": VOLUME_SIZE_BYTES,
        "format": "qcow2",
        "owner": identities["qemu_uid"],
        "group": identities["libvirt_gid"],
        "mode": DISK_MODE,
    }


def preinstall_disk_payload(
    state: dict[str, Any],
    intent: dict[str, Any],
) -> dict[str, Any]:
    return {
        "schema": PREINSTALL_DISK_SCHEMA,
        "generation": intent["generation"],
        "intent_sha256": sha256_file(PREINSTALL_DISK_INTENT_PATH),
        "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "domain": DOMAIN,
        "domain_uuid": DOMAIN_UUID,
        "pool": VOLUME_POOL,
        "name": VOLUME_NAME,
        "path": str(DISK_PATH),
        "capacity": VOLUME_SIZE_BYTES,
        "format": "qcow2",
        "owner": state["volume"]["owner"],
        "group": state["volume"]["group"],
        "mode": DISK_MODE,
        "artifact_stat": state["stat"],
        "qemu_info_sha256": canonical_json_sha256(state["info"]),
        "qemu_check_sha256": canonical_json_sha256(state["check"]),
        "qemu_map_sha256": canonical_json_sha256(state["map"]),
        "logical_zero": True,
    }


def preinstall_disk_state(verify_current: bool = True) -> dict[str, Any]:
    payload, errors = managed_json_object(
        PREINSTALL_DISK_ATTESTATION_PATH,
        "pre-install disk attestation",
    )
    if payload:
        try:
            exact_object_keys(
                payload,
                {
                    "schema",
                    "generation",
                    "intent_sha256",
                    "created_utc",
                    "domain",
                    "domain_uuid",
                    "pool",
                    "name",
                    "path",
                    "capacity",
                    "format",
                    "owner",
                    "group",
                    "mode",
                    "artifact_stat",
                    "qemu_info_sha256",
                    "qemu_check_sha256",
                    "qemu_map_sha256",
                    "logical_zero",
                },
                "pre-install disk attestation",
            )
            parse_utc_timestamp(payload["created_utc"], "pre-install disk created_utc")
            canonical_uuid(payload["generation"], "pre-install disk generation")
            exact_object_keys(
                payload["artifact_stat"],
                {"device", "inode", "mode", "uid", "gid", "nlink", "size", "mtime_ns", "ctime_ns"},
                "pre-install disk artifact_stat",
            )
        except (KeyError, TypeError, ValueError) as error:
            errors.append(str(error))
        identities = media_identities()
        errors.extend(identities["errors"])
        intent = preinstall_disk_intent_state()
        if not intent["ok"]:
            errors.extend(intent["errors"])
        required = {
            "schema": PREINSTALL_DISK_SCHEMA,
            "domain": DOMAIN,
            "domain_uuid": DOMAIN_UUID,
            "pool": VOLUME_POOL,
            "name": VOLUME_NAME,
            "path": str(DISK_PATH),
            "capacity": VOLUME_SIZE_BYTES,
            "format": "qcow2",
            "owner": identities.get("qemu_uid"),
            "group": identities.get("libvirt_gid"),
            "mode": DISK_MODE,
            "logical_zero": True,
        }
        for key, expected in required.items():
            if payload.get(key) != expected or type(payload.get(key)) is not type(expected):
                errors.append(f"pre-install disk {key}={payload.get(key)!r}, expected {expected!r}")
        if intent["ok"]:
            if payload.get("generation") != intent["payload"].get("generation"):
                errors.append("pre-install disk generation differs from creation intent")
            try:
                intent_digest, _intent_metadata = stable_regular_file_hash(
                    PREINSTALL_DISK_INTENT_PATH,
                    "pre-install disk creation intent",
                )
                if payload.get("intent_sha256") != intent_digest:
                    errors.append("pre-install disk intent hash differs from attestation")
            except (OSError, ValueError) as error:
                errors.append(f"cannot hash pre-install disk intent: {error}")
        if not HEX_SHA256_RE.fullmatch(str(payload.get("intent_sha256", ""))):
            errors.append("pre-install disk intent_sha256 is not a SHA-256 value")
        for key in ("qemu_info_sha256", "qemu_check_sha256", "qemu_map_sha256"):
            if not HEX_SHA256_RE.fullmatch(str(payload.get(key, ""))):
                errors.append(f"pre-install disk {key} is not a SHA-256 value")
        if verify_current and not errors:
            current = blank_preinstall_disk_state()
            if not current["ok"]:
                errors.extend(current["errors"])
            else:
                comparisons = {
                    "artifact_stat": current["stat"],
                    "qemu_info_sha256": canonical_json_sha256(current["info"]),
                    "qemu_check_sha256": canonical_json_sha256(current["check"]),
                    "qemu_map_sha256": canonical_json_sha256(current["map"]),
                }
                for key, expected in comparisons.items():
                    if payload.get(key) != expected:
                        errors.append(f"pre-install disk current {key} differs from attestation")
    return {
        "ok": bool(payload) and not errors,
        "path": str(PREINSTALL_DISK_ATTESTATION_PATH),
        "payload": payload,
        "errors": errors,
    }


def create_managed_windows_volume(identities: dict[str, Any]) -> CommandResult:
    volume = ET.Element("volume")
    ET.SubElement(volume, "name").text = VOLUME_NAME
    ET.SubElement(volume, "capacity", {"unit": "bytes"}).text = str(VOLUME_SIZE_BYTES)
    ET.SubElement(volume, "allocation", {"unit": "bytes"}).text = "0"
    target = ET.SubElement(volume, "target")
    ET.SubElement(target, "format", {"type": "qcow2"})
    permissions = ET.SubElement(target, "permissions")
    ET.SubElement(permissions, "owner").text = str(identities["qemu_uid"])
    ET.SubElement(permissions, "group").text = str(identities["libvirt_gid"])
    ET.SubElement(permissions, "mode").text = f"0{DISK_MODE:03o}"
    descriptor, name = tempfile.mkstemp(prefix="ctos-apple-volume.", suffix=".xml")
    path = Path(name)
    try:
        encoded = ET.tostring(volume, encoding="utf-8", xml_declaration=True)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        return virsh(["vol-create", VOLUME_POOL, str(path), "--validate"], timeout=60.0)
    finally:
        if path.exists() or path.is_symlink():
            path.unlink()


def own_domain_state() -> dict[str, Any]:
    info = virsh(["dominfo", DOMAIN], readonly=True)
    if info.rc != 0:
        if is_not_found(info):
            return {"ok": True, "exists": False, "compatible": False, "errors": []}
        return {"ok": False, "exists": False, "compatible": False, "errors": [info.stderr or info.stdout]}
    info_data = parse_info(info.stdout)
    dump = virsh(["dumpxml", "--inactive", DOMAIN], readonly=True)
    if dump.rc != 0:
        return {"ok": False, "exists": True, "compatible": False, "info": info_data, "errors": [dump.stderr or dump.stdout]}
    try:
        signature = xml_signature(ET.fromstring(dump.stdout))
    except (ET.ParseError, ValueError) as error:
        return {"ok": False, "exists": True, "compatible": False, "info": info_data, "errors": [str(error)]}
    profile = signature.get("profile", "")
    expected = expected_signature(profile) if profile in PROFILE_PATHS else {}
    errors: list[str] = []
    live_signature: dict[str, Any] = {}
    if not expected:
        errors.append(f"unknown live profile marker: {profile!r}")
    else:
        errors.extend(signature_errors(signature, expected, "inactive XML"))
    state = info_data.get("state", "").lower()
    if state not in {"shut off", "shutoff"}:
        live_dump = virsh(["dumpxml", DOMAIN], readonly=True)
        if live_dump.rc != 0:
            errors.append(live_dump.stderr or live_dump.stdout or "live dumpxml failed")
        else:
            try:
                live_signature = xml_signature(ET.fromstring(live_dump.stdout))
            except (ET.ParseError, ValueError) as error:
                errors.append(f"invalid live domain XML: {error}")
            else:
                live_profile = live_signature.get("profile", "")
                if live_profile != profile:
                    errors.append(
                        f"live profile marker {live_profile!r} differs from inactive {profile!r}"
                    )
                if expected:
                    errors.extend(signature_errors(live_signature, expected, "live XML"))
    for key, label in (
        ("autostart", "domain autostart"),
        ("autostart_once", "domain one-shot autostart"),
    ):
        value = info_data.get(key, "").lower()
        if value not in {"no", "disable"}:
            errors.append(f"{label} must be explicitly disabled, found {value!r}")
    return {
        "ok": not errors,
        "exists": True,
        "compatible": not errors,
        "profile": profile,
        "signature": signature,
        "live_signature": live_signature,
        "info": info_data,
        "errors": errors,
    }


def usb_qualification_state() -> dict[str, Any]:
    errors: list[str] = []
    cmdline = ""
    try:
        cmdline = read_text(PROC_CMDLINE_PATH)
    except OSError as error:
        errors.append(f"cannot read kernel command line: {error}")
    cmdline_tokens = cmdline.split()
    if cmdline_tokens.count("intel_iommu=on") != 1:
        errors.append("kernel command line must contain exactly one intel_iommu=on")
    if any(token.startswith("pcie_acs_override") for token in cmdline_tokens):
        errors.append("ACS override is active; controller qualification is prohibited")
    if not IOMMU_GROUPS_ROOT.is_dir():
        errors.append("IOMMU groups are unavailable")

    controller = PCI_DEVICES_ROOT / USB_CONTROLLER
    group_members: list[str] = []
    driver = ""
    identity: dict[str, str] = {}
    usb_children: list[str] = []
    if not controller.exists():
        errors.append(f"USB-C controller missing: {USB_CONTROLLER}")
    else:
        try:
            identity = {
                "vendor": read_text(controller / "vendor").lower(),
                "device": read_text(controller / "device").lower(),
                "class": read_text(controller / "class").lower(),
            }
        except OSError as error:
            errors.append(f"cannot inspect USB-C controller identity: {error}")
        if not (
            identity.get("vendor") == USB_CONTROLLER_VENDOR
            and identity.get("device") == USB_CONTROLLER_DEVICE
            and identity.get("class", "").startswith(USB_CONTROLLER_CLASS_PREFIX)
        ):
            errors.append(f"unexpected USB-C controller identity: {identity}")
        group_link = controller / "iommu_group"
        if not group_link.exists():
            errors.append(f"controller {USB_CONTROLLER} has no iommu_group")
        else:
            try:
                group_dir = group_link.resolve(strict=True)
                group_members = sorted(item.name for item in (group_dir / "devices").iterdir())
            except OSError as error:
                errors.append(f"cannot inspect controller IOMMU group: {error}")
            if group_members != [USB_CONTROLLER]:
                errors.append(f"controller group is not isolated: {group_members}")
        driver_link = controller / "driver"
        if driver_link.exists():
            try:
                driver = driver_link.resolve(strict=True).name
            except OSError:
                driver = "unreadable"
        if driver != "xhci_hcd":
            errors.append(f"controller is not safely host-bound to xhci_hcd: {driver!r}")
        usb_children = candidate_usb_children()
        if usb_children:
            errors.append("USB-C controller is not empty: " + ", ".join(usb_children))

    marker: dict[str, Any] = {}
    if not USB_QUALIFICATION_PATH.is_file() or USB_QUALIFICATION_PATH.is_symlink():
        errors.append(f"USB qualification evidence missing: {USB_QUALIFICATION_PATH}")
    else:
        try:
            marker = json.loads(USB_QUALIFICATION_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            errors.append(f"USB qualification evidence invalid: {error}")
    required = {
        "schema": USB_QUALIFICATION_SCHEMA,
        "controller": USB_CONTROLLER,
        "group_isolated": True,
        "physical_port_mapped": True,
        "non_sensitive_reenumeration_passed": True,
        "managed_detach_reattach_passed": True,
        "ac_charging_survived": True,
    }
    if marker:
        for key, expected in required.items():
            if marker.get(key) != expected:
                errors.append(f"USB qualification {key}={marker.get(key)!r}, expected {expected!r}")
    if not USB_QUALIFICATION_IMPLEMENTED:
        errors.append(
            "trusted detach/reattach and non-sensitive re-enumeration workflow is not implemented"
        )
    apple = apple_usb_check()
    typec = typec_partner_check()
    ac = ac_power_check()
    if not apple.ok:
        errors.append(apple.detail)
    if not typec.ok:
        errors.append(typec.detail)
    if not ac.ok:
        errors.append(ac.detail)
    return {
        "ok": not errors,
        "controller": USB_CONTROLLER,
        "driver": driver,
        "identity": identity,
        "group_members": group_members,
        "usb_children": usb_children,
        "evidence": str(USB_QUALIFICATION_PATH),
        "errors": errors,
    }


def full_state() -> dict[str, Any]:
    validation = repo_validation_state()
    checks = host_checks()
    infra = infra_state()
    entitlement = entitlement_state()
    media = media_state(verify_hash=True)
    volume = volume_state()
    domain = own_domain_state()
    run_path_exists = RUN_ATTESTATION_PATH.exists() or RUN_ATTESTATION_PATH.is_symlink()
    maintenance_profile = domain.get("profile") == "maintenance"
    if maintenance_profile:
        state = maintenance_state(verify_artifacts=True)
        state_phase = "maintenance"
    else:
        state = secure_state()
        state_phase = "pre-install"
    lifecycle = {
        "run": run_attestation_state(
            require_current_environment=domain.get("profile") != "maintenance"
        ),
        "transition_intent": transition_intent_state(),
        "transition_complete": transition_complete_state(),
    }
    preinstall_disk = preinstall_disk_state(
        verify_current=not maintenance_profile and not run_path_exists
    )
    lifecycle_ready = not maintenance_profile or (
        lifecycle["transition_intent"]["ok"]
        and lifecycle["transition_complete"]["ok"]
        and not incomplete_transition_exists()
    )
    return {
        "ok": validation["ok"]
        and all(check.ok for check in checks)
        and infra.get("ok", False)
        and entitlement["ok"]
        and media["verified"]
        and state["ok"]
        and lifecycle_ready
        and preinstall_disk["ok"]
        and volume.get("compatible", False)
        and domain.get("compatible", False),
        "connection": URI,
        "domain": DOMAIN,
        "architecture": {
            "disk": "SATA/AHCI using Windows inbox driver",
            "network": "e1000e using Windows inbox driver",
            "virtio": "forbidden until a separately authenticated Windows Update path is approved",
            "hostdev_in_repo_profiles": False,
        },
        "validation": validation,
        "host_checks": [asdict(check) for check in checks],
        "infra": infra,
        "entitlement": entitlement,
        "media": media,
        "secure_state": state,
        "state_phase": state_phase,
        "lifecycle": lifecycle,
        "preinstall_disk": preinstall_disk,
        "volume": volume,
        "domain_state": domain,
    }


def print_state(state: dict[str, Any], title: str) -> None:
    print(f"CTOS Apple Recovery {title}")
    print(f"connection: {state['connection']}")
    print(f"domain: {state['domain']}")
    print("drivers: Windows inbox SATA/AHCI + e1000e; no VirtIO media")
    print()
    print(f"repo XML: {'ok' if state['validation']['ok'] else 'blocked'}")
    for profile, item in state["validation"]["profiles"].items():
        print(f"  {profile}: {'ok' if item['ok'] else 'blocked'} {item['path']}")
        for error in item["errors"]:
            print(f"    error: {error}")
    print("host gates:")
    for check in state["host_checks"]:
        print(f"  {check['name']}: {'ok' if check['ok'] else 'blocked'} {check['detail']}")
    print(f"infra: {'ready' if state['infra'].get('ok') else 'blocked'}")
    if state["infra"].get("error"):
        print(f"  error: {state['infra']['error']}")
    print(f"Windows VM entitlement: {'ready' if state['entitlement']['ok'] else 'blocked'}")
    for error in state["entitlement"]["errors"]:
        print(f"  error: {error}")
    print(f"media: {'verified' if state['media']['verified'] else 'blocked'} {state['media']['path']}")
    for error in state["media"]["errors"]:
        print(f"  error: {error}")
    print(
        f"secure state ({state.get('state_phase', 'unknown')}): "
        f"{'ready' if state['secure_state']['ok'] else 'blocked'}"
    )
    for error in state["secure_state"]["errors"]:
        print(f"  error: {error}")
    print(f"volume: {'ready' if state['volume'].get('compatible') else 'missing/blocked'}")
    for error in state["volume"].get("errors", []):
        print(f"  error: {error}")
    print(
        "pre-install disk provenance: "
        f"{'ready' if state['preinstall_disk'].get('ok') else 'missing/blocked'}"
    )
    for error in state["preinstall_disk"].get("errors", []):
        print(f"  error: {error}")
    domain = state["domain_state"]
    print(f"domain definition: {'ready' if domain.get('compatible') else 'missing/blocked'}")
    for error in domain.get("errors", []):
        print(f"  error: {error}")


def mutation_preflight(
    require_media: bool,
    require_secure_state: bool,
    require_infra: bool,
    require_entitlement: bool = False,
) -> dict[str, Any]:
    checks = host_checks()
    validation = repo_validation_state()
    media = media_state(verify_hash=require_media)
    state = secure_state() if require_secure_state else {"ok": True, "errors": []}
    infra = infra_state() if require_infra else {"ok": True}
    entitlement = entitlement_state() if require_entitlement else {"ok": True, "errors": []}
    errors = [check.detail for check in checks if not check.ok]
    if not validation["ok"]:
        errors.append("repo domain XML validation failed")
    if require_media and not media["ok"]:
        errors.extend(media["errors"])
    if require_secure_state and not state["ok"]:
        errors.extend(state["errors"])
    if require_infra and not infra.get("ok"):
        errors.append(infra.get("error", "CTOS libvirt infra is not ready"))
    if require_entitlement and not entitlement.get("ok"):
        errors.extend(entitlement.get("errors", ["Windows VM entitlement is not ready"]))
    return {
        "ok": not errors,
        "checks": [asdict(check) for check in checks],
        "validation": validation,
        "media": media,
        "secure_state": state,
        "infra": infra,
        "entitlement": entitlement,
        "errors": errors,
    }


def command_status(args: argparse.Namespace) -> int:
    state = full_state()
    if args.json:
        print(json.dumps(state, indent=2, sort_keys=True))
    else:
        print_state(state, "status")
    return 0 if state["ok"] else 1


def command_plan(args: argparse.Namespace) -> int:
    state = full_state()
    actions: list[dict[str, str]] = []
    if not state["infra"].get("ok"):
        actions.append({"command": "apply-infra", "reason": "CTOS network/storage pools are not converged"})
    if not state["entitlement"]["ok"]:
        actions.append(
            {
                "command": "record an eligible durable VM entitlement decision",
                "reason": "consumer media, disk creation, definition, and guest start are blocked",
            }
        )
    if state["entitlement"]["ok"] and not state["media"]["ok"]:
        actions.append(
            {
                "command": f"import-media --source /absolute/path/{WINDOWS_ISO_NAME}",
                "reason": "official Windows ISO or its managed attestation is missing",
            }
        )
    if not state["secure_state"]["ok"]:
        if state.get("state_phase") == "pre-install":
            actions.append(
                {
                    "command": "prepare-secure-state",
                    "reason": "Microsoft 2011/2023 NVRAM and private TPM state are not attested",
                }
            )
        else:
            actions.append(
                {
                    "command": "audit transition-maintenance state",
                    "reason": "post-install consistency state is invalid; pre-install preparation is forbidden",
                }
            )
    if state["entitlement"]["ok"] and (
        not state["volume"].get("exists") or not state["domain_state"].get("compatible")
    ):
        actions.append({"command": "define --profile install", "reason": "install profile is not converged"})
    if incomplete_transition_exists():
        actions.append(
            {
                "command": "transition-maintenance --evidence-id <uuid>",
                "reason": "an immutable transition intent exists and must be resumed or audited",
            }
        )
    elif state["domain_state"].get("profile") == "install" and state["lifecycle"]["run"].get("ok"):
        actions.append(
            {
                "command": "ingest-evidence, ACPI receipt, then transition-maintenance",
                "reason": "the install run must be attested before the maintenance XML is defined",
            }
        )
    actions.extend(
        [
            {"command": "seal-baseline", "reason": "blocked until consistency-set workflow is implemented"},
            {"command": "start-session", "reason": "blocked until disposable disk/NVRAM/TPM workflow is implemented"},
            {"command": "close-session", "reason": "blocked until recoverable cleanup workflow is implemented"},
        ]
    )
    payload = {
        "ok": state["ok"],
        "plan_generated": state["validation"]["ok"],
        "actions": actions,
        "state": state,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print_state(state, "plan")
        print("\nplanned commands:")
        for item in actions:
            print(f"  {item['command']}: {item['reason']}")
    return 0 if state["ok"] else 1


def command_apply_infra(args: argparse.Namespace) -> int:
    preflight = mutation_preflight(False, False, False)
    if not preflight["ok"]:
        payload = {"ok": False, "error": "apply-infra blocked by host gates", "preflight": preflight}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in preflight["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1
    result = run([str(INFRA_SCRIPT), "--json", "apply"], timeout=120.0)
    try:
        infra_output = json.loads(result.stdout) if result.stdout else {}
    except json.JSONDecodeError:
        infra_output = {"stdout": result.stdout, "stderr": result.stderr}
    payload = {"ok": result.rc == 0, "result": infra_output}
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    elif result.rc == 0:
        print("CTOS libvirt infrastructure converged")
    else:
        print(result.stderr or result.stdout or "ctos-libvirt-infra apply failed", file=sys.stderr)
    return 0 if payload["ok"] else 1


def command_prepare_secure_state(args: argparse.Namespace) -> int:
    if os.geteuid() != 0:
        message = "prepare-secure-state requires a visible local sudo invocation"
        if args.json:
            print(json.dumps({"ok": False, "error": message}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
        return 1

    identities = secure_state_identities()
    if not identities["ok"]:
        payload = {
            "ok": False,
            "error": "secure-state service identities are missing or unavailable",
            "identities": identities,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in identities["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    preflight = mutation_preflight(False, False, True)
    if not preflight["ok"]:
        payload = {"ok": False, "error": "secure-state preparation blocked by host gates", "preflight": preflight}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in preflight["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    domain = own_domain_state()
    if not domain.get("ok") or domain.get("exists"):
        message = "secure-state preparation requires the Apple domain to be absent"
        if args.json:
            print(json.dumps({"ok": False, "error": message, "domain": domain}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
        return 1

    if STATE_ROOT.exists() or STATE_ROOT.is_symlink():
        state = secure_state()
        if state["ok"]:
            payload = {"ok": True, "changed": False, "message": "secure state already verified", "state": state}
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["message"])
            return 0
        message = "existing secure-state path is incomplete or incompatible; no overwrite or cleanup performed"
        if args.json:
            print(json.dumps({"ok": False, "error": message, "state": state}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
            for error in state["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    if (
        not STATE_ROOT.parent.is_dir()
        or STATE_ROOT.parent.is_symlink()
        or not OVMF_VARS_TEMPLATE_PATH.is_file()
        or OVMF_VARS_TEMPLATE_PATH.is_symlink()
    ):
        message = "managed snapshot parent or packaged OVMF variable template is missing/unsafe"
        if args.json:
            print(json.dumps({"ok": False, "error": message}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
        return 1

    tool = shutil.which("virt-fw-vars")
    if not tool:
        print("virt-fw-vars not found", file=sys.stderr)
        return 1

    staging = Path(tempfile.mkdtemp(prefix=".ctos-apple-recovery.", dir=STATE_ROOT.parent))
    try:
        staging_nvram = staging / NVRAM_PATH.name
        staging_tpm = staging / TPM_STATE_PATH.name
        staging_attestation = staging / STATE_ATTESTATION_PATH.name
        staging_tpm.mkdir(mode=0o700)
        generate_args = [
            tool,
            "-i",
            str(OVMF_VARS_TEMPLATE_PATH),
            "--enroll-microsoft",
            "--microsoft-db",
            "all",
            "--microsoft-kek",
            "all",
            "--secure-boot",
            "-o",
            str(staging_nvram),
        ]
        generated = run(generate_args, timeout=60.0)
        if generated.rc != 0 or not staging_nvram.is_file() or staging_nvram.is_symlink():
            message = generated.stderr or generated.stdout or "virt-fw-vars generation failed"
            print(message, file=sys.stderr)
            return 1
        inspection = inspect_secure_boot_varstore(staging_nvram)
        if not inspection["ok"]:
            for error in inspection["errors"]:
                print(error, file=sys.stderr)
            return 1
        attestation = {
            "schema": SECURE_STATE_SCHEMA,
            "domain": DOMAIN,
            "phase": "pre-install",
            "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
            "template_path": str(OVMF_VARS_TEMPLATE_PATH),
            "template_sha256": sha256_file(OVMF_VARS_TEMPLATE_PATH),
            "nvram_path": str(NVRAM_PATH),
            "nvram_sha256": sha256_file(staging_nvram),
            "tpm_path": str(TPM_STATE_PATH),
            "secure_boot": True,
            "microsoft_db_2011": True,
            "microsoft_db_2023": True,
            "microsoft_kek_2011": True,
            "microsoft_kek_2023": True,
            "inspection": "virt-fw-vars --print",
            "generator_argv": generate_args[:-1] + [str(NVRAM_PATH)],
            "state_permissions": {
                "root": f"root:{LIBVIRT_OPERATOR_GROUP} {STATE_ROOT_MODE:04o}",
                "nvram": f"{LIBVIRT_QEMU_USER}:{LIBVIRT_OPERATOR_GROUP} {NVRAM_MODE:04o}",
                "tpm": f"{SWTPM_USER}:{LIBVIRT_OPERATOR_GROUP} {TPM_STATE_MODE:04o}",
                "attestation": f"root:{LIBVIRT_OPERATOR_GROUP} {STATE_ATTESTATION_MODE:04o}",
            },
        }
        staging_attestation.write_text(json.dumps(attestation, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.chown(staging, identities["root_uid"], identities["libvirt_gid"])
        os.chown(staging_nvram, identities["qemu_uid"], identities["libvirt_gid"])
        os.chown(staging_tpm, identities["swtpm_uid"], identities["libvirt_gid"])
        os.chown(staging_attestation, identities["root_uid"], identities["libvirt_gid"])
        os.chmod(staging, STATE_ROOT_MODE)
        os.chmod(staging_nvram, NVRAM_MODE)
        os.chmod(staging_tpm, TPM_STATE_MODE)
        os.chmod(staging_attestation, STATE_ATTESTATION_MODE)
        for durable_file in (staging_nvram, staging_attestation):
            durable_fd = os.open(
                durable_file,
                os.O_RDONLY
                | getattr(os, "O_CLOEXEC", 0)
                | getattr(os, "O_NOFOLLOW", 0),
            )
            try:
                os.fsync(durable_fd)
            finally:
                os.close(durable_fd)
        fsync_directory(staging_tpm)
        fsync_directory(staging)
        parent_fd = os.open(
            STATE_ROOT.parent,
            os.O_RDONLY
            | os.O_DIRECTORY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _rename_no_replace(parent_fd, staging.name, STATE_ROOT.name)
            os.fsync(parent_fd)
        except OSError as error:
            print(
                f"secure-state publication failed without replacing existing state: {error}",
                file=sys.stderr,
            )
            return 1
        finally:
            os.close(parent_fd)
        final = secure_state()
        payload = {"ok": final["ok"], "changed": True, "state": final}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        elif final["ok"]:
            print(f"prepared and verified secure state: {STATE_ROOT}")
        else:
            for error in final["errors"]:
                print(error, file=sys.stderr)
        return 0 if final["ok"] else 1
    finally:
        if staging.exists() and staging != STATE_ROOT:
            shutil.rmtree(staging)


def command_verify_media(args: argparse.Namespace) -> int:
    state = media_state(verify_hash=True)
    if args.json:
        print(json.dumps(state, indent=2, sort_keys=True))
    elif state["ok"]:
        print(f"verified: {state['path']}")
        print(f"sha256: {state['actual_sha256']}")
        print("driver media: none; Windows inbox SATA/AHCI and e1000e only")
    else:
        for error in state["errors"]:
            print(error, file=sys.stderr)
    return 0 if state["ok"] else 1


def media_attestation_payload(size: int) -> dict[str, Any]:
    return {
        "schema": MEDIA_ATTESTATION_SCHEMA,
        "pool": ISO_POOL,
        "filename": WINDOWS_ISO_NAME,
        "managed_path": str(WINDOWS_ISO_PATH),
        "release": WINDOWS_RELEASE,
        "language": WINDOWS_LANGUAGE,
        "size": size,
        "sha256": WINDOWS_SHA256,
        "hash_source": WINDOWS_HASH_SOURCE,
        "entitlement_status": ELIGIBLE_DURABLE_ENTITLEMENT,
        "imported_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
    }


def source_stat_signature(metadata: os.stat_result) -> tuple[int, ...]:
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_mode,
        metadata.st_uid,
        metadata.st_gid,
        metadata.st_nlink,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def open_media_source(source: Path) -> tuple[int | None, os.stat_result | None, list[str]]:
    """Open the explicit operator-owned ISO without following links."""

    errors: list[str] = []
    if not source.is_absolute():
        return None, None, ["ISO source path must be absolute"]
    if source.name != WINDOWS_ISO_NAME:
        return None, None, [f"ISO source basename must be exactly {WINDOWS_ISO_NAME}"]
    if source == WINDOWS_ISO_PATH or source == MEDIA_ATTESTATION_PATH:
        return None, None, ["ISO source must be outside the managed destination paths"]
    try:
        if source.is_symlink() or source.resolve(strict=True) != source:
            return None, None, ["ISO source must be canonical and contain no symlink component"]
    except OSError as error:
        return None, None, [f"cannot resolve ISO source: {error}"]

    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(source, flags)
    except OSError as error:
        return None, None, [f"cannot open ISO source safely: {error}"]
    try:
        metadata = os.fstat(descriptor)
        path_metadata = source.lstat()
        if not stat.S_ISREG(metadata.st_mode):
            errors.append("ISO source must be a regular file")
        if (metadata.st_dev, metadata.st_ino) != (path_metadata.st_dev, path_metadata.st_ino):
            errors.append("ISO source changed while it was opened")
        if metadata.st_nlink != 1:
            errors.append("ISO source must have exactly one hard link")
        if metadata.st_uid != invoking_uid():
            errors.append(
                f"ISO source owner is {metadata.st_uid}, expected invoking uid {invoking_uid()}"
            )
        if stat.S_IMODE(metadata.st_mode) & 0o022:
            errors.append("ISO source must not be writable by group or others")
        if metadata.st_size <= 0:
            errors.append("ISO source is empty")
    except OSError as error:
        errors.append(f"cannot inspect ISO source: {error}")
        metadata = None
    if errors:
        os.close(descriptor)
        return None, None, errors
    return descriptor, metadata, []


def publish_media_from_source(source: Path, identities: dict[str, Any]) -> tuple[bool, list[str]]:
    """Copy, authenticate, and publish the fixed ISO with no replacement path."""

    descriptor, initial_metadata, errors = open_media_source(source)
    if descriptor is None or initial_metadata is None:
        return False, errors

    destination_descriptor: int | None = None
    directory_descriptor: int | None = None
    try:
        initial_hash = sha256_fd(descriptor)
        if initial_hash != WINDOWS_SHA256:
            return False, [
                f"ISO source SHA-256 mismatch: {initial_hash} != {WINDOWS_SHA256}"
            ]

        directory_descriptor = os.open(
            WINDOWS_ISO_PATH.parent,
            os.O_RDONLY
            | os.O_DIRECTORY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        tmpfile_flag = getattr(os, "O_TMPFILE", 0)
        if not tmpfile_flag:
            raise OSError(errno.EOPNOTSUPP, "O_TMPFILE is unavailable; no fallback attempted")
        destination_descriptor = os.open(
            ".",
            os.O_RDWR | tmpfile_flag | getattr(os, "O_CLOEXEC", 0),
            0o600,
            dir_fd=directory_descriptor,
        )
        copied_digest = hashlib.sha256()
        os.lseek(descriptor, 0, os.SEEK_SET)
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            view = memoryview(chunk)
            while view:
                written = os.write(destination_descriptor, view)
                if written <= 0:
                    raise OSError("short write while copying ISO")
                view = view[written:]
            copied_digest.update(chunk)
        os.fchown(
            destination_descriptor,
            identities["qemu_uid"],
            identities["libvirt_gid"],
        )
        os.fchmod(destination_descriptor, MEDIA_MODE)
        os.fsync(destination_descriptor)

        copied_hash = copied_digest.hexdigest()
        destination_hash = sha256_fd(destination_descriptor)
        final_hash = sha256_fd(descriptor)
        final_metadata = os.fstat(descriptor)
        if source_stat_signature(final_metadata) != source_stat_signature(initial_metadata):
            return False, ["ISO source metadata changed during import"]
        if not (initial_hash == copied_hash == destination_hash == final_hash == WINDOWS_SHA256):
            return False, ["ISO source or destination changed during authenticated copy"]

        try:
            _link_tmpfile_no_replace(
                destination_descriptor,
                directory_descriptor,
                WINDOWS_ISO_PATH.name,
            )
        except FileExistsError:
            existing = media_artifact_state(verify_hash=True)
            if not existing["ok"]:
                return False, [
                    "managed ISO appeared during import and is incompatible; no overwrite performed",
                    *existing["errors"],
                ]
            return False, []
        published_fd = os.fstat(destination_descriptor)
        published_path = os.stat(
            WINDOWS_ISO_PATH.name,
            dir_fd=directory_descriptor,
            follow_symlinks=False,
        )
        if (
            not stat.S_ISREG(published_path.st_mode)
            or published_fd.st_nlink != 1
            or published_path.st_nlink != 1
            or (published_fd.st_dev, published_fd.st_ino)
            != (published_path.st_dev, published_path.st_ino)
            or published_path.st_uid != identities["qemu_uid"]
            or published_path.st_gid != identities["libvirt_gid"]
            or stat.S_IMODE(published_path.st_mode) != MEDIA_MODE
            or published_path.st_size != initial_metadata.st_size
        ):
            raise OSError("published ISO inode failed verification")
        os.fsync(destination_descriptor)
        os.fsync(directory_descriptor)
        return True, []
    except OSError as error:
        return False, [f"authenticated ISO copy failed: {error}"]
    finally:
        os.close(descriptor)
        if destination_descriptor is not None:
            os.close(destination_descriptor)
        if directory_descriptor is not None:
            os.close(directory_descriptor)


def refresh_media_pool() -> list[str]:
    refresh = virsh(["pool-refresh", ISO_POOL], timeout=60.0)
    if refresh.rc != 0:
        return [refresh.stderr or refresh.stdout or f"failed to refresh {ISO_POOL}"]
    volume_path = virsh(
        ["vol-path", "--pool", ISO_POOL, WINDOWS_ISO_NAME],
        readonly=True,
    )
    if volume_path.rc != 0:
        return [volume_path.stderr or volume_path.stdout or "managed ISO volume is not visible"]
    if volume_path.stdout != str(WINDOWS_ISO_PATH):
        return [
            f"managed ISO volume path mismatch: {volume_path.stdout!r} != {str(WINDOWS_ISO_PATH)!r}"
        ]
    return []


def command_import_media(args: argparse.Namespace) -> int:
    if os.geteuid() != 0:
        message = "import-media requires a visible local sudo invocation"
        payload = {"ok": False, "changed": False, "error": message}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
        return 1

    preflight = mutation_preflight(False, False, True, True)
    if not preflight["ok"]:
        payload = {
            "ok": False,
            "changed": False,
            "error": "media import blocked before source access",
            "preflight": preflight,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in preflight["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    identities = media_identities()
    if not identities["ok"]:
        payload = {
            "ok": False,
            "changed": False,
            "error": "managed-media service identities are unavailable",
            "errors": identities["errors"],
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in identities["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    directory_errors = [
        *exact_directory_errors(WINDOWS_ISO_PATH.parent, "managed ISO directory"),
        *exact_directory_errors(MEDIA_ATTESTATION_PATH.parent, "media attestation directory"),
    ]
    if directory_errors:
        payload = {"ok": False, "changed": False, "error": "unsafe media directories", "errors": directory_errors}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            for error in directory_errors:
                print(error, file=sys.stderr)
        return 1

    changed = False
    artifact_exists = WINDOWS_ISO_PATH.exists() or WINDOWS_ISO_PATH.is_symlink()
    if artifact_exists:
        artifact = media_artifact_state(verify_hash=True)
        if not artifact["ok"]:
            payload = {
                "ok": False,
                "changed": False,
                "error": "existing managed ISO is incompatible; no overwrite performed",
                "errors": artifact["errors"],
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
                for error in artifact["errors"]:
                    print(f"error: {error}", file=sys.stderr)
            return 1
    else:
        changed, copy_errors = publish_media_from_source(Path(args.source), identities)
        if copy_errors:
            payload = {
                "ok": False,
                "changed": False,
                "error": "authenticated media import failed",
                "errors": copy_errors,
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
                for error in copy_errors:
                    print(f"error: {error}", file=sys.stderr)
            return 1

    attestation_exists = MEDIA_ATTESTATION_PATH.exists() or MEDIA_ATTESTATION_PATH.is_symlink()
    if attestation_exists:
        existing_state = media_state(verify_hash=True)
        if not existing_state["ok"]:
            payload = {
                "ok": False,
                "changed": changed,
                "error": "existing media attestation is incompatible; no overwrite performed",
                "state": existing_state,
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
                for error in existing_state["errors"]:
                    print(f"error: {error}", file=sys.stderr)
            return 1
    else:
        artifact = media_artifact_state(verify_hash=True)
        if not artifact["ok"]:
            payload = {
                "ok": False,
                "changed": changed,
                "error": "managed ISO failed verification before attestation",
                "errors": artifact["errors"],
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                for error in artifact["errors"]:
                    print(error, file=sys.stderr)
            return 1
        try:
            publish_json_no_replace(
                MEDIA_ATTESTATION_PATH,
                media_attestation_payload(artifact["size"]),
                uid=identities["root_uid"],
                gid=identities["libvirt_gid"],
                mode=MEDIA_ATTESTATION_MODE,
            )
        except FileExistsError:
            raced_state = media_state(verify_hash=True)
            if not raced_state["ok"]:
                payload = {
                    "ok": False,
                    "changed": changed,
                    "error": "media attestation appeared concurrently and is incompatible",
                    "state": raced_state,
                }
                if args.json:
                    print(json.dumps(payload, indent=2, sort_keys=True))
                else:
                    print(payload["error"], file=sys.stderr)
                return 1
        except OSError as error:
            payload = {
                "ok": False,
                "changed": changed,
                "error": f"media attestation publication failed: {error}",
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
            return 1
        else:
            changed = True

    pool_errors = refresh_media_pool()
    final = media_state(verify_hash=True)
    payload = {
        "ok": not pool_errors and final["ok"],
        "changed": changed,
        "media": final,
        "pool_errors": pool_errors,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    elif payload["ok"]:
        action = "imported" if changed else "already verified"
        print(f"{action}: {WINDOWS_ISO_PATH}")
        print(f"sha256: {final['actual_sha256']}")
    else:
        for error in [*pool_errors, *final["errors"]]:
            print(error, file=sys.stderr)
    return 0 if payload["ok"] else 1


def ensure_evidence_root(identities: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    if EVIDENCE_ROOT.exists() or EVIDENCE_ROOT.is_symlink():
        errors.extend(exact_directory_errors(EVIDENCE_ROOT, "guest evidence directory"))
        if not errors:
            errors.extend(
                exact_metadata_errors(
                    EVIDENCE_ROOT,
                    "guest evidence directory",
                    identities["root_uid"],
                    identities["libvirt_gid"],
                    EVIDENCE_ROOT_MODE,
                )
            )
        return errors
    try:
        if exact_directory_errors(STATE_ROOT, "managed state root"):
            return exact_directory_errors(STATE_ROOT, "managed state root")
        EVIDENCE_ROOT.mkdir(mode=0o700)
        os.chown(EVIDENCE_ROOT, identities["root_uid"], identities["libvirt_gid"])
        os.chmod(EVIDENCE_ROOT, EVIDENCE_ROOT_MODE)
        fsync_directory(STATE_ROOT)
    except OSError as error:
        errors.append(f"cannot create guest evidence directory: {error}")
    return errors


def command_ingest_evidence(args: argparse.Namespace) -> int:
    if os.geteuid() != 0:
        payload = {
            "ok": False,
            "changed": False,
            "error": "ingest-evidence requires a visible local sudo invocation",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    preflight = mutation_preflight(False, False, True, True)
    if not preflight["ok"]:
        payload = {
            "ok": False,
            "changed": False,
            "error": "guest evidence ingestion blocked before source access",
            "preflight": preflight,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in preflight["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    if args.phase != "windows-installed":
        return unsupported(
            args,
            f"ingest-evidence --phase {args.phase}",
            "apple-ready evidence requires the maintenance-run lifecycle, which is not implemented",
        )
    domain = own_domain_state()
    state = domain.get("info", {}).get("state", "").lower()
    if (
        not domain.get("compatible")
        or domain.get("profile") != "install"
        or state != "running"
    ):
        payload = {
            "ok": False,
            "changed": False,
            "error": "windows-installed evidence must be ingested while the exact install run is active",
            "domain": domain,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    run_state = run_attestation_state()
    if not run_state["ok"]:
        payload = {
            "ok": False,
            "changed": False,
            "error": "valid install-run attestation is required",
            "run": run_state,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    try:
        source_payload = read_operator_json_source(Path(args.source))
    except (OSError, ValueError) as error:
        payload = {
            "ok": False,
            "changed": False,
            "error": f"guest evidence source rejected: {error}",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    validation_errors = validate_guest_evidence(
        source_payload,
        expected_phase=args.phase,
        expected_run_id=run_state["run_id"],
        expected_challenge=str(run_state["payload"].get("challenge", "")),
        expected_host_boot_id=str(run_state["payload"].get("host_boot_id", "")),
        expected_workflow_sha256=str(run_state["payload"].get("workflow_sha256", "")),
        run_prepared_utc=str(run_state["payload"].get("prepared_utc", "")),
    )
    if validation_errors:
        payload = {
            "ok": False,
            "changed": False,
            "error": "guest evidence failed strict validation",
            "errors": validation_errors,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in validation_errors:
                print(f"error: {error}", file=sys.stderr)
        return 1

    identities = media_identities()
    root_errors = ensure_evidence_root(identities) if identities["ok"] else identities["errors"]
    if root_errors:
        payload = {
            "ok": False,
            "changed": False,
            "error": "managed guest evidence directory is unsafe",
            "errors": root_errors,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    evidence_id = canonical_uuid(source_payload["evidence_id"], "evidence_id")
    target = EVIDENCE_ROOT / f"{evidence_id}.json"
    changed = False
    if target.exists() or target.is_symlink():
        existing = guest_evidence_state(evidence_id, args.phase, run_state["payload"])
        if not existing["ok"] or existing["payload"] != source_payload:
            payload = {
                "ok": False,
                "changed": False,
                "error": "existing guest evidence is incompatible; no overwrite performed",
                "state": existing,
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
            return 1
    else:
        try:
            publish_json_no_replace(
                target,
                source_payload,
                uid=identities["root_uid"],
                gid=identities["libvirt_gid"],
                mode=MANAGED_JSON_MODE,
            )
        except OSError as error:
            payload = {
                "ok": False,
                "changed": False,
                "error": f"guest evidence publication failed: {error}",
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
            return 1
        changed = True

    final = guest_evidence_state(evidence_id, args.phase, run_state["payload"])
    payload = {"ok": final["ok"], "changed": changed, "evidence": final}
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    elif final["ok"]:
        print(f"ingested guest evidence: {target}")
    else:
        for error in final["errors"]:
            print(error, file=sys.stderr)
    return 0 if final["ok"] else 1


def disable_all_domain_autostart() -> tuple[list[str], list[str]]:
    """Disable both persistent and one-shot libvirt autostart modes."""

    messages: list[str] = []
    errors: list[str] = []
    for arguments, label in (
        (["autostart", DOMAIN, "--disable"], "persistent autostart"),
        (["autostart", DOMAIN, "--once", "--disable"], "one-shot autostart"),
    ):
        result = virsh(arguments)
        if result.rc != 0:
            errors.append(result.stderr or result.stdout or f"failed to disable {label}")
        else:
            messages.append(result.stdout or f"disabled {label} for {DOMAIN}")
    return messages, errors


def command_transition_maintenance(args: argparse.Namespace) -> int:
    if os.geteuid() != 0:
        payload = {
            "ok": False,
            "changed": False,
            "error": "transition-maintenance requires a visible local sudo invocation",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    try:
        evidence_id = canonical_uuid(args.evidence_id, "evidence_id")
    except ValueError as error:
        payload = {"ok": False, "changed": False, "error": str(error)}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    preflight = mutation_preflight(True, False, True, True)
    if not preflight["ok"]:
        payload = {
            "ok": False,
            "changed": False,
            "error": "install-to-maintenance transition blocked by preflight",
            "preflight": preflight,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in preflight["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    if TRANSITION_COMPLETE_PATH.exists() or TRANSITION_COMPLETE_PATH.is_symlink():
        complete = transition_complete_state()
        maintenance = maintenance_state(verify_artifacts=True)
        domain = own_domain_state()
        existing_intent = transition_intent_state()
        if (
            complete["ok"]
            and maintenance["ok"]
            and domain.get("compatible")
            and domain.get("profile") == "maintenance"
            and complete["payload"].get("transition_id")
            == existing_intent.get("payload", {}).get("transition_id")
            and existing_intent.get("payload", {}).get("evidence_id") == evidence_id
        ):
            payload = {
                "ok": True,
                "changed": False,
                "message": "maintenance transition already verified",
                "complete": complete,
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["message"])
            return 0
        payload = {
            "ok": False,
            "changed": False,
            "error": "existing transition completion is incompatible; no overwrite performed",
            "complete": complete,
            "maintenance": maintenance,
            "domain": domain,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    intent_exists = TRANSITION_INTENT_PATH.exists() or TRANSITION_INTENT_PATH.is_symlink()
    intent = transition_intent_state() if intent_exists else {"ok": False, "payload": {}, "errors": []}
    if intent_exists and not intent["ok"]:
        payload = {
            "ok": False,
            "changed": False,
            "error": "existing transition intent is incompatible; no overwrite performed",
            "intent": intent,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    if intent_exists and intent["payload"].get("evidence_id") != evidence_id:
        payload = {
            "ok": False,
            "changed": False,
            "error": "existing transition intent belongs to a different evidence ID",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    boundary_domain = own_domain_state()
    if not intent_exists and (
        not boundary_domain.get("compatible") or boundary_domain.get("profile") != "install"
    ):
        payload = {
            "ok": False,
            "changed": False,
            "error": (
                "a new transition intent may only be created from the exact install profile; "
                "maintenance is accepted only when resuming an existing valid intent"
            ),
            "domain": boundary_domain,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    consistency = postinstall_consistency_state(
        evidence_id,
        allow_maintenance_profile=intent_exists,
    )
    if not consistency["ok"]:
        payload = {
            "ok": False,
            "changed": False,
            "error": "post-install consistency validation failed before redefine",
            "consistency": consistency,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in consistency["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    identities = media_identities()
    if not identities["ok"]:
        print("transition service identities are unavailable", file=sys.stderr)
        return 1
    changed = False
    if not intent_exists:
        maintenance_payload = build_maintenance_payload(consistency, str(uuid.uuid4()))
        intent_payload = {
            "schema": TRANSITION_INTENT_SCHEMA,
            "transition_id": str(uuid.uuid4()),
            "operation": "install-to-maintenance",
            "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
            "evidence_id": evidence_id,
            "run_id": consistency["run"]["run_id"],
            "source_profile": "install",
            "target_profile": "maintenance",
            "maintenance": maintenance_payload,
            "maintenance_sha256": canonical_json_sha256(maintenance_payload),
        }
        try:
            publish_json_no_replace(
                TRANSITION_INTENT_PATH,
                intent_payload,
                uid=identities["root_uid"],
                gid=identities["libvirt_gid"],
                mode=MANAGED_JSON_MODE,
            )
        except OSError as error:
            print(f"transition intent publication failed before redefine: {error}", file=sys.stderr)
            return 1
        intent = transition_intent_state()
        if not intent["ok"]:
            print("published transition intent failed verification; domain was not redefined", file=sys.stderr)
            return 1
        changed = True
    maintenance_payload = intent["payload"]["maintenance"]
    consistency_errors = consistency_matches_maintenance(consistency, maintenance_payload)
    if consistency_errors:
        payload = {
            "ok": False,
            "changed": changed,
            "error": "current offline state differs from the immutable transition intent",
            "errors": consistency_errors,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    domain = consistency["domain"]
    if domain.get("profile") == "install":
        defined = virsh(["define", str(MAINTENANCE_XML_PATH), "--validate"])
        if defined.rc != 0:
            print(
                defined.stderr or defined.stdout or "maintenance profile redefine failed; intent retained",
                file=sys.stderr,
            )
            return 1
        changed = True
    elif domain.get("profile") != "maintenance":
        print("transition intent exists but domain is neither install nor maintenance", file=sys.stderr)
        return 1
    _autostart_messages, autostart_errors = disable_all_domain_autostart()
    if autostart_errors:
        for error in autostart_errors:
            print(error, file=sys.stderr)
        return 1
    converged = own_domain_state()
    if not converged.get("compatible") or converged.get("profile") != "maintenance":
        payload = {
            "ok": False,
            "changed": changed,
            "error": "maintenance XML did not converge; intent retained and no rollback attempted",
            "domain": converged,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    revalidated = postinstall_consistency_state(
        evidence_id,
        allow_maintenance_profile=True,
    )
    if not revalidated["ok"]:
        print("full offline revalidation failed after redefine; transition remains incomplete", file=sys.stderr)
        for error in revalidated["errors"]:
            print(f"error: {error}", file=sys.stderr)
        return 1
    revalidation_errors = consistency_matches_maintenance(revalidated, maintenance_payload)
    if revalidation_errors:
        print("offline VM artifacts changed across redefine; transition remains incomplete", file=sys.stderr)
        for error in revalidation_errors:
            print(f"error: {error}", file=sys.stderr)
        return 1

    maintenance_exists = (
        MAINTENANCE_ATTESTATION_PATH.exists() or MAINTENANCE_ATTESTATION_PATH.is_symlink()
    )
    if maintenance_exists:
        existing_payload, existing_errors = managed_json_object(
            MAINTENANCE_ATTESTATION_PATH,
            "maintenance state attestation",
        )
        if existing_errors or existing_payload != maintenance_payload:
            print("existing maintenance attestation differs from intent; no overwrite performed", file=sys.stderr)
            return 1
    else:
        try:
            publish_json_no_replace(
                MAINTENANCE_ATTESTATION_PATH,
                maintenance_payload,
                uid=identities["root_uid"],
                gid=identities["libvirt_gid"],
                mode=MANAGED_JSON_MODE,
            )
        except OSError as error:
            print(f"maintenance attestation publication failed; intent retained: {error}", file=sys.stderr)
            return 1
        changed = True
    maintenance = maintenance_state(verify_artifacts=True)
    if not maintenance["ok"] or maintenance["payload"] != maintenance_payload:
        print("published maintenance state failed strict verification", file=sys.stderr)
        return 1

    commit_boundary = maintenance_commit_boundary(maintenance_payload)
    if not commit_boundary["ok"]:
        print("maintenance completion boundary is not stable; completion was not published", file=sys.stderr)
        for error in commit_boundary["errors"]:
            print(f"error: {error}", file=sys.stderr)
        return 1

    complete_payload = {
        "schema": TRANSITION_COMPLETE_SCHEMA,
        "transition_id": intent["payload"]["transition_id"],
        "completed_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "intent_sha256": sha256_file(TRANSITION_INTENT_PATH),
        "maintenance_sha256": sha256_file(MAINTENANCE_ATTESTATION_PATH),
        "target_profile": "maintenance",
    }
    try:
        publish_json_no_replace(
            TRANSITION_COMPLETE_PATH,
            complete_payload,
            uid=identities["root_uid"],
            gid=identities["libvirt_gid"],
            mode=MANAGED_JSON_MODE,
        )
    except FileExistsError:
        pass
    except OSError as error:
        print(f"transition completion publication failed; rerun is safe: {error}", file=sys.stderr)
        return 1
    complete = transition_complete_state()
    final_boundary = maintenance_commit_boundary(maintenance_payload)
    if not final_boundary["ok"]:
        complete = {
            **complete,
            "ok": False,
            "errors": [
                *complete.get("errors", []),
                *final_boundary["errors"],
            ],
        }
    payload = {
        "ok": complete["ok"],
        "changed": changed or complete["ok"],
        "maintenance": maintenance,
        "complete": complete,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    elif complete["ok"]:
        print("install-to-maintenance transition committed")
    else:
        for error in complete["errors"]:
            print(error, file=sys.stderr)
    return 0 if complete["ok"] else 1


def command_define(args: argparse.Namespace) -> int:
    if args.profile == "maintenance":
        return unsupported(
            args,
            "define --profile maintenance",
            "post-install guest evidence and NVRAM re-attestation workflow is not implemented",
        )
    if incomplete_transition_exists():
        return unsupported(
            args,
            f"define --profile {args.profile}",
            "an install-to-maintenance transition intent is incomplete; resume transition-maintenance",
        )
    preflight = mutation_preflight(args.profile == "install", True, True, True)
    if not preflight["ok"]:
        payload = {"ok": False, "error": "define blocked by preflight", "preflight": preflight}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in preflight["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1

    domain = own_domain_state()
    if not domain.get("ok") and domain.get("errors"):
        message = "existing domain conflicts with repo definition: " + "; ".join(domain["errors"])
        if args.json:
            print(json.dumps({"ok": False, "error": message}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
        return 1
    if domain.get("exists"):
        state = domain.get("info", {}).get("state", "").lower()
        if state not in {"shut off", "shutoff"}:
            print(f"{DOMAIN} is {state!r}; refusing redefine", file=sys.stderr)
            return 1

    messages: list[str] = []
    identities = media_identities()
    if not identities["ok"]:
        for error in identities["errors"]:
            print(error, file=sys.stderr)
        return 1
    volume = volume_state()
    if not volume.get("ok"):
        for error in volume.get("errors", []):
            print(error, file=sys.stderr)
        return 1

    intent_exists = PREINSTALL_DISK_INTENT_PATH.exists() or PREINSTALL_DISK_INTENT_PATH.is_symlink()
    intent = preinstall_disk_intent_state() if intent_exists else {
        "ok": False,
        "payload": {},
        "errors": [],
    }
    if intent_exists and not intent["ok"]:
        print("pre-install disk creation intent is incompatible; no mutation attempted", file=sys.stderr)
        for error in intent["errors"]:
            print(f"error: {error}", file=sys.stderr)
        return 1
    attestation_exists = (
        PREINSTALL_DISK_ATTESTATION_PATH.exists()
        or PREINSTALL_DISK_ATTESTATION_PATH.is_symlink()
    )
    if attestation_exists:
        disk_attestation = preinstall_disk_state(verify_current=True)
        if not disk_attestation["ok"]:
            print("existing pre-install disk attestation is incompatible", file=sys.stderr)
            for error in disk_attestation["errors"]:
                print(f"error: {error}", file=sys.stderr)
            return 1
    else:
        if not intent_exists:
            if volume.get("exists"):
                print(
                    "an unclaimed Windows volume already exists; without a prior creation intent "
                    "it will not be adopted, overwritten, or deleted",
                    file=sys.stderr,
                )
                return 1
            try:
                publish_json_no_replace(
                    PREINSTALL_DISK_INTENT_PATH,
                    new_preinstall_disk_intent(identities),
                    uid=identities["root_uid"],
                    gid=identities["libvirt_gid"],
                    mode=MANAGED_JSON_MODE,
                )
            except OSError as error:
                print(f"pre-install disk intent publication failed: {error}", file=sys.stderr)
                return 1
            intent = preinstall_disk_intent_state()
            if not intent["ok"]:
                print("published pre-install disk intent failed verification", file=sys.stderr)
                return 1
            intent_exists = True
            messages.append("published recoverable pre-install disk creation intent")
        if not volume.get("exists"):
            create = create_managed_windows_volume(identities)
            if create.rc != 0:
                print(create.stderr or create.stdout or "disk creation failed", file=sys.stderr)
                return 1
            messages.append(create.stdout or f"created {VOLUME_POOL}/{VOLUME_NAME}")
            volume = volume_state()
            if not volume.get("compatible"):
                for error in volume.get("errors", ["created disk did not pass compatibility checks"]):
                    print(error, file=sys.stderr)
                return 1
        blank = blank_preinstall_disk_state()
        if not blank["ok"]:
            print("intended Windows disk is not provably empty and clean", file=sys.stderr)
            for error in blank["errors"]:
                print(f"error: {error}", file=sys.stderr)
            return 1
        try:
            publish_json_no_replace(
                PREINSTALL_DISK_ATTESTATION_PATH,
                preinstall_disk_payload(blank, intent["payload"]),
                uid=identities["root_uid"],
                gid=identities["libvirt_gid"],
                mode=MANAGED_JSON_MODE,
            )
        except OSError as error:
            print(
                f"pre-install disk attestation publication failed; disk and intent were preserved: {error}",
                file=sys.stderr,
            )
            return 1
        messages.append("attested a new standalone logically-zero Windows disk")

    disk_attestation = preinstall_disk_state(verify_current=True)
    if not disk_attestation["ok"]:
        print("pre-install disk failed final intent-bound validation", file=sys.stderr)
        for error in disk_attestation["errors"]:
            print(f"error: {error}", file=sys.stderr)
        return 1

    xml_path = PROFILE_PATHS[args.profile]
    define = virsh(["define", str(xml_path)])
    if define.rc != 0:
        print(define.stderr or define.stdout or "virsh define failed", file=sys.stderr)
        return 1
    messages.append(define.stdout or f"defined {DOMAIN} profile={args.profile}")
    autostart_messages, autostart_errors = disable_all_domain_autostart()
    if autostart_errors:
        for error in autostart_errors:
            print(error, file=sys.stderr)
        return 1
    messages.extend(autostart_messages)
    converged = own_domain_state()
    if not converged.get("compatible") or converged.get("profile") != args.profile:
        message = "defined domain did not converge to the exact allowlisted inactive XML; it was not started"
        if args.json:
            print(json.dumps({"ok": False, "error": message, "domain": converged}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
            for error in converged.get("errors", []):
                print(f"error: {error}", file=sys.stderr)
        return 1
    payload = {"ok": True, "profile": args.profile, "messages": messages}
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for message in messages:
            print(message)
    return 0


def launch_console() -> tuple[bool, str]:
    viewer = shutil.which("virt-viewer")
    if viewer:
        try:
            subprocess.Popen(
                [viewer, "--connect", URI, "--wait", DOMAIN],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as error:
            return False, str(error)
        return True, f"virt-viewer launched for {DOMAIN}"
    manager = shutil.which("virt-manager")
    if manager:
        try:
            subprocess.Popen(
                [manager, "-c", URI, "--show-domain-console", DOMAIN],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as error:
            return False, str(error)
        return True, f"virt-manager console launched for {DOMAIN}"
    return False, "virt-viewer and virt-manager not found"


def install_run_payload(run_id: str) -> dict[str, Any]:
    return {
        "schema": RUN_ATTESTATION_SCHEMA,
        "run_id": canonical_uuid(run_id, "run_id"),
        "domain": DOMAIN,
        "domain_uuid": DOMAIN_UUID,
        "profile": "install",
        "prepared_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "challenge": secrets.token_hex(32),
        "host_boot_id": canonical_uuid(read_text(BOOT_ID_PATH), "host_boot_id"),
        "workflow_sha256": sha256_file(Path(__file__).resolve()),
        "hardware_sha256": canonical_json_sha256(expected_signature("install")),
        "entitlement_status": ELIGIBLE_DURABLE_ENTITLEMENT,
        "media_sha256": WINDOWS_SHA256,
        "windows_release": WINDOWS_RELEASE,
        "preinstall_attestation_sha256": sha256_file(STATE_ATTESTATION_PATH),
        "preinstall_disk_attestation_sha256": sha256_file(
            PREINSTALL_DISK_ATTESTATION_PATH
        ),
    }


def command_start_maintenance(args: argparse.Namespace) -> int:
    if args.profile == "maintenance":
        return unsupported(
            args,
            "start-maintenance --profile maintenance",
            "post-install guest evidence and NVRAM re-attestation workflow is not implemented",
        )
    if incomplete_transition_exists():
        return unsupported(
            args,
            f"start-maintenance --profile {args.profile}",
            "an install-to-maintenance transition intent is incomplete; resume transition-maintenance",
        )
    if os.geteuid() != 0:
        payload = {
            "ok": False,
            "error": "start-maintenance requires a visible local sudo invocation",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    preflight = mutation_preflight(args.profile == "install", True, True, True)
    if not preflight["ok"]:
        payload = {"ok": False, "error": "maintenance start blocked by preflight", "preflight": preflight}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
            for error in preflight["errors"]:
                print(f"error: {error}", file=sys.stderr)
        return 1
    domain = own_domain_state()
    if not domain.get("compatible") or domain.get("profile") != args.profile:
        message = (
            f"requested hostdev-free profile {args.profile!r} is not defined and compatible; "
            f"run define --profile {args.profile} first"
        )
        if args.json:
            print(json.dumps({"ok": False, "error": message, "domain": domain}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
        return 1
    volume = volume_state()
    if not volume.get("compatible"):
        message = f"{args.profile} disk is missing or incompatible"
        if args.json:
            print(json.dumps({"ok": False, "error": message, "volume": volume}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
            for error in volume.get("errors", []):
                print(f"error: {error}", file=sys.stderr)
        return 1
    state = domain.get("info", {}).get("state", "").lower()
    managed_save = domain.get("info", {}).get("managed_save", "no").lower()
    if managed_save not in {"", "no"}:
        print("managed save exists; refusing maintenance boot", file=sys.stderr)
        return 1
    existing_run = run_attestation_state()
    run_path_exists = RUN_ATTESTATION_PATH.exists() or RUN_ATTESTATION_PATH.is_symlink()
    if not run_path_exists:
        disk_attestation = preinstall_disk_state(verify_current=True)
        if not disk_attestation["ok"]:
            payload = {
                "ok": False,
                "error": "first install boot requires the exact attested logically-zero disk",
                "preinstall_disk": disk_attestation,
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
            return 1
    if run_path_exists and not existing_run["ok"]:
        payload = {
            "ok": False,
            "error": "existing install-run attestation is incompatible; no overwrite performed",
            "run": existing_run,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    if state == "running" and not existing_run["ok"]:
        payload = {
            "ok": False,
            "error": "install domain is already running without a valid pre-start run attestation",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    if state in {"shut off", "shutoff"} and existing_run["ok"] and not getattr(args, "resume", False):
        payload = {
            "ok": False,
            "error": "a prior install run is attested; pass --resume to boot it again",
            "run": existing_run,
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    if getattr(args, "resume", False) and any(
        path.exists() or path.is_symlink()
        for path in (SHUTDOWN_RECEIPT_PATH, TRANSITION_INTENT_PATH, TRANSITION_COMPLETE_PATH)
    ):
        payload = {
            "ok": False,
            "error": "install run cannot resume after shutdown/transition evidence has been published",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1

    new_run_payload: dict[str, Any] = {}
    if not existing_run["ok"]:
        try:
            new_run_payload = install_run_payload(str(uuid.uuid4()))
        except OSError as error:
            payload = {"ok": False, "error": f"cannot prepare install-run attestation: {error}"}
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
            return 1
    if new_run_payload:
        identities = media_identities()
        if not identities["ok"]:
            print("cannot publish install-run attestation: " + "; ".join(identities["errors"]), file=sys.stderr)
            return 1
        try:
            publish_json_no_replace(
                RUN_ATTESTATION_PATH,
                new_run_payload,
                uid=identities["root_uid"],
                gid=identities["libvirt_gid"],
                mode=MANAGED_JSON_MODE,
            )
        except FileExistsError:
            raced_run = run_attestation_state()
            if not raced_run["ok"]:
                print("install-run attestation appeared concurrently and is incompatible", file=sys.stderr)
                return 1
        except OSError as error:
            print(
                f"pre-start install-run attestation publication failed: {error}; VM was not started",
                file=sys.stderr,
            )
            return 1
        existing_run = run_attestation_state()
        if not existing_run["ok"]:
            payload = {
                "ok": False,
                "error": "published pre-start install-run attestation failed verification; VM was not started",
                "run": existing_run,
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["error"], file=sys.stderr)
            return 1
    messages: list[str] = [f"attested install run {existing_run['run_id']}"]
    if state in {"shut off", "shutoff"}:
        result = virsh(["start", DOMAIN])
        if result.rc != 0:
            print(
                (result.stderr or result.stdout or "virsh start failed")
                + "; the prepared run remains recoverable with --resume",
                file=sys.stderr,
            )
            return 1
        messages.append(result.stdout or f"started {DOMAIN} profile={args.profile}")
    elif state == "running":
        messages.append(f"{DOMAIN} already running")
    else:
        print(f"{DOMAIN} state is {state!r}; refusing maintenance start", file=sys.stderr)
        return 1
    if args.open_console:
        ok, message = launch_console()
        messages.append(message)
        if not ok:
            payload = {"ok": False, "error": message, "messages": messages}
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(message, file=sys.stderr)
            return 1
    payload = {"ok": True, "messages": messages, "run": existing_run}
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for message in messages:
            print(message)
    return 0


def command_usb_preflight(args: argparse.Namespace) -> int:
    state = usb_qualification_state()
    if args.json:
        print(json.dumps(state, indent=2, sort_keys=True))
    elif state["ok"]:
        print(f"qualified controller: {state['controller']}")
        print(f"driver: {state['driver']}")
    else:
        print(f"USB-C controller {state['controller']} is not qualified")
        for error in state["errors"]:
            print(f"error: {error}")
    return 0 if state["ok"] else 1


def command_open_console(args: argparse.Namespace) -> int:
    if incomplete_transition_exists():
        return unsupported(
            args,
            "open-console",
            "an install-to-maintenance transition intent is incomplete",
        )
    entitlement = entitlement_state()
    if not entitlement["ok"]:
        message = "console access blocked: " + "; ".join(entitlement["errors"])
        if args.json:
            print(
                json.dumps(
                    {"ok": False, "error": message, "entitlement": entitlement},
                    indent=2,
                    sort_keys=True,
                )
            )
        else:
            print(message, file=sys.stderr)
        return 1
    domain = own_domain_state()
    if not domain.get("exists") or not domain.get("compatible"):
        message = "compatible domain is not defined"
        if args.json:
            print(json.dumps({"ok": False, "error": message, "domain": domain}, indent=2, sort_keys=True))
        else:
            print(message, file=sys.stderr)
        return 1
    ok, message = launch_console()
    if args.json:
        print(json.dumps({"ok": ok, "message": message}, indent=2, sort_keys=True))
    elif ok:
        print(message)
    else:
        print(message, file=sys.stderr)
    return 0 if ok else 1


def wait_for_shutoff(timeout: int) -> bool:
    deadline = time.monotonic() + timeout
    while True:
        result = virsh(["domstate", DOMAIN], readonly=True)
        if result.rc != 0:
            return False
        if result.stdout.strip().lower() in {"shut off", "shutoff"}:
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        time.sleep(min(2.0, remaining))


def domain_numeric_state() -> dict[str, Any]:
    result = virsh(
        ["domstats", DOMAIN, "--state", "--raw", "--enforce"],
        readonly=True,
    )
    if result.rc != 0:
        return {
            "ok": False,
            "state": -1,
            "reason": -1,
            "errors": [result.stderr or result.stdout or "domstats failed"],
        }
    values: dict[str, str] = {}
    for line in result.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    try:
        state = int(values["state.state"])
        reason = int(values["state.reason"])
    except (KeyError, ValueError) as error:
        return {
            "ok": False,
            "state": -1,
            "reason": -1,
            "errors": [f"invalid domain numeric state: {error}"],
        }
    return {"ok": True, "state": state, "reason": reason, "errors": []}


def offline_receipt_domain_state(
    *,
    allowed_profiles: set[str],
    require_shutdown_reason: bool,
) -> dict[str, Any]:
    """Recheck the exact inactive domain around receipt/commit boundaries."""

    errors: list[str] = []
    domain = own_domain_state()
    if not domain.get("compatible") or domain.get("profile") not in allowed_profiles:
        errors.extend(domain.get("errors", ["domain profile is incompatible"]))
        if domain.get("compatible") and domain.get("profile") not in allowed_profiles:
            errors.append(
                f"domain profile {domain.get('profile')!r} is outside "
                f"{sorted(allowed_profiles)}"
            )
    guards = offline_domain_guards(domain)
    if not guards["ok"]:
        errors.extend(guards["errors"])
    numeric = domain_numeric_state()
    if not numeric["ok"]:
        errors.extend(numeric["errors"])
    elif numeric["state"] != 5 or (
        require_shutdown_reason and numeric["reason"] != 1
    ):
        expected = "5/1" if require_shutdown_reason else "state 5"
        errors.append(
            f"domain numeric state must be {expected}, found "
            f"{numeric['state']}/{numeric['reason']}"
        )
    return {
        "ok": not errors,
        "domain": domain,
        "guards": guards,
        "numeric": numeric,
        "errors": errors,
    }


def shutdown_receipt_state(run_payload: dict[str, Any]) -> dict[str, Any]:
    payload, errors = managed_json_object(SHUTDOWN_RECEIPT_PATH, "ACPI shutdown receipt")
    if payload:
        try:
            exact_object_keys(
                payload,
                {
                    "schema",
                    "run_id",
                    "evidence_id",
                    "evidence_sha256",
                    "domain",
                    "domain_uuid",
                    "profile",
                    "mode",
                    "requested_utc",
                    "observed_shutoff_utc",
                    "host_boot_id",
                    "workflow_sha256",
                    "artifact_stat_sha256",
                    "libvirt_state",
                    "libvirt_reason",
                },
                "ACPI shutdown receipt",
            )
            canonical_uuid(payload["run_id"], "run_id")
            canonical_uuid(payload["evidence_id"], "evidence_id")
            canonical_uuid(payload["host_boot_id"], "host_boot_id")
            requested = parse_utc_timestamp(payload["requested_utc"], "requested_utc")
            observed = parse_utc_timestamp(
                payload["observed_shutoff_utc"],
                "observed_shutoff_utc",
            )
            prepared = parse_utc_timestamp(run_payload.get("prepared_utc"), "run prepared_utc")
            if not prepared <= requested <= observed:
                raise ValueError("shutdown receipt timestamps are out of order")
        except (KeyError, TypeError, ValueError) as error:
            errors.append(str(error))
        required = {
            "schema": SHUTDOWN_RECEIPT_SCHEMA,
            "run_id": run_payload.get("run_id"),
            "domain": DOMAIN,
            "domain_uuid": DOMAIN_UUID,
            "profile": "install",
            "mode": "acpi-observed",
            "host_boot_id": run_payload.get("host_boot_id"),
            "workflow_sha256": run_payload.get("workflow_sha256"),
            "libvirt_state": 5,
            "libvirt_reason": 1,
        }
        for key, expected in required.items():
            if payload.get(key) != expected or type(payload.get(key)) is not type(expected):
                errors.append(
                    f"shutdown receipt {key}={payload.get(key)!r}, expected {expected!r}"
                )
        try:
            fingerprint = offline_state_fingerprint()
            if payload.get("artifact_stat_sha256") != fingerprint["sha256"]:
                errors.append("shutdown receipt artifact fingerprint is stale")
        except (OSError, ValueError) as error:
            fingerprint = {"sha256": ""}
            errors.append(f"cannot validate shutdown artifact fingerprint: {error}")
        boundary = offline_receipt_domain_state(
            allowed_profiles={"install", "maintenance"},
            require_shutdown_reason=False,
        )
        if not boundary["ok"]:
            errors.extend(boundary["errors"])
        try:
            final_fingerprint = offline_state_fingerprint()
            if final_fingerprint["sha256"] != fingerprint.get("sha256"):
                errors.append("offline artifacts changed while validating shutdown receipt")
            if payload.get("artifact_stat_sha256") != final_fingerprint["sha256"]:
                errors.append("shutdown receipt final artifact fingerprint is stale")
        except (OSError, ValueError) as error:
            errors.append(f"cannot revalidate shutdown artifact fingerprint: {error}")
        final_boundary = offline_receipt_domain_state(
            allowed_profiles={"install", "maintenance"},
            require_shutdown_reason=False,
        )
        if not final_boundary["ok"]:
            errors.extend(final_boundary["errors"])
        evidence = guest_evidence_state(
            str(payload.get("evidence_id", "")),
            "windows-installed",
            run_payload,
            enforce_freshness=False,
        )
        if not evidence["ok"]:
            errors.append("shutdown receipt references invalid guest evidence")
        elif payload.get("evidence_sha256") != evidence["sha256"]:
            errors.append("shutdown receipt evidence SHA-256 does not match managed evidence")
        else:
            try:
                captured = parse_utc_timestamp(
                    evidence["payload"].get("captured_utc"),
                    "evidence captured_utc",
                )
                requested = parse_utc_timestamp(payload.get("requested_utc"), "requested_utc")
                if captured > requested:
                    errors.append("guest evidence was captured after ACPI shutdown was requested")
            except ValueError as error:
                errors.append(str(error))
    return {
        "ok": bool(payload) and not errors,
        "path": str(SHUTDOWN_RECEIPT_PATH),
        "payload": payload,
        "evidence_id": str(payload.get("evidence_id", "")),
        "errors": errors,
    }


def command_shutdown(args: argparse.Namespace) -> int:
    record_receipt = getattr(args, "record_receipt", False)
    run_state: dict[str, Any] = {}
    evidence_state: dict[str, Any] = {}
    evidence_id = ""
    requested_utc = ""
    if record_receipt:
        if os.geteuid() != 0:
            print("recording an ACPI receipt requires a visible local sudo invocation", file=sys.stderr)
            return 1
        if args.wait <= 0 or args.wait > 900:
            print("--record-receipt requires --wait between 1 and 900 seconds", file=sys.stderr)
            return 1
        try:
            evidence_id = canonical_uuid(getattr(args, "evidence_id", ""), "evidence_id")
        except ValueError as error:
            print(str(error), file=sys.stderr)
            return 1
        run_state = run_attestation_state()
        if not run_state["ok"]:
            print("valid install-run attestation is required before ACPI receipt", file=sys.stderr)
            return 1
        evidence_state = guest_evidence_state(
            evidence_id,
            "windows-installed",
            run_state["payload"],
        )
        if not evidence_state["ok"]:
            print("valid managed windows-installed evidence is required before shutdown", file=sys.stderr)
            return 1
        existing_receipt = shutdown_receipt_state(run_state["payload"])
        if SHUTDOWN_RECEIPT_PATH.exists() or SHUTDOWN_RECEIPT_PATH.is_symlink():
            if existing_receipt["ok"] and existing_receipt["evidence_id"] == evidence_id:
                current_domain = own_domain_state()
                current_state = current_domain.get("info", {}).get("state", "").lower()
                numeric = domain_numeric_state()
                if (
                    not current_domain.get("compatible")
                    or current_domain.get("profile") != "install"
                    or current_state not in {"shut off", "shutoff"}
                    or not numeric["ok"]
                    or numeric["state"] != 5
                ):
                    print(
                        "matching receipt exists but the current install domain is not in its attested shutoff state",
                        file=sys.stderr,
                    )
                    return 1
                payload = {
                    "ok": True,
                    "message": "matching ACPI shutdown receipt already exists",
                    "receipt": existing_receipt,
                }
                if args.json:
                    print(json.dumps(payload, indent=2, sort_keys=True))
                else:
                    print(payload["message"])
                return 0
            print("existing ACPI shutdown receipt is incompatible; no overwrite performed", file=sys.stderr)
            return 1
    domain = own_domain_state()
    if not domain.get("exists"):
        print(f"{DOMAIN} is not defined", file=sys.stderr)
        return 1
    if record_receipt and (
        not domain.get("compatible") or domain.get("profile") != "install"
    ):
        print("ACPI receipt requires the exact compatible install profile", file=sys.stderr)
        return 1
    state = domain.get("info", {}).get("state", "").lower()
    if state in {"shut off", "shutoff"}:
        if record_receipt:
            print("domain is already shut off; refusing to manufacture an ACPI receipt", file=sys.stderr)
            return 1
        payload = {"ok": True, "message": f"{DOMAIN} already shut off"}
    elif state == "running":
        requested_utc = dt.datetime.now(dt.timezone.utc).isoformat()
        result = virsh(["shutdown", DOMAIN, "--mode", "acpi"])
        if result.rc != 0:
            print(result.stderr or result.stdout or "ACPI shutdown failed", file=sys.stderr)
            return 1
        if args.wait and not wait_for_shutoff(args.wait):
            print(f"{DOMAIN} did not shut off within {args.wait}s; no force fallback was attempted", file=sys.stderr)
            return 1
        payload = {"ok": True, "message": result.stdout or f"ACPI shutdown requested for {DOMAIN}"}
        if record_receipt:
            numeric = domain_numeric_state()
            if not numeric["ok"] or numeric["state"] != 5 or numeric["reason"] != 1:
                print(
                    "domain stopped but libvirt did not attest shutoff reason=shutdown; no receipt written",
                    file=sys.stderr,
                )
                return 1
            identities = media_identities()
            if not identities["ok"]:
                print("cannot resolve receipt identities", file=sys.stderr)
                return 1
            try:
                artifact_fingerprint = offline_state_fingerprint()
            except (OSError, ValueError) as error:
                print(f"cannot fingerprint offline VM state: {error}", file=sys.stderr)
                return 1
            strict_boundary = offline_receipt_domain_state(
                allowed_profiles={"install"},
                require_shutdown_reason=True,
            )
            if not strict_boundary["ok"]:
                print(
                    "install domain changed while preparing the ACPI receipt; no receipt written",
                    file=sys.stderr,
                )
                for error in strict_boundary["errors"]:
                    print(f"error: {error}", file=sys.stderr)
                return 1
            try:
                final_fingerprint = offline_state_fingerprint()
            except (OSError, ValueError) as error:
                print(f"cannot re-fingerprint offline VM state: {error}", file=sys.stderr)
                return 1
            if final_fingerprint["sha256"] != artifact_fingerprint["sha256"]:
                print(
                    "offline VM artifacts changed while preparing the ACPI receipt; no receipt written",
                    file=sys.stderr,
                )
                return 1
            numeric = strict_boundary["numeric"]
            receipt_payload = {
                "schema": SHUTDOWN_RECEIPT_SCHEMA,
                "run_id": run_state["run_id"],
                "evidence_id": evidence_id,
                "evidence_sha256": evidence_state["sha256"],
                "domain": DOMAIN,
                "domain_uuid": DOMAIN_UUID,
                "profile": "install",
                "mode": "acpi-observed",
                "requested_utc": requested_utc,
                "observed_shutoff_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
                "host_boot_id": run_state["payload"]["host_boot_id"],
                "workflow_sha256": run_state["payload"]["workflow_sha256"],
                "artifact_stat_sha256": artifact_fingerprint["sha256"],
                "libvirt_state": numeric["state"],
                "libvirt_reason": numeric["reason"],
            }
            try:
                publish_json_no_replace(
                    SHUTDOWN_RECEIPT_PATH,
                    receipt_payload,
                    uid=identities["root_uid"],
                    gid=identities["libvirt_gid"],
                    mode=MANAGED_JSON_MODE,
                )
            except OSError as error:
                print(f"ACPI receipt publication failed: {error}", file=sys.stderr)
                return 1
            receipt = shutdown_receipt_state(run_state["payload"])
            if not receipt["ok"]:
                print("published ACPI receipt failed verification", file=sys.stderr)
                return 1
            payload["receipt"] = receipt
    else:
        print(f"{DOMAIN} state is {state!r}; ACPI shutdown is not safe from this state", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(payload["message"])
    return 0


def unsupported(args: argparse.Namespace, command: str, reason: str) -> int:
    payload = {
        "ok": False,
        "command": command,
        "error": reason,
        "fallback": "none",
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"{command} unavailable: {reason}", file=sys.stderr)
    return 1


def command_seal_baseline(args: argparse.Namespace) -> int:
    return unsupported(
        args,
        "seal-baseline",
        "the atomic disk/NVRAM/TPM seal and guest validation evidence workflow is not implemented",
    )


def command_start_session(args: argparse.Namespace) -> int:
    return unsupported(
        args,
        "start-session",
        "disposable disk/NVRAM/TPM state and qualified-controller session XML are not implemented",
    )


def command_close_session(args: argparse.Namespace) -> int:
    return unsupported(
        args,
        "close-session",
        "recoverable session cleanup is not implemented; no state was deleted",
    )


def add_json_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="emit JSON")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Safely manage the CTOS Windows Apple recovery VM scaffold."
    )
    parser.add_argument("--json", action="store_true", help="emit JSON")
    subparsers = parser.add_subparsers(dest="command", required=True)

    for name, help_text in (
        ("status", "show read-only VM, host, media, and state readiness"),
        ("plan", "show the next explicit actions and blockers"),
        ("apply-infra", "apply only the existing CTOS libvirt network and pools"),
        ("prepare-secure-state", "atomically generate inspected pre-install NVRAM and empty TPM state"),
        ("verify-media", "verify the fixed official Windows ISO SHA-256"),
        ("usb-preflight", "read-only USB-C/IOMMU qualification check"),
        ("open-console", "open a local console without starting the VM"),
        ("seal-baseline", "seal an atomic apple-ready consistency set"),
        ("start-session", "start a disposable recovery consistency set"),
        ("close-session", "close and explicitly clean a disposable session"),
    ):
        add_json_argument(subparsers.add_parser(name, help=help_text))

    import_parser = subparsers.add_parser(
        "import-media",
        help="atomically import and attest the fixed official Windows ISO",
    )
    add_json_argument(import_parser)
    import_parser.add_argument(
        "--source",
        required=True,
        help=f"absolute canonical source path ending in {WINDOWS_ISO_NAME}",
    )

    evidence_parser = subparsers.add_parser(
        "ingest-evidence",
        help="strictly validate and publish operator-reviewed guest evidence",
    )
    add_json_argument(evidence_parser)
    evidence_parser.add_argument(
        "--phase",
        choices=("windows-installed", "apple-ready"),
        required=True,
    )
    evidence_parser.add_argument("--source", required=True, help="absolute canonical JSON source")

    transition_parser = subparsers.add_parser(
        "transition-maintenance",
        help="crash-consistently attest and redefine install state as maintenance",
    )
    add_json_argument(transition_parser)
    transition_parser.add_argument("--evidence-id", required=True, help="managed evidence UUID")

    define_parser = subparsers.add_parser("define", help="create the 96 GiB disk and define a shutoff profile")
    add_json_argument(define_parser)
    define_parser.add_argument("--profile", choices=sorted(PROFILE_PATHS), required=True)

    start_parser = subparsers.add_parser(
        "start-maintenance",
        help="start an explicitly selected hostdev-free install or maintenance profile",
    )
    add_json_argument(start_parser)
    start_parser.add_argument("--profile", choices=sorted(PROFILE_PATHS), required=True)
    start_parser.add_argument("--open-console", action="store_true")
    start_parser.add_argument(
        "--resume",
        action="store_true",
        help="explicitly resume the already attested shut-off install run",
    )

    shutdown_parser = subparsers.add_parser("shutdown", help="request explicit ACPI shutdown; never force")
    add_json_argument(shutdown_parser)
    shutdown_parser.add_argument("--wait", type=int, default=0, metavar="SECONDS")
    shutdown_parser.add_argument(
        "--record-receipt",
        action="store_true",
        help="after an observed ACPI shutoff, publish a run-bound receipt",
    )
    shutdown_parser.add_argument(
        "--evidence-id",
        help="canonical UUID that the shutdown receipt must bind",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    commands = {
        "status": command_status,
        "plan": command_plan,
        "apply-infra": command_apply_infra,
        "prepare-secure-state": command_prepare_secure_state,
        "verify-media": command_verify_media,
        "import-media": command_import_media,
        "ingest-evidence": command_ingest_evidence,
        "transition-maintenance": command_transition_maintenance,
        "define": command_define,
        "start-maintenance": command_start_maintenance,
        "seal-baseline": command_seal_baseline,
        "start-session": command_start_session,
        "usb-preflight": command_usb_preflight,
        "open-console": command_open_console,
        "shutdown": command_shutdown,
        "close-session": command_close_session,
    }
    mutating_commands = {
        "apply-infra",
        "prepare-secure-state",
        "import-media",
        "ingest-evidence",
        "transition-maintenance",
        "define",
        "start-maintenance",
        "shutdown",
        "seal-baseline",
        "start-session",
        "close-session",
    }
    if args.command not in mutating_commands:
        return commands[args.command](args)
    if os.geteuid() != 0:
        payload = {
            "ok": False,
            "command": args.command,
            "error": "mutation requires a visible local sudo invocation",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1
    try:
        with mutation_lock():
            return commands[args.command](args)
    except (OSError, RuntimeError) as error:
        payload = {
            "ok": False,
            "command": args.command,
            "error": f"mutation lock refused: {error}",
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(payload["error"], file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
