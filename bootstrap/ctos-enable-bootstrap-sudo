#!/usr/bin/env bash
set -euo pipefail

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
	printf 'run with sudo: sudo %s\n' "$0" >&2
	exit 1
fi

install -d -m 0750 /etc/sudoers.d
cat >/etc/sudoers.d/ctos-bootstrap <<'EOF'
ctos ALL=(root) NOPASSWD: /home/ctos/T480/bootstrap/ctos-apply-role
EOF
chmod 0440 /etc/sudoers.d/ctos-bootstrap
visudo -cf /etc/sudoers.d/ctos-bootstrap

printf 'temporary CTOS bootstrap sudo rule installed.\n'
