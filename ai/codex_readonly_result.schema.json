{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctos.local/schemas/codex-readonly-result-v1.json",
  "title": "CTOS bounded read-only Codex result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "findings",
    "checks",
    "clarifications"
  ],
  "properties": {
    "schema_version": {
      "const": "ctos.codex_readonly_result.v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "clarifications": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
