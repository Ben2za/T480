{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctos.local/schemas/voice-task-spec-v1.json",
  "title": "CTOS transcript-free read-only voice task specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "workspace",
    "allowed_scope",
    "constraints",
    "deliverable",
    "acceptance_checks",
    "approval_class",
    "clarification_state"
  ],
  "properties": {
    "schema_version": {
      "const": "ctos.voice_task.v1"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "workspace": {
      "const": "/home/operator/T480"
    },
    "allowed_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "deliverable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "approval_class": {
      "const": "read_only"
    },
    "clarification_state": {
      "type": "string",
      "enum": [
        "resolved",
        "needs_clarification"
      ]
    }
  }
}
